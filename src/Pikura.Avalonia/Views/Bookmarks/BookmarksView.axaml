<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:gallery="using:Pikura.Avalonia.Views.Gallery"
             xmlns:local="using:Pikura.Avalonia.Views.Gallery"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             xmlns:services="using:Pikura.Avalonia.Services"
             x:DataType="vm:BookmarksViewModel"
             x:Class="Pikura.Avalonia.Views.Bookmarks.BookmarksView"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800">

    <UserControl.Resources>
        <conv:BoolToBlurRadiusConverter x:Key="BoolToBlurRadiusConverter"/>

        <!-- Vector star icon for the "local favorite" card badge (replaces the plain "★" glyph). -->
        <StreamGeometry x:Key="FavoriteStarGeometry">M10,1.5 L12.6,7.5 L19,8 L14,12.3 L15.5,18.5 L10,15 L4.5,18.5 L6,12.3 L1,8 L7.4,7.5 Z</StreamGeometry>

        <!-- ══════════════════════════════════════════════════════════════════
             Shared card badge fragments (reused in all templates below)
             ══════════════════════════════════════════════════════════════════ -->

        <!-- Tag chip template (used inside ItemsControl in all views) -->
        <DataTemplate x:Key="TagChipTemplate" x:DataType="x:String">
            <Border Margin="0,1,3,1" Padding="4,1" CornerRadius="3"
                    Background="{DynamicResource Container2BackgroundBrush}">
                <TextBlock Text="{Binding}" FontSize="9"
                           Foreground="{DynamicResource DefaultForegroundBrush}"/>
            </Border>
        </DataTemplate>

        <!-- ══════════════════════════════════════════════════════════════════
             BOOKMARK card — Fixed height (WrapPanel grid, image fills card)
             ══════════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="BookmarkFixedCardTemplate" x:DataType="vm:ArtworkCardViewModel">
            <Panel>
            <Border Width="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize}"
                    Height="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).FixedCardTotalHeight}"
                    Margin="0,0,6,6"
                    Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="1" CornerRadius="8" BoxShadow="{DynamicResource CardShadow}"
                    Cursor="Hand" Tapped="OnCardTapped" DoubleTapped="OnCardDoubleTapped"
                    ClipToBounds="True"
                    Classes.selected="{Binding IsSelected}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Select" Click="OnContextSelectFavorite">
                            <MenuItem.Icon><PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open in side panel" Click="OnContextPreview">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PanelIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open full screen" Click="OnContextOpenFullScreen">
                            <MenuItem.Icon><PathIcon Data="{StaticResource FullscreenIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in new tab" Click="OnContextOpenInNewTab">
                            <MenuItem.Icon><PathIcon Data="{StaticResource NewTabIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in popup" Click="OnContextOpenPopup">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PopupIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Download" Click="OnContextDownload">
                            <MenuItem.Icon><PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Download with Preset" Click="OnContextDownloadPreset">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PaletteIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open artist gallery" Click="OnContextOpenArtistGallery">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PersonIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open on pixiv.net" Click="OnContextOpenPixiv">
                            <MenuItem.Icon><PathIcon Data="{StaticResource GlobeIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Add to local favorites" Click="OnContextAddFavorite" IsVisible="{Binding !IsLocalFavorite}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Remove from favorites" Click="OnContextRemoveFavorite" IsVisible="{Binding IsLocalFavorite}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Copy ID" Click="OnContextCopyId"/>
                        <MenuItem Header="Copy image" Click="OnContextCopyImage">
                            <MenuItem.Icon><PathIcon Data="{StaticResource CopyIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Use as app background" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource ImageIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="BoxShadow"    Value="{DynamicResource CardShadowHover}"/>
                        <Setter Property="BorderBrush"  Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                        <Image.Effect><BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/></Image.Effect>
                    </Image>
                    <!-- Selection checkbox — wrapped in a background chip so it's visible over any image. -->
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6,0,0"
                            Padding="2" CornerRadius="4" Background="#99000000">
                        <CheckBox ZIndex="6" IsChecked="{Binding IsSelected}"
                                  MinWidth="0" MinHeight="0"
                                  Click="OnFavCardCheckboxClicked"/>
                    </Border>
                    <!-- Info overlay -->
                    <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8,5"
                            IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowInfo}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Title}"    FontSize="11" FontWeight="SemiBold" Foreground="White"    TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <TextBlock Text="{Binding UserName}" FontSize="10"                       Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                          IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowTags}"
                                          ItemTemplate="{StaticResource TagChipTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Badges -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"  Margin="6,0,0,6" Padding="5,2" CornerRadius="4" Background="#BB000000" IsVisible="{Binding IsMultiPage}"    IsHitTestVisible="False"><TextBlock Text="{Binding PageCount, StringFormat='1/{0}'}" FontSize="9" Foreground="White"/></Border>
                    <Border VerticalAlignment="Top"    HorizontalAlignment="Right" Margin="0,6,6,0"  Padding="5,2" CornerRadius="4" Background="#CCDC2626" IsVisible="{Binding IsR18}"          IsHitTestVisible="False"><TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/></Border>
                    <!-- Liked heart + bookmarked badge + local favorite star — all bound to
                         ShowBadges so they can be hidden as a group. Individually positioned
                         (not a StackPanel) — a horizontal StackPanel here only renders its first
                         child when this template is hosted inside MasonryPanel (Natural mode). -->
                    <Panel IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowBadges}" IsHitTestVisible="False">
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                            <Border.Margin>
                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                    <Binding Path="IsLiked"/>
                                </MultiBinding>
                            </Border.Margin>
                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                        </Border>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                        </Border>
                        <!-- Favorite star — sits at the very top-right normally, and drops below the
                             R-18 badge only when that badge is also showing, so it's never left
                             floating in an empty gap or overlapping another badge. -->
                        <Panel IsVisible="{Binding IsLocalFavorite}">
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,6,0"  Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding !IsR18}">
                                <Path Data="{StaticResource FavoriteStarGeometry}" Width="9" Height="9" Stretch="Uniform" Fill="White"/>
                            </Border>
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,28,6,0" Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding IsR18}">
                                <Path Data="{StaticResource FavoriteStarGeometry}" Width="9" Height="9" Stretch="Uniform" Fill="White"/>
                            </Border>
                        </Panel>
                    </Panel>
                </Panel>
            </Border>
            <Border Margin="0,0,6,6" IsVisible="{Binding IsSelected}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource ControlBackgroundBrushSolidAccent}" BorderThickness="2" CornerRadius="8"/>
            </Panel>
        </DataTemplate>

        <!-- ══════════════════════════════════════════════════════════════════
             BOOKMARK card — Natural height (Masonry grid)
             ══════════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="BookmarkNaturalCardTemplate" x:DataType="vm:ArtworkCardViewModel">
            <Panel>
            <Border Width="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize}"
                    Margin="0,0,6,6"
                    Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="1" CornerRadius="8" BoxShadow="{DynamicResource CardShadow}"
                    Cursor="Hand" Tapped="OnCardTapped" DoubleTapped="OnCardDoubleTapped"
                    Classes.selected="{Binding IsSelected}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Select" Click="OnContextSelectFavorite">
                            <MenuItem.Icon><PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open in side panel" Click="OnContextPreview">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PanelIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open full screen" Click="OnContextOpenFullScreen">
                            <MenuItem.Icon><PathIcon Data="{StaticResource FullscreenIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in new tab" Click="OnContextOpenInNewTab">
                            <MenuItem.Icon><PathIcon Data="{StaticResource NewTabIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in popup" Click="OnContextOpenPopup">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PopupIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Download" Click="OnContextDownload">
                            <MenuItem.Icon><PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Download with Preset" Click="OnContextDownloadPreset">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PaletteIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open artist gallery" Click="OnContextOpenArtistGallery">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PersonIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open on pixiv.net" Click="OnContextOpenPixiv">
                            <MenuItem.Icon><PathIcon Data="{StaticResource GlobeIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Add to local favorites" Click="OnContextAddFavorite" IsVisible="{Binding !IsLocalFavorite}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Remove from favorites" Click="OnContextRemoveFavorite" IsVisible="{Binding IsLocalFavorite}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Copy ID" Click="OnContextCopyId"/>
                        <MenuItem Header="Copy image" Click="OnContextCopyImage">
                            <MenuItem.Icon><PathIcon Data="{StaticResource CopyIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Use as app background" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource ImageIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="BoxShadow"   Value="{DynamicResource CardShadowHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                    </Style>
                </Border.Styles>
                <Panel>
                <Grid RowDefinitions="Auto,Auto">
                    <!-- Image section -->
                    <Border Grid.Row="0" CornerRadius="7,7,0,0" ClipToBounds="True" MinHeight="120">
                        <Panel>
                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                <Image.Height>
                                    <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                        <Binding Path="$parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize"/>
                                        <Binding Path="ClampedAspectRatio"/>
                                    </MultiBinding>
                                </Image.Height>
                                <Image.Effect><BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/></Image.Effect>
                            </Image>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"  Margin="6,0,0,6" Padding="5,2" CornerRadius="4" Background="#BB000000" IsVisible="{Binding IsMultiPage}"     IsHitTestVisible="False"><TextBlock Text="{Binding PageCount, StringFormat='1/{0}'}" FontSize="9" Foreground="White"/></Border>
                            <Border VerticalAlignment="Top"    HorizontalAlignment="Left"  Margin="42,6,0,0" Padding="5,2" CornerRadius="4" Background="#CCDC2626" IsVisible="{Binding IsR18}"           IsHitTestVisible="False"><TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/></Border>
                            <Panel IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowBadges}" IsHitTestVisible="False">
                                <Border VerticalAlignment="Top"    HorizontalAlignment="Right" Margin="0,6,6,0" Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding IsLocalFavorite}"><Path Data="{StaticResource FavoriteStarGeometry}" Width="9" Height="9" Stretch="Uniform" Fill="White"/></Border>
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                        Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                                    <Border.Margin>
                                        <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                            <Binding Path="IsLiked"/>
                                        </MultiBinding>
                                    </Border.Margin>
                                    <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                </Border>
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                        Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                                    <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                </Border>
                            </Panel>
                            <!-- Selection checkbox — this template previously had none, which made
                                 selection/Download Selected effectively unusable in Natural (masonry)
                                 grid mode. Wrapped in a background chip so it's visible over any image. -->
                            <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6,0,0"
                                    Padding="2" CornerRadius="4" Background="#99000000">
                                <CheckBox ZIndex="6" IsChecked="{Binding IsSelected}"
                                          MinWidth="0" MinHeight="0"
                                          Click="OnFavCardCheckboxClicked"/>
                            </Border>
                        </Panel>
                    </Border>
                    <!-- Info strip -->
                    <StackPanel Grid.Row="1" Margin="8,6,8,8" Spacing="2"
                                IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowInfo}">
                        <TextBlock Text="{Binding Title}"    FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{Binding UserName}" FontSize="10" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                      IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowTags}"
                                      ItemTemplate="{StaticResource TagChipTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                </Panel>
            </Border>
            <Border Margin="0,0,6,6" IsVisible="{Binding IsSelected}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource ControlBackgroundBrushSolidAccent}" BorderThickness="2" CornerRadius="8"/>
            </Panel>
        </DataTemplate>

        <!-- ══════════════════════════════════════════════════════════════════
             BOOKMARK card — List row
             ══════════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="BookmarkListRowTemplate" x:DataType="vm:ArtworkCardViewModel">
            <Panel>
            <Border Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="1" CornerRadius="8" BoxShadow="{DynamicResource CardShadow}"
                    Cursor="Hand" Tapped="OnCardTapped" DoubleTapped="OnCardDoubleTapped"
                    Classes.selected="{Binding IsSelected}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Select" Click="OnContextSelectFavorite">
                            <MenuItem.Icon><PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open in side panel" Click="OnContextPreview">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PanelIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open full screen" Click="OnContextOpenFullScreen">
                            <MenuItem.Icon><PathIcon Data="{StaticResource FullscreenIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in new tab" Click="OnContextOpenInNewTab">
                            <MenuItem.Icon><PathIcon Data="{StaticResource NewTabIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open in popup" Click="OnContextOpenPopup">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PopupIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Download" Click="OnContextDownload">
                            <MenuItem.Icon><PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Download with Preset" Click="OnContextDownloadPreset">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PaletteIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Open artist gallery" Click="OnContextOpenArtistGallery">
                            <MenuItem.Icon><PathIcon Data="{StaticResource PersonIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Open on pixiv.net" Click="OnContextOpenPixiv">
                            <MenuItem.Icon><PathIcon Data="{StaticResource GlobeIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Add to local favorites" Click="OnContextAddFavorite" IsVisible="{Binding !IsLocalFavorite}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Remove from favorites" Click="OnContextRemoveFavorite" IsVisible="{Binding IsLocalFavorite}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Copy ID" Click="OnContextCopyId"/>
                        <MenuItem Header="Copy image" Click="OnContextCopyImage">
                            <MenuItem.Icon><PathIcon Data="{StaticResource CopyIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Use as app background" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}">
                            <MenuItem.Icon><PathIcon Data="{StaticResource ImageIcon}" Width="14" Height="14"/></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="BoxShadow"   Value="{DynamicResource CardShadowHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                    </Style>
                </Border.Styles>
                <Panel>
                <Grid ColumnDefinitions="Auto,72,*" Height="72">
                    <CheckBox Grid.Column="0" ZIndex="6" IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center" Margin="6,0,2,0"
                              MinWidth="0" MinHeight="0" Click="OnFavCardCheckboxClicked"/>
                    <Border Grid.Column="1" CornerRadius="7,0,0,7" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                            <Image.Effect><BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/></Image.Effect>
                        </Image>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="10,0,10,0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="{StaticResource FavoriteStarGeometry}" Width="10" Height="10" Stretch="Uniform"
                                  Fill="#EAB308" IsVisible="{Binding IsLocalFavorite}"/>
                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="11" Height="11"
                                      Foreground="#2563EB" IsVisible="{Binding IsPixivBookmarked}"/>
                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="11" Height="11"
                                      Foreground="#DB2777" IsVisible="{Binding IsLiked}"/>
                            <TextBlock Text="{Binding Title}"    FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UserName}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <ItemsControl ItemsSource="{Binding TopTags}"
                                      IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowTags}"
                                      ItemTemplate="{StaticResource TagChipTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                </Panel>
            </Border>
            <Border IsVisible="{Binding IsSelected}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource ControlBackgroundBrushSolidAccent}" BorderThickness="2" CornerRadius="8"/>
            </Panel>
        </DataTemplate>

        <!-- ══════════════════════════════════════════════════════════════════
             FAVORITES card — Fixed height (adds selection checkbox)
             ══════════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="FavoriteFixedCardTemplate" x:DataType="vm:ArtworkCardViewModel">
            <Panel>
            <Border Width="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize}"
                    Height="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).FixedCardTotalHeight}"
                    Margin="0,0,6,6"
                    Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="1" CornerRadius="8" BoxShadow="{DynamicResource CardShadow}"
                    Cursor="Hand" Tapped="OnCardTapped" DoubleTapped="OnCardDoubleTapped"
                    ClipToBounds="True"
                    Classes.selected="{Binding IsSelected}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="☑ Select"              Click="OnContextSelectFavorite"/>
                        <Separator/>
                        <MenuItem Header="👁 Open in side panel"  Click="OnContextPreview"/>
                        <MenuItem Header="⧶ Open full screen"     Click="OnContextOpenFullScreen"/>
                        <MenuItem Header="⊞ Open in new tab"      Click="OnContextOpenInNewTab"/>
                        <MenuItem Header="⧉ Open in popup"        Click="OnContextOpenPopup"/>
                        <Separator/>
                        <MenuItem Header="↓ Download"             Click="OnContextDownload"/>
                        <MenuItem Header="🎨 Download with Preset" Click="OnContextDownloadPreset"/>
                        <Separator/>
                        <MenuItem Header="👤 Open artist gallery" Click="OnContextOpenArtistGallery"/>
                        <MenuItem Header="🌐 Open on pixiv.net"   Click="OnContextOpenPixiv"/>
                        <Separator/>
                        <MenuItem Header="★ Remove from favorites" Click="OnContextRemoveFavorite"/>
                        <MenuItem Header="📁 Set folder…"          Click="OnContextSetFolder"/>
                        <Separator/>
                        <MenuItem Header="Copy ID"       Click="OnContextCopyId"/>
                        <MenuItem Header="📋 Copy image" Click="OnContextCopyImage"/>
                        <MenuItem Header="🖼 Use as app background" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="BoxShadow"   Value="{DynamicResource CardShadowHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                    </Style>
                </Border.Styles>
                <Panel>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                        <Image.Effect><BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/></Image.Effect>
                    </Image>
                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6,0,0"
                            Padding="2" CornerRadius="4" Background="#99000000">
                        <CheckBox ZIndex="6" IsChecked="{Binding IsSelected}"
                                  MinWidth="0" MinHeight="0"
                                  Click="OnFavCardCheckboxClicked"/>
                    </Border>
                    <!-- Info overlay -->
                    <Border VerticalAlignment="Bottom" Background="#CC000000" Padding="8,5"
                            IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowInfo}">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{Binding Title}"    FontSize="11" FontWeight="SemiBold" Foreground="White"    TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <TextBlock Text="{Binding UserName}" FontSize="10"                       Foreground="#CCFFFFFF" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                            <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                          IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowTags}"
                                          ItemTemplate="{StaticResource TagChipTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <!-- Badges -->
                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"  Margin="6,0,0,6"  Padding="5,2" CornerRadius="4" Background="#BB000000" IsVisible="{Binding IsMultiPage}" IsHitTestVisible="False"><TextBlock Text="{Binding PageCount, StringFormat='1/{0}'}" FontSize="9" Foreground="White"/></Border>
                    <Border VerticalAlignment="Top"    HorizontalAlignment="Right" Margin="0,6,6,0" Padding="5,2" CornerRadius="4" Background="#CCDC2626" IsVisible="{Binding IsR18}"          IsHitTestVisible="False"><TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/></Border>
                    <Panel IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowBadges}" IsHitTestVisible="False">
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                            <Border.Margin>
                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                    <Binding Path="IsLiked"/>
                                </MultiBinding>
                            </Border.Margin>
                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                        </Border>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                        </Border>
                        <!-- Every card in this template is already a favorite, so the star always
                             shows — it just needs to sit right below R-18 when that badge is also
                             present, instead of always being offset down and leaving an empty gap. -->
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,6,0"  Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding !IsR18}">
                            <Path Data="{StaticResource FavoriteStarGeometry}" Width="9" Height="9" Stretch="Uniform" Fill="White"/>
                        </Border>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,28,6,0" Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding IsR18}">
                            <Path Data="{StaticResource FavoriteStarGeometry}" Width="9" Height="9" Stretch="Uniform" Fill="White"/>
                        </Border>
                    </Panel>
                </Panel>
            </Border>
            <Border Margin="0,0,6,6" IsVisible="{Binding IsSelected}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource ControlBackgroundBrushSolidAccent}" BorderThickness="2" CornerRadius="8"/>
            </Panel>
        </DataTemplate>

        <!-- ══════════════════════════════════════════════════════════════════
             FAVORITES card — Natural height (Masonry, adds checkbox)
             ══════════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="FavoriteNaturalCardTemplate" x:DataType="vm:ArtworkCardViewModel">
            <Panel>
            <Border Width="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize}"
                    Margin="0,0,6,6"
                    Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="1" CornerRadius="8" BoxShadow="{DynamicResource CardShadow}"
                    Cursor="Hand" Tapped="OnCardTapped" DoubleTapped="OnCardDoubleTapped"
                    Classes.selected="{Binding IsSelected}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="☑ Select"              Click="OnContextSelectFavorite"/>
                        <Separator/>
                        <MenuItem Header="👁 Open in side panel"  Click="OnContextPreview"/>
                        <MenuItem Header="⧶ Open full screen"     Click="OnContextOpenFullScreen"/>
                        <MenuItem Header="⊞ Open in new tab"      Click="OnContextOpenInNewTab"/>
                        <MenuItem Header="⧉ Open in popup"        Click="OnContextOpenPopup"/>
                        <Separator/>
                        <MenuItem Header="↓ Download"             Click="OnContextDownload"/>
                        <MenuItem Header="🎨 Download with Preset" Click="OnContextDownloadPreset"/>
                        <Separator/>
                        <MenuItem Header="👤 Open artist gallery" Click="OnContextOpenArtistGallery"/>
                        <MenuItem Header="🌐 Open on pixiv.net"   Click="OnContextOpenPixiv"/>
                        <Separator/>
                        <MenuItem Header="★ Remove from favorites" Click="OnContextRemoveFavorite"/>
                        <MenuItem Header="📁 Set folder…"          Click="OnContextSetFolder"/>
                        <Separator/>
                        <MenuItem Header="Copy ID"       Click="OnContextCopyId"/>
                        <MenuItem Header="📋 Copy image" Click="OnContextCopyImage"/>
                        <MenuItem Header="🖼 Use as app background" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="BoxShadow"   Value="{DynamicResource CardShadowHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                    </Style>
                </Border.Styles>
                <Panel>
                <Grid RowDefinitions="*,Auto">
                    <!-- Image area: natural height, clipped top corners — image ONLY inside clip -->
                    <Border Grid.Row="0" CornerRadius="7,7,0,0" ClipToBounds="True">
                        <Panel>
                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                    IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Image.Height>
                                    <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                        <Binding Path="$parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize"/>
                                        <Binding Path="ClampedAspectRatio"/>
                                    </MultiBinding>
                                </Image.Height>
                                <Image.Effect><BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/></Image.Effect>
                            </Image>
                        </Panel>
                    </Border>
                    <!-- Badges overlaid on image row — outside ClipToBounds -->
                    <Panel Grid.Row="0" ZIndex="5" IsHitTestVisible="False">
                        <Panel.Height>
                            <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                <Binding Path="$parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize"/>
                                <Binding Path="ClampedAspectRatio"/>
                            </MultiBinding>
                        </Panel.Height>
                        <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                Margin="0,6,6,0" Padding="5,2" CornerRadius="4"
                                Background="#CCDC2626" IsVisible="{Binding IsR18}">
                            <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                        </Border>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                Margin="6,0,0,6" Padding="5,2" CornerRadius="4"
                                Background="#BB000000" IsVisible="{Binding IsMultiPage}">
                            <TextBlock Text="{Binding PageCount, StringFormat='1/{0}'}" FontSize="9" Foreground="White"/>
                        </Border>
                        <!-- Moved to top-right (was top-left, directly overlapping the selection
                             checkbox below) — drops beneath R-18 when that badge is also shown. -->
                        <Panel IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowBadges}">
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Margin="0,6,6,0" Padding="5,3" CornerRadius="4"
                                    Background="#CC8B5CF6" IsVisible="{Binding !IsR18}">
                                <Path Data="{StaticResource FavoriteStarGeometry}" Width="9" Height="9" Stretch="Uniform" Fill="White"/>
                            </Border>
                            <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Margin="0,28,6,0" Padding="5,3" CornerRadius="4"
                                    Background="#CC8B5CF6" IsVisible="{Binding IsR18}">
                                <Path Data="{StaticResource FavoriteStarGeometry}" Width="9" Height="9" Stretch="Uniform" Fill="White"/>
                            </Border>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                    Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                                <Border.Margin>
                                    <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                        <Binding Path="IsLiked"/>
                                    </MultiBinding>
                                </Border.Margin>
                                <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                            </Border>
                            <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                    Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                                <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                            </Border>
                        </Panel>
                    </Panel>
                    <!-- Selection checkbox — top-left (always inside card bounds) -->
                    <Border Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6,6,0,0"
                            ZIndex="10" Padding="2" CornerRadius="4" Background="#99000000">
                        <CheckBox MinWidth="0" MinHeight="0"
                                  IsChecked="{Binding IsSelected}" Click="OnFavCardCheckboxClicked"/>
                    </Border>
                    <!-- Info strip below image -->
                    <StackPanel Grid.Row="1" Margin="8,6,8,8" Spacing="2"
                                IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowInfo}">
                        <TextBlock Text="{Binding Title}"    FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{Binding UserName}" FontSize="10" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                      IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowTags}"
                                      ItemTemplate="{StaticResource TagChipTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                </Panel>
            </Border>
            <Border Margin="0,0,6,6" IsVisible="{Binding IsSelected}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource ControlBackgroundBrushSolidAccent}" BorderThickness="2" CornerRadius="8"/>
            </Panel>
        </DataTemplate>

        <!-- ══════════════════════════════════════════════════════════════════
             FAVORITES card — List row (adds checkbox column)
             ══════════════════════════════════════════════════════════════════ -->
        <DataTemplate x:Key="FavoriteListRowTemplate" x:DataType="vm:ArtworkCardViewModel">
            <Panel>
            <Border Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="1" CornerRadius="8" BoxShadow="{DynamicResource CardShadow}"
                    Cursor="Hand" Tapped="OnCardTapped" DoubleTapped="OnCardDoubleTapped"
                    Classes.selected="{Binding IsSelected}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="☑ Select"              Click="OnContextSelectFavorite"/>
                        <Separator/>
                        <MenuItem Header="👁 Open in side panel"  Click="OnContextPreview"/>
                        <MenuItem Header="⧶ Open full screen"     Click="OnContextOpenFullScreen"/>
                        <MenuItem Header="⊞ Open in new tab"      Click="OnContextOpenInNewTab"/>
                        <MenuItem Header="⧉ Open in popup"        Click="OnContextOpenPopup"/>
                        <Separator/>
                        <MenuItem Header="↓ Download"             Click="OnContextDownload"/>
                        <MenuItem Header="🎨 Download with Preset" Click="OnContextDownloadPreset"/>
                        <Separator/>
                        <MenuItem Header="👤 Open artist gallery" Click="OnContextOpenArtistGallery"/>
                        <MenuItem Header="🌐 Open on pixiv.net"   Click="OnContextOpenPixiv"/>
                        <Separator/>
                        <MenuItem Header="★ Remove from favorites" Click="OnContextRemoveFavorite"/>
                        <MenuItem Header="📁 Set folder…"          Click="OnContextSetFolder"/>
                        <Separator/>
                        <MenuItem Header="Copy ID"       Click="OnContextCopyId"/>
                        <MenuItem Header="📋 Copy image" Click="OnContextCopyImage"/>
                        <MenuItem Header="🖼 Use as app background" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="BoxShadow"   Value="{DynamicResource CardShadowHover}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                    </Style>
                </Border.Styles>
                <Panel>
                <Grid ColumnDefinitions="Auto,72,*" Height="72">
                    <CheckBox Grid.Column="0" ZIndex="6" IsChecked="{Binding IsSelected}"
                              VerticalAlignment="Center" Margin="6,0,2,0"
                              MinWidth="0" MinHeight="0" Click="OnFavCardCheckboxClicked"/>
                    <Border Grid.Column="1" CornerRadius="7,0,0,7" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                            <Image.Effect><BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/></Image.Effect>
                        </Image>
                    </Border>
                    <StackPanel Grid.Column="2" Margin="10,0,10,0" Spacing="3" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="{StaticResource FavoriteStarGeometry}" Width="10" Height="10" Stretch="Uniform"
                                  Fill="#EAB308" IsVisible="{Binding IsLocalFavorite}"/>
                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="11" Height="11"
                                      Foreground="#2563EB" IsVisible="{Binding IsPixivBookmarked}"/>
                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="11" Height="11"
                                      Foreground="#DB2777" IsVisible="{Binding IsLiked}"/>
                            <TextBlock Text="{Binding Title}"    FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        </StackPanel>
                        <TextBlock Text="{Binding UserName}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <ItemsControl ItemsSource="{Binding TopTags}"
                                      IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowTags}"
                                      ItemTemplate="{StaticResource TagChipTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
                </Panel>
            </Border>
            <Border IsVisible="{Binding IsSelected}" IsHitTestVisible="False"
                    BorderBrush="{DynamicResource ControlBackgroundBrushSolidAccent}" BorderThickness="2" CornerRadius="8"/>
            </Panel>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ════════════════════════════════════════════════════════════════════════
         ROOT LAYOUT
         ════════════════════════════════════════════════════════════════════════ -->
    <Grid RowDefinitions="Auto,*,Auto"
          Background="{DynamicResource Container3BackgroundBrush}">

        <!-- ── Toolbar ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Margin="0,32,0,0" Padding="10,7">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">

                <!-- Left: tabs + refresh + R-18 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsPublicTab}"    CornerRadius="6" Padding="10,5" FontSize="12" Click="OnTabClicked" Tag="0">
                        <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource BookmarkIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" /><TextBlock Text="Public" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsPrivateTab}"   CornerRadius="6" Padding="10,5" FontSize="12" Click="OnTabClicked" Tag="1">
                        <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource LockIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" /><TextBlock Text="Private" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsFavoritesTab}" CornerRadius="6" Padding="10,5" FontSize="12" Click="OnTabClicked" Tag="2">
                        <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource StarIcon}" Width="13" Height="13" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" /><TextBlock Text="Local Favorites" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsLikedTab}" CornerRadius="6" Padding="10,5" FontSize="12" Click="OnTabClicked" Tag="3"
                                  ToolTip.Tip="All artworks you've Liked (not just liked bookmarks)">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked">
                                <Setter Property="Background" Value="#DB2777"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                            <Style Selector="ToggleButton:pointerover:checked">
                                <Setter Property="Background" Value="#BE185D"/>
                            </Style>
                        </ToggleButton.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource HeartFilledIcon}" Width="13" Height="13" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" /><TextBlock Text="Liked" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsCollectionsTab}" CornerRadius="6" Padding="10,5" FontSize="12" Click="OnTabClicked" Tag="4"
                                  ToolTip.Tip="Pixiv Collections you've bookmarked">
                        <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="13" Height="13" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" /><TextBlock Text="Collections" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Command="{Binding RefreshCommand}" ToolTip.Tip="Reload current tab">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding $parent[Button].Foreground}"/>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"
                               IsVisible="{Binding ShowR18Buttons}"/>
                    <ToggleButton IsChecked="{Binding ShowR18}" CornerRadius="6" Padding="9,5" FontSize="12"
                                  IsVisible="{Binding ShowR18Buttons}" ToolTip.Tip="Show / hide R-18 content">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton:checked">
                                <Setter Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="{DynamicResource R18ButtonForegroundBrush}"/>
                            </Style>
                            <Style Selector="ToggleButton:checked /template/ ContentPresenter">
                                <Setter Property="Background" Value="#DC2626"/>
                                <Setter Property="Foreground" Value="{DynamicResource R18ButtonForegroundBrush}"/>
                            </Style>
                            <Style Selector="ToggleButton:pointerover:checked">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Style>
                            <Style Selector="ToggleButton:pointerover:checked /template/ ContentPresenter">
                                <Setter Property="Background" Value="#B91C1C"/>
                            </Style>
                            <Style Selector="ToggleButton:not(:checked)">
                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSoftAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrush}"/>
                            </Style>
                            <Style Selector="ToggleButton:not(:checked) /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSoftAccent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrush}"/>
                            </Style>
                        </ToggleButton.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Data="{StaticResource WarningIcon}" Width="13" Height="13" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" /><TextBlock Text="R-18" FontSize="12" VerticalAlignment="Center"/></StackPanel>
                    </ToggleButton>
                    <Rectangle Width="1" Height="18" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                    <Button CornerRadius="6" Padding="9,5" FontSize="11"
                            Command="{Binding SelectAllFavoritesCommand}" ToolTip.Tip="Select all visible items">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="Select All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="11"
                            Command="{Binding ClearFavoritesSelectionCommand}"
                            IsVisible="{Binding HasSelection}" ToolTip.Tip="Clear selection">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="{StaticResource CloseIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                            <TextBlock Text="Deselect All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="11"
                            IsVisible="{Binding HasSelection}"
                            Command="{Binding DownloadSelectedCommand}" ToolTip.Tip="Download selected bookmarks">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{Binding SelectedCount, StringFormat='Download Selected ({0})'}" />
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="11"
                            Command="{Binding ViewSelectedAsCollageCommand}"
                            IsVisible="{Binding CanViewSelectedAsCollage}"
                            ToolTip.Tip="Show the selected artworks tiled together in the side panel (up to 10)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Text="⊞" FontSize="12"/>
                            <TextBlock Text="Collage" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="11"
                            Command="{Binding ViewSelectedInNewTabsCommand}"
                            IsVisible="{Binding CanViewSelectedInNewTabs}"
                            ToolTip.Tip="Open each selected artwork in its own tab">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="View in New Tabs" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Command="{Binding DownloadAllCommand}" ToolTip.Tip="Download all bookmarks">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="Download All" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Command="{Binding DownloadFolderCommand}" ToolTip.Tip="Download all bookmarks to folder"
                            IsVisible="{Binding IsFavoritesTab}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource FolderIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="Download Folder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="11"
                            Click="OnDownloadPresetClicked" ToolTip.Tip="Download with image processing preset">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource PaletteIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{Binding SelectedCount, StringFormat='Download Preset ({0})', TargetNullValue='Download Preset'}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Center: height mode + toggles + tag filter + size -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsGridView}">
                        <Button CornerRadius="6" Padding="8,4" FontSize="11" Command="{Binding SetFixedHeightCommand}"   IsEnabled="{Binding !IsFixedHeight}"   ToolTip.Tip="Fixed card height">Fixed</Button>
                        <Button CornerRadius="6" Padding="8,4" FontSize="11" Command="{Binding SetNaturalHeightCommand}" IsEnabled="{Binding !IsNaturalHeight}" ToolTip.Tip="Natural height">Natural</Button>
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                    </StackPanel>
                    <ToggleButton IsChecked="{Binding ShowTags,    Mode=TwoWay}" CornerRadius="6" Padding="8,4" FontSize="11" ToolTip.Tip="Show/hide tag chips">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource TagIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                            <TextBlock Text="Tags" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowInfo,    Mode=TwoWay}" CornerRadius="6" Padding="8,4" FontSize="11" ToolTip.Tip="Show/hide info strip">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource InfoIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                            <TextBlock Text="Info" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowBadges, Mode=TwoWay}" CornerRadius="6" Padding="8,4" FontSize="11" ToolTip.Tip="Show/hide liked/bookmarked/favorite badges on cards">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource HeartBadgeIconBrush}" />
                            <TextBlock Text="Badges" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowPreview, Mode=TwoWay}" CornerRadius="6" Padding="8,4" FontSize="11" ToolTip.Tip="Toggle side panel">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="{StaticResource ShowPanelIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"
                                  IsVisible="{Binding !ShowPreview}"/>
                            <Path Data="{StaticResource HidePanelIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"
                                  IsVisible="{Binding ShowPreview}"/>
                            <TextBlock Text="Show Panel" FontSize="11" IsVisible="{Binding !ShowPreview}"/>
                            <TextBlock Text="Hide Panel" FontSize="11" IsVisible="{Binding ShowPreview}"/>
                        </StackPanel>
                    </ToggleButton>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                    <TextBox x:Name="TagFilterBox" Text="{Binding TagFilter}" PlaceholderText="Filter by tag…"
                             CornerRadius="6" Width="140" FontSize="12" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                    <ComboBox x:Name="SortComboBox"
                              ItemsSource="{Binding SortOptions}"
                              SelectedIndex="0"
                              Width="160" FontSize="11" VerticalAlignment="Center"
                              CornerRadius="6" Padding="8,4"
                              ToolTip.Tip="Sort bookmarks"/>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" IsVisible="{Binding IsGridView}">
                        <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                        <TextBlock Text="Size" FontSize="11" VerticalAlignment="Center" Opacity="0.7"/>
                        <Slider Minimum="100" Maximum="320" Value="{Binding CardSize, Mode=TwoWay}"
                                Width="80" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding CardSize, StringFormat='Card size: {0}px'}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Right: Grid / List -->
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Button CornerRadius="6" Padding="8,4" FontSize="11" Command="{Binding SetGridViewCommand}" IsEnabled="{Binding !IsGridView}" ToolTip.Tip="Grid view">⊞ Grid</Button>
                    <Button CornerRadius="6" Padding="8,4" FontSize="11" Command="{Binding SetListViewCommand}" IsEnabled="{Binding !IsListView}" ToolTip.Tip="List view">≡ List</Button>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Content area ────────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Name="BookmarksBodyGrid"
              PointerMoved="OnSplitterPointerMoved"
              PointerReleased="OnSplitterPointerReleased">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto" MinWidth="0"/>
            </Grid.ColumnDefinitions>


            <!-- Splitter -->
            <Border Grid.Column="1" Width="5" Name="BookmarksSplitter"
                    IsVisible="{Binding ShowPreview}"
                    Cursor="SizeWestEast"
                    Background="{DynamicResource Container1BorderBrush}"
                    PointerPressed="OnSplitterPointerPressed"/>

            <!-- Side-panel viewer -->
            <Border Grid.Column="2"
                    IsVisible="{Binding ShowPreview}"
                    Width="{Binding BrowsePanelWidth}"
                    MinWidth="300"
                    Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="1,0,0,0">
                <local:InlineArtworkViewer x:Name="BookmarksInlineViewer" DataContext="{Binding GalleryVm}"
                                           IsExpanded="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).IsViewerExpanded}"
                                           IsPanelOpen="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowPreview}"
                                           IsVisible="{Binding HasTabs}"/>
            </Border>

            <!-- ── PUBLIC TAB ──────────────────────────────────────────────── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding PublicTabVisible}">
                <!-- Selection action bar -->
                <Border Grid.Row="0" IsVisible="{Binding HasSelection}"
                        Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container1BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,6">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" FontWeight="SemiBold"
                                   Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"/>
                        <Button Content="Select all"   CornerRadius="5" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding SelectAllFavoritesCommand}"/>
                        <Button Content="Deselect All" CornerRadius="5" Padding="8,4" FontSize="11"                  Command="{Binding ClearFavoritesSelectionCommand}"/>
                    </WrapPanel>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="PublicScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <StackPanel>
                        <TextBlock Text="No public bookmarks loaded yet."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40" FontSize="14"
                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!HasPublic"/>
                                    <Binding Path="!IsLoading"/>
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>

                        <!-- Fixed grid -->
                        <ItemsControl ItemsSource="{Binding FilteredPublic}" Margin="10,10,4,10"
                                      IsVisible="{Binding ShowFixedGrid}"
                                      ItemTemplate="{StaticResource BookmarkFixedCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Natural grid -->
                        <ItemsControl ItemsSource="{Binding FilteredPublic}" Margin="10,10,4,10"
                                      IsVisible="{Binding ShowNaturalGrid}"
                                      ItemTemplate="{StaticResource BookmarkNaturalCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><gallery:MasonryPanel ColumnWidth="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize}" ItemSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- List -->
                        <ItemsControl ItemsSource="{Binding FilteredPublic}" Margin="10"
                                      IsVisible="{Binding IsListView}"
                                      ItemTemplate="{StaticResource BookmarkListRowTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Button Content="Load more…" Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding CanLoadMore}"
                                HorizontalAlignment="Center" Margin="0,8" CornerRadius="6" Padding="16,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── PRIVATE TAB ─────────────────────────────────────────────── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding PrivateTabVisible}">
                <!-- Selection action bar -->
                <Border Grid.Row="0" IsVisible="{Binding HasSelection}"
                        Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container1BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,6">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" FontWeight="SemiBold"
                                   Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"/>
                        <Button Content="Select all"   CornerRadius="5" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding SelectAllFavoritesCommand}"/>
                        <Button Content="Deselect All" CornerRadius="5" Padding="8,4" FontSize="11"                  Command="{Binding ClearFavoritesSelectionCommand}"/>
                    </WrapPanel>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="PrivateScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <StackPanel>
                        <TextBlock Text="No private bookmarks loaded yet."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40" FontSize="14"
                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!HasPrivate"/>
                                    <Binding Path="!IsLoading"/>
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>

                        <!-- Fixed grid -->
                        <ItemsControl ItemsSource="{Binding FilteredPrivate}" Margin="10,10,4,10"
                                      IsVisible="{Binding ShowFixedGrid}"
                                      ItemTemplate="{StaticResource BookmarkFixedCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Natural grid -->
                        <ItemsControl ItemsSource="{Binding FilteredPrivate}" Margin="10,10,4,10"
                                      IsVisible="{Binding ShowNaturalGrid}"
                                      ItemTemplate="{StaticResource BookmarkNaturalCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><gallery:MasonryPanel ColumnWidth="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize}" ItemSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- List -->
                        <ItemsControl ItemsSource="{Binding FilteredPrivate}" Margin="10"
                                      IsVisible="{Binding IsListView}"
                                      ItemTemplate="{StaticResource BookmarkListRowTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <Button Content="Load more…" Command="{Binding LoadMoreCommand}"
                                IsVisible="{Binding CanLoadMore}"
                                HorizontalAlignment="Center" Margin="0,8" CornerRadius="6" Padding="16,8"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── LIKED TAB (all artworks Liked via Pikura, not just liked bookmarks) ── -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*" IsVisible="{Binding LikedTabVisible}">
                <!-- Selection action bar -->
                <Border Grid.Row="0" IsVisible="{Binding HasSelection}"
                        Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container1BorderBrush}"
                        BorderThickness="0,0,0,1" Padding="10,6">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" FontSize="12" FontWeight="SemiBold"
                                   Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"/>
                        <Button Content="Select all"   CornerRadius="5" Padding="8,4" FontSize="11" Margin="0,0,6,0" Command="{Binding SelectAllFavoritesCommand}"/>
                        <Button Content="Deselect All" CornerRadius="5" Padding="8,4" FontSize="11"                  Command="{Binding ClearFavoritesSelectionCommand}"/>
                    </WrapPanel>
                </Border>
                <ScrollViewer Grid.Row="1" x:Name="LikedScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AllowAutoHide="False">
                    <StackPanel>
                        <TextBlock Text="No liked artworks yet — the ♥ Like button on an artwork adds it here."
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,40" FontSize="14"
                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}">
                            <TextBlock.IsVisible>
                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                    <Binding Path="!HasLiked"/>
                                    <Binding Path="!IsLoading"/>
                                </MultiBinding>
                            </TextBlock.IsVisible>
                        </TextBlock>

                        <!-- Fixed grid -->
                        <ItemsControl ItemsSource="{Binding FilteredLiked}" Margin="10,10,4,10"
                                      IsVisible="{Binding ShowFixedGrid}"
                                      ItemTemplate="{StaticResource BookmarkFixedCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Natural grid -->
                        <ItemsControl ItemsSource="{Binding FilteredLiked}" Margin="10,10,4,10"
                                      IsVisible="{Binding ShowNaturalGrid}"
                                      ItemTemplate="{StaticResource BookmarkNaturalCardTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><gallery:MasonryPanel ColumnWidth="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize}" ItemSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- List -->
                        <ItemsControl ItemsSource="{Binding FilteredLiked}" Margin="10"
                                      IsVisible="{Binding IsListView}"
                                      ItemTemplate="{StaticResource BookmarkListRowTemplate}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── COLLECTIONS TAB (Pixiv Collections you've bookmarked) ───── -->
            <Grid Grid.Column="0" IsVisible="{Binding CollectionsTabVisible}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20" Spacing="16">
                        <ProgressBar IsIndeterminate="True" Height="3" IsVisible="{Binding IsLoadingCollectionsUi}"/>
                        <TextBlock Text="You haven't bookmarked any Collections yet."
                                   Margin="0,40" FontSize="14" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                   IsVisible="{Binding ShowEmptyCollectionsMessage}"/>
                        <ItemsControl ItemsSource="{Binding BookmarkedCollections}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CollectionTileViewModel">
                                    <Border Width="220" Margin="0,0,12,12" CornerRadius="8" ClipToBounds="True"
                                            Background="{DynamicResource Container1BackgroundBrush}">
                                        <StackPanel>
                                            <Button Height="220" Padding="0" CornerRadius="0" BorderThickness="0"
                                                    Background="{DynamicResource Container2BackgroundBrush}"
                                                    Cursor="Hand"
                                                    Command="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).OpenBookmarkedCollectionCommand}"
                                                    CommandParameter="{Binding}">
                                                <Panel>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                           IsVisible="{Binding !HasMultipleThumbnails}"/>
                                                    <ItemsControl ItemsSource="{Binding CollageThumbnails}"
                                                                  IsVisible="{Binding HasMultipleThumbnails}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><UniformGrid Columns="2" Rows="2"/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border ClipToBounds="True" Margin="0.5">
                                                                    <Image Source="{Binding}" Stretch="UniformToFill"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,6,6,0"
                                                            Padding="5,2" CornerRadius="4" Background="#CCDC2626"
                                                            IsVisible="{Binding IsR18}" IsHitTestVisible="False">
                                                        <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                </Panel>
                                            </Button>
                                            <TextBlock Text="{Binding Title}" FontSize="12" Margin="8,6,8,0"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            <TextBlock Text="{Binding UserName}" FontSize="10" Margin="8,0,8,8"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── LOCAL FAVORITES TAB ─────────────────────────────────────── -->
            <Grid Grid.Column="0" ColumnDefinitions="Auto,*" IsVisible="{Binding FavoritesTabVisible}">

                <!-- Folder sidebar -->
                <Border Grid.Column="0" Width="140"
                        Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container1BorderBrush}"
                        BorderThickness="0,0,1,0"
                        IsVisible="{Binding AvailableFolders.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="2" Margin="6,8">
                            <TextBlock Text="FOLDERS" FontSize="9" FontWeight="SemiBold" Opacity="0.5" Margin="4,0,0,4"/>
                            <Button Content="All" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                    CornerRadius="5" Padding="8,5" FontSize="11"
                                    IsEnabled="{Binding FolderFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                    Command="{Binding SetFolderCommand}" CommandParameter="{x:Null}"/>
                            <ItemsControl ItemsSource="{Binding AvailableFolders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Button Content="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                CornerRadius="5" Padding="8,5" FontSize="11"
                                                Command="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).SetFolderCommand}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Favorites content -->
                <Grid Grid.Column="1" RowDefinitions="Auto,*">

                    <!-- Selection action bar (all tabs) -->
                    <ScrollViewer Grid.Row="1" x:Name="FavoritesScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AllowAutoHide="False">
                        <StackPanel>
                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="0,40">
                                <StackPanel.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding Path="!HasFavorites"/>
                                        <Binding Path="!IsLoading"/>
                                    </MultiBinding>
                                </StackPanel.IsVisible>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource StarIcon}" Width="16" Height="16" VerticalAlignment="Center"
                                              Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                    <TextBlock Text="No local favorites yet"
                                               HorizontalAlignment="Center" FontSize="14"
                                               Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <TextBlock Text="Right-click any artwork anywhere and choose"
                                               HorizontalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource DefaultForegroundBrushDisabled}" VerticalAlignment="Center"/>
                                    <PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14" VerticalAlignment="Center"
                                              Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                    <TextBlock Text="Add to favorites"
                                               HorizontalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource DefaultForegroundBrushDisabled}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Fixed grid -->
                            <ItemsControl ItemsSource="{Binding FilteredFavorites}" Margin="10,10,4,10"
                                          IsVisible="{Binding ShowFixedGrid}"
                                          ItemTemplate="{StaticResource FavoriteFixedCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- Natural grid -->
                            <ItemsControl ItemsSource="{Binding FilteredFavorites}" Margin="10,10,4,10"
                                          IsVisible="{Binding ShowNaturalGrid}"
                                          ItemTemplate="{StaticResource FavoriteNaturalCardTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><gallery:MasonryPanel ColumnWidth="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).CardSize}" ItemSpacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>

                            <!-- List -->
                            <ItemsControl ItemsSource="{Binding FilteredFavorites}" Margin="10"
                                          IsVisible="{Binding IsListView}"
                                          ItemTemplate="{StaticResource FavoriteListRowTemplate}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- Loading overlay -->
            <Border Grid.Column="0" IsVisible="{Binding IsLoading}" Background="#88000000" ZIndex="10">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13" HorizontalAlignment="Center" Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Full-screen viewer overlay — covers entire view incl. toolbar -->
        <local:InlineArtworkViewer x:Name="BookmarksFullViewer"
                                    Grid.Row="0" Grid.RowSpan="3"
                                    Margin="0,32,0,0"
                                    IsVisible="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).IsViewerExpanded}"
                                    IsExpanded="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).IsViewerExpanded}"
                                    IsPanelOpen="{Binding $parent[UserControl].((vm:BookmarksViewModel)DataContext).ShowPreview}"
                                    ZIndex="10"
                                    DataContext="{Binding GalleryVm}"/>

        <!-- ── Status bar ───────────────────────────────────────────────────── -->
        <Border Grid.Row="2"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,6">
            <TextBlock Text="{Binding StatusMessage}" FontSize="11"
                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                       VerticalAlignment="Center"/>
        </Border>

    </Grid>
</UserControl>
