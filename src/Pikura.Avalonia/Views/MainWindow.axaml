<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        xmlns:vm="using:Pikura.Avalonia.ViewModels"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:DataType="vm:MainWindowViewModel"
        x:Class="Pikura.Avalonia.Views.MainWindow"
        Icon="/Assets/pikura-logo.png"
        Title="Pikura"
        MinWidth="1000" MinHeight="600"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="32">

    <!-- Sidebar nav icons — vector path data (20x20 viewBox), same syntax as an SVG "d"
         attribute. Rendered via Path below instead of plain-text glyphs. -->
    <Window.Resources>
        <StreamGeometry x:Key="GalleryIconGeometry">M2,2 H8 V8 H2 Z M12,2 H18 V8 H12 Z M2,12 H8 V18 H2 Z M12,12 H18 V18 H12 Z</StreamGeometry>
        <StreamGeometry x:Key="RankingsIconGeometry">M10,1.5 L12.6,7.5 L19,8 L14,12.3 L15.5,18.5 L10,15 L4.5,18.5 L6,12.3 L1,8 L7.4,7.5 Z</StreamGeometry>
        <StreamGeometry x:Key="DiscoverIconGeometry">M2,10 L18,3 L11,18 L9,12 Z</StreamGeometry>
        <StreamGeometry x:Key="SearchIconGeometry">M15.5,14 H14.71 L14.43,13.73 C15.41,12.59 16,11.11 16,9.5 C16,5.91 13.09,3 9.5,3 S3,5.91 3,9.5 S5.91,16 9.5,16 C11.11,16 12.59,15.41 13.73,14.43 L14,14.71 V15.5 L19,20.49 L20.49,19 Z M9.5,14 C7.01,14 5,11.99 5,9.5 S7.01,5 9.5,5 S14,7.01 14,9.5 S11.99,14 9.5,14 Z</StreamGeometry>
        <StreamGeometry x:Key="BookmarksIconGeometry">M5,2 H15 V19 L10,15 L5,19 Z</StreamGeometry>
        <StreamGeometry x:Key="HoshiIconGeometry">M10,2 C10.6,6 14,9.4 18,10 C14,10.6 10.6,14 10,18 C9.4,14 6,10.6 2,10 C6,9.4 9.4,6 10,2 Z</StreamGeometry>
        <StreamGeometry x:Key="BatchIconGeometry">M7,1 H13 V9 H17 L10,16 L3,9 H7 Z M2,18 H18 V20 H2 Z</StreamGeometry>
        <StreamGeometry x:Key="JobsIconGeometry">M2,3 H18 V6 H2 Z M2,9 H18 V12 H2 Z M2,15 H18 V18 H2 Z</StreamGeometry>
        <StreamGeometry x:Key="ViewedIconGeometry">M10,2 A8,8 0 1 0 10,18 A8,8 0 1 0 10,2 Z M10,5 V10 L14,12</StreamGeometry>
        <StreamGeometry x:Key="PixivisionIconGeometry">M2,3 H18 V15 H2 Z M4,5 H16 V11 H4 Z M4,13 H9 V14 H4 Z M11,13 H16 V14 H11 Z</StreamGeometry>
        <StreamGeometry x:Key="AnalyticsIconGeometry">M2,12 H6 V18 H2 Z M8,7 H12 V18 H8 Z M14,2 H18 V18 H14 Z</StreamGeometry>
        <StreamGeometry x:Key="SettingsIconGeometry">M10,1 L12.3,4.5 L16.4,3.6 L15.5,7.7 L19,10 L15.5,12.3 L16.4,16.4 L12.3,15.5 L10,19 L7.7,15.5 L3.6,16.4 L4.5,12.3 L1,10 L4.5,7.7 L3.6,3.6 L7.7,4.5 Z</StreamGeometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrushTertiary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="8,1"/>
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccent}"/>
            <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrush}"/>
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccentPressed}"/>
        </Style>
        <!-- Active nav item -->
        <Style Selector="Button.nav.active /template/ ContentPresenter">
            <Setter Property="Background" Value="{actipro:ThemeResource ControlBackgroundBrushSoftAccent}"/>
            <Setter Property="Foreground" Value="{actipro:ThemeResource ControlForegroundBrushOutlineAccent}"/>
        </Style>
        <!-- Caption button base style -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{actipro:ThemeResource DefaultForegroundBrush}"/>
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1AFFFFFF"/>
        </Style>
        <Style Selector="Button.caption:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#33FFFFFF"/>
        </Style>
        <Style Selector="Button#CloseBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button#CloseBtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#9D1B12"/>
        </Style>
    </Window.Styles>

    <Border x:Name="WindowBorder"
            BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
            BorderThickness="1"
            PointerPressed="ResizeBorder_PointerPressed">
    <Grid x:Name="RootGrid" ColumnDefinitions="220,*">

            <!-- Sidebar with box shadow for depth -->
            <Border x:Name="SidebarBorder" Grid.Column="0"
                    Background="{actipro:ThemeResource Container1BackgroundBrush}"
                    BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                    BorderThickness="0,0,1,0"
                    BoxShadow="4 0 12 0 #33000000">
                    <Grid RowDefinitions="*,Auto">

                        <!-- Nav Items -->
                        <StackPanel Grid.Row="0" Margin="0,40,0,0">
                            <TextBlock Text="MENU" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{actipro:ThemeResource DefaultForegroundBrushDisabled}"
                                       Margin="20,4,0,4" LetterSpacing="1.5"/>
                            <Button Classes="nav" Click="GalleryButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource GalleryIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Gallery"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="RankingsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource RankingsIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Rankings"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="PixivisionButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource PixivisionIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Pixivision"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="DiscoverButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource DiscoverIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Discover"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="SearchButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource SearchIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Search"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="BookmarksButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource BookmarksIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Bookmarks"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="HoshiButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource HoshiIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Hoshi 星"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="ViewedButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource ViewedIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Viewed"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="BatchDownloadButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource BatchIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Batch"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="JobsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource JobsIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Jobs"/>
                                </StackPanel>
                            </Button>

                            <Separator Margin="14,8" Background="{actipro:ThemeResource Container1BorderBrush}"/>

                            <TextBlock Text="SYSTEM" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{actipro:ThemeResource DefaultForegroundBrushDisabled}"
                                       Margin="20,4,0,4" LetterSpacing="1.5"/>
                            <Button Classes="nav" Click="AnalyticsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource AnalyticsIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Analytics"/>
                                </StackPanel>
                            </Button>
                            <Button Classes="nav" Click="SettingsButton_Click">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource SettingsIconGeometry}" Width="16" Height="16"
                                          Stretch="Uniform" Fill="{Binding $parent[Button].Foreground}"/>
                                    <TextBlock Text="Settings"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Account switcher chip -->
                        <Button Grid.Row="1" Margin="10,0,10,10" Padding="10"
                                Background="{actipro:ThemeResource Container2BackgroundBrush}"
                                BorderBrush="{actipro:ThemeResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="AccountChip_Click" x:Name="AccountChipBtn">
                            <Button.Flyout>
                                <Flyout Placement="Top">
                                    <Border MinWidth="200" MaxHeight="320" Padding="6">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="ACCOUNTS" FontSize="10" FontWeight="SemiBold"
                                                       Foreground="{actipro:ThemeResource DefaultForegroundBrushDisabled}"
                                                       Margin="6,2,0,4" LetterSpacing="1.5"/>
                                            <ItemsControl x:Name="AccountList"/>
                                            <Separator Margin="0,4"/>
                                            <Button Content="＋  Add account" FontSize="12"
                                                    Background="Transparent" BorderThickness="0"
                                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                    Padding="6,6" CornerRadius="4"
                                                    Click="AddAccountBtn_Click"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Border Grid.Column="0" Background="{actipro:ThemeResource ControlBackgroundBrushSolidAccent}"
                                        CornerRadius="14" Width="28" Height="28">
                                    <TextBlock Text="{Binding SidebarUserInitial}" FontSize="12" FontWeight="Bold"
                                               Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SidebarUserName}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{actipro:ThemeResource DefaultForegroundBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SidebarUserStatus}" FontSize="10"
                                               Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="⌄" FontSize="11" VerticalAlignment="Center"
                                           Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                                           Margin="6,0,0,0"/>
                            </Grid>
                        </Button>
                    </Grid>
            </Border>

            <!-- Main content -->
            <Border Grid.Column="1" Background="{actipro:ThemeResource Container3BackgroundBrush}">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0">
                    <!-- Update available banner.
                         Margin 32 on top clears the custom title bar overlay (ZIndex=9) which
                         covers the first 32px of this column. Without it the banner is hidden. -->
                    <Border IsVisible="{Binding UpdateAvailable}"
                            Background="#1A3A7AFF" BorderBrush="#3A5A9AFF"
                            BorderThickness="0,0,0,1" Padding="12,7"
                            Margin="0,32,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="🆕" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock FontSize="13" VerticalAlignment="Center">
                                    <Run Text="Pikura v"/>
                                    <Run Text="{Binding UpdateVersion}"/>
                                    <Run Text=" is available"/>
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Content="Download"
                                    Command="{Binding DownloadUpdateCommand}"
                                    IsVisible="{Binding UpdateDownloadUrl, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    Classes="accent"
                                    FontSize="12" Padding="10,4" Margin="6,0"
                                    CornerRadius="4"/>
                            <Button Grid.Column="2" Content="Release Notes"
                                    Command="{Binding OpenUpdatePageCommand}"
                                    FontSize="12" Padding="10,4" Margin="0,0,6,0"
                                    CornerRadius="4"/>
                            <Button Grid.Column="3" Content="✕"
                                    Command="{Binding DismissUpdateCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="12" Padding="6,4" CornerRadius="4"
                                    Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"/>
                        </Grid>
                    </Border>

                    <!-- Downloading banner (see Update available banner for the Margin rationale). -->
                    <Border IsVisible="{Binding UpdateDownloading}"
                            Background="#1A4A1AFF" BorderBrush="#3A7A3AFF"
                            BorderThickness="0,0,0,1" Padding="12,7"
                            Margin="0,32,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="12" VerticalAlignment="Center"/>
                                <ProgressBar Value="{Binding UpdateDownloadProgress}" Minimum="0" Maximum="100"
                                             Height="4" CornerRadius="2"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕"
                                    Command="{Binding DismissUpdateCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="12" Padding="6,4" CornerRadius="4"
                                    Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"/>
                        </Grid>
                    </Border>

                    <!-- Ready to install banner (see Update available banner for the Margin rationale). -->
                    <Border IsVisible="{Binding UpdateReadyToInstall}"
                            Background="#1A4A1AFF" BorderBrush="#3A7A3AFF"
                            BorderThickness="0,0,0,1" Padding="12,7"
                            Margin="0,32,0,0">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock FontSize="13">
                                    <Run Text="✅  Pikura v"/>
                                    <Run Text="{Binding UpdateVersion}"/>
                                    <Run Text=" downloaded — ready to install"/>
                                </TextBlock>
                                <TextBlock Text="{Binding UpdateStatusText}" FontSize="11" Opacity="0.75"
                                           IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Install &amp; Restart"
                                    Click="InstallAndRestartBtn_Click"
                                    Classes="accent"
                                    FontSize="12" Padding="10,4" Margin="6,0"
                                    CornerRadius="4"/>
                            <Button Grid.Column="3" Content="Later"
                                    Command="{Binding DismissUpdateCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    FontSize="12" Padding="6,4" CornerRadius="4"
                                    Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"/>
                        </Grid>
                    </Border>
                    </StackPanel>
                    <ContentControl x:Name="MainContentControl" Grid.Row="1"/>
                </Grid>
            </Border>

            <!-- Artwork background overlay - rendered above content but below title bars -->
            <Panel Grid.Column="0" Grid.ColumnSpan="2" ZIndex="8"
                   IsVisible="{Binding OverlayService.IsEnabled}"
                   IsHitTestVisible="False">
                <Image Source="{Binding OverlayService.CurrentImage}"
                       Opacity="{Binding OverlayService.ImageOpacity}"
                       Stretch="UniformToFill"
                       IsHitTestVisible="False"/>
                <Rectangle Fill="Black" Opacity="{Binding OverlayService.Darkness}"
                           IsHitTestVisible="False"/>
                <Rectangle Fill="White" Opacity="{Binding OverlayService.Brightness}"
                           IsHitTestVisible="False"/>
            </Panel>

            <!-- Title bar background — covers full width to hide OS-rendered title text -->
            <Border Grid.Column="0" Height="32" VerticalAlignment="Top" ZIndex="9"
                    Background="{actipro:ThemeResource Container1BackgroundBrush}"
                    BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                    BorderThickness="0,0,1,0"
                    IsHitTestVisible="False"/>
            <Border Grid.Column="1" Height="32" VerticalAlignment="Top" ZIndex="9"
                    Background="{actipro:ThemeResource Container1BackgroundBrush}"
                    IsHitTestVisible="False"/>

            <!-- Draggable title bar strip — spans full width -->
            <Panel Grid.Column="0" Grid.ColumnSpan="2"
                   Height="32" VerticalAlignment="Top" ZIndex="10"
                   Background="Transparent"
                   IsHitTestVisible="True"
                   chrome:WindowDecorationProperties.ElementRole="TitleBar"/>

            <!-- Window caption buttons — ZIndex=20 sits above the draggable panel -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Orientation="Horizontal" ZIndex="20" Height="32">
                <!-- Fullscreen toggle (cross-platform glyphs; toggled in code-behind) -->
                <Button x:Name="FullscreenBtn" Classes="caption" Content="&#x26F6;"
                        ToolTip.Tip="Fullscreen" Click="FullscreenBtn_Click"/>
                <!-- Minimize -->
                <Button x:Name="MinimizeBtn" Classes="caption" Content="&#x2014;"
                        ToolTip.Tip="Minimize" Click="MinimizeBtn_Click"
                        chrome:WindowDecorationProperties.ElementRole="MinimizeButton"/>
                <!-- Maximize/Restore -->
                <Button x:Name="MaximizeBtn" Classes="caption" Content="&#x2610;"
                        ToolTip.Tip="Maximize" Click="MaximizeBtn_Click"
                        chrome:WindowDecorationProperties.ElementRole="MaximizeButton"/>
                <!-- Close -->
                <Button x:Name="CloseBtn" Classes="caption" Content="&#x2715;"
                        ToolTip.Tip="Close" Click="CloseBtn_Click"
                        chrome:WindowDecorationProperties.ElementRole="CloseButton"/>
            </StackPanel>

            <!-- Hamburger button — always in column 1 so it survives sidebar collapse -->
            <Button x:Name="HamburgerBtn"
                    Grid.Column="1"
                    VerticalAlignment="Top" HorizontalAlignment="Left"
                    Margin="8,4,0,0" Padding="7,4" ZIndex="20"
                    Background="Transparent" BorderThickness="0"
                    Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                    FontSize="15" CornerRadius="5"
                    IsHitTestVisible="True"
                    Click="HamburgerBtn_Click"
                    ToolTip.Tip="Toggle sidebar">☰</Button>
    </Grid>
    </Border>

</Window>
