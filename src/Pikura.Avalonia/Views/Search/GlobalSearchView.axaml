<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             xmlns:services="using:Pikura.Avalonia.Services"
             xmlns:gallery="using:Pikura.Avalonia.Views.Gallery"
             xmlns:media="using:Avalonia.Media.Imaging"
             xmlns:settings="using:Pikura.Core.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Pikura.Avalonia.Views.Search.GlobalSearchView"
             x:DataType="vm:GlobalSearchViewModel">

    <UserControl.Resources>
        <conv:BoolToBlurRadiusConverter x:Key="BoolToBlurRadiusConverter"/>

        <ContextMenu x:Key="SearchCardContextMenu" x:DataType="vm:ArtworkCardViewModel">
            <MenuItem Header="☑ Select" Click="OnContextToggleSelection" IsVisible="{Binding !IsSelected}"/>
            <MenuItem Header="☒ Deselect" Click="OnContextToggleSelection" IsVisible="{Binding IsSelected}"/>
            <Separator/>
            <MenuItem Header="↓ Download all" Click="OnContextDownloadAll"/>
            <MenuItem Header="↓ First page only" Click="OnContextDownloadThisPage" IsVisible="{Binding IsMultiPage}"/>
            <Separator/>
            <MenuItem Header="👁 Open in side panel" Click="OnContextPreview"/>
            <MenuItem Header="⛶ Open full screen" Click="OnContextOpenFullScreen"/>
            <MenuItem Header="⊞ Open in new tab" Click="OnContextOpenInNewTab"/>
            <MenuItem Header="⧉ Open in popup" Click="OnContextOpenPopup"/>
            <MenuItem Header="🌐 Open on pixiv.net" Click="OnContextOpenPixiv"/>
            <MenuItem Header="👤 Open artist gallery" Click="OnContextOpenArtistGallery"/>
            <Separator/>
            <MenuItem Header="★ Add to local favorites" Click="OnContextToggleFavorite" IsVisible="{Binding !IsLocalFavorite}"/>
            <MenuItem Header="★ Remove from favorites" Click="OnContextToggleFavorite" IsVisible="{Binding IsLocalFavorite}"/>
            <Separator/>
            <MenuItem Header="Copy artwork ID" Click="OnContextCopyId"/>
            <MenuItem Header="Copy artist ID" Click="OnContextCopyArtistId"/>
            <MenuItem Header="📋 Copy image" Click="OnContextCopyImage"/>
            <MenuItem Header="🖼 Use as app background" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
        </ContextMenu>
    </UserControl.Resources>

    <!-- title/search | controls | actions | grid | status -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

        <!-- ══ Row 0: Title + search box + R-18 ══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,10"
                Margin="0,32,0,0">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Search" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                    <ProgressBar IsIndeterminate="True" Width="70" Height="3"
                                 IsVisible="{Binding IsLoading}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720">
                    <Panel>
                        <TextBox Name="SearchBox" Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Search all of Pixiv…"
                                 Width="360" CornerRadius="7" FontSize="12"
                                 KeyDown="OnSearchBoxKeyDown"
                                 GotFocus="OnSearchBoxGotFocus" LostFocus="OnSearchBoxLostFocus"/>
                        <!-- Search history dropdown — mirrors Pixiv's own "History" panel under the
                             search box: past queries with the filters active at the time, an X per
                             row to remove just that one, and "Clear history" for all of them. -->
                        <Popup Name="SearchHistoryPopup" PlacementTarget="{Binding #SearchBox}"
                               Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True"
                               Width="360" MaxHeight="360">
                            <Border Background="{DynamicResource Container1BackgroundBrush}"
                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                    BoxShadow="{DynamicResource DropdownShadow}">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto" Margin="12,8">
                                        <TextBlock Grid.Column="0" Text="History" FontWeight="SemiBold" FontSize="12"/>
                                        <Button Grid.Column="1" Content="Clear history" FontSize="11"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                Command="{Binding ClearSearchHistoryCommand}"/>
                                    </Grid>
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SearchHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="settings:SearchHistoryEntry">
                                                    <Grid ColumnDefinitions="*,Auto" Margin="12,6"
                                                          Cursor="Hand" PointerPressed="OnHistoryEntryClicked">
                                                        <StackPanel Grid.Column="0" Spacing="1">
                                                            <TextBlock Text="{Binding Query}" FontSize="12"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding FilterSummary}" FontSize="10"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="✕" FontSize="11"
                                                                Background="Transparent" BorderThickness="0" Padding="4"
                                                                Command="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).RemoveHistoryEntryCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Text="No search history yet." FontSize="11" Margin="12,8"
                                               IsVisible="{Binding !HasSearchHistory}"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>
                    <Button Content="Search" CornerRadius="6" Padding="12,6" FontSize="12"
                            Classes="accent" Command="{Binding SearchCommand}"/>
                    <Button Content="✕ Reset" CornerRadius="6" Padding="10,6" FontSize="12"
                            IsVisible="{Binding HasSearched}"
                            Click="OnResetSearchClicked"
                            ToolTip.Tip="Clear results and go back to the search start screen"/>
                    <ToggleButton IsChecked="{Binding ShowKeywordOptions, Mode=TwoWay}"
                                  Content="± Keywords" CornerRadius="6" Padding="10,6" FontSize="12"
                                  ToolTip.Tip="Show include/exclude keyword options"/>
                    <Button Name="AdvancedFiltersButton" CornerRadius="6" Padding="10,6" FontSize="12"
                            Classes.accent="{Binding HasAdvancedFilters}"
                            ToolTip.Tip="Advanced search options"
                            IsVisible="{Binding IsArtworksCategory}">
                        <Panel>
                            <TextBlock Text="⚙ Options" IsVisible="{Binding !HasAdvancedFilters}"/>
                            <TextBlock Text="⚙ Options •" IsVisible="{Binding HasAdvancedFilters}"/>
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight"
                                    PlacementConstraintAdjustment="All"
                                    Opening="OnAdvancedFiltersOpening">
                                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                                <StackPanel Width="300" Spacing="10" Margin="4">
                                    <TextBlock Text="Search options" FontWeight="Bold" FontSize="13"/>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Targets" FontSize="11" FontWeight="SemiBold"/>
                                        <ComboBox SelectedValue="{Binding AdvancedFilterEdit.TargetMode}" SelectedValueBinding="{ReflectionBinding Tag}"
                                                  HorizontalAlignment="Stretch" FontSize="11">
                                            <ComboBoxItem Content="Tags (partial match)" Tag="s_tag"/>
                                            <ComboBoxItem Content="Tags (exact match)" Tag="s_tag_full"/>
                                            <ComboBoxItem Content="Title and caption" Tag="s_tc"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <!-- Only meaningful on the Illustrations tab — Manga tab is always just manga,
                                         so there's nothing to narrow and this is hidden entirely there. -->
                                    <StackPanel Spacing="3" IsVisible="{Binding IsIllustrationsCategory}">
                                        <TextBlock Text="Work type" FontSize="11" FontWeight="SemiBold"/>
                                        <ComboBox SelectedValue="{Binding AdvancedFilterEdit.WorkType}" SelectedValueBinding="{ReflectionBinding Tag}"
                                                  HorizontalAlignment="Stretch" FontSize="11">
                                            <ComboBoxItem Content="Illustrations + Ugoira" Tag="illust_and_ugoira"/>
                                            <ComboBoxItem Content="Illustrations only" Tag="illust"/>
                                            <ComboBoxItem Content="Ugoira only" Tag="ugoira"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="AI-generated work" FontSize="11" FontWeight="SemiBold"/>
                                        <ComboBox SelectedValue="{Binding AdvancedFilterEdit.AiFilter}" SelectedValueBinding="{ReflectionBinding Tag}"
                                                  HorizontalAlignment="Stretch" FontSize="11">
                                            <ComboBoxItem Content="Display" Tag="display"/>
                                            <ComboBoxItem Content="Hide" Tag="hide"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Aspect ratio" FontSize="11" FontWeight="SemiBold"/>
                                        <ComboBox SelectedValue="{Binding AdvancedFilterEdit.RatioTag}" SelectedValueBinding="{ReflectionBinding Tag}"
                                                  HorizontalAlignment="Stretch" FontSize="11">
                                            <ComboBoxItem Content="Any" Tag="{x:Null}"/>
                                            <ComboBoxItem Content="Portrait" Tag="-0.5"/>
                                            <ComboBoxItem Content="Square" Tag="0"/>
                                            <ComboBoxItem Content="Landscape" Tag="0.5"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Creation tool" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding AdvancedFilterEdit.Tool}" PlaceholderText="e.g. Photoshop, CLIP STUDIO PAINT" FontSize="11"/>
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Posted date range" FontSize="11" FontWeight="SemiBold"/>
                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <DatePicker SelectedDate="{Binding AdvancedFilterEdit.PostedAfter}" Grid.Column="0" FontSize="10"/>
                                            <TextBlock Text="–" Grid.Column="1" VerticalAlignment="Center" Margin="4,0"/>
                                            <DatePicker SelectedDate="{Binding AdvancedFilterEdit.PostedBefore}" Grid.Column="2" FontSize="10"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Image width (px)" FontSize="11" FontWeight="SemiBold"/>
                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <NumericUpDown Value="{Binding AdvancedFilterEdit.MinWidth}" Grid.Column="0" FontSize="10" Minimum="0" FormatString="0"/>
                                            <TextBlock Text="–" Grid.Column="1" VerticalAlignment="Center" Margin="4,0"/>
                                            <NumericUpDown Value="{Binding AdvancedFilterEdit.MaxWidth}" Grid.Column="2" FontSize="10" Minimum="0" FormatString="0"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="Image height (px)" FontSize="11" FontWeight="SemiBold"/>
                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <NumericUpDown Value="{Binding AdvancedFilterEdit.MinHeight}" Grid.Column="0" FontSize="10" Minimum="0" FormatString="0"/>
                                            <TextBlock Text="–" Grid.Column="1" VerticalAlignment="Center" Margin="4,0"/>
                                            <NumericUpDown Value="{Binding AdvancedFilterEdit.MaxHeight}" Grid.Column="2" FontSize="10" Minimum="0" FormatString="0"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="3" IsVisible="{Binding IsPremiumAccount}">
                                        <TextBlock FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Text>Bookmark count</TextBlock.Text>
                                        </TextBlock>
                                        <Grid ColumnDefinitions="*,Auto,*">
                                            <NumericUpDown Value="{Binding AdvancedFilterEdit.MinBookmarks}" Grid.Column="0" FontSize="10" Minimum="0" FormatString="0"/>
                                            <TextBlock Text="–" Grid.Column="1" VerticalAlignment="Center" Margin="4,0"/>
                                            <NumericUpDown Value="{Binding AdvancedFilterEdit.MaxBookmarks}" Grid.Column="2" FontSize="10" Minimum="0" FormatString="0"/>
                                        </Grid>
                                        <TextBlock Text="Pixiv Premium required" FontSize="9"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>

                                    <Separator Margin="0,4"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="Reset" FontSize="11" CornerRadius="5" Padding="10,5"
                                                Command="{Binding ResetAdvancedFiltersCommand}"
                                                Click="OnResetAdvancedFiltersClick"/>
                                        <Button Content="Apply" FontSize="11" CornerRadius="5" Padding="10,5"
                                                Classes="accent" Command="{Binding ApplyAdvancedFiltersCommand}"
                                                Click="OnApplyAdvancedFiltersClick"/>
                                    </StackPanel>
                                </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1"
                            Orientation="Horizontal" Spacing="12"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="-120,6,0,0"
                            IsVisible="{Binding ShowKeywordOptions}">
                    <StackPanel Orientation="Vertical" Spacing="2" Width="240">
                        <TextBlock Text="Include any of the keywords" FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        <TextBox Text="{Binding IncludeAnyKeywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="e.g. cat, dog"
                                 FontSize="11" CornerRadius="6"
                                 KeyDown="OnSearchBoxKeyDown"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" Spacing="2" Width="240">
                        <TextBlock Text="Exclude keywords" FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        <TextBox Text="{Binding ExcludeKeywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="e.g. 3D, AI"
                                 FontSize="11" CornerRadius="6"
                                 KeyDown="OnSearchBoxKeyDown"/>
                    </StackPanel>
                </StackPanel>

                <!-- Related tags — comes straight from Pixiv's own search response for the
                     current keyword, no extra API call needed. Clicking one pivots the search. -->
                <ScrollViewer Grid.Row="2" Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0"
                              IsVisible="{Binding HasRelatedTags}">
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="Related:" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   Margin="0,0,4,0"/>
                        <ItemsControl ItemsSource="{Binding RelatedTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{Binding}" FontSize="11" CornerRadius="10" Padding="10,3"
                                            Cursor="Hand" Click="OnTagChipClicked"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══ Row 1: Mode/Sort + view controls ══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,7">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- Category -->
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsIllustrationsCategory}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Content="Illustrations" Click="OnIllustrationsCategoryClicked"/>
                    <ToggleButton IsChecked="{Binding IsMangaCategory}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Content="Manga" Click="OnMangaCategoryClicked"/>
                    <ToggleButton IsChecked="{Binding IsNovelsCategory}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Content="Novels" Click="OnNovelsCategoryClicked"/>
                    <ToggleButton IsChecked="{Binding IsUsersCategory}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Content="User" Click="OnUsersCategoryClicked"/>
                </StackPanel>

                <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}"/>

                <!-- Mode / Sort -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding !IsUsersCategory}">
                    <ComboBox SelectedValue="{Binding SearchMode}" SelectedValueBinding="{ReflectionBinding Tag}"
                              CornerRadius="6" FontSize="11" MinWidth="80">
                        <ComboBoxItem Content="Safe" Tag="safe"/>
                        <ComboBoxItem Content="R-18" Tag="r18"/>
                        <ComboBoxItem Content="All" Tag="all"/>
                    </ComboBox>
                    <ComboBox SelectedValue="{Binding SortOrder}" SelectedValueBinding="{ReflectionBinding Tag}"
                              CornerRadius="6" FontSize="11" MinWidth="100">
                        <ComboBoxItem Content="Newest First" Tag="date_d"/>
                        <ComboBoxItem Content="Popular First" Tag="popular_d"
                                      IsVisible="{Binding IsPremiumAccount}"
                                      IsEnabled="{Binding IsPremiumAccount}"
                                      ToolTip.Tip="Pixiv Premium"/>
                        <ComboBoxItem Content="Popular (Male)" Tag="popular_male_d"
                                      IsVisible="{Binding IsPremiumAccount}"
                                      IsEnabled="{Binding IsPremiumAccount}"
                                      ToolTip.Tip="Pixiv Premium"/>
                        <ComboBoxItem Content="Popular (Female)" Tag="popular_female_d"
                                      IsVisible="{Binding IsPremiumAccount}"
                                      IsEnabled="{Binding IsPremiumAccount}"
                                      ToolTip.Tip="Pixiv Premium"/>
                    </ComboBox>
                </StackPanel>

                <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}"
                           IsVisible="{Binding !IsUsersCategory}"/>

                <!-- View/size controls -->
                <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsGridView}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Command="{Binding SetGridViewCommand}">⊞ Grid</ToggleButton>
                    <ToggleButton IsChecked="{Binding IsListView}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Command="{Binding SetListViewCommand}">☰ List</ToggleButton>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="3,0"
                               IsVisible="{Binding IsGridView}"/>
                    <ToggleButton IsChecked="{Binding IsFixedHeight}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Command="{Binding SetFixedHeightCommand}" IsVisible="{Binding IsGridView}">

                        Fixed
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsNaturalHeight}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Command="{Binding SetNaturalHeightCommand}" IsVisible="{Binding IsGridView}">

                        Natural
                    </ToggleButton>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="3,0"
                               IsVisible="{Binding IsGridView}"/>
                    <Slider Value="{Binding CardSize}" Minimum="100" Maximum="320"
                            Width="90" VerticalAlignment="Center" IsVisible="{Binding IsGridView}"/>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="3,0"
                               IsVisible="{Binding IsUsersCategory}"/>
                    <ToggleButton IsChecked="{Binding IsUsersCompactView}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Command="{Binding SetUsersCompactViewCommand}"
                                  IsVisible="{Binding IsUsersCategory}">Compact</ToggleButton>
                    <ToggleButton IsChecked="{Binding IsUsersThumbnailView}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  Command="{Binding SetUsersThumbnailViewCommand}"
                                  IsVisible="{Binding IsUsersCategory}">Thumbnails</ToggleButton>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="3,0"/>
                    <ToggleButton IsChecked="{Binding ShowPreview}" CornerRadius="5" Padding="10,5" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="▣" FontSize="12"/>
                            <TextBlock Text="Show Panel" FontSize="11" IsVisible="{Binding !ShowPreview}"/>
                            <TextBlock Text="Hide Panel" FontSize="11" IsVisible="{Binding ShowPreview}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowInfo}" CornerRadius="5" Padding="9,5" FontSize="11">Info</ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowTags}" CornerRadius="5" Padding="9,5" FontSize="11">Tags</ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowBadges}" CornerRadius="5" Padding="9,5" FontSize="11"
                                  ToolTip.Tip="Show/hide liked/bookmarked/favorite badges on cards">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource HeartBadgeIconBrush}" />
                            <TextBlock Text="Badges" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Row 2: Action buttons (artwork downloads only) ══ -->
        <Border Grid.Row="2"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,6"
                IsVisible="{Binding IsArtworksCategory}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button CornerRadius="6" Padding="12,6" FontSize="11"
                        Classes.accent="{Binding HasSelection}"
                        IsEnabled="{Binding HasSelection}"
                        Command="{Binding DownloadSelectedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="↓" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedCount, StringFormat='Download Selected ({0})'}"/>
                    </StackPanel>
                </Button>
                <Button CornerRadius="6" Padding="12,6" FontSize="11"
                        Command="{Binding ViewSelectedAsCollageCommand}"
                        IsVisible="{Binding CanViewSelectedAsCollage}"
                        ToolTip.Tip="Show the selected artworks tiled together in the side panel (up to 10)">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="⊞" FontSize="12"/>
                        <TextBlock Text="Collage" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button CornerRadius="6" Padding="12,6" FontSize="11"
                        Command="{Binding ViewSelectedInNewTabsCommand}"
                        IsVisible="{Binding CanViewSelectedInNewTabs}"
                        ToolTip.Tip="Open each selected artwork in its own tab">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                        <TextBlock Text="View in New Tabs" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button CornerRadius="6" Padding="12,6" FontSize="11"
                        Command="{Binding DownloadAllVisibleCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="⊞" FontSize="12"/>
                        <TextBlock Text="Download Visible"/>
                    </StackPanel>
                </Button>
                <Button Content="☑ Select All" CornerRadius="6" Padding="12,6" FontSize="11"
                        Command="{Binding SelectAllCommand}"/>
                <Button Content="{Binding SelectedCount, StringFormat='☒ Deselect All ({0})'}"
                        CornerRadius="6" Padding="12,6" FontSize="11"
                        Command="{Binding ClearSelectionCommand}"
                        IsVisible="{Binding HasSelection}"/>
                <Button Content="🎨 Download Preset" CornerRadius="6" Padding="12,6" FontSize="11"
                        Classes="accent"
                        Click="OnDownloadPresetClicked"
                        ToolTip.Tip="Download with image processing preset"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ Row 3: Results area ══ -->
        <Border Grid.Row="3"
                Background="{DynamicResource Container3BackgroundBrush}"
                Margin="0">
            <Grid Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Width="4"
                              Background="{DynamicResource Container1BorderBrush}"
                              IsVisible="{Binding ShowPreview}"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              DragCompleted="OnSplitterDragCompleted"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource Container1BackgroundBrush}"
                        BorderBrush="{DynamicResource Container1BorderBrush}"
                        BorderThickness="1,0,0,0"
                        IsVisible="{Binding ShowPreview}">
                    <gallery:InlineArtworkViewer Name="SearchInlineViewer"
                                                 DataContext="{Binding GalleryVm}"
                                                 IsExpanded="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).IsViewerExpanded}"
                                                 IsPanelOpen="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowPreview}"/>
                </Border>

                <Panel Grid.Column="0" IsVisible="{Binding IsArtworksCategory}">
                    <!-- Empty / loading hint. Wrapped in a ScrollViewer (rather than just
                         VerticalAlignment="Center" in the bare Panel) — with a full row of
                         popular-tag thumbnail chips this content easily exceeds the viewport
                         height, and centering an over-tall block with no scroll container just
                         pushes its top/bottom off-screen instead of showing a scrollbar. -->
                    <ScrollViewer Name="EmptyStateScrollViewer" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !HasResults}">
                    <StackPanel HorizontalAlignment="Center" Spacing="12"
                                Margin="0,40,0,40" MaxWidth="720">
                        <TextBlock Text="🔍 Search all of Pixiv" FontSize="15"
                                   IsVisible="{Binding !HasSearched}"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   IsVisible="{Binding HasSearched}"
                                   FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                        <!-- Popular tags — a proxy for "trending right now" built from whatever's
                             currently loaded in Rankings (see GlobalSearchViewModel.PopularTags for
                             why there's no direct "global trending tags" endpoint to call instead).
                             Click a tag to search it directly. -->
                        <StackPanel Spacing="6" IsVisible="{Binding !HasSearched}">
                            <TextBlock Text="Popular tags right now" FontSize="12" FontWeight="SemiBold"
                                       IsVisible="{Binding HasPopularTags}"
                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                       HorizontalAlignment="Center"/>
                            <ItemsControl ItemsSource="{Binding PopularTags}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PopularTagInfo">
                                        <Button CornerRadius="12" Padding="8" Margin="5" Cursor="Hand"
                                                Click="OnTagChipClicked">
                                            <StackPanel Spacing="6" Width="150">
                                                <Border Width="140" Height="140" CornerRadius="10" ClipToBounds="True"
                                                        Background="{DynamicResource Container2BackgroundBrush}"
                                                        HorizontalAlignment="Center">
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                </Border>
                                                <TextBlock Text="{Binding Tag}" FontSize="12" TextWrapping="Wrap"
                                                           TextAlignment="Center" MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Visit Rankings once to populate this with what's actually trending."
                                       FontSize="10" IsVisible="{Binding !HasPopularTags}"
                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- GRID view. IsHitTestVisible is tied to HasResults — even with no items,
                         an IsVisible="True" ScrollViewer still occupies the full Panel area and
                         (since it's declared after, thus on top in z-order) swallows clicks meant
                         for the "Empty / loading hint" content underneath, e.g. the popular-tags
                         chips before a search has run. -->
                    <ScrollViewer Name="GridScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="False"
                                  ScrollChanged="OnScrollChanged">
                        <ScrollViewer.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsGridView"/>
                                <Binding Path="HasResults"/>
                            </MultiBinding>
                        </ScrollViewer.IsVisible>
                        <ItemsControl ItemsSource="{Binding DisplayResults}" Margin="10,10,4,10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <gallery:MasonryPanel ColumnWidth="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).CardSize}" ItemSpacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtworkCardViewModel">
                                    <Panel>
                                        <!-- FIXED HEIGHT card -->
                                        <Border Margin="0,0,6,6"
                                                Width="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).CardSize}"
                                                IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowFixedGrid}"
                                                Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                BoxShadow="{DynamicResource CardShadow}" Cursor="Hand"
                                                PointerPressed="OnCardClicked"
                                                ContextMenu="{StaticResource SearchCardContextMenu}">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BoxShadow" Value="{DynamicResource CardShadowHover}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid RowDefinitions="*,Auto">
                                                <Border Grid.Row="0"
                                                        Height="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).FixedCardTotalHeight}"
                                                        CornerRadius="7,7,0,0" ClipToBounds="True">
                                                    <Panel>
                                                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                                IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                                            <Image.Effect>
                                                                <BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/>
                                                            </Image.Effect>
                                                        </Image>
                                                    </Panel>
                                                </Border>
                                                <Panel Grid.Row="0" ZIndex="5" IsHitTestVisible="False">
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                            Margin="0,6,6,0" Padding="5,2" CornerRadius="4"
                                                            Background="#CCDC2626" IsVisible="{Binding IsR18}">
                                                        <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                            Margin="6,0,0,6" Padding="5,2" CornerRadius="4"
                                                            Background="#BB000000" IsVisible="{Binding IsMultiPage}">
                                                        <TextBlock Text="{Binding PageCount, StringFormat='1/{0}'}" FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <Panel IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowBadges}">
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding IsLocalFavorite}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsPixivBookmarked"/>
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource StarIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                                                Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                                                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                    </Panel>
                                                </Panel>
                                                <CheckBox Grid.Row="0" ZIndex="6"
                                                          IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Top" HorizontalAlignment="Left"
                                                          Margin="6,6,0,0" MinWidth="0" MinHeight="0"
                                                          Click="OnCardCheckboxClicked"/>
                                                <StackPanel Grid.Row="1" Margin="8,5,8,7" Spacing="2"
                                                            IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowInfo}">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding UserName}" FontSize="10"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,1,0,0"
                                                                  IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Margin="0,1,3,1" Padding="5,2" CornerRadius="3"
                                                                        Background="{DynamicResource Container2BackgroundBrush}">
                                                                    <TextBlock Text="{Binding}" FontSize="10"
                                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- NATURAL HEIGHT card -->
                                        <Border Margin="0,0,6,6"
                                                Width="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).CardSize}"
                                                IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowNaturalGrid}"
                                                Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                BoxShadow="{DynamicResource CardShadow}" Cursor="Hand"
                                                PointerPressed="OnCardClicked"
                                                ContextMenu="{StaticResource SearchCardContextMenu}">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BoxShadow" Value="{DynamicResource CardShadowHover}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid RowDefinitions="*,Auto">
                                                <Border Grid.Row="0" CornerRadius="7,7,0,0" ClipToBounds="True">
                                                    <Panel>
                                                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                                IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                                            <Image.Height>
                                                                <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                                                    <Binding Path="$parent[UserControl].((vm:GlobalSearchViewModel)DataContext).CardSize"/>
                                                                    <Binding Path="ClampedAspectRatio"/>
                                                                </MultiBinding>
                                                            </Image.Height>
                                                            <Image.Effect>
                                                                <BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/>
                                                            </Image.Effect>
                                                        </Image>
                                                    </Panel>
                                                </Border>
                                                <Panel Grid.Row="0" ZIndex="5" IsHitTestVisible="False">
                                                    <Panel.Height>
                                                        <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                                            <Binding Path="$parent[UserControl].((vm:GlobalSearchViewModel)DataContext).CardSize"/>
                                                            <Binding Path="ClampedAspectRatio"/>
                                                        </MultiBinding>
                                                    </Panel.Height>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                            Margin="0,6,6,0" Padding="5,2" CornerRadius="4"
                                                            Background="#CCDC2626" IsVisible="{Binding IsR18}">
                                                        <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                    <Panel IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowBadges}">
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding IsLocalFavorite}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsPixivBookmarked"/>
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource StarIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                                                Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                                                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                    </Panel>
                                                </Panel>
                                                <CheckBox Grid.Row="0" ZIndex="6"
                                                          IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Top" HorizontalAlignment="Left"
                                                          Margin="6,6,0,0" MinWidth="0" MinHeight="0"
                                                          Click="OnCardCheckboxClicked"/>
                                                <StackPanel Grid.Row="1" Margin="8,5,8,7" Spacing="2"
                                                            IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowInfo}">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding UserName}" FontSize="10"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- LIST view -->
                    <ScrollViewer Name="ListScrollViewer"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="False"
                                  ScrollChanged="OnScrollChanged">
                        <ScrollViewer.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="IsListView"/>
                                <Binding Path="HasResults"/>
                            </MultiBinding>
                        </ScrollViewer.IsVisible>
                        <ItemsControl ItemsSource="{Binding DisplayResults}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtworkCardViewModel">
                                    <Border Margin="0,0,0,4"
                                            Background="{DynamicResource Container1BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            BoxShadow="{DynamicResource CardShadow}" Cursor="Hand"
                                            PointerPressed="OnCardClicked"
                                            ContextMenu="{StaticResource SearchCardContextMenu}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,4">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      MinWidth="0" MinHeight="0" Margin="0,0,6,0"
                                                      Click="OnCardCheckboxClicked"/>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{Binding UserName}" FontSize="10"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding DateLabel}" FontSize="10"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                       VerticalAlignment="Center" Margin="12,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Panel>

                <!-- Novels results -->
                <ScrollViewer Grid.Column="0" IsVisible="{Binding IsNovelsCategory}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              AllowAutoHide="False" ScrollChanged="OnScrollChanged">
                    <Panel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding !HasNovelResults}" Margin="0,60,0,0">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding NovelResults}" Margin="14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NovelCardViewModel">
                                    <Border Width="220" Margin="0,0,10,10"
                                            Background="{DynamicResource Container1BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                                            PointerPressed="OnNovelCardClicked">
                                        <StackPanel>
                                            <Panel Height="150">
                                                <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                        IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                                <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                        Margin="0,6,6,0" Padding="5,2" CornerRadius="4"
                                                        Background="#CCDC2626" IsVisible="{Binding IsR18}">
                                                    <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                </Border>
                                            </Panel>
                                            <StackPanel Margin="8,6,8,8" Spacing="3">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           TextWrapping="Wrap" MaxLines="2"/>
                                                <TextBlock Text="{Binding UserName}" FontSize="10"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Margin="0,0,3,3" Padding="5,2" CornerRadius="3"
                                                                    Background="{DynamicResource Container2BackgroundBrush}">
                                                                <TextBlock Text="{Binding}" FontSize="9"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </ScrollViewer>

                <!-- Users results -->
                <ScrollViewer Grid.Column="0" IsVisible="{Binding IsUsersCategory}"
                              HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                              AllowAutoHide="False" ScrollChanged="OnScrollChanged">
                    <Panel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                    IsVisible="{Binding !HasUserResults}" Margin="0,60,0,0">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                       HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding UserResults}" Margin="14">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UserSearchCardViewModel">
                                    <Panel Width="220" Margin="0,0,10,10">
                                        <!-- Compact view -->
                                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                                PointerPressed="OnUserCardClicked"
                                                IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).IsUsersCompactView}">
                                            <StackPanel Margin="12" Spacing="8" HorizontalAlignment="Center">
                                                <Border Width="64" Height="64" CornerRadius="32" ClipToBounds="True">
                                                    <Panel>
                                                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                                IsVisible="{Binding Avatar, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                        <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                                    </Panel>
                                                </Border>
                                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding RecentWorkCount, StringFormat='{}{0} recent work(s)'}"
                                                           FontSize="10" IsVisible="{Binding HasRecentWorks}"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock Text="Open Gallery →" FontSize="10" HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Thumbnail-grid view: avatar + up to 4 recent thumbnails -->
                                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                                PointerPressed="OnUserCardClicked"
                                                IsVisible="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).IsUsersThumbnailView}">
                                            <Grid RowDefinitions="Auto,*" Margin="10" Width="200" Height="230">
                                                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                                                    <Border Width="36" Height="36" CornerRadius="18" ClipToBounds="True">
                                                        <Panel>
                                                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                                    IsVisible="{Binding Avatar, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                            <Image Source="{Binding Avatar}" Stretch="UniformToFill"/>
                                                        </Panel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"
                                                               VerticalAlignment="Center" Width="140"/>
                                                </StackPanel>
                                                <Border Grid.Row="1" Background="{DynamicResource Container2BackgroundBrush}"
                                                        CornerRadius="6" ClipToBounds="True">
                                                    <ItemsControl ItemsSource="{Binding RecentThumbnails}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Columns="2" Rows="2"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="media:Bitmap">
                                                                <Image Source="{Binding}" Stretch="UniformToFill" Width="90" Height="90"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Panel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ══ Row 4: Status bar ══ -->
        <Border Grid.Row="4"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="11"
                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                           Text="{Binding StatusMessage}" VerticalAlignment="Center"/>

                <!-- Autoload (scroll)/Load More vs. Pages toggle — mirrors Rankings/Pixivision's "Pages"
                     control, and lives in the status bar (not the crowded, horizontally-scrolling view
                     options row above) so it's always visible without scrolling. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsArtworksCategory}">
                    <ToggleButton IsChecked="{Binding UsePagination, Mode=TwoWay}"
                                  CornerRadius="6" Padding="8,4" FontSize="11"
                                  ToolTip.Tip="Toggle pagination (off = autoload while scrolling)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📄" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Pages" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ComboBox IsVisible="{Binding UsePagination}"
                              SelectedItem="{Binding ItemsPerPage, Mode=TwoWay}"
                              ItemsSource="{Binding ItemsPerPageOptions}"
                              CornerRadius="6" MinWidth="75" FontSize="11"
                              ToolTip.Tip="Items per page"/>

                    <StackPanel IsVisible="{Binding UsePagination}" Orientation="Horizontal" Spacing="6">
                        <Button Content="« First" CornerRadius="6" Padding="10,5" FontSize="11"
                                Command="{Binding FirstPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                        <Button Content="‹ Prev" CornerRadius="6" Padding="10,5" FontSize="11"
                                Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                        <TextBlock Text="{Binding DisplayPage, StringFormat='Page {0} of'}" FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="{Binding TotalPages}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PageInput}" PlaceholderText="#"
                                 Width="44" BorderThickness="1" CornerRadius="6"
                                 Padding="6,4" FontSize="11" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnSearchPageInputKeyDown"
                                 ToolTip.Tip="Type a page number and press Enter"/>
                        <Button Content="Next ›" CornerRadius="6" Padding="10,5" FontSize="11"
                                Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
                        <Button Content="Last »" CornerRadius="6" Padding="10,5" FontSize="11"
                                Command="{Binding LastPageCommand}" IsEnabled="{Binding CanGoNext}"/>
                    </StackPanel>

                    <Panel IsVisible="{Binding !UsePagination}">
                        <Button Content="Load More" CornerRadius="6" Padding="12,5" FontSize="11"
                                Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}"/>
                    </Panel>
                </StackPanel>

                <!-- Novels/Users never got a "Pages" mode — keep the plain Load More button for them. -->
                <Panel Grid.Column="1" IsVisible="{Binding !IsArtworksCategory}">
                    <Button Content="Load More" CornerRadius="6" Padding="12,5" FontSize="11"
                            Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}"/>
                </Panel>
            </Grid>
        </Border>

        <!-- Full-screen viewer overlay -->
        <gallery:InlineArtworkViewer Name="SearchOverlayViewer"
                                     Grid.Row="0" Grid.RowSpan="5"
                                     Margin="0,32,0,0"
                                     ZIndex="10"
                                     DataContext="{Binding GalleryVm}"
                                     IsExpanded="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).IsViewerExpanded}"
                                     IsPanelOpen="{Binding $parent[UserControl].((vm:GlobalSearchViewModel)DataContext).ShowPreview}">
            <gallery:InlineArtworkViewer.IsVisible>
                <Binding Path="$parent[UserControl].((vm:GlobalSearchViewModel)DataContext).IsViewerExpanded"/>
            </gallery:InlineArtworkViewer.IsVisible>
        </gallery:InlineArtworkViewer>
    </Grid>
</UserControl>
