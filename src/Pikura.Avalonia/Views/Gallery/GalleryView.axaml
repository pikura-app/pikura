<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pikura.Avalonia.Localization"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:local="using:Pikura.Avalonia.Views.Gallery"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             xmlns:services="using:Pikura.Avalonia.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Pikura.Avalonia.Views.Gallery.GalleryView"
             x:DataType="vm:GalleryViewModel">


    <UserControl.Resources>
        <!-- Converter for R-18 blur effect -->
        <conv:BoolToBlurRadiusConverter x:Key="BoolToBlurRadiusConverter" />

        <!-- Inline context menus defined per-card for proper DataContext -->
    </UserControl.Resources>

    <!-- Root: top bar | optional filter bar | content | status bar -->
    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ── Top bar (matches WPF reference) ──────────────────────── -->
        <Border Grid.Row="0"
                Background="{DynamicResource Container1BackgroundBrush}"
                Padding="16,10,16,10"
                Margin="0,32,0,0">
            <!-- Single scrollable toolbar row -->
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">

                <!-- LEFT: title + count + Refresh + Copy All + Recent Works -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Gallery_FollowedArtists}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"
                               AutomationProperties.Name="Gallery Header"
                               AutomationProperties.HelpText="List of artists you follow on Pixiv"/>
                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                            CornerRadius="10" Padding="8,2" VerticalAlignment="Center"
                            ToolTip.Tip="{loc:Tr Gallery_NumberOfFollowedArtistsLoaded}">
                        <TextBlock FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                   Text="{Binding ArtistsTotal}"/>
                    </Border>
                    <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                 IsVisible="{Binding IsLoadingArtists}" VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                    <Button CornerRadius="8" Padding="12,8" FontSize="12"
                            Command="{Binding RefreshFollowedArtistsCommand}"
                            ToolTip.Tip="{loc:Tr Gallery_RefreshFollowedArtistsListFromPixiv}"
                            AutomationProperties.Name="Refresh Button"
                            AutomationProperties.HelpText="Refresh the list of followed artists from Pixiv server"
                            KeyboardNavigation.TabIndex="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource RefreshIcon}" Width="16" Height="16"
                                      VerticalAlignment="Center"
                                      Foreground="{Binding $parent[Button].Foreground}"/>
                            <TextBlock Text="{loc:Tr Common_Refresh}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="8" Padding="12,8" FontSize="12"
                            Command="{Binding CopyAllArtistIdsCommand}"
                            ToolTip.Tip="{loc:Tr Gallery_ClickIndividualArtistIDsToQueue}"
                            AutomationProperties.Name="Copy All Button"
                            KeyboardNavigation.TabIndex="1">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource CopyIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_CopyAll}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="{Binding QueuedArtistCount, StringFormat='({0})'}" FontSize="12"
                                       IsVisible="{Binding QueuedArtistCount, Converter={x:Static conv:GreaterThanZeroConverter.Instance}}"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="8" Padding="12,8" FontSize="12"
                            Command="{Binding LoadRecentWorksCommand}"
                            ToolTip.Tip="{loc:Tr Gallery_ViewRecentWorksFromAllFollowed}"
                            AutomationProperties.Name="Recent Works Button"
                            AutomationProperties.HelpText="View recent works from all followed artists"
                            KeyboardNavigation.TabIndex="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource ImageIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Gallery_RecentWorks}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- CENTER: unified search bar with integrated scope selector -->
                <Border Background="{DynamicResource Container1BackgroundBrush}"
                        BorderBrush="{DynamicResource Container1BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Height="34" MinWidth="280" Width="320"
                        VerticalAlignment="Center">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <ComboBox Grid.Column="0"
                                  SelectedIndex="{Binding SearchScopeIndex, Mode=TwoWay}"
                                  ToolTip.Tip="{loc:Tr Gallery_SearchScopeCurrentArtistFiltersThe}"
                                  FontSize="11" Background="Transparent" BorderThickness="0"
                                  Padding="8,0,4,0" Height="34" VerticalAlignment="Center">
                            <ComboBoxItem Content="{loc:Tr Gallery_CurrentArtist}"/>
                            <ComboBoxItem Content="{loc:Tr Gallery_AllFollowed}"/>
                        </ComboBox>

                        <Rectangle Grid.Column="1" Width="1" Height="20"
                                   Fill="{DynamicResource Container1BorderBrush}"
                                   Margin="4,0" VerticalAlignment="Center"/>

                        <TextBox Grid.Column="2" Text="{Binding IdSearchQuery}"
                                 PlaceholderText="{loc:Tr Gallery_SearchTagArtistOrID}"
                                 FontSize="11" Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Padding="6,0"
                                 KeyDown="OnIdSearchKeyDown">
                            <ToolTip.Tip>
                                <StackPanel Spacing="6" MaxWidth="300">
                                    <TextBlock Text="{loc:Tr Gallery_PixivSearch}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushSecondary}" TextWrapping="Wrap">
                                        <Run Text="• "/><Run Text="{loc:Tr Gallery_Sakura}" FontWeight="SemiBold"/><Run Text="{loc:Tr Gallery_SearchArtworksByTag}"/><LineBreak/>
                                        <Run Text="• "/><Run Text="123456" FontWeight="SemiBold"/><Run Text="{loc:Tr Gallery_OpenArtworkByID}"/><LineBreak/>
                                        <Run Text="• "/><Run Text="{loc:Tr Gallery_U12345}" FontWeight="SemiBold"/><Run Text="{loc:Tr Gallery_OpenArtistByUserID}"/><LineBreak/>
                                        <Run Text="• "/><Run Text="{loc:Tr Gallery_AName}" FontWeight="SemiBold"/><Run Text="{loc:Tr Gallery_SearchArtistByName}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="10" Foreground="{DynamicResource DefaultForegroundBrushDisabled}" TextWrapping="Wrap"
                                               Text="{loc:Tr Gallery_PressEnterToSearchUseThe}"/>
                                </StackPanel>
                            </ToolTip.Tip>
                        </TextBox>

                        <Button Grid.Column="3" FontSize="11" Padding="8,0"
                                Background="Transparent" BorderThickness="0"
                                VerticalAlignment="Center"
                                Command="{Binding ClearSearchAndReturnCommand}"
                                IsVisible="{Binding IdSearchQuery, Converter={x:Static conv:StringNotEmptyConverter.Instance}}"
                                ToolTip.Tip="{loc:Tr Gallery_ClearSearchAndReturnToGallery}">
                            <Path Data="{StaticResource CloseIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- RIGHT: downloads | grid/list+preview+filters | size slider -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">

                    <!-- Download buttons — only shown when an artist is selected -->
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding SelectedArtist}">
                        <Button CornerRadius="8" Padding="10,6" FontSize="11"
                                Classes="accent"
                                Click="OnDownloadAllClicked"
                                ToolTip.Tip="{loc:Tr Gallery_DownloadEveryArtworkFromThisArtist}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_DownloadAll}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button CornerRadius="8" Padding="10,6" FontSize="11"
                                Click="OnDownloadLoadedClicked"
                                ToolTip.Tip="{loc:Tr Gallery_DownloadOnlyTheArtworksCurrentlyShown}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_DownloadLoaded}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button CornerRadius="8" Padding="10,6" FontSize="11"
                                Click="OnDownloadSelectedClicked"
                                IsVisible="{Binding SelectedCount}"
                                ToolTip.Tip="{loc:Tr Gallery_DownloadOnlyTheCheckedArtworks}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="{Binding SelectedCount, StringFormat='Download Selected ({0})'}" />
                            </StackPanel>
                        </Button>
                        <Button CornerRadius="8" Padding="10,6" FontSize="11"
                                Command="{Binding ViewSelectedAsCollageCommand}"
                                IsVisible="{Binding CanViewSelectedAsCollage}"
                                ToolTip.Tip="{loc:Tr Gallery_ShowTheCheckedArtworksInA}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="⊞" FontSize="12"/>
                                <TextBlock Text="{loc:Tr Collage_ViewAsCollage}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <SplitButton CornerRadius="8" Padding="10,6" FontSize="11"
                                Command="{Binding AddSelectedToCollageCommand}"
                                IsVisible="{Binding CanAddSelectedToCollage}"
                                ToolTip.Tip="{loc:Tr Gallery_AddTheCheckedArtworksToThe}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="⊞" FontSize="12"/>
                                <TextBlock Text="{loc:Tr Collage_AddToCollage}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="{loc:Tr Collage_ChooseCollage}"
                                              Command="{Binding AddSelectedToCollagePickCommand}"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button CornerRadius="8" Padding="10,6" FontSize="11"
                                Command="{Binding ViewSelectedInNewTabsCommand}"
                                IsVisible="{Binding CanViewSelectedInNewTabs}"
                                ToolTip.Tip="{loc:Tr Search_OpenEachSelectedArtworkInIts}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="{loc:Tr Search_ViewInNewTabs}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button CornerRadius="8" Padding="10,6" FontSize="11"
                                Command="{Binding ClearSelectionCommand}"
                                IsVisible="{Binding SelectedCount}"
                                ToolTip.Tip="{loc:Tr Gallery_ClearSelection}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Data="{StaticResource CloseIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                <TextBlock>
                                    <Run Text="{loc:Tr Gallery_DeselectAll}"/><Run Text="{Binding SelectedCount}"/><Run Text=")"/>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Button CornerRadius="8" Padding="10,6" FontSize="11"
                                Click="OnDownloadRangeClicked"
                                ToolTip.Tip="{loc:Tr Gallery_ChooseANumberedRangeToDownload}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_DownloadRange}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button CornerRadius="8" Padding="10,6" FontSize="11"
                                Classes="accent"
                                Click="OnDownloadPresetClicked"
                                ToolTip.Tip="{loc:Tr Search_DownloadWithImageProcessingPreset}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource PaletteIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_DownloadPreset}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Border IsVisible="{Binding HasQueuedDownloads}"
                                Background="{DynamicResource Container3BackgroundBrush}"
                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="8,4"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{loc:Tr Gallery_DownloadsWaitingInQueueAutoStart}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource ClockIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding QueuedDownloadCount, StringFormat='Queued: {0}'}"
                                           FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"
                               IsVisible="{Binding SelectedArtist, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <!-- Preview + Filters -->
                    <ToggleButton IsChecked="{Binding ShowPreview, Mode=TwoWay}"
                                  CornerRadius="8" Padding="10,6" FontSize="11"
                                  ToolTip.Tip="{loc:Tr Rankings_ToggleTheSidePanelBrowseArtworks}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Path Data="{StaticResource ShowPanelIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"
                                  IsVisible="{Binding !ShowPreview}"/>
                            <Path Data="{StaticResource HidePanelIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"
                                  IsVisible="{Binding ShowPreview}"/>
                            <TextBlock Text="{loc:Tr Search_ShowPanel}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding !ShowPreview}"/>
                            <TextBlock Text="{loc:Tr Search_HidePanel}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding ShowPreview}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowFilters}"
                                  CornerRadius="8" Padding="10,6" FontSize="11"
                                  ToolTip.Tip="{loc:Tr Gallery_ToggleTagAndDateFilters}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource FilterIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                            <TextBlock Text="{loc:Tr Gallery_Filters}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Sort — standalone dropdown styled like other buttons -->
                    <ComboBox Name="SortCombo" SelectedIndex="0"
                              FontSize="11" CornerRadius="8"
                              Padding="10,6" MaxDropDownHeight="400"
                              SelectionChanged="OnSortComboChanged"
                              ToolTip.Tip="{loc:Tr Gallery_SortArtworks}">
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource DocumentIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Gallery_Default}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem Content="{loc:Tr Gallery_AZ}"/>
                        <ComboBoxItem Content="{loc:Tr Gallery_ZA}"/>
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource ChevronDownIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Gallery_NewestFirst}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource ChevronUpIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Gallery_OldestFirst}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource QueueIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Gallery_MostPages}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ComboBoxItem>
                    </ComboBox>

                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>

                    <!-- Card size + height mode + Grid/List — far right -->
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                IsVisible="{Binding IsGridView}">
                        <ToggleButton IsChecked="{Binding IsFixedHeight}"
                                      Command="{Binding SetFixedHeightCommand}"
                                      CornerRadius="8" Padding="10,6" FontSize="11"
                                      ToolTip.Tip="{loc:Tr Gallery_FixedCardHeight}">
                            <ToggleButton.Styles>
                                <Style Selector="ToggleButton:checked">
                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </ToggleButton.Styles>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource MaximizeIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_Fixed}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding IsNaturalHeight}"
                                      Command="{Binding SetNaturalHeightCommand}"
                                      CornerRadius="8" Padding="10,6" FontSize="11"
                                      ToolTip.Tip="{loc:Tr Gallery_NaturalHeightPreservesAspectRatio}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource ResizeVerticalIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_Natural}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                        <ToggleButton IsChecked="{Binding ShowTags}"
                                      CornerRadius="8" Padding="10,6" FontSize="11"
                                      ToolTip.Tip="{loc:Tr Gallery_ShowHideTagsOnCards}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource TagIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_Tags}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowInfo}"
                                      CornerRadius="8" Padding="10,6" FontSize="11"
                                      ToolTip.Tip="{loc:Tr Gallery_ShowHideCardInfoStripTitle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource InfoIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                                <TextBlock Text="{loc:Tr Gallery_Info}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton IsChecked="{Binding ShowBadges}"
                                      CornerRadius="8" Padding="10,6" FontSize="11"
                                      ToolTip.Tip="{loc:Tr Search_ShowHideLikedBookmarkedFavoriteBadges}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource HeartFilledIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{DynamicResource HeartBadgeIconBrush}" />
                                <TextBlock Text="{loc:Tr Search_Badges}" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                        <Rectangle Width="1" Height="20" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                        <TextBlock Text="{loc:Tr Gallery_Size}" FontSize="11"
                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                   VerticalAlignment="Center"/>
                        <Slider Value="{Binding CardSize}" Minimum="120" Maximum="300" Width="90"
                                VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- View mode — after slider, always visible -->
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                    <Button CornerRadius="8" Padding="10,6" FontSize="11"
                            Command="{Binding SetGridViewCommand}"
                            IsEnabled="{Binding !IsGridView}"
                            ToolTip.Tip="{loc:Tr Rankings_GridView}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="⊞" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Gallery_Grid}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="8" Padding="10,6" FontSize="11"
                            Command="{Binding SetListViewCommand}"
                            IsEnabled="{Binding !IsListView}"
                            ToolTip.Tip="{loc:Tr Rankings_ListView}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="☰" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Gallery_List}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="20" Fill="{DynamicResource Container1BorderBrush}" Margin="2,0"/>
                    
                </StackPanel>

            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Collapsible filter bar (tag + date only, no sort) ────────── -->
        <Border Grid.Row="1"
                Background="{DynamicResource Container1BackgroundBrush}"
                Padding="14,8">
            <Border.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Path="ShowFilters"/>
                    <Binding Path="!IsViewerFullScreen"/>
                </MultiBinding>
            </Border.IsVisible>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">

                <!-- Tag include -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Gallery_INCLUDETAGS}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                               LetterSpacing="1"/>
                    <TextBox Text="{Binding TagIncludeFilter}" Width="160"
                             PlaceholderText="{loc:Tr Gallery_Tag1Tag2}" CornerRadius="8" FontSize="11"
                             Padding="8,5"
                             ToolTip.Tip="{loc:Tr Gallery_ShowOnlyArtworksThatHaveALL}"/>
                </StackPanel>

                <!-- Tag exclude -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Gallery_EXCLUDETAGS}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                               LetterSpacing="1"/>
                    <TextBox Text="{Binding TagExcludeFilter}" Width="160"
                             PlaceholderText="{loc:Tr Gallery_Tag1Tag2}" CornerRadius="8" FontSize="11"
                             Padding="8,5"
                             ToolTip.Tip="{loc:Tr Gallery_HideArtworksThatHaveANYOf}"/>
                </StackPanel>

                <Rectangle Width="1" Height="36" Fill="{DynamicResource Container1BorderBrush}" VerticalAlignment="Center"/>

                <!-- Date range -->
                <StackPanel Spacing="4">
                    <TextBlock Text="{loc:Tr Gallery_DATERANGE}" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                               LetterSpacing="1"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <DatePicker SelectedDate="{Binding DateFrom}" FontSize="11"
                                    ToolTip.Tip="{loc:Tr Gallery_ShowArtworksFromThisDate}"/>
                        <TextBlock Text="→" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                        <DatePicker SelectedDate="{Binding DateTo}" FontSize="11"
                                    ToolTip.Tip="{loc:Tr Gallery_ShowArtworksUpToThisDate}"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Width="1" Height="36" Fill="{DynamicResource Container1BorderBrush}" VerticalAlignment="Center"/>

                <Button Content="{loc:Tr Gallery_ClearFilters}" CornerRadius="8" Padding="10,6" FontSize="11"
                        Click="OnClearFilters" VerticalAlignment="Bottom"
                        ToolTip.Tip="{loc:Tr Gallery_ClearAllTagAndDateFilters}"/>
            </StackPanel>
        </Border>

        <!-- ── Main body: sidebar | artwork grid | inline viewer ──────────── -->
        <Grid Grid.Row="2" ColumnDefinitions="230,1,*" Name="BodyGrid"
              Background="{DynamicResource Container1BackgroundBrush}">
            <!-- Top gallery separator -->
            <Rectangle Grid.ColumnSpan="3"
                       Height="1"
                       VerticalAlignment="Top"
                       Fill="{DynamicResource Container2BorderBrush}"
                       IsHitTestVisible="False"
                       ZIndex="100"/>

            <!-- Sidebar divider — hidden with sidebar -->
            <Rectangle Grid.Column="1"
                       Fill="{DynamicResource Container1BorderBrush}"
                       Width="1" HorizontalAlignment="Stretch">
                <Rectangle.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="ShowSidebar"/>
                        <Binding Path="!IsViewerFullScreen"/>
                    </MultiBinding>
                </Rectangle.IsVisible>
            </Rectangle>

            <!-- ── Artist sidebar — hidden when viewer is full-screen or sidebar toggled off ── -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="0,0,1,0">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="ShowSidebar"/>
                        <Binding Path="!IsViewerFullScreen"/>
                    </MultiBinding>
                </Border.IsVisible>
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Search bar — stretches full width -->
                    <Border Grid.Row="0" Margin="10,10,10,8"
                            Background="{DynamicResource Container1BackgroundBrush}"
                            BorderBrush="{DynamicResource Container1BorderBrush}"
                            BorderThickness="1" CornerRadius="10">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="12" Margin="12,0,6,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                            <TextBox Grid.Column="1" Text="{Binding ArtistFilter}"
                                     PlaceholderText="{loc:Tr Gallery_FilterArtists}"
                                     CornerRadius="0" FontSize="12"
                                     Background="Transparent" BorderThickness="0"
                                     Padding="0,9"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Margin="10,0,10,0"
                            Background="{DynamicResource Container1BackgroundBrush}"
                            BorderBrush="{DynamicResource Container1BorderBrush}"
                            BorderThickness="1" CornerRadius="12"
                            BoxShadow="{DynamicResource CardShadow}"
                            ClipToBounds="True">
                    <ListBox ItemsSource="{Binding FilteredArtists}"
                             SelectedItem="{Binding SelectedArtist}"
                             Background="Transparent" Padding="6,4,6,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerTheme>
                            <ControlTheme TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,7"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <Border Name="Root"
                                                Background="Transparent"
                                                CornerRadius="10"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter>
                                <Style Selector="^:pointerover /template/ Border#Root">
                                    <Setter Property="Background" Value="{DynamicResource Container2BackgroundBrush}"/>
                                </Style>
                                <Style Selector="^:selected /template/ Border#Root">
                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSoftAccent}"/>
                                </Style>
                                <Style Selector="^:selected:pointerover /template/ Border#Root">
                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSoftAccentPressed}"/>
                                </Style>
                            </ControlTheme>
                        </ListBox.ItemContainerTheme>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArtistCardViewModel">
                                <Grid ColumnDefinitions="3,Auto,*,Auto" VerticalAlignment="Center"
                                      PointerPressed="OnArtistRowPointerPressed"
                                      Tag="{Binding UserId}">
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr Gallery_OpenArtistPage}" Click="OnOpenArtistPageMenu">
                                                <MenuItem.Tag>
                                                    <Binding Path="UserId"/>
                                                </MenuItem.Tag>
                                            </MenuItem>
                                            <MenuItem Header="{loc:Tr Gallery_CopyID}" Click="OnCopyArtistIdMenu">
                                                <MenuItem.Tag>
                                                    <Binding Path="UserId"/>
                                                </MenuItem.Tag>
                                            </MenuItem>
                                            <Separator/>
                                            <MenuItem Header="{loc:Tr Gallery_Unfollow}" Click="OnUnfollowArtistMenu"/>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <!-- Left accent bar — visible when selected -->
                                    <Border Grid.Column="0" Width="3" Height="20" CornerRadius="2"
                                            Background="{DynamicResource ControlForegroundBrushOutlineAccent}" VerticalAlignment="Center"
                                            IsVisible="{Binding $parent[ListBoxItem].IsSelected}"/>
                                    <!-- Avatar -->
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="18"
                                            ClipToBounds="True"
                                            Background="{DynamicResource Container2BackgroundBrush}">
                                        <Panel>
                                            <TextBlock Text="{Binding Initial}"
                                                       FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding Avatar, Converter={x:Static ObjectConverters.IsNull}}"/>
                                            <Image Source="{Binding Avatar}" Stretch="UniformToFill"
                                                   IsVisible="{Binding Avatar, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                        </Panel>
                                    </Border>
                                    <!-- Name + ID -->
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultForegroundBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="ArtistIdText"
                                                   Text="{Binding UserId, StringFormat='ID {0}'}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                                   Cursor="IBeam"
                                                   TextTrimming="CharacterEllipsis"
                                                   PointerPressed="OnArtistIdPointerPressed"
                                                   Tag="{Binding UserId}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Border>

                    <!-- R-18 toggle at the bottom of the sidebar -->
                    <Border Grid.Row="2" Margin="10,6,10,10"
                            Background="{DynamicResource Container1BackgroundBrush}"
                            BorderBrush="{DynamicResource Container1BorderBrush}"
                            BorderThickness="1" CornerRadius="10"
                            IsVisible="{Binding ShowR18Buttons}">
                        <Grid ColumnDefinitions="*,Auto" Margin="14,12">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="{loc:Tr Settings_R18Content}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Tr Gallery_ShowExplicitContent}" FontSize="10"
                                           Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                            </StackPanel>
                            <!-- Pill toggle switch -->
                            <ToggleButton Grid.Column="1" IsChecked="{Binding ShowR18}"
                                          VerticalAlignment="Center"
                                          Width="44" Height="24"
                                          Padding="0" CornerRadius="12"
                                          Background="Transparent" BorderThickness="0"
                                          ToolTip.Tip="{loc:Tr Gallery_ShowHideR18Content}">
                                <ToggleButton.Styles>
                                    <Style Selector="ToggleButton">
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <Border Width="44" Height="24" CornerRadius="12"
                                                        Background="#374151">
                                                    <Border.Styles>
                                                        <Style Selector="Border:pointerover">
                                                            <Setter Property="Background" Value="#4B5563"/>
                                                        </Style>
                                                    </Border.Styles>
                                                    <Canvas Width="44" Height="24" ClipToBounds="False">
                                                        <Ellipse Width="18" Height="18"
                                                                 Canvas.Left="3" Canvas.Top="3"
                                                                 Fill="White" Opacity="0.5"/>
                                                    </Canvas>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter>
                                    </Style>
                                    <Style Selector="ToggleButton:checked">
                                        <Setter Property="Template">
                                            <ControlTemplate>
                                                <Border Width="44" Height="24" CornerRadius="12"
                                                        Background="#EF4444">
                                                    <Canvas Width="44" Height="24" ClipToBounds="False">
                                                        <Ellipse Width="18" Height="18"
                                                                 Canvas.Left="23" Canvas.Top="3"
                                                                 Fill="White"/>
                                                    </Canvas>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Styles>
                            </ToggleButton>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource Container1BorderBrush}"/>

            <!-- ── Artwork area: grid | optional preview side panel ─────────── -->
            <Grid Grid.Column="2" x:Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <!-- Custom splitter (Border with pointer events) — avoids GridSplitter's direct column manipulation -->
                <Border Grid.Column="1" Width="4" Name="GallerySplitter"
                        Cursor="SizeWestEast"
                        Background="{DynamicResource Container1BorderBrush}"
                        IsVisible="{Binding ShowPreview}"
                        PointerPressed="OnSplitterPointerPressed"
                        PointerMoved="OnSplitterPointerMoved"
                        PointerReleased="OnSplitterPointerReleased"/>

                <!-- Side preview panel -->
                <Border Grid.Column="2"
                        Margin="6,0,0,0"
                        IsVisible="{Binding ShowPreview}">
                    <Border
                        Width="{Binding BrowsePanelWidth}"
                        MinWidth="300"
                        ClipToBounds="True"
                        Background="{DynamicResource Container1BackgroundBrush}"
                        BoxShadow="{DynamicResource PanelShadow}">
                        <local:InlineArtworkViewer x:Name="GallerySideViewer"
                                                   DataContext="{Binding}"
                                                   IsExpanded="{Binding IsViewerExpanded}"
                                                   IsPanelOpen="{Binding ShowPreview}"/>
                    </Border>
                </Border>


                <!-- ── Main content area (full-screen viewer OR grid/list) ── -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Container1BackgroundBrush}"
                        ClipToBounds="True">

                <!-- ─── GRID / LIST layer ─── -->
                <Grid IsVisible="{Binding ShowGridLayer}">

                    <!-- Empty / select-artist hint -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                ZIndex="1">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="SelectedArtist" Converter="{x:Static ObjectConverters.IsNull}"/>
                                <Binding Path="!IsRecentFeedActive"/>
                                <Binding Path="!IsLoading"/>
                                <Binding Path="!HasArtworks"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <TextBlock Text="{loc:Tr Gallery_SelectAnArtist}"
                                   Foreground="{DynamicResource DefaultForegroundBrush}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Gallery_ChooseFromTheSidebarOrClick}"
                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}" FontSize="13" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- ── GRID view ──────────────────────────────── -->
                    <ScrollViewer Grid.Row="0" Name="GridScroll"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="False"
                                  IsVisible="{Binding IsGridView}">
                        <Panel>
                        <!-- FIXED MODE: dense layout -->
                        <ItemsControl ItemsSource="{Binding FilteredArtworks}" Margin="10,10,4,10"
                                      IsVisible="{Binding IsFixedHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:MasonryPanel x:Name="ArtworksPanel"
                                                        ColumnWidth="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).CardSize}"
                                                        ItemSpacing="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtworkCardViewModel">
                                    <Panel>
                                        <!-- FIXED HEIGHT MODE: Seamless cropped images, clean layout -->
                                        <Border Margin="0,0,2,2"
                                                Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                BoxShadow="{DynamicResource CardShadow}"
                                                Cursor="Hand"
                                                PointerPressed="OnArtworkCardClicked">
                                                <Border.ContextMenu>
                                                    <ContextMenu Opening="OnCardContextMenuOpening">
                                                        <MenuItem Header="{loc:Tr Search_Select}" Click="OnContextToggleSelection"
                                                                  IsVisible="{Binding !IsSelected}"/>
                                                        <MenuItem Header="{loc:Tr Search_Deselect}" Click="OnContextToggleSelection"
                                                                  IsVisible="{Binding IsSelected}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr Search_DownloadAll}" Click="OnContextDownloadAll"/>
                                                        <MenuItem Header="{loc:Tr Search_FirstPageOnly}" Click="OnContextDownloadThisPage"
                                                                  IsVisible="{Binding IsMultiPage}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr Search_OpenInSidePanel}" Click="OnContextOpenSidePanel"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenFullScreen}" Click="OnContextOpenFullScreen"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenInNewTab}" Click="OnContextOpenInNewTab"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenInPopup}" Click="OnContextOpenPopup"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenOnPixivNet}" Click="OnContextOpenPixiv"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenArtistGallery}" Click="OnContextOpenArtistGallery"
                                                                  Tag="OpenArtistGallery"
                                                                  IsVisible="{Binding !IsCurrentArtist}"/>
                                                        <MenuItem Header="{loc:Tr Gallery_FollowArtist}" Click="OnContextToggleFollow"
                                                                  IsVisible="{Binding !IsFollowed}"/>
                                                        <MenuItem Header="{loc:Tr Gallery_UnfollowArtist}" Click="OnContextToggleFollow"
                                                                  IsVisible="{Binding IsFollowed}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr Search_AddToLocalFavorites}" Click="OnContextToggleFavorite"
                                                                  IsVisible="{Binding !IsLocalFavorite}"/>
                                                        <MenuItem Header="{loc:Tr Search_RemoveFromFavorites}" Click="OnContextToggleFavorite"
                                                                  IsVisible="{Binding IsLocalFavorite}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr Search_CopyArtworkID}" Click="OnContextCopyId"/>
                                                        <MenuItem Header="{loc:Tr Search_CopyArtistID}" Click="OnContextCopyArtistId"/>
                                                        <MenuItem Header="{loc:Tr Search_CopyImage}" Click="OnContextCopyImage"/>
                                                        <MenuItem Header="{loc:Tr Search_UseAsAppBackground}" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr History_ExportMetadata}" Click="OnContextExportMetadata"
                                                                  ToolTip.Tip="{loc:Tr Gallery_SaveIdArtistLinkSizeUpload}"/>
                                                        <MenuItem Header="{loc:Tr Gallery_ExportMetadataOfSelected}" Click="OnContextExportSelectedMetadata"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BoxShadow" Value="0 6 20 0 #55000000"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid RowDefinitions="*,Auto">
                                                <!-- Image area: clipped top corners only — image ONLY inside clip -->
                                                <Border Grid.Row="0"
                                                        Height="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).FixedCardTotalHeight}"
                                                        CornerRadius="7,7,0,0" ClipToBounds="True">
                                                    <Panel>
                                                        <!-- Loading placeholder — visible until thumbnail loads -->
                                                        <Panel IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <Border Background="{DynamicResource Container2BackgroundBrush}"/>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                                <StackPanel.Styles>
                                                                    <Style>
                                                                        <Style.Animations>
                                                                            <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                                                                <KeyFrame Cue="0%">
                                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                                </KeyFrame>
                                                                                <KeyFrame Cue="100%">
                                                                                    <Setter Property="Opacity" Value="1.0"/>
                                                                                </KeyFrame>
                                                                            </Animation>
                                                                        </Style.Animations>
                                                                    </Style>
                                                                </StackPanel.Styles>
                                                                <PathIcon Data="{StaticResource ImageIcon}" Width="28" Height="28"
                                                                          Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                                <TextBlock Text="{loc:Tr Common_Loading}" FontSize="10"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                            </StackPanel>
                                                        </Panel>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality" UseLayoutRounding="True">
                                                            <Image.Effect>
                                                                <BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}" />
                                                            </Image.Effect>
                                                        </Image>
                                                    </Panel>
                                                </Border>
                                                <!-- Badges overlaid on image row — outside ClipToBounds -->
                                                <Panel Grid.Row="0" ZIndex="5" IsHitTestVisible="False">
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                            Margin="6,0,0,6" Padding="5,2" CornerRadius="4"
                                                            Background="#BB000000" IsVisible="{Binding IsMultiPage}">
                                                        <TextBlock Text="{Binding PageCount, StringFormat='{}{0}'}"
                                                                   FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                            Margin="0,6,6,0" Padding="5,2" CornerRadius="4"
                                                            Background="#CCDC2626" IsVisible="{Binding IsR18}">
                                                        <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#AA000000" IsVisible="{Binding IsDownloading}" IsHitTestVisible="True">
                                                        <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Local favorite + liked heart + bookmarked badge — bottom-right.
                                                         Individually positioned (not a StackPanel) — a horizontal
                                                         StackPanel here was only ever rendering its first child. -->
                                                    <Panel IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowBadges}">
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding IsLocalFavorite}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsPixivBookmarked"/>
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource StarIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                                                Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                                                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                    </Panel>
                                                </Panel>
                                                <!-- Selection checkbox — top-left (always inside card bounds) -->
                                                <CheckBox Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                          Margin="6,6,0,0" ZIndex="10" MinWidth="0" MinHeight="0"
                                                          IsChecked="{Binding IsSelected}" Click="OnArtworkCheckboxClicked"/>
                                                <!-- Info strip below image -->
                                                <StackPanel Grid.Row="1" Margin="8,6,8,8" Spacing="2"
                                                            IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowInfo}">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DefaultForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding DateLabel}" FontSize="10"
                                                               IsVisible="{Binding HasDate}"
                                                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                    <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                                                  IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Margin="0,1,3,1" Padding="5,2" CornerRadius="3"
                                                                        Background="{DynamicResource Container2BackgroundBrush}"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand" PointerPressed="OnTagChipPressed">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border:pointerover">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                        </Style>
                                                                        <Style Selector="Border:pointerover TextBlock">
                                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrush}"/>
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                                               Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- NATURAL HEIGHT MODE: Full images with aspect ratio preservation -->
                                        <Border Margin="0,0,6,6"
                                                Width="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).CardSize}"
                                                IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).IsNaturalHeight}"
                                                Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                BoxShadow="{DynamicResource CardShadow}"
                                                Cursor="Hand"
                                                PointerPressed="OnArtworkCardClicked">
                                                <Border.ContextMenu>
                                                    <ContextMenu Opening="OnListCardContextMenuOpening">
                                                        <MenuItem Header="{loc:Tr Search_Select}" Click="OnContextToggleSelection"
                                                                  IsVisible="{Binding !IsSelected}"/>
                                                        <MenuItem Header="{loc:Tr Search_Deselect}" Click="OnContextToggleSelection"
                                                                  IsVisible="{Binding IsSelected}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr Search_DownloadAll}" Click="OnContextDownloadAll"/>
                                                        <MenuItem Header="{loc:Tr Search_FirstPageOnly}" Click="OnContextDownloadThisPage"
                                                                  IsVisible="{Binding IsMultiPage}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr Search_OpenInSidePanel}" Click="OnContextOpenSidePanel"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenFullScreen}" Click="OnContextOpenFullScreen"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenInNewTab}" Click="OnContextOpenInNewTab"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenInPopup}" Click="OnContextOpenPopup"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenOnPixivNet}" Click="OnContextOpenPixiv"/>
                                                        <MenuItem Header="{loc:Tr Search_OpenArtistGallery}" Click="OnContextOpenArtistGallery"
                                                                  Tag="OpenArtistGallery"
                                                                  IsVisible="{Binding !IsCurrentArtist}"/>
                                                        <MenuItem Header="{loc:Tr Gallery_FollowArtist}" Click="OnContextToggleFollow"
                                                                  IsVisible="{Binding !IsFollowed}"/>
                                                        <MenuItem Header="{loc:Tr Gallery_UnfollowArtist}" Click="OnContextToggleFollow"
                                                                  IsVisible="{Binding IsFollowed}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr Search_AddToLocalFavorites}" Click="OnContextToggleFavorite"
                                                                  IsVisible="{Binding !IsLocalFavorite}"/>
                                                        <MenuItem Header="{loc:Tr Search_RemoveFromFavorites}" Click="OnContextToggleFavorite"
                                                                  IsVisible="{Binding IsLocalFavorite}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr Search_CopyArtworkID}" Click="OnContextCopyId"/>
                                                        <MenuItem Header="{loc:Tr Search_CopyArtistID}" Click="OnContextCopyArtistId"/>
                                                        <MenuItem Header="{loc:Tr Search_CopyImage}" Click="OnContextCopyImage"/>
                                                        <MenuItem Header="{loc:Tr Search_UseAsAppBackground}" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                                                        <Separator/>
                                                        <MenuItem Header="{loc:Tr History_ExportMetadata}" Click="OnContextExportMetadata"
                                                                  ToolTip.Tip="{loc:Tr Gallery_SaveIdArtistLinkSizeUpload}"/>
                                                        <MenuItem Header="{loc:Tr Gallery_ExportMetadataOfSelected}" Click="OnContextExportSelectedMetadata"/>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BoxShadow" Value="0 6 20 0 #55000000"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid RowDefinitions="*,Auto">
                                                <!-- Image area: natural height, clipped top corners — image ONLY inside clip -->
                                                <Border Grid.Row="0" CornerRadius="7,7,0,0" ClipToBounds="True">
                                                    <Panel>
                                                        <!-- Loading placeholder — visible until thumbnail loads -->
                                                        <Panel IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <Border Background="{DynamicResource Container2BackgroundBrush}"/>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                                <StackPanel.Styles>
                                                                    <Style>
                                                                        <Style.Animations>
                                                                            <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                                                                <KeyFrame Cue="0%">
                                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                                </KeyFrame>
                                                                                <KeyFrame Cue="100%">
                                                                                    <Setter Property="Opacity" Value="1.0"/>
                                                                                </KeyFrame>
                                                                            </Animation>
                                                                        </Style.Animations>
                                                                    </Style>
                                                                </StackPanel.Styles>
                                                                <PathIcon Data="{StaticResource ImageIcon}" Width="28" Height="28"
                                                                          Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                                <TextBlock Text="{loc:Tr Common_Loading}" FontSize="10"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                            </StackPanel>
                                                        </Panel>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality" UseLayoutRounding="True">
                                                            <Image.Height>
                                                                <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                                                    <Binding Path="$parent[UserControl].((vm:GalleryViewModel)DataContext).CardSize"/>
                                                                    <Binding Path="ClampedAspectRatio"/>
                                                                </MultiBinding>
                                                            </Image.Height>
                                                            <Image.Effect>
                                                                <BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}" />
                                                            </Image.Effect>
                                                        </Image>
                                                    </Panel>
                                                </Border>
                                                <!-- Badges overlaid on image row — outside ClipToBounds -->
                                                <Panel Grid.Row="0" ZIndex="5" IsHitTestVisible="False">
                                                    <Panel.Height>
                                                        <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                                            <Binding Path="$parent[UserControl].((vm:GalleryViewModel)DataContext).CardSize"/>
                                                            <Binding Path="ClampedAspectRatio"/>
                                                        </MultiBinding>
                                                    </Panel.Height>
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                            Margin="6,0,0,6" Padding="5,2" CornerRadius="4"
                                                            Background="#BB000000" IsVisible="{Binding IsMultiPage}">
                                                        <TextBlock Text="{Binding PageCount, StringFormat='{}{0}'}"
                                                                   FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                            Margin="0,6,6,0" Padding="5,2" CornerRadius="4"
                                                            Background="#CCDC2626" IsVisible="{Binding IsR18}">
                                                        <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#AA000000" IsVisible="{Binding IsDownloading}" IsHitTestVisible="True">
                                                        <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Local favorite + liked heart + bookmarked badge — bottom-right.
                                                         Individually positioned (not a StackPanel) — a horizontal
                                                         StackPanel here was only ever rendering its first child. -->
                                                    <Panel IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowBadges}">
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding IsLocalFavorite}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsPixivBookmarked"/>
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource StarIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                                                Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                                                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                    </Panel>
                                                </Panel>
                                                <!-- Selection checkbox — top-left (always inside card bounds) -->
                                                <CheckBox Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                          Margin="6,6,0,0" ZIndex="10" MinWidth="0" MinHeight="0"
                                                          IsChecked="{Binding IsSelected}" Click="OnArtworkCheckboxClicked"/>
                                                <!-- Info strip below image -->
                                                <StackPanel Grid.Row="1" Margin="8,6,8,8" Spacing="2"
                                                            IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowInfo}">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DefaultForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding DateLabel}" FontSize="10"
                                                               IsVisible="{Binding HasDate}"
                                                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                    <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                                                  IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Margin="0,1,3,1" Padding="5,2" CornerRadius="3"
                                                                        Background="{DynamicResource Container2BackgroundBrush}"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand" PointerPressed="OnTagChipPressed">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border:pointerover">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                        </Style>
                                                                        <Style Selector="Border:pointerover TextBlock">
                                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrush}"/>
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                                               Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <!-- Selection state overlay: accent border around card -->
                                        <Border Margin="0,0,2,2"
                                                IsVisible="{Binding IsSelected}"
                                                IsHitTestVisible="False"
                                                BorderBrush="#5B8DEF" BorderThickness="2"
                                                CornerRadius="8"/>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- NATURAL MODE: masonry with breathing room (matches Bookmarks/Rankings) -->
                        <ItemsControl ItemsSource="{Binding FilteredArtworks}" Margin="10,10,4,10"
                                      IsVisible="{Binding IsNaturalHeight}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:MasonryPanel ColumnWidth="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).CardSize}"
                                                        ItemSpacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtworkCardViewModel">
                                    <Panel>
                                        <Border Margin="0,0,6,6"
                                                Width="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).CardSize}"
                                                Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                BoxShadow="{DynamicResource CardShadow}"
                                                Cursor="Hand"
                                                PointerPressed="OnArtworkCardClicked">
                                            <Border.ContextMenu>
                                                <ContextMenu Opening="OnListCardContextMenuOpening">
                                                    <MenuItem Header="{loc:Tr Search_Select}" Click="OnContextToggleSelection"
                                                              IsVisible="{Binding !IsSelected}"/>
                                                    <MenuItem Header="{loc:Tr Search_Deselect}" Click="OnContextToggleSelection"
                                                              IsVisible="{Binding IsSelected}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Tr Search_DownloadAll}" Click="OnContextDownloadAll"/>
                                                    <MenuItem Header="{loc:Tr Search_FirstPageOnly}" Click="OnContextDownloadThisPage"
                                                              IsVisible="{Binding IsMultiPage}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Tr Search_OpenInSidePanel}" Click="OnContextOpenSidePanel"/>
                                                    <MenuItem Header="{loc:Tr Search_OpenFullScreen}" Click="OnContextOpenFullScreen"/>
                                                    <MenuItem Header="{loc:Tr Search_OpenInNewTab}" Click="OnContextOpenInNewTab"/>
                                                    <MenuItem Header="{loc:Tr Search_OpenInPopup}" Click="OnContextOpenPopup"/>
                                                    <MenuItem Header="{loc:Tr Search_OpenOnPixivNet}" Click="OnContextOpenPixiv"/>
                                                    <MenuItem Header="{loc:Tr Search_OpenArtistGallery}" Click="OnContextOpenArtistGallery"
                                                              Tag="OpenArtistGallery"
                                                              IsVisible="{Binding !IsCurrentArtist}"/>
                                                    <MenuItem Header="{loc:Tr Gallery_FollowArtist}" Click="OnContextToggleFollow"
                                                              IsVisible="{Binding !IsFollowed}"/>
                                                    <MenuItem Header="{loc:Tr Gallery_UnfollowArtist}" Click="OnContextToggleFollow"
                                                              IsVisible="{Binding IsFollowed}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Tr Search_AddToLocalFavorites}" Click="OnContextToggleFavorite"
                                                              IsVisible="{Binding !IsLocalFavorite}"/>
                                                    <MenuItem Header="{loc:Tr Search_RemoveFromFavorites}" Click="OnContextToggleFavorite"
                                                              IsVisible="{Binding IsLocalFavorite}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Tr Search_CopyArtworkID}" Click="OnContextCopyId"/>
                                                    <MenuItem Header="{loc:Tr Search_CopyArtistID}" Click="OnContextCopyArtistId"/>
                                                    <MenuItem Header="{loc:Tr Search_CopyImage}" Click="OnContextCopyImage"/>
                                                    <MenuItem Header="{loc:Tr Search_UseAsAppBackground}" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BoxShadow" Value="0 6 20 0 #55000000"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid RowDefinitions="*,Auto">
                                                <Border Grid.Row="0" CornerRadius="7,7,0,0" ClipToBounds="True">
                                                    <Panel>
                                                        <!-- Loading placeholder — visible until thumbnail loads -->
                                                        <Panel IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}">
                                                            <Border Background="{DynamicResource Container2BackgroundBrush}"/>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                                                <StackPanel.Styles>
                                                                    <Style>
                                                                        <Style.Animations>
                                                                            <Animation Duration="0:0:1.2" IterationCount="INFINITE" PlaybackDirection="Alternate">
                                                                                <KeyFrame Cue="0%">
                                                                                    <Setter Property="Opacity" Value="0.35"/>
                                                                                </KeyFrame>
                                                                                <KeyFrame Cue="100%">
                                                                                    <Setter Property="Opacity" Value="1.0"/>
                                                                                </KeyFrame>
                                                                            </Animation>
                                                                        </Style.Animations>
                                                                    </Style>
                                                                </StackPanel.Styles>
                                                                <PathIcon Data="{StaticResource ImageIcon}" Width="28" Height="28"
                                                                          Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                                <TextBlock Text="{loc:Tr Common_Loading}" FontSize="10"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                            </StackPanel>
                                                        </Panel>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                               RenderOptions.BitmapInterpolationMode="HighQuality" UseLayoutRounding="True">
                                                            <Image.Height>
                                                                <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                                                    <Binding Path="$parent[UserControl].((vm:GalleryViewModel)DataContext).CardSize"/>
                                                                    <Binding Path="ClampedAspectRatio"/>
                                                                </MultiBinding>
                                                            </Image.Height>
                                                            <Image.Effect>
                                                                <BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}" />
                                                            </Image.Effect>
                                                        </Image>
                                                    </Panel>
                                                </Border>
                                                <Panel Grid.Row="0" ZIndex="5" IsHitTestVisible="False">
                                                    <Panel.Height>
                                                        <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                                            <Binding Path="$parent[UserControl].((vm:GalleryViewModel)DataContext).CardSize"/>
                                                            <Binding Path="ClampedAspectRatio"/>
                                                        </MultiBinding>
                                                    </Panel.Height>
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                                            Margin="6,0,0,6" Padding="5,2" CornerRadius="4"
                                                            Background="#BB000000" IsVisible="{Binding IsMultiPage}">
                                                        <TextBlock Text="{Binding PageCount, StringFormat='{}{0}'}"
                                                                   FontSize="9" Foreground="White"/>
                                                    </Border>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right"
                                                            Margin="0,6,6,0" Padding="5,2" CornerRadius="4"
                                                            Background="#CCDC2626" IsVisible="{Binding IsR18}">
                                                        <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                    <Border Background="#AA000000" IsVisible="{Binding IsDownloading}" IsHitTestVisible="True">
                                                        <ProgressBar IsIndeterminate="True" Width="60" Height="3"
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <!-- Local favorite + liked heart + bookmarked badge — bottom-right.
                                                         Individually positioned (not a StackPanel) — a horizontal
                                                         StackPanel here was only ever rendering its first child. -->
                                                    <Panel IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowBadges}">
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC8B5CF6" IsVisible="{Binding IsLocalFavorite}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsPixivBookmarked"/>
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource StarIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                                                Padding="5,3" CornerRadius="4" Background="#CC2563EB" IsVisible="{Binding IsPixivBookmarked}">
                                                            <Border.Margin>
                                                                <MultiBinding Converter="{x:Static conv:BadgeStackMarginConverter.Instance}">
                                                                    <Binding Path="IsLiked"/>
                                                                </MultiBinding>
                                                            </Border.Margin>
                                                            <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,6,6"
                                                                Padding="5,3" CornerRadius="4" Background="#CCDB2777" IsVisible="{Binding IsLiked}">
                                                            <PathIcon Data="{StaticResource HeartFilledIcon}" Width="9" Height="9" Foreground="White"/>
                                                        </Border>
                                                    </Panel>
                                                </Panel>
                                                <CheckBox Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                          Margin="6,6,0,0" ZIndex="10" MinWidth="0" MinHeight="0"
                                                          IsChecked="{Binding IsSelected}" Click="OnArtworkCheckboxClicked"/>
                                                <StackPanel Grid.Row="1" Margin="8,6,8,8" Spacing="2"
                                                            IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowInfo}">
                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DefaultForegroundBrush}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding DateLabel}" FontSize="10"
                                                               IsVisible="{Binding HasDate}"
                                                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                    <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                                                  IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowTags}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="x:String">
                                                                <Border Margin="0,1,3,1" Padding="5,2" CornerRadius="3"
                                                                        Background="{DynamicResource Container2BackgroundBrush}"
                                                                        BorderThickness="0"
                                                                        Cursor="Hand" PointerPressed="OnTagChipPressed">
                                                                    <Border.Styles>
                                                                        <Style Selector="Border:pointerover">
                                                                            <Setter Property="Background" Value="Transparent"/>
                                                                            <Setter Property="BorderThickness" Value="0"/>
                                                                        </Style>
                                                                        <Style Selector="Border:pointerover TextBlock">
                                                                            <Setter Property="TextDecorations" Value="Underline"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrush}"/>
                                                                        </Style>
                                                                    </Border.Styles>
                                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                                               Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Border Margin="0,0,6,6"
                                                IsVisible="{Binding IsSelected}"
                                                IsHitTestVisible="False"
                                                BorderBrush="#5B8DEF" BorderThickness="2"
                                                CornerRadius="8"/>
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Panel>
                    </ScrollViewer>

                    <!-- ── LIST view ──────────────────────────────── -->
                    <ScrollViewer Grid.Row="0" Name="ListScroll" Padding="10,10,10,4"
                                  IsVisible="{Binding IsListView}">
                        <ItemsControl ItemsSource="{Binding FilteredArtworks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtworkCardViewModel">
                                    <Border Margin="0,0,0,3"
                                            Background="{DynamicResource Container1BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="6"
                                            Cursor="Hand"
                                            PointerPressed="OnArtworkCardClicked">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="{loc:Tr Search_Select}" Click="OnContextToggleSelection"
                                                              IsVisible="{Binding !IsSelected}"/>
                                                    <MenuItem Header="{loc:Tr Search_Deselect}" Click="OnContextToggleSelection"
                                                              IsVisible="{Binding IsSelected}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Tr Search_DownloadAll}" Click="OnContextDownloadAll"/>
                                                    <MenuItem Header="{loc:Tr Search_FirstPageOnly}" Click="OnContextDownloadThisPage"
                                                              IsVisible="{Binding IsMultiPage}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Tr Gallery_OpenPopup}" Click="OnContextOpenPopup"/>
                                                    <MenuItem Header="{loc:Tr Gallery_OpenInNewTab_2}" Click="OnContextOpenInNewTab"/>
                                                    <MenuItem Header="{loc:Tr Viewer_OpenOnPixivNet}" Click="OnContextOpenPixiv"/>
                                                    <MenuItem Header="{loc:Tr Search_OpenArtistGallery}" Click="OnContextOpenArtistGallery"
                                                              Tag="OpenArtistGallery"/>
                                                    <MenuItem Header="{loc:Tr Gallery_FollowArtist}" Click="OnContextToggleFollow"
                                                              IsVisible="{Binding !IsFollowed}"/>
                                                    <MenuItem Header="{loc:Tr Gallery_UnfollowArtist}" Click="OnContextToggleFollow"
                                                              IsVisible="{Binding IsFollowed}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Tr Search_AddToLocalFavorites}" Click="OnContextToggleFavorite"
                                                              IsVisible="{Binding !IsLocalFavorite}"/>
                                                    <MenuItem Header="{loc:Tr Search_RemoveFromFavorites}" Click="OnContextToggleFavorite"
                                                              IsVisible="{Binding IsLocalFavorite}"/>
                                                    <Separator/>
                                                    <MenuItem Header="{loc:Tr Search_CopyArtworkID}" Click="OnContextCopyId"/>
                                                    <MenuItem Header="{loc:Tr Search_CopyArtistID}" Click="OnContextCopyArtistId"/>
                                                    <MenuItem Header="{loc:Tr Search_CopyImage}" Click="OnContextCopyImage"/>
                                                    <MenuItem Header="{loc:Tr Search_UseAsAppBackground}" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Click="OnArtworkCheckboxClicked"/>
                                            <Border Grid.Column="1" Width="56" Height="56" CornerRadius="4"
                                                    ClipToBounds="True" Margin="4,0,10,0"
                                                    Background="{DynamicResource Container1BackgroundBrush}">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" UseLayoutRounding="True"/>
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="4"
                                                                IsVisible="{Binding $parent[UserControl].((vm:GalleryViewModel)DataContext).ShowBadges}">
                                                        <PathIcon Data="{StaticResource StarIcon}" Width="11" Height="11"
                                                                  Foreground="#8B5CF6" IsVisible="{Binding IsLocalFavorite}"/>
                                                        <PathIcon Data="{StaticResource BookmarkFilledIcon}" Width="11" Height="11"
                                                                  Foreground="#2563EB" IsVisible="{Binding IsPixivBookmarked}"/>
                                                        <PathIcon Data="{StaticResource HeartFilledIcon}" Width="11" Height="11"
                                                                  Foreground="#DB2777" IsVisible="{Binding IsLiked}"/>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                    <TextBlock Text="{Binding DateLabel}" FontSize="11"
                                                               IsVisible="{Binding HasDate}"
                                                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                    <TextBlock Text="{Binding PageCount, StringFormat='{}{0} pages'}"
                                                               FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushSecondary}" IsVisible="{Binding IsMultiPage}"/>
                                                    <Border Background="#CCDC2626" CornerRadius="3" Padding="4,1" IsVisible="{Binding IsR18}">
                                                        <TextBlock Text="R-18" FontSize="10" Foreground="White" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                            <ProgressBar Grid.Column="3" IsIndeterminate="True" Width="40" Height="3"
                                                         IsVisible="{Binding IsDownloading}" VerticalAlignment="Center" Margin="8,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Loading overlay -->
                    <Border Grid.Row="0" Background="{DynamicResource Container1BackgroundBrush}"
                            IsVisible="{Binding IsLoading}" PointerPressed="SwallowPointer">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                            <ProgressBar IsIndeterminate="True" Width="200"/>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource DefaultForegroundBrush}"
                                       FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty state: selected artist has no artworks -->
                    <StackPanel Grid.Row="0"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                ZIndex="1">
                        <StackPanel.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="SelectedArtist" Converter="{x:Static ObjectConverters.IsNotNull}"/>
                                <Binding Path="!IsLoading"/>
                                <Binding Path="!HasArtworks"/>
                            </MultiBinding>
                        </StackPanel.IsVisible>
                        <PathIcon Data="{StaticResource ImageIcon}" Width="48" Height="48" HorizontalAlignment="Center"
                                  Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                        <TextBlock Text="{loc:Tr Gallery_NoArtworksFoundForThisArtist}"
                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}" FontSize="14" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Gallery_TryChangingFiltersOrSelectingA}"
                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}" FontSize="12" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- No separate bottom bar — action buttons live in the global status bar -->
                </Grid>

                </Border>
            </Grid>

        </Grid>

        <!-- Full-screen viewer overlay — covers entire view incl. toolbars -->
        <local:InlineArtworkViewer x:Name="GalleryFullViewer"
                                    Grid.Row="0" Grid.RowSpan="4"
                                    Margin="0,32,0,0"
                                    IsVisible="{Binding IsViewerExpanded}"
                                    IsExpanded="{Binding IsViewerExpanded}"
                                    IsPanelOpen="{Binding ShowPreview}"
                                    ZIndex="10"
                                    DataContext="{Binding}"/>

        <!-- ── Status bar ─────────────────────────────────────────────── -->
        <Border Grid.Row="3"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,9">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBlock Grid.Column="0" FontSize="11"
                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                           Text="{Binding StatusMessage}" VerticalAlignment="Center"/>

                <!-- Pagination controls at bottom -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,20,0">
                    <!-- Pagination Toggle -->
                    <ToggleButton IsChecked="{Binding UsePagination, Mode=TwoWay}"
                                  CornerRadius="8" Padding="8,4" FontSize="11"
                                  ToolTip.Tip="{loc:Tr Gallery_TogglePaginationOffShowAllOn}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📄" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Search_Pages}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Items per page selector (visible when pagination enabled) -->
                    <ComboBox IsVisible="{Binding UsePagination}"
                              SelectedItem="{Binding ItemsPerPage, Mode=TwoWay}"
                              ItemsSource="{Binding ItemsPerPageOptions}"
                              CornerRadius="8" Width="60" FontSize="11"
                              ToolTip.Tip="{loc:Tr Search_ItemsPerPage}"/>

                    <!-- Page navigation (visible when pagination enabled) -->
                    <StackPanel IsVisible="{Binding UsePagination}" Orientation="Horizontal" Spacing="4">
                        <!-- First page -->
                        <Button Command="{Binding FirstPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}"
                                CornerRadius="8" Padding="8,4" FontSize="11"
                                ToolTip.Tip="{loc:Tr Gallery_GoToFirstPage}">|←</Button>

                        <!-- Previous page -->
                        <Button Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}"
                                CornerRadius="8" Padding="8,4" FontSize="11"
                                ToolTip.Tip="{loc:Tr Viewer_PreviousPage}">←</Button>

                        <!-- Page input -->
                        <TextBox Text="{Binding CurrentPage, Mode=TwoWay}"
                                 Width="40"
                                 CornerRadius="8"
                                 FontSize="11"
                                 HorizontalContentAlignment="Center"
                                 VerticalAlignment="Center"
                                 ToolTip.Tip="{loc:Tr Gallery_EnterPageNumberAndPressEnter}"/>

                        <TextBlock Text="/" VerticalAlignment="Center" FontSize="11" Margin="2,0"/>
                        <TextBlock Text="{Binding TotalPages, StringFormat='{}{0}'}" VerticalAlignment="Center" FontSize="11" Margin="0,0,2,0"/>

                        <!-- Next page -->
                        <Button Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}"
                                CornerRadius="8" Padding="8,4" FontSize="11"
                                ToolTip.Tip="{loc:Tr Viewer_NextPage}">→</Button>

                        <!-- Last page -->
                        <Button Command="{Binding LastPageCommand}"
                                IsEnabled="{Binding CanGoNext}"
                                CornerRadius="8" Padding="8,4" FontSize="11"
                                ToolTip.Tip="{loc:Tr Gallery_GoToLastPage}">→|</Button>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                               Text="{Binding SelectedCount, StringFormat='{}{0} selected'}"
                               IsVisible="{Binding SelectedCount}"
                               VerticalAlignment="Center"/>
                    <Rectangle Width="1" Height="14" Fill="{DynamicResource Container1BorderBrush}"
                               IsVisible="{Binding SelectedArtist, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Content="{loc:Tr Gallery_SelectAll}" CornerRadius="8" Padding="8,4" FontSize="11"
                            Command="{Binding SelectAllCommand}"
                            IsVisible="{Binding SelectedArtist, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Content="{Binding SelectedCount, StringFormat='☒ Deselect All ({0})'}"
                            CornerRadius="8" Padding="8,4" FontSize="11"
                            Command="{Binding ClearSelectionCommand}"
                            IsVisible="{Binding SelectedCount}"/>
                    <Button Content="{loc:Tr Gallery_LoadAllIntoView}" CornerRadius="8" Padding="8,4" FontSize="11"
                            Command="{Binding LoadAllArtworksCommand}"
                            IsVisible="{Binding CanLoadMore}"
                            ToolTip.Tip="{loc:Tr Gallery_LoadEveryArtworkIntoTheGrid}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
