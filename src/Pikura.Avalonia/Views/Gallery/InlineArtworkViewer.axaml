<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pikura.Avalonia.Localization"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:ctrl="using:Pikura.Avalonia.Views.Controls"
             xmlns:anim="using:Pikura.Avalonia.Controls"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             xmlns:services="using:Pikura.Avalonia.Services"
             xmlns:local="using:Pikura.Avalonia.Views.Gallery"
             x:Class="Pikura.Avalonia.Views.Gallery.InlineArtworkViewer"
             x:DataType="vm:GalleryViewModel"
             x:Name="ViewerRoot"
             Background="{DynamicResource Container1BackgroundBrush}">

    <Grid Name="RootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- ── Tab strip ── -->
        <Border Grid.Row="0"
                Background="{DynamicResource Container1BackgroundBrush}"
                Padding="6,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Browse gallery alongside tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                    <Button x:Name="BrowsePanelButton"
                            CornerRadius="6" Padding="10,6" FontSize="12"
                            Click="OnBrowseButtonClicked"
                            ToolTip.Tip="{loc:Tr Viewer_HideOrShowTheSidePanel}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path x:Name="ShowPanelIcon" Data="{StaticResource ShowPanelIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" UseLayoutRounding="False"/>
                            <Path x:Name="HidePanelIcon" Data="{StaticResource HidePanelIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" UseLayoutRounding="False" IsVisible="False"/>
                            <TextBlock x:Name="ShowPanelLabel" Text="{loc:Tr Search_ShowPanel}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HidePanelLabel" Text="{loc:Tr Search_HidePanel}" FontSize="12" VerticalAlignment="Center" IsVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="10,6" FontSize="12"
                            Click="OnExpandButtonClicked"
                            ToolTip.Tip="{loc:Tr Viewer_ExpandToFullScreenRestoreSide}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource FullscreenEnterIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock x:Name="ExpandLabel" Text="{loc:Tr Viewer_Expand}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RestoreLabel" Text="{loc:Tr Viewer_Restore}" FontSize="12" VerticalAlignment="Center" IsVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="10,6" FontSize="12"
                            Classes="accent"
                            Click="OnFullscreen"
                            ToolTip.Tip="{loc:Tr Viewer_OpenInFullscreenWindowF11}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource FullscreenEnterIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Common_Fullscreen}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="10,6" FontSize="12"
                            Click="OnCloseAllClicked"
                            ToolTip.Tip="{loc:Tr Viewer_CloseAllTabs}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Data="{StaticResource CloseIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" UseLayoutRounding="False"/>
                            <TextBlock Text="{loc:Tr Viewer_CloseAll}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Scrollable tab list -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasTabs}">
                    <ItemsControl Name="TabStrip" ItemsSource="{Binding ViewerTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ViewerTab">
                                <Border Name="TabItem" CornerRadius="6"
                                        Background="{DynamicResource Container2BackgroundBrush}"
                                        BorderThickness="0"
                                        Padding="4,2"
                                        MinWidth="80" MaxWidth="200"
                                        RenderTransformOrigin="0.5,0.5"
                                        RenderTransform="scale(1)"
                                        PointerPressed="OnTabHeaderPressed">
                                    <Border.Transitions>
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                            <DoubleTransition Property="Opacity" Duration="0:0:0.15" Easing="CubicEaseOut"/>
                                        </Transitions>
                                    </Border.Transitions>
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="RenderTransform" Value="scale(1.05)"/>
                                        </Style>
                                        <Style Selector="Border.drag-over">
                                            <Setter Property="RenderTransform" Value="scale(1.08)"/>
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Style>
                                    </Border.Styles>
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="{Binding Header}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="150" Margin="10,5,6,5"/>
                                        <Button Name="TabCloseBtn" FontSize="9"
                                                Padding="4,2" Margin="0,3,4,3"
                                                CornerRadius="3" VerticalAlignment="Center"
                                                Click="OnTabCloseClick"
                                                ToolTip.Tip="{loc:Tr Viewer_CloseThisTab}">
                                            <Path Data="{StaticResource CloseIcon}" Width="10" Height="10"
                                              Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                              StrokeLineCap="Round"
                                              VerticalAlignment="Center" UseLayoutRounding="False"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Right: tab list picker + zoom label -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,4,0">
                    <Button Name="TabListBtn" Padding="9,5" CornerRadius="6"
                            ToolTip.Tip="{loc:Tr Viewer_AllOpenTabs}"
                            Click="OnTabListClick">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="HasMultipleTabs"/>
                                <Binding Path="!IsCollageGridVisible"/>
                            </MultiBinding>
                        </Button.IsVisible>
                        <PathIcon Data="{StaticResource HamburgerIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <TextBlock Name="ZoomLabel" FontSize="12"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Active artwork info row ── -->
        <Border Grid.Row="1"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,6"
                IsVisible="{Binding !IsCollageGridVisible}">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <SelectableTextBlock Text="{Binding InlineViewerCard.Title}"
                                         FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"
                                         MaxWidth="340"/>
                    <SelectableTextBlock Text="{Binding InlineViewerCard.UserName}"
                                         FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushSecondary}" VerticalAlignment="Center"
                                         Cursor="Hand"
                                         MaxWidth="160"
                                         ToolTip.Tip="{loc:Tr Viewer_ClickToCopyArtistID}"
                                         PointerPressed="OnArtistNamePressed"/>
                    <Button Name="FollowToggleBtn" CornerRadius="6" Padding="8,3" FontSize="12"
                            Click="OnFollowToggleClicked" VerticalAlignment="Center"
                            IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="{loc:Tr Viewer_FollowOrUnfollowThisArtist}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource PersonIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Name="FollowToggleLabel" Text="{loc:Tr Viewer_Follow}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Background="#7F374151" CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding InlineViewerCard.IsR18}">
                        <TextBlock Text="R-18" FontSize="10" Foreground="#FC8181" FontWeight="Bold"/>
                    </Border>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="4,0"
                               IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNotNull}}"/>

                    <ToggleButton Name="ShowStatsBtn" CornerRadius="6" Padding="6,3" FontSize="12"
                                  Click="OnShowStatsToggled" IsChecked="True"
                                  MinHeight="24" MinWidth="28"
                                  VerticalAlignment="Center"
                                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                  ToolTip.Tip="{loc:Tr Viewer_ShowHidePixivLikeBookmarkView}"
                                  IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <PathIcon Data="{StaticResource EyeIcon}" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding $parent[ToggleButton].Foreground}" />
                    </ToggleButton>
                    <StackPanel Name="StatsStackPanel" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center"
                                IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr Viewer_Likes}">
                            <PathIcon Data="{StaticResource HeartIcon}" Width="12" Height="12" VerticalAlignment="Center"
                                      Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                            <TextBlock Name="LikeCountLabel" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr Nav_Bookmarks}">
                            <PathIcon Data="{StaticResource BookmarkIcon}" Width="12" Height="12" VerticalAlignment="Center"
                                      Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                            <TextBlock Name="BookmarkCountLabel" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" ToolTip.Tip="{loc:Tr Viewer_Views}">
                            <PathIcon Data="{StaticResource EyeIcon}" Width="12" Height="12" VerticalAlignment="Center"
                                      Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                            <TextBlock Name="ViewCountLabel" FontSize="12" VerticalAlignment="Center"
                                       Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Name="ArtworkCounterLabel" FontSize="12"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                               VerticalAlignment="Center"/>
                    <TextBox Name="ArtworkJumpBox" Width="52" Height="28" Padding="6,3"
                             FontSize="12" TextAlignment="Center" VerticalContentAlignment="Center"
                             PlaceholderText="#" KeyDown="OnArtworkJumpKeyDown"
                             ToolTip.Tip="{loc:Tr Viewer_EnterAnArtworkPositionAndPress}"/>
                    <Button Name="FirstArtworkBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnFirstArtwork" ToolTip.Tip="{loc:Tr Viewer_FirstArtwork}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="-2">
                            <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="10" Height="10" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="10" Height="10" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                        </StackPanel>
                    </Button>
                    <Button Name="PrevArtworkBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnPrevArtwork" ToolTip.Tip="{loc:Tr Viewer_PreviousArtwork}">
                        <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button Name="NextArtworkBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnNextArtwork" ToolTip.Tip="{loc:Tr Viewer_NextArtwork}">
                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button Name="LastArtworkBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnLastArtwork" ToolTip.Tip="{loc:Tr Viewer_LastArtwork}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="-2">
                            <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Action bar (scrollable so it never clips) ── -->
        <Border Grid.Row="2"
                Background="{DynamicResource Container1BackgroundBrush}"
                Padding="8,5">
            <Grid ColumnDefinitions="*,Auto">
                <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False"
                              VerticalAlignment="Center"
                              IsVisible="{Binding !IsCollageGridVisible}">
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <!-- Zoom controls -->
                    <Button CornerRadius="6" Padding="9,5" FontSize="14"
                            Name="ZoomOutBtn" Click="OnZoomOut" ToolTip.Tip="{loc:Tr Viewer_ZoomOut}">
                        <PathIcon Data="{StaticResource MinusIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="ZoomFitBtn" Click="OnZoomFit" ToolTip.Tip="{loc:Tr Viewer_FitToWindow}">
                        <PathIcon Data="{StaticResource MaximizeIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="14"
                            Name="ZoomInBtn" Click="OnZoomIn" ToolTip.Tip="{loc:Tr Viewer_ZoomIn}">
                        <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- Page navigation (multi-page only) -->
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="PrevPageBtn" Click="OnPrevPage"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                            ToolTip.Tip="{loc:Tr Viewer_PreviousPage}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_Prev}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource Container1BackgroundBrush}"
                            CornerRadius="6" Padding="9,5"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}">
                        <TextBlock Name="PageIndicatorText" FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                    </Border>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="NextPageBtn" Click="OnNextPage"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                            ToolTip.Tip="{loc:Tr Viewer_NextPage}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Common_Next}" FontSize="12" VerticalAlignment="Center"/>
                            <PathIcon Data="{StaticResource ChevronRightIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- Downloads -->
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="DlPageBtn" Click="OnDownloadCurrentPage"
                            ToolTip.Tip="{loc:Tr Viewer_DownloadCurrentPage}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_Page}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Classes="accent" Name="DlAllBtn" Click="OnDownloadAllPages"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                            ToolTip.Tip="{loc:Tr Viewer_DownloadAllPages}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_AllPages}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="DlRangeBtn" Click="OnDownloadPageRange"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                            ToolTip.Tip="{loc:Tr Viewer_DownloadPageRange}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_Range}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="DlPresetBtn" Click="OnDownloadWithPreset"
                            ToolTip.Tip="{loc:Tr Search_DownloadWithImageProcessingPreset}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource PaletteIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_Preset}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="4,0"/>

                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="OpenPixivBtn" Click="OnOpenInPixiv"
                            ToolTip.Tip="{loc:Tr Viewer_OpenOnPixivNet}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource GlobeIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="Pixiv" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GoToArtistBtn"
                            CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnGoToArtist"
                            ToolTip.Tip="{loc:Tr Hoshi_OpenThisArtistSGallery}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource PersonIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_Artist}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnOpenPopup"
                            ToolTip.Tip="{loc:Tr Viewer_OpenInFloatingPopupWindow}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource PopupIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_Popup}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnCopyImage"
                            ToolTip.Tip="{loc:Tr Viewer_CopyThisImageToTheClipboard}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource CopyIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Common_Copy}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- ★ Local favorite toggle -->
                    <Button Name="LocalFavBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnToggleLocalFavorite"
                            ToolTip.Tip="{loc:Tr Viewer_AddRemoveFromLocalFavorites}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Name="LocalFavLabel" Text="{loc:Tr Viewer_Favorite}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- Pixiv Like -->
                    <Button Name="LikeBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnLikeClicked"
                            IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="{loc:Tr Viewer_LikeThisArtworkOnPixiv}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource HeartIcon}" Width="14" Height="14" VerticalAlignment="Center" Name="LikeBtnIcon" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Name="LikeBtnLabel" Text="{loc:Tr Viewer_Like}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Pixiv Bookmark -->
                    <SplitButton Name="BookmarkSplitBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                                 Click="OnBookmarkMainClicked"
                                 IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                                 ToolTip.Tip="{loc:Tr Viewer_MainClickAddsAPublicPixiv}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource BookmarkIcon}" Width="14" Height="14" VerticalAlignment="Center" Name="BookmarkBtnIcon"/>
                            <TextBlock Name="BookmarkBtnLabel" Text="{loc:Tr Viewer_Bookmark}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <SplitButton.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                <MenuItem Header="{loc:Tr Viewer_PublicBookmark}" Click="OnBookmarkPublicClicked" Name="BookmarkPublicMenuItem"
                                          ToolTip.Tip="{loc:Tr Viewer_AddAsAPublicPixivBookmark}"/>
                                <MenuItem Header="{loc:Tr Viewer_PrivateBookmark}" Click="OnBookmarkPrivateClicked" Name="BookmarkPrivateMenuItem"
                                          ToolTip.Tip="{loc:Tr Viewer_AddAsAPrivatePixivBookmark}"/>
                            </MenuFlyout>
                        </SplitButton.Flyout>
                    </SplitButton>

                    <!-- Comments -->
                    <Panel>
                        <Button Name="CommentsBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                                Click="OnCommentsClicked"
                                IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                                ToolTip.Tip="{loc:Tr Viewer_ViewAndPostComments}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource CommentIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                <TextBlock Name="CommentsBtnLabel" Text="{loc:Tr Viewer_Comments}" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Popup Name="CommentsPopup" PlacementTarget="{Binding #CommentsBtn}"
                               Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="True"
                               Width="380" MaxHeight="480" Closed="OnCommentsPopupClosed">
                            <Border Background="{DynamicResource Container1BackgroundBrush}"
                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Margin="0,4,0,0"
                                    BoxShadow="0 4 16 0 #55000000">
                                <Grid RowDefinitions="Auto,*,Auto" MaxHeight="480">
                                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="12,10,12,6">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr Viewer_Comments}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Grid.Column="1" Name="CommentsCountLabel" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="320"
                                                  Name="CommentsScrollViewer" ScrollChanged="OnCommentsScrollChanged">
                                        <StackPanel Name="CommentsListPanel" Spacing="10" Margin="12,0,12,8"/>
                                    </ScrollViewer>
                                    <StackPanel Grid.Row="1" Name="CommentsEmptyPanel" Spacing="8"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="12,30" IsVisible="False">
                                        <ProgressBar Name="CommentsLoadingBar" IsIndeterminate="True" Width="120" Height="3"/>
                                        <TextBlock Name="CommentsEmptyLabel" Text="{loc:Tr Viewer_LoadingComments}" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Spacing="4" Margin="12,8">
                                        <Grid Name="ReplyingToRow" ColumnDefinitions="*,Auto" IsVisible="False">
                                            <TextBlock Grid.Column="0" Name="ReplyingToLabel" FontSize="10"
                                                       Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                            <Button Grid.Column="1" Content="✕" FontSize="10" Padding="4,0"
                                                    Background="Transparent" BorderThickness="0"
                                                    Click="OnCancelReplyClicked" ToolTip.Tip="{loc:Tr Viewer_CancelReply}"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <Panel Grid.Column="0">
                                                <Button Name="StickerPickerBtn" Content="😊" FontSize="14"
                                                        CornerRadius="6" Padding="7,5" Click="OnStickerPickerClicked"
                                                        ToolTip.Tip="{loc:Tr Viewer_SendASticker}"/>
                                                <Popup Name="StickerPickerPopup" PlacementTarget="{Binding #StickerPickerBtn}"
                                                       Placement="Top" IsLightDismissEnabled="True"
                                                       Width="280" MaxHeight="280">
                                                    <Border Background="{DynamicResource Container1BackgroundBrush}"
                                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                                            BorderThickness="1" CornerRadius="8" Margin="0,0,0,4"
                                                            BoxShadow="0 4 16 0 #55000000">
                                                        <StackPanel>
                                                            <!-- Mirrors Pixiv's own Emoji/Stickers tabs — Emoji inserts a
                                                                 plain Unicode character into the comment text (click "Post"
                                                                 yourself after), Stickers sends immediately on click. -->
                                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="8,8,8,0">
                                                                <ToggleButton Name="EmojiTabBtn" Content="{loc:Tr Viewer_Emoji}" FontSize="11"
                                                                              Padding="8,3" CornerRadius="5" IsChecked="True"
                                                                              Click="OnEmojiTabClicked"/>
                                                                <ToggleButton Name="StickersTabBtn" Content="{loc:Tr Viewer_Stickers}" FontSize="11"
                                                                              Padding="8,3" CornerRadius="5"
                                                                              Click="OnStickersTabClicked"/>
                                                            </StackPanel>
                                                            <ScrollViewer Name="EmojiScrollViewer" MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                                                <WrapPanel Name="EmojiGrid" Margin="8"/>
                                                            </ScrollViewer>
                                                            <StackPanel Name="StickerLoadingPanel" Spacing="6"
                                                                        HorizontalAlignment="Center" Margin="12" IsVisible="False">
                                                                <ProgressBar IsIndeterminate="True" Width="100" Height="3"/>
                                                                <TextBlock Text="{loc:Tr Viewer_LoadingStickers}" FontSize="11"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                            </StackPanel>
                                                            <ScrollViewer Name="StickerScrollViewer" MaxHeight="240" VerticalScrollBarVisibility="Auto" IsVisible="False">
                                                                <WrapPanel Name="StickerGrid" Margin="8"/>
                                                            </ScrollViewer>
                                                        </StackPanel>
                                                    </Border>
                                                </Popup>
                                            </Panel>
                                            <TextBox Grid.Column="1" Name="NewCommentBox" FontSize="12"
                                                     PlaceholderText="{loc:Tr Viewer_AddAComment}" CornerRadius="6"
                                                     AcceptsReturn="False" KeyDown="OnNewCommentKeyDown"/>
                                            <Button Grid.Column="2" Content="{loc:Tr Viewer_Post}" CornerRadius="6" Padding="10,5"
                                                    FontSize="12" Classes="accent" Click="OnPostCommentClicked"
                                                    Name="PostCommentBtn"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Panel>

                    <!-- Collage mode is entered via a "View as Collage" button in each tab's own
                         multi-select toolbar (Gallery/Bookmarks/Collections/etc.) for 2–10
                         selected artworks — once IN it, this button exits back to normal tabs. -->
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnExitCollageClicked"
                            IsVisible="{Binding IsCollageGridVisible}"
                            ToolTip.Tip="{loc:Tr Viewer_ExitCollageView}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource CloseIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Collage_Exit}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Command="{Binding ReturnToCollageCommand}"
                            IsVisible="{Binding CanReturnToCollage}"
                            ToolTip.Tip="{loc:Tr Viewer_ReturnToTheStoredCollageView}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="⊞" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Tr Collage_Return}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Command="{Binding DownloadCollageCommand}"
                            IsVisible="{Binding IsCollageGridVisible}"
                            ToolTip.Tip="{loc:Tr Viewer_DownloadAllCollageArtworksIntoA}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Collage_Download}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- Hoshi AI assistant toggle -->
                    <Button Name="AiToggleBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnAiToggleClicked"
                            ToolTip.Tip="{loc:Tr Viewer_ToggleHoshiAIAssistant}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Name="AiToggleBtnLabel" Text="Hoshi" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <!-- Collage-only action bar: exit or download the whole collage. -->
            <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center" IsVisible="{Binding IsCollageGridVisible}">
                <Button CornerRadius="6" Padding="9,5" FontSize="12"
                        Click="OnExitCollageClicked"
                        ToolTip.Tip="{loc:Tr Viewer_CloseTheCollageTab}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource CloseIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                        <TextBlock Text="{loc:Tr Collage_Exit}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button CornerRadius="6" Padding="9,5" FontSize="12"
                        Command="{Binding DownloadCollageCommand}"
                        ToolTip.Tip="{loc:Tr Viewer_DownloadAllCollageArtworksIntoA}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource DownloadIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                        <TextBlock Text="{loc:Tr Collage_Download}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            </Grid>
        </Border>

        <!-- ── Zoomable image canvas ── -->
        <Border Grid.Row="3" ClipToBounds="True" Name="ImageCanvas"
                Background="{DynamicResource ImageCanvasBackgroundBrush}"
                BorderThickness="0"
                PointerWheelChanged="OnImageWheel"
                PointerPressed="OnImagePointerPressed"
                PointerMoved="OnImagePointerMoved"
                PointerReleased="OnImagePointerReleased"
                PointerCaptureLost="OnImagePointerCaptureLost"
                PointerExited="OnImagePointerExited">
            <Panel>
                <!-- No artwork selected placeholder -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                            IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="{loc:Tr Viewer_Preview}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource DefaultForegroundBrush}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="{loc:Tr Viewer_ClickAnImageToPreviewIt}" FontSize="13"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>

                <!-- Loading spinner -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Name="LoadingPanel" IsVisible="False">
                    <ProgressBar IsIndeterminate="True" Width="180"/>
                    <TextBlock Text="{loc:Tr Common_Loading_2}" Foreground="{DynamicResource DefaultForegroundBrushSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Load error panel (e.g. HTTP 429 rate limit) -->
                <StackPanel Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10" IsVisible="False">
                    <TextBlock Name="ErrorText" FontSize="13" TextAlignment="Center"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                    <Button Name="RetryBtn" Content="{loc:Tr Viewer_Retry}" HorizontalAlignment="Center"
                            CornerRadius="6" Padding="16,6" Click="OnRetryLoad"/>
                </StackPanel>

                <!-- The actual image, transformed by code-behind -->
                <Image Name="ViewerImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="16"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.ContextMenu>
                        <ContextMenu Opening="OnImageContextMenuOpening">
                            <MenuItem Name="CtxDlPage" Click="OnDownloadCurrentPage">
                                <MenuItem.Header>
                                    <TextBlock Name="CtxDlPageHeader" Text="{loc:Tr Viewer_DownloadThisPage}"/>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Name="CtxDlAll" Click="OnDownloadAllPages">
                                <MenuItem.Header>
                                    <TextBlock Name="CtxDlAllHeader" Text="{loc:Tr Viewer_DownloadAllPages_2}"/>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Name="CtxDlRange" Click="OnDownloadPageRange">
                                <MenuItem.Header>
                                    <TextBlock Name="CtxDlRangeHeader" Text="{loc:Tr Viewer_DownloadPageRange_2}"/>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="{loc:Tr Viewer_FullscreenF11}" Click="OnFullscreen"/>
                            <MenuItem Header="{loc:Tr Viewer_OpenInPopupWindow}" Click="OnOpenPopup"/>
                            <MenuItem Header="{loc:Tr Viewer_OpenArtworkOnPixiv}" Click="OnOpenInPixiv"/>
                            <Separator/>
                            <MenuItem x:Name="GoToArtistMenuItem"
                                      Header="{loc:Tr Viewer_GoToArtistSGallery}" Click="OnGoToArtist"/>
                            <MenuItem Header="{loc:Tr Viewer_OpenArtistOnPixiv}" Click="OnOpenArtistInPixiv"/>
                            <Separator/>
                            <MenuItem Header="{loc:Tr Search_CopyArtworkID}" Click="OnCopyId"/>
                            <MenuItem Header="{loc:Tr Search_CopyArtistID}" Click="OnCopyArtistId"/>
                            <MenuItem Header="{loc:Tr Search_CopyImage}" Click="OnCopyImage"/>
                            <MenuItem Header="{loc:Tr Search_UseAsAppBackground}" Click="OnUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                            <MenuItem Header="{loc:Tr Viewer_ResetZoom}" Click="OnZoomFit"/>
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>

                <!-- Animated image (ugoira) — same transforms, toggled in code-behind -->
                <anim:AnimatedImage x:Name="UgoiraImage"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Margin="16"
                                    RenderTransformOrigin="0.5,0.5"
                                    IsVisible="False">
                    <anim:AnimatedImage.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </anim:AnimatedImage.RenderTransform>
                </anim:AnimatedImage>

                <!-- ── All-pages grid overlay (inline) ── -->
                <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="#E6000000" Padding="40"
                        IsVisible="{Binding IsInlinePageGridVisible}"
                        ZIndex="10">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock Text="{loc:Tr Viewer_AllPages}"
                                       FontSize="16"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    FontSize="14"
                                    Padding="8,4"
                                    CornerRadius="4"
                                    Click="OnToggleInlinePageGrid"
                                    Background="{DynamicResource Container2BackgroundBrush}"
                                    Foreground="White"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding InlinePageList}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <local:MasonryPanel ColumnWidth="540" ItemSpacing="16" PreserveOrder="True"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PageThumbnailItem">
                                        <Button Margin="8" Padding="0" Background="Transparent"
                                                Click="OnInlinePageGridItemClick">
                                            <Border CornerRadius="10"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource Container1BackgroundBrush}">
                                                <Grid RowDefinitions="Auto,Auto">
                                                    <Image Grid.Row="0"
                                                           Source="{Binding Thumbnail}"
                                                           Stretch="Uniform"
                                                           Width="540"
                                                           Height="{Binding AspectRatio, Converter={x:Static conv:AspectRatioToHeightConverter.Instance}, ConverterParameter=540}"
                                                           RenderOptions.BitmapInterpolationMode="HighQuality"
                                                           UseLayoutRounding="True"/>
                                                    <Border Grid.Row="1"
                                                            Background="#CC000000"
                                                            Padding="8,5">
                                                        <TextBlock Text="{Binding Number}"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="White"
                                                                   FontSize="12"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ── Page strip for multi-page artworks ── -->
                <Border Name="PageStrip" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                        Background="#CC000000" Padding="8,4"
                        IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                        ZIndex="20">
                    <Grid ColumnDefinitions="*,Auto">
                        <ScrollViewer Grid.Column="0"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding InlinePageList}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PageThumbnailItem">
                                        <Button Content="{Binding Number}" CornerRadius="4" Padding="8,4" FontSize="11"
                                                Click="OnPageStripItemClick"
                                                Background="{DynamicResource Container2BackgroundBrush}"
                                                Foreground="White"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Button Grid.Column="1"
                                Content="{loc:Tr Search_All}"
                                CornerRadius="4" Padding="10,4" FontSize="11" Margin="8,0,0,0"
                                Click="OnToggleInlinePageGrid"
                                Background="{DynamicResource Container2BackgroundBrush}"
                                Foreground="White"
                                ToolTip.Tip="{loc:Tr Viewer_ShowAllPages}"/>
                    </Grid>
                </Border>

                <!-- ── Collage overlay — every image in the current tab's nav list, tiled.
                     Populated in code-behind (ItemsSource set manually) rather than a compiled
                     binding, since it needs to reflect whichever tab/nav-list is active and
                     refresh on toggle without a dedicated ViewModel property. Clicking a tile
                     shows that image in-place inside the same collage tab; the grid is only
                     visible when the user is not currently viewing a single collage item. -->
                <Border Name="CollagePanel" IsVisible="{Binding IsCollageGridVisible}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        Background="{DynamicResource Container1BackgroundBrush}">
                    <Panel>
                    <ScrollViewer Name="CollageScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  AllowAutoHide="False"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                  PointerWheelChanged="OnCollageWheel"
                                  PointerPressed="OnCollagePanPressed"
                                  PointerMoved="OnCollagePanMoved"
                                  PointerReleased="OnCollagePanReleased"
                                  PointerCaptureLost="OnCollagePanCaptureLost">
                        <!-- Natural-height masonry, like a traditional photo collage — each tile
                             keeps its own aspect ratio instead of being cropped to a fixed square. -->
                        <ItemsControl Name="CollageGrid" Margin="10" Padding="0,0,0,24"
                                      HorizontalAlignment="Left" VerticalAlignment="Top"
                                      ItemsSource="{Binding CollageItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <local:MasonryPanel ColumnWidth="{Binding CollageGridColumnWidth, FallbackValue=200}" ItemSpacing="12" PreserveOrder="True"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtworkCardViewModel">
                                    <Border CornerRadius="8" ClipToBounds="True" Cursor="Hand"
                                            Background="{DynamicResource Container2BackgroundBrush}"
                                            PointerReleased="OnCollageTileReleased">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:Tr Viewer_ExpandIntoPageTiles}" IsVisible="{Binding IsMultiPage}"
                                                          Command="{Binding #ViewerRoot.DataContext.ExpandCollageItemCommand}"
                                                          CommandParameter="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <Grid RowDefinitions="Auto,Auto">
                                            <Grid Grid.Row="0">
                                                <Image Source="{Binding Thumbnail}" Stretch="Uniform"
                                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality" UseLayoutRounding="True">
                                                    <Image.Width>
                                                        <Binding Path="ColumnWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType=local:MasonryPanel}" FallbackValue="200"/>
                                                    </Image.Width>
                                                    <Image.Height>
                                                        <MultiBinding Converter="{x:Static conv:MultiplyByAspectRatioConverter.Instance}">
                                                            <Binding Path="ColumnWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType=local:MasonryPanel}" FallbackValue="200"/>
                                                            <Binding Path="ClampedAspectRatio"/>
                                                        </MultiBinding>
                                                    </Image.Height>
                                                </Image>
                                                <Button Content="×" FontSize="14" Padding="4,0" CornerRadius="12"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4"
                                                        Background="#CC000000" Foreground="White" BorderThickness="0"
                                                        Click="OnRemoveCollageItemClicked"
                                                        Tapped="OnRemoveCollageItemTapped"
                                                        ToolTip.Tip="{loc:Tr Viewer_RemoveFromCollage}"/>
                                                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4"
                                                        Background="#CC000000" CornerRadius="4" Padding="4,2"
                                                        IsVisible="{Binding IsMultiPage}">
                                                    <TextBlock Text="{Binding PageCountText}" FontSize="10" Foreground="White" FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>
                                            <Border Grid.Row="1" Background="#CC000000" Padding="6,4"
                                                    IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{Binding Title}" FontSize="10" Foreground="White"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </Panel>
                </Border>

            </Panel>
        </Border>

        <!-- ── Hoshi AI panel (collapsible) ── -->
        <Border Grid.Row="5" Name="AiPanel"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*"
                      Background="{DynamicResource Container2BackgroundBrush}"
                      Margin="0,0,0,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="10,5,0,5">
                        <TextBlock Text="{loc:Tr Viewer_Hoshi}" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Name="AiStatusLabel" FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                   VerticalAlignment="Center"/>
                        <Button Content="{loc:Tr Viewer_FullView}" Name="AiFullViewBtn" Click="OnAiFullViewClicked"
                                CornerRadius="4" Padding="7,3" FontSize="10"
                                ToolTip.Tip="{loc:Tr Viewer_ContinueThisChatInTheFull}"/>
                    </StackPanel>
                    <!-- Quick action buttons — wraps to a second line rather than clipping
                         when the inline viewer is narrow. -->
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <WrapPanel.Styles>
                            <Style Selector="Button, SplitButton">
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="Padding" Value="7,3"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Margin" Value="0,4,4,4"/>
                            </Style>
                        </WrapPanel.Styles>
                        <!-- Single-page submissions get a plain button; the "all pages" dropdown
                             only appears once a multi-page submission is actually detected
                             (toggled in code-behind — this control's DataContext is
                             GalleryViewModel, not AiViewModel, so it can't bind directly). -->
                        <Button Content="{loc:Tr Hoshi_Describe}" Name="AiDescribeBtn" Click="OnAiDescribeClicked"
                                ToolTip.Tip="{loc:Tr Viewer_DescribeThisImage}"/>
                        <SplitButton Content="{loc:Tr Hoshi_Describe}" Name="AiDescribeSplitBtn" Click="OnAiDescribeClicked"
                                IsVisible="False"
                                ToolTip.Tip="{loc:Tr Viewer_DescribeThisImageUseTheArrow}">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="{loc:Tr Hoshi_DescribeCurrentPage}" Click="OnAiDescribeClicked"/>
                                    <MenuItem Header="{loc:Tr Hoshi_DescribeAllPages}" Click="OnAiAllPagesClicked"
                                              ToolTip.Tip="{loc:Tr Hoshi_DescribesEveryPageOfAMulti}"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Content="{loc:Tr Hoshi_Tags}" Name="AiTagsBtn" Click="OnAiTagsClicked"
                                ToolTip.Tip="{loc:Tr Viewer_SuggestTags}"/>
                        <Button Content="{loc:Tr Viewer_SimilarArt}" Name="AiSimilarArtBtn" Click="OnAiSimilarArtClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_RecommendArtworksSimilarToThisImage}"/>
                        <Button Content="{loc:Tr Hoshi_SimilarArtists}" Name="AiSimilarArtistsBtn" Click="OnAiSimilarArtistsClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_RecommendArtistsWithASimilarStyle}"/>
                        <Button Content="{loc:Tr Hoshi_Fav}" Name="AiFavBtn" Click="OnAiFavClicked"
                                ToolTip.Tip="{loc:Tr Viewer_AddToLocalFavorites}"/>
                        <Button Content="{loc:Tr Hoshi_DL}" Name="AiDlBtn" Click="OnAiDlClicked"
                                ToolTip.Tip="{loc:Tr Viewer_DownloadThisArtwork}"/>
                        <Button Content="{loc:Tr Viewer_Clear}" Name="AiClearBtn" Click="OnAiClearClicked" Margin="0,4,8,4"
                                ToolTip.Tip="{loc:Tr Viewer_ClearChatHistory}"/>
                    </WrapPanel>
                </Grid>

                <!-- Message list -->
                <ScrollViewer Grid.Row="1" Name="AiScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <ItemsControl Name="AiMessagesList" Margin="8,6,8,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiChatMessage">
                                <Panel>
                                    <!-- User bubble -->
                                    <Border IsVisible="{Binding IsUser}"
                                            Background="#3356A0DB"
                                            CornerRadius="10,10,2,10"
                                            Padding="10,7" Margin="50,0,0,0"
                                            HorizontalAlignment="Right"
                                            MaxWidth="340">
                                        <ctrl:LinkTextBlock LinkText="{Binding Content}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                    </Border>
                                    <!-- Assistant bubble -->
                                    <Border IsVisible="{Binding IsAssistant}"
                                            Background="{DynamicResource Container2BackgroundBrush}"
                                            CornerRadius="10,10,10,2"
                                            Padding="10,7" Margin="0,0,50,0"
                                            HorizontalAlignment="Left"
                                            MaxWidth="380">
                                        <StackPanel Spacing="6">
                                            <ctrl:LinkTextBlock LinkText="{Binding Content}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding HasAnyAction}">
                                                <Button Content="{loc:Tr Hoshi_ViewArtwork}" Padding="5,2" FontSize="10" CornerRadius="4"
                                                        IsVisible="{Binding HasArtworkAction}"
                                                        Click="OnOpenArtworkFromChat"
                                                        Tag="{Binding ArtworkId}"
                                                        ToolTip.Tip="{loc:Tr Rankings_OpenThisArtworkInANew}"/>
                                                <Button Content="{loc:Tr Hoshi_Gallery}" Padding="5,2" FontSize="10" CornerRadius="4"
                                                        IsVisible="{Binding HasArtistAction}"
                                                        Click="OnOpenArtistFromChat"
                                                        Tag="{Binding ArtistId}"
                                                        ToolTip.Tip="{loc:Tr Hoshi_OpenThisArtistSGallery}"/>
                                                <Button Content="{loc:Tr Hoshi_OpenURL}" Padding="5,2" FontSize="10" CornerRadius="4"
                                                        IsVisible="{Binding HasUrlAction}"
                                                        Click="OnOpenUrlFromChat"
                                                        Tag="{Binding PixivUrl}"
                                                        ToolTip.Tip="{loc:Tr Hoshi_OpenThisPixivPageInYour}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- System note -->
                                    <Border IsVisible="{Binding IsSystem}"
                                            Padding="4,2" HorizontalAlignment="Center">
                                        <ctrl:LinkTextBlock LinkText="{Binding Content}" FontSize="10"
                                                   TextWrapping="Wrap" FontStyle="Italic"
                                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- "Hoshi is thinking…" indicator — this control's DataContext is
                         GalleryViewModel, not AiViewModel, so IsVisible is toggled in
                         code-behind (see UpdateThinkingIndicator) instead of a direct binding. -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,8" Name="AiThinkingIndicator" IsVisible="False">
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                CornerRadius="12" Padding="12,6"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#10022;" FontSize="10" VerticalAlignment="Center"
                                           Foreground="#FFD6BAFF">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="50%">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <TextBlock Text="{loc:Tr Hoshi_HoshiIsThinking}" FontSize="12"
                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                           FontStyle="Italic" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>

                <!-- Input row -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="8,4,8,8">
                    <TextBox Grid.Column="0" Name="AiInputBox"
                             PlaceholderText="{loc:Tr Viewer_AskHoshiAnythingDescribeSuggestTags}"
                             FontSize="12" CornerRadius="6,0,0,6"
                             KeyDown="OnAiInputKeyDown"/>
                    <Button Grid.Column="1" Content="{loc:Tr Hoshi_Send}" Name="AiSendBtn"
                            CornerRadius="0,6,6,0" Padding="12,0" FontSize="12"
                            Click="OnAiSendClicked"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Info strip with clickable tags ── -->
        <Border Grid.Row="4"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding InlineViewerCard.TypeLabel}"
                           FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushSecondary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushSecondary}" VerticalAlignment="Center"
                           Text="{Binding InlineViewerCard.PageCount, StringFormat='{}{0} pages'}"
                           IsVisible="{Binding InlineViewerCard.IsMultiPage}" Margin="0,0,16,0"/>
                <!-- Clickable tag chips -->
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <ItemsControl Name="TagsItemsControl"
                                  ItemsSource="{Binding InlineViewerCard.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Classes="badge"
                                        Cursor="Hand"
                                        PointerPressed="OnTagPressed">
                                    <Border.Styles>
                                        <Style Selector="Border.badge:pointerover">
                                            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSoftAccent}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSoftAccentPressed}"/>
                                        </Style>
                                        <Style Selector="Border.badge:pointerover TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrushOutlineAccent}"/>
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Style>
                                    </Border.Styles>
                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Column="3" FontSize="10" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                           Text="{loc:Tr Viewer_ClickTagFilterShiftClickSearch}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
