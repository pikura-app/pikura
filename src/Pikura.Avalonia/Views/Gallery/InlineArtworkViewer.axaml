<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:ctrl="using:Pikura.Avalonia.Views.Controls"
             xmlns:anim="using:Pikura.Avalonia.Controls"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             xmlns:services="using:Pikura.Avalonia.Services"
             x:Class="Pikura.Avalonia.Views.Gallery.InlineArtworkViewer"
             x:DataType="vm:GalleryViewModel"
             x:Name="ViewerRoot"
             Background="{actipro:ThemeResource Container3BackgroundBrush}">

    <Grid Name="RootGrid" RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">

        <!-- ── Tab strip ── -->
        <Border Grid.Row="0"
                Background="{actipro:ThemeResource Container1BackgroundBrush}"
                BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="6,4">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- Browse gallery alongside tabs -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
                    <Button x:Name="BrowsePanelButton"
                            CornerRadius="6" Padding="10,6" FontSize="12"
                            Click="OnBrowseButtonClicked"
                            ToolTip.Tip="Hide or show the side panel">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path x:Name="ShowPanelIcon" Data="{StaticResource ShowPanelIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{actipro:ThemeResource DefaultForegroundBrush}" StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" UseLayoutRounding="False"/>
                            <Path x:Name="HidePanelIcon" Data="{StaticResource HidePanelIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{actipro:ThemeResource DefaultForegroundBrush}" StrokeThickness="1.5"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" UseLayoutRounding="False" IsVisible="False"/>
                            <TextBlock x:Name="ShowPanelLabel" Text="Show Panel" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HidePanelLabel" Text="Hide Panel" FontSize="12" VerticalAlignment="Center" IsVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="10,6" FontSize="12"
                            Click="OnExpandButtonClicked"
                            ToolTip.Tip="Expand to full screen / restore side panel">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource FullscreenEnterIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ExpandLabel" Text="Expand" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RestoreLabel" Text="Restore" FontSize="12" VerticalAlignment="Center" IsVisible="False"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="10,6" FontSize="12"
                            Classes="accent"
                            Click="OnFullscreen"
                            ToolTip.Tip="Open in fullscreen window (F11)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <PathIcon Data="{StaticResource FullscreenEnterIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Fullscreen" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="10,6" FontSize="12"
                            Click="OnCloseAllClicked"
                            ToolTip.Tip="Close all tabs">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Path Data="{StaticResource CloseIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{actipro:ThemeResource DefaultForegroundBrush}" StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" UseLayoutRounding="False"/>
                            <TextBlock Text="Close all" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Scrollable tab list -->
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl Name="TabStrip" ItemsSource="{Binding ViewerTabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="2"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ViewerTab">
                                <Border Name="TabItem" CornerRadius="6,6,0,0"
                                        Background="{actipro:ThemeResource Container2BackgroundBrush}"
                                        BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                                        BorderThickness="1,1,1,0"
                                        MinWidth="80" MaxWidth="200"
                                        PointerPressed="OnTabPointerPressed">
                                    <StackPanel Orientation="Horizontal" Spacing="0">
                                        <TextBlock Text="{Binding Header}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="150" Margin="10,5,6,5"/>
                                        <Button Name="TabCloseBtn" FontSize="9"
                                                Padding="4,2" Margin="0,3,4,3"
                                                CornerRadius="3" VerticalAlignment="Center"
                                                Click="OnTabCloseClick"
                                                ToolTip.Tip="Close this tab">
                                            <Path Data="{StaticResource CloseIcon}" Width="10" Height="10"
                                              Stretch="Uniform" Stroke="{actipro:ThemeResource DefaultForegroundBrush}" StrokeThickness="2"
                                              StrokeLineCap="Round"
                                              VerticalAlignment="Center" UseLayoutRounding="False"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Right: tab list picker + zoom label -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="6,0,4,0">
                    <Button Name="TabListBtn" Padding="9,5" CornerRadius="6"
                            ToolTip.Tip="All open tabs"
                            Click="OnTabListClick"
                            IsVisible="{Binding HasMultipleTabs}">
                        <PathIcon Data="{StaticResource HamburgerIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                    </Button>
                    <TextBlock Name="ZoomLabel" FontSize="12"
                               Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Active artwork info row ── -->
        <Border Grid.Row="1"
                Background="{actipro:ThemeResource Container1BackgroundBrush}"
                BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="10,6">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <SelectableTextBlock Text="{Binding InlineViewerCard.Title}"
                                         FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"
                                         TextTrimming="CharacterEllipsis"/>
                    <SelectableTextBlock Text="{Binding InlineViewerCard.UserName}"
                                         FontSize="12" Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"
                                         Cursor="Hand"
                                         ToolTip.Tip="Click to copy artist ID"
                                         PointerPressed="OnArtistNamePressed"/>
                    <Button Name="FollowToggleBtn" CornerRadius="6" Padding="8,3" FontSize="12"
                            Click="OnFollowToggleClicked" VerticalAlignment="Center"
                            IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Follow or unfollow this artist"/>
                    <Border Background="#7F374151" CornerRadius="4" Padding="6,2"
                            IsVisible="{Binding InlineViewerCard.IsR18}">
                        <TextBlock Text="R-18" FontSize="10" Foreground="#FC8181" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Name="ArtworkCounterLabel" FontSize="12"
                               Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                               VerticalAlignment="Center"/>
                    <TextBox Name="ArtworkJumpBox" Width="52" Height="28" Padding="6,3"
                             FontSize="12" TextAlignment="Center" VerticalContentAlignment="Center"
                             PlaceholderText="#" KeyDown="OnArtworkJumpKeyDown"
                             ToolTip.Tip="Enter an artwork position and press Enter"/>
                    <Button Name="FirstArtworkBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnFirstArtwork" ToolTip.Tip="First artwork">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="-2">
                            <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="10" Height="10" VerticalAlignment="Center"/>
                            <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="10" Height="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Name="PrevArtworkBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnPrevArtwork" ToolTip.Tip="Previous artwork">
                        <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                    </Button>
                    <Button Name="NextArtworkBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnNextArtwork" ToolTip.Tip="Next artwork">
                        <PathIcon Data="{StaticResource ChevronRightIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                    </Button>
                    <Button Name="LastArtworkBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnLastArtwork" ToolTip.Tip="Last artwork">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="-2">
                            <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" VerticalAlignment="Center"/>
                            <PathIcon Data="{StaticResource ChevronRightIcon}" Width="10" Height="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Action bar (scrollable so it never clips) ── -->
        <Border Grid.Row="2"
                Background="{actipro:ThemeResource Container2BackgroundBrush}"
                BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <!-- Zoom controls -->
                    <Button CornerRadius="6" Padding="9,5" FontSize="14"
                            Name="ZoomOutBtn" Click="OnZoomOut" ToolTip.Tip="Zoom out">
                        <PathIcon Data="{StaticResource MinusIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="ZoomFitBtn" Click="OnZoomFit" ToolTip.Tip="Fit to window">
                        <PathIcon Data="{StaticResource MaximizeIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="14"
                            Name="ZoomInBtn" Click="OnZoomIn" ToolTip.Tip="Zoom in">
                        <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{actipro:ThemeResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- Page navigation (multi-page only) -->
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="PrevPageBtn" Click="OnPrevPage"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                            ToolTip.Tip="Previous page">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Prev" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{actipro:ThemeResource Container1BackgroundBrush}"
                            CornerRadius="6" Padding="9,5"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}">
                        <TextBlock Name="PageIndicatorText" FontSize="12" Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"/>
                    </Border>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="NextPageBtn" Click="OnNextPage"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                            ToolTip.Tip="Next page">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Next" FontSize="12" VerticalAlignment="Center"/>
                            <PathIcon Data="{StaticResource ChevronRightIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{actipro:ThemeResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- Downloads -->
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="DlPageBtn" Click="OnDownloadCurrentPage"
                            ToolTip.Tip="Download current page">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Page" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Classes="accent" Name="DlAllBtn" Click="OnDownloadAllPages"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                            ToolTip.Tip="Download all pages">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="All pages" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="DlRangeBtn" Click="OnDownloadPageRange"
                            IsVisible="{Binding InlineViewerCard.IsMultiPage}"
                            ToolTip.Tip="Download page range">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Range…" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="DlPresetBtn" Click="OnDownloadWithPreset"
                            ToolTip.Tip="Download with image processing preset">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource PaletteIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Preset" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{actipro:ThemeResource Container1BorderBrush}" Margin="4,0"/>

                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Name="OpenPixivBtn" Click="OnOpenInPixiv"
                            ToolTip.Tip="Open on pixiv.net">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource GlobeIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Pixiv" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="GoToArtistBtn"
                            CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnGoToArtist"
                            ToolTip.Tip="Open this artist's gallery">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource PersonIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Artist" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnOpenPopup"
                            ToolTip.Tip="Open in floating popup window">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource PopupIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Popup" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnCopyImage"
                            ToolTip.Tip="Copy this image to the clipboard">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource CopyIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Copy" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{actipro:ThemeResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- ★ Local favorite toggle -->
                    <Button Name="LocalFavBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnToggleLocalFavorite"
                            ToolTip.Tip="Add / remove from local favorites">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource StarIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Name="LocalFavLabel" Text="Favorite" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Rectangle Width="1" Height="16" Fill="{actipro:ThemeResource Container1BorderBrush}" Margin="4,0"/>

                    <!-- Hoshi AI assistant toggle -->
                    <Button Name="AiToggleBtn" CornerRadius="6" Padding="9,5" FontSize="12"
                            Click="OnAiToggleClicked"
                            ToolTip.Tip="Toggle Hoshi (星) — AI assistant">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <PathIcon Data="{StaticResource NewIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Name="AiToggleBtnLabel" Text="Hoshi" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── Zoomable image canvas ── -->
        <Border Grid.Row="3" ClipToBounds="True" Name="ImageCanvas"
                Background="{actipro:ThemeResource Container3BackgroundBrush}"
                Margin="10,8" CornerRadius="12"
                PointerWheelChanged="OnImageWheel"
                PointerPressed="OnImagePointerPressed"
                PointerMoved="OnImagePointerMoved"
                PointerReleased="OnImagePointerReleased">
            <Panel>
                <!-- No artwork selected placeholder -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                            IsVisible="{Binding InlineViewerCard, Converter={x:Static ObjectConverters.IsNull}}">
                    <TextBlock Text="Click an image to preview it here" FontSize="13"
                               Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                </StackPanel>

                <!-- Loading spinner -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12"
                            Name="LoadingPanel" IsVisible="False">
                    <ProgressBar IsIndeterminate="True" Width="180"/>
                    <TextBlock Text="Loading…" Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Load error panel (e.g. HTTP 429 rate limit) -->
                <StackPanel Name="ErrorPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="10" IsVisible="False">
                    <TextBlock Name="ErrorText" FontSize="13" TextAlignment="Center"
                               Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                    <Button Name="RetryBtn" Content="↺ Retry" HorizontalAlignment="Center"
                            CornerRadius="6" Padding="16,6" Click="OnRetryLoad"/>
                </StackPanel>

                <!-- The actual image, transformed by code-behind -->
                <Image Name="ViewerImage"
                       Stretch="Uniform"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </Image.RenderTransform>
                    <Image.ContextMenu>
                        <ContextMenu Opening="OnImageContextMenuOpening">
                            <MenuItem Name="CtxDlPage" Click="OnDownloadCurrentPage">
                                <MenuItem.Header>
                                    <TextBlock Name="CtxDlPageHeader" Text="↓ Download this page"/>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Name="CtxDlAll" Click="OnDownloadAllPages">
                                <MenuItem.Header>
                                    <TextBlock Name="CtxDlAllHeader" Text="↓ Download all pages"/>
                                </MenuItem.Header>
                            </MenuItem>
                            <MenuItem Name="CtxDlRange" Click="OnDownloadPageRange">
                                <MenuItem.Header>
                                    <TextBlock Name="CtxDlRangeHeader" Text="↓ Download page range…"/>
                                </MenuItem.Header>
                            </MenuItem>
                            <Separator/>
                            <MenuItem Header="&#9974; Fullscreen (F11)" Click="OnFullscreen"/>
                            <MenuItem Header="Open in popup window" Click="OnOpenPopup"/>
                            <MenuItem Header="🌐 Open artwork on Pixiv" Click="OnOpenInPixiv"/>
                            <Separator/>
                            <MenuItem x:Name="GoToArtistMenuItem"
                                      Header="👤 Go to artist's gallery" Click="OnGoToArtist"/>
                            <MenuItem Header="🌐 Open artist on Pixiv" Click="OnOpenArtistInPixiv"/>
                            <Separator/>
                            <MenuItem Header="Copy artwork ID" Click="OnCopyId"/>
                            <MenuItem Header="Copy artist ID" Click="OnCopyArtistId"/>
                            <MenuItem Header="📋 Copy image" Click="OnCopyImage"/>
                            <MenuItem Header="🖼 Use as app background" Click="OnUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
                            <MenuItem Header="Reset zoom" Click="OnZoomFit"/>
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>

                <!-- Animated image (ugoira) — same transforms, toggled in code-behind -->
                <anim:AnimatedImage x:Name="UgoiraImage"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5"
                                    IsVisible="False">
                    <anim:AnimatedImage.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                            <TranslateTransform X="0" Y="0"/>
                        </TransformGroup>
                    </anim:AnimatedImage.RenderTransform>
                </anim:AnimatedImage>
            </Panel>
        </Border>

        <!-- ── Hoshi AI panel (collapsible) ── -->
        <Border Grid.Row="5" Name="AiPanel"
                Background="{actipro:ThemeResource Container1BackgroundBrush}"
                BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                BorderThickness="0,1,0,0"
                IsVisible="False">
            <Grid RowDefinitions="Auto,*,Auto">

                <!-- Header -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*"
                      Background="{actipro:ThemeResource Container2BackgroundBrush}"
                      Margin="0,0,0,0">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                VerticalAlignment="Center" Margin="10,5,0,5">
                        <TextBlock Text="✦ Hoshi 星" FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Name="AiStatusLabel" FontSize="10"
                                   Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                                   VerticalAlignment="Center"/>
                        <Button Content="⤢ Full View" Name="AiFullViewBtn" Click="OnAiFullViewClicked"
                                CornerRadius="4" Padding="7,3" FontSize="10"
                                ToolTip.Tip="Continue this chat in the full Hoshi tab"/>
                    </StackPanel>
                    <!-- Quick action buttons — wraps to a second line rather than clipping
                         when the inline viewer is narrow. -->
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                        <WrapPanel.Styles>
                            <Style Selector="Button, SplitButton">
                                <Setter Property="CornerRadius" Value="4"/>
                                <Setter Property="Padding" Value="7,3"/>
                                <Setter Property="FontSize" Value="10"/>
                                <Setter Property="Margin" Value="0,4,4,4"/>
                            </Style>
                        </WrapPanel.Styles>
                        <!-- Single-page submissions get a plain button; the "all pages" dropdown
                             only appears once a multi-page submission is actually detected
                             (toggled in code-behind — this control's DataContext is
                             GalleryViewModel, not AiViewModel, so it can't bind directly). -->
                        <Button Content="👁 Describe" Name="AiDescribeBtn" Click="OnAiDescribeClicked"
                                ToolTip.Tip="Describe this image"/>
                        <SplitButton Content="👁 Describe" Name="AiDescribeSplitBtn" Click="OnAiDescribeClicked"
                                IsVisible="False"
                                ToolTip.Tip="Describe this image. Use the arrow to describe all pages.">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="👁 Describe current page" Click="OnAiDescribeClicked"/>
                                    <MenuItem Header="📚 Describe all pages" Click="OnAiAllPagesClicked"
                                              ToolTip.Tip="Describes every page of a multi-page submission, not just the one you're viewing"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Content="🏷 Tags" Name="AiTagsBtn" Click="OnAiTagsClicked"
                                ToolTip.Tip="Suggest tags"/>
                        <Button Content="🖼 Similar Art" Name="AiSimilarArtBtn" Click="OnAiSimilarArtClicked"
                                ToolTip.Tip="Recommend artworks similar to this image"/>
                        <Button Content="🧑‍🎨 Similar Artists" Name="AiSimilarArtistsBtn" Click="OnAiSimilarArtistsClicked"
                                ToolTip.Tip="Recommend artists with a similar style"/>
                        <Button Content="⭐ Fav" Name="AiFavBtn" Click="OnAiFavClicked"
                                ToolTip.Tip="Add to local favorites"/>
                        <Button Content="↓ DL" Name="AiDlBtn" Click="OnAiDlClicked"
                                ToolTip.Tip="Download this artwork"/>
                        <Button Content="🗑 Clear" Name="AiClearBtn" Click="OnAiClearClicked" Margin="0,4,8,4"
                                ToolTip.Tip="Clear chat history"/>
                    </WrapPanel>
                </Grid>

                <!-- Message list -->
                <ScrollViewer Grid.Row="1" Name="AiScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <ItemsControl Name="AiMessagesList" Margin="8,6,8,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiChatMessage">
                                <Panel>
                                    <!-- User bubble -->
                                    <Border IsVisible="{Binding IsUser}"
                                            Background="#3356A0DB"
                                            CornerRadius="10,10,2,10"
                                            Padding="10,7" Margin="50,0,0,0"
                                            HorizontalAlignment="Right"
                                            MaxWidth="340">
                                        <ctrl:LinkTextBlock LinkText="{Binding Content}" FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{actipro:ThemeResource DefaultForegroundBrush}"/>
                                    </Border>
                                    <!-- Assistant bubble -->
                                    <Border IsVisible="{Binding IsAssistant}"
                                            Background="{actipro:ThemeResource Container2BackgroundBrush}"
                                            CornerRadius="10,10,10,2"
                                            Padding="10,7" Margin="0,0,50,0"
                                            HorizontalAlignment="Left"
                                            MaxWidth="380">
                                        <StackPanel Spacing="6">
                                            <ctrl:LinkTextBlock LinkText="{Binding Content}" FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Foreground="{actipro:ThemeResource DefaultForegroundBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding HasAnyAction}">
                                                <Button Content="🖼 View Artwork" Padding="5,2" FontSize="10" CornerRadius="4"
                                                        IsVisible="{Binding HasArtworkAction}"
                                                        Click="OnOpenArtworkFromChat"
                                                        Tag="{Binding ArtworkId}"
                                                        ToolTip.Tip="Open this artwork in a new viewer tab"/>
                                                <Button Content="👤 Gallery" Padding="5,2" FontSize="10" CornerRadius="4"
                                                        IsVisible="{Binding HasArtistAction}"
                                                        Click="OnOpenArtistFromChat"
                                                        Tag="{Binding ArtistId}"
                                                        ToolTip.Tip="Open this artist's gallery"/>
                                                <Button Content="🌐 Open URL" Padding="5,2" FontSize="10" CornerRadius="4"
                                                        IsVisible="{Binding HasUrlAction}"
                                                        Click="OnOpenUrlFromChat"
                                                        Tag="{Binding PixivUrl}"
                                                        ToolTip.Tip="Open this Pixiv page in your browser"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <!-- System note -->
                                    <Border IsVisible="{Binding IsSystem}"
                                            Padding="4,2" HorizontalAlignment="Center">
                                        <ctrl:LinkTextBlock LinkText="{Binding Content}" FontSize="10"
                                                   TextWrapping="Wrap" FontStyle="Italic"
                                                   Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- "Hoshi is thinking…" indicator — this control's DataContext is
                         GalleryViewModel, not AiViewModel, so IsVisible is toggled in
                         code-behind (see UpdateThinkingIndicator) instead of a direct binding. -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,8" Name="AiThinkingIndicator" IsVisible="False">
                        <Border Background="{actipro:ThemeResource Container2BackgroundBrush}"
                                CornerRadius="12" Padding="12,6"
                                BorderBrush="{actipro:ThemeResource Container2BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#10022;" FontSize="10" VerticalAlignment="Center"
                                           Foreground="#FFD6BAFF">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="50%">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <TextBlock Text="Hoshi is thinking…" FontSize="12"
                                           Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"
                                           FontStyle="Italic" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>

                <!-- Input row -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="8,4,8,8">
                    <TextBox Grid.Column="0" Name="AiInputBox"
                             PlaceholderText="Ask Hoshi anything — describe, suggest tags, download, add to favorites, move to folder…"
                             FontSize="12" CornerRadius="6,0,0,6"
                             KeyDown="OnAiInputKeyDown"/>
                    <Button Grid.Column="1" Content="Send" Name="AiSendBtn"
                            CornerRadius="0,6,6,0" Padding="12,0" FontSize="12"
                            Click="OnAiSendClicked"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Info strip with clickable tags ── -->
        <Border Grid.Row="4"
                Background="{actipro:ThemeResource Container1BackgroundBrush}"
                BorderBrush="{actipro:ThemeResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Grid.Column="0" Text="{Binding InlineViewerCard.TypeLabel}"
                           FontSize="12" Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <TextBlock Grid.Column="1" FontSize="12" Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"
                           Text="{Binding InlineViewerCard.PageCount, StringFormat='{}{0} pages'}"
                           IsVisible="{Binding InlineViewerCard.IsMultiPage}" Margin="0,0,16,0"/>
                <!-- Clickable tag chips -->
                <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" AllowAutoHide="False">
                    <ItemsControl Name="TagsItemsControl"
                                  ItemsSource="{Binding InlineViewerCard.Tags}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Padding="6,2"
                                        CornerRadius="8"
                                        Background="{actipro:ThemeResource Container2BackgroundBrush}"
                                        BorderBrush="{actipro:ThemeResource Container2BorderBrush}"
                                        BorderThickness="1"
                                        Cursor="Hand"
                                        PointerPressed="OnTagPressed">
                                    <Border.Styles>
                                        <Style Selector="Border:pointerover">
                                            <Setter Property="Background" Value="{actipro:ThemeResource Container3BackgroundBrush}"/>
                                        </Style>
                                        <Style Selector="Border:pointerover TextBlock">
                                            <Setter Property="Foreground" Value="#5B8DEF"/>
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Style>
                                    </Border.Styles>
                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="{actipro:ThemeResource DefaultForegroundBrushTertiary}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Column="3" FontSize="10" Foreground="{actipro:ThemeResource DefaultForegroundBrushDisabled}"
                           Text="Click tag: filter • Shift+click: search global"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
