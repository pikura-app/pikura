<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        x:Class="Pikura.Avalonia.Views.Login.ManualCookieDialog"
        Title="{loc:Tr Login_PastePHPSESSID}"
        Width="520" Height="270"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Container2BackgroundBrush}">

    <StackPanel Margin="24,20" Spacing="14">

        <TextBlock Text="{loc:Tr Login_ManualSignInEmergencyFallback}" FontWeight="SemiBold" FontSize="14"/>

        <TextBlock x:Name="ReasonText" TextWrapping="Wrap" FontSize="11"
                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                   IsVisible="False"/>

        <TextBlock TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}">
            Pikura couldn't open a sign-in window automatically, so paste your
            session cookie as a one-time workaround:
            open pixiv.net in your regular browser → DevTools → Application → Cookies →
            <Run FontWeight="SemiBold">www.pixiv.net</Run> → copy the value of
            <Run FontWeight="SemiBold">PHPSESSID</Run> and paste it below.
        </TextBlock>

        <TextBox x:Name="CookieInput"
                 PlaceholderText="{loc:Tr Login_PastePHPSESSIDValueHere}"
                 CornerRadius="6" FontSize="13"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:Tr Common_Cancel}" Click="OnCancel"/>
            <Button Content="{loc:Tr Common_Confirm}" Classes="accent" Click="OnConfirm"/>
        </StackPanel>

    </StackPanel>
</Window>
