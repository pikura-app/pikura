<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        x:Class="Pikura.Avalonia.Views.Login.ChromiumInstallDialog"
        Title="{loc:Tr Login_SettingUpSignIn}"
        Width="520" Height="240"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Container2BackgroundBrush}">

    <Grid Margin="24,20" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">

        <TextBlock Grid.Row="0" Text="{loc:Tr Login_SettingUpSignIn}"
                   FontWeight="SemiBold" FontSize="14"/>

        <TextBlock Grid.Row="1" x:Name="StatusText"
                   Text="{loc:Tr Login_DownloadingTheBundledBrowserUsedTo}"
                   TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>

        <ProgressBar Grid.Row="2" x:Name="Progress"
                     IsIndeterminate="True" Height="6"
                     CornerRadius="3"/>

        <TextBlock Grid.Row="3" x:Name="DetailText"
                   Text="{loc:Tr Login_ContactingPlaywrightDev}"
                   FontSize="11" VerticalAlignment="Top"
                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="CancelBtn" Content="{loc:Tr Common_Cancel}" Click="OnCancel"/>
        </StackPanel>
    </Grid>
</Window>
