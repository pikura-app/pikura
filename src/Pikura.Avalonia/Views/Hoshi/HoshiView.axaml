<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:svc="using:Pikura.Avalonia.Services"
             xmlns:loc="using:Pikura.Avalonia.Localization"
             xmlns:ctrl="using:Pikura.Avalonia.Views.Controls"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             x:Class="Pikura.Avalonia.Views.Hoshi.HoshiView"
             DragDrop.AllowDrop="True"
             x:DataType="vm:AiViewModel"
             x:CompileBindings="false">

    <UserControl.Styles>
        <!-- Flat sidebar rows: soft hover, accent bar + light fill on selected. -->
        <Style Selector="Border.hoshiSession:pointerover">
            <Setter Property="Background" Value="{DynamicResource Container2BackgroundBrush}"/>
        </Style>
        <Style Selector="Border.hoshiSession.hoshiSelected">
            <Setter Property="Background" Value="{DynamicResource Container2BackgroundBrush}"/>
        </Style>
        <Style Selector="Border.hoshiSession.hoshiSelected /template/ Border#AccentBar,
                         Border.hoshiSession.hoshiSelected Border#AccentBar">
            <Setter Property="IsVisible" Value="True"/>
        </Style>
        <!-- Pill chips for the quick actions. -->
        <Style Selector="Button.hoshiChip, SplitButton.hoshiChip">
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
        <Style Selector="Button.hoshiIcon">
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="MinHeight" Value="24"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="240,*" Margin="0,32,0,0">
        <!-- ══ Sidebar ══ -->
        <Border Grid.Column="0" Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
                <!-- header row: title + new + overflow -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="10,8,10,4">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Hoshi_Sessions}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource DefaultForegroundBrush}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Name="NewSessionBtn" Content="{loc:Tr Hoshi_New}" Click="OnNewSessionClicked"
                            FontSize="11" Padding="8,2" Margin="0,0,4,0"/>
                    <Button Grid.Column="2" Name="SidebarOverflowBtn" Content="⋯" FontSize="13" Padding="6,0">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{loc:Tr Hoshi_Select}" Click="OnToggleSelectionMode"/>
                                <MenuItem Header="{loc:Tr Hoshi_NewFolder}" Click="OnNewFolderClicked"/>
                                <MenuItem Header="{loc:Tr Hoshi_ClearAll}" Click="OnClearAllSessionsClicked" Name="ClearAllBtn"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
                <!-- search box -->
                <TextBox Grid.Row="1" PlaceholderText="{loc:Tr Hoshi_SearchChats}" Text="{Binding SessionSearchText}"
                         Margin="10,0,10,6" FontSize="11"/>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4" Margin="10,0,10,4">
                    <ComboBox SelectedIndex="{Binding SessionFilterIndex}" FontSize="10" Padding="6,2">
                        <ComboBoxItem Content="{loc:Tr Hoshi_Filter_All}"/>
                        <ComboBoxItem Content="{loc:Tr Hoshi_Filter_Pinned}"/>
                        <ComboBoxItem Content="{loc:Tr Hoshi_Filter_Archived}"/>
                    </ComboBox>
                    <ComboBox SelectedIndex="{Binding SessionGroupingIndex}" FontSize="10" Padding="6,2">
                        <ComboBoxItem Content="{loc:Tr Hoshi_Group_Date}"/>
                        <ComboBoxItem Content="{loc:Tr Hoshi_Group_Kind}"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="10,0,10,4" Spacing="4">
                    <TextBlock Text="{Binding MigrationStatusText}" FontSize="11" IsVisible="{Binding !!MigrationStatusText}"
                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}" TextWrapping="Wrap"/>
                    <Button Name="DeleteSelectedBtn" Content="{loc:Tr Hoshi_DeleteSelected}" FontSize="11"
                            Click="OnDeleteSelectedSessionsClicked"
                            IsVisible="{Binding IsSelectionMode}"/>
                    <Button Name="ArchiveSelectedBtn" Content="{loc:Tr Hoshi_ArchiveSelected}" FontSize="11"
                            Click="OnArchiveSelectedClicked"
                            IsVisible="{Binding IsSelectionMode}"/>
                    <Button Name="MoveSelectedBtn" Content="{loc:Tr Hoshi_MoveSelectedToFolder}" FontSize="11"
                            IsVisible="{Binding IsSelectionMode}" Click="OnMoveSelectedClicked"/>
                </StackPanel>
                <!-- session list — NO outer ScrollViewer: ListBox virtualizes inside its own -->
                <Grid Grid.Row="4">
                    <TextBlock Text="{loc:Tr Hoshi_NoSessionsYet}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="10,20"
                               IsVisible="{Binding Sessions.Count, Converter={x:Static svc:CountToBoolConverter.IsZero}}"/>
                    <ListBox Name="SessionsList" ItemsSource="{Binding FlattenedSessions}"
                             IsVisible="{Binding !SessionSearchText}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                >
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.DataTemplates>
                            <DataTemplate DataType="vm:SessionGroupViewModel">
                                <TextBlock Text="{Binding DisplayDate}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Margin="10,10,10,4"/>
                            </DataTemplate>
                            <DataTemplate DataType="vm:AiViewModel+FolderRow">
                                <Border Classes.hoshiSession="True" Padding="4,2" Cursor="Hand" Tag="{Binding}"
                                        PointerPressed="OnFolderHeaderClicked">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{loc:Tr Hoshi_RenameFolder}" Click="OnRenameFolderClicked" Tag="{Binding}"/>
                                            <MenuItem Header="{loc:Tr Hoshi_DeleteFolder}" Click="OnDeleteFolderClicked" Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="▾" FontSize="9" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <TextBlock Text="{Binding Folder.Name}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <TextBlock Text="{Binding Count}" FontSize="10" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                            <DataTemplate DataType="vm:AiViewModel+KindRow">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Margin="10,10,10,4"/>
                            </DataTemplate>
                            <DataTemplate DataType="svc:HoshiSession">
                                <Border Classes.hoshiSession="True" Classes.hoshiSelected="{Binding IsCurrent}" Background="Transparent"
                                        Padding="0" Cursor="Hand" Tag="{Binding}"
                                        PointerPressed="OnSessionClicked">
                                    <Grid ColumnDefinitions="3,Auto,*,Auto">
                                        <!-- 3px accent bar -->
                                        <Border Grid.Column="0" Name="AccentBar" Width="3" IsVisible="False"
                                                Background="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                        <CheckBox Grid.Column="1" Name="SessionCheckbox"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  IsVisible="{Binding $parent[ListBox].DataContext.IsSelectionMode}"
                                                  VerticalAlignment="Center" Margin="6,0,6,0"
                                                  Click="OnSessionCheckboxClicked" Tag="{Binding}"/>
                                        <StackPanel Grid.Column="2" Spacing="2" Margin="6,6" >
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="📌" FontSize="10" IsVisible="{Binding Pinned}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" Text="{Binding RelativeTime}" FontSize="9"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   VerticalAlignment="Top" Margin="0,6,8,0"/>
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu Opened="OnSessionContextMenuOpening" Tag="{Binding}">
                                            <MenuItem Header="{loc:Tr Hoshi_Pin}" Click="OnPinSession" Tag="{Binding}" IsVisible="{Binding !Pinned}"/>
                                            <MenuItem Header="{loc:Tr Hoshi_Unpin}" Click="OnPinSession" Tag="{Binding}" IsVisible="{Binding Pinned}"/>
                                            <MenuItem Header="{loc:Tr Hoshi_Archive}" Click="OnArchiveSessionClicked" Tag="{Binding}" IsVisible="{Binding !Archived}"/>
                                            <MenuItem Header="{loc:Tr Hoshi_Unarchive}" Click="OnArchiveSessionClicked" Tag="{Binding}" IsVisible="{Binding Archived}"/>
                                            <MenuItem Header="{loc:Tr Hoshi_MoveToFolder}" Tag="{Binding}" Name="MoveToFolderMenuItem">
                                                <MenuItem.Items>
                                                    <MenuItem Name="MoveToFolderList" Header="{loc:Tr Hoshi_MoveToFolderLoading}"/>
                                                </MenuItem.Items>
                                            </MenuItem>
                                            <MenuItem Header="{loc:Tr Hoshi_Rename}" Click="OnRenameSession" Tag="{Binding}"/>
                                            <MenuItem Header="{loc:Tr Hoshi_Duplicate}" Click="OnDuplicateSession" Tag="{Binding}"/>
                                            <MenuItem Header="{loc:Tr Hoshi_Delete}" Click="OnDeleteSession" Tag="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ListBox.DataTemplates>
                    </ListBox>
                    <ListBox ItemsSource="{Binding SearchResultSessions}" IsVisible="{Binding !!SessionSearchText}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="svc:HoshiSession">
                                <Border Padding="10,6" Cursor="Hand" Tag="{Binding}" PointerPressed="OnSessionClicked">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                        <TextBlock Text="{loc:Tr Hoshi_ArchivedBadge}" FontSize="9" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   IsVisible="{Binding Archived}"/>
                                        <TextBlock Text="{Binding SearchSnippet}" FontSize="10" TextWrapping="Wrap" MaxLines="2"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </Border>

        <!-- ══ Chat area ══ -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">
            <!-- Header: title + status dot + model + overflow menu -->
            <Border Grid.Row="0" Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Ellipse Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0"
                             Fill="{DynamicResource SystemAccentColor}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Name="SessionTitleLabel" Text="Hoshi 星" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Name="StatusLabel" Text="{Binding StatusText}" FontSize="11"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ActiveModelName}" FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="2" Content="⋯" FontSize="14" Padding="6,0">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Name="ToggleBtn" Header="{loc:Tr Hoshi_Enable}" Click="OnToggleClicked"/>
                                <MenuItem Header="{loc:Tr Hoshi_Rename}" Click="OnRenameSession" Tag="{Binding CurrentSession}"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </Grid>
            </Border>

            <!-- Image strip: 48px thumb + title/artist + small actions -->
            <Border Grid.Row="1" Background="{DynamicResource Container2BackgroundBrush}"
                    BorderBrush="{DynamicResource Container2BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="10,6">
                <Grid ColumnDefinitions="48,*,Auto">
                    <Border Grid.Column="0" Name="ImageThumbBorder" Width="48" Height="48" CornerRadius="6" ClipToBounds="True"
                            Cursor="Hand" PointerPressed="OnImageThumbClicked"
                            ToolTip.Tip="{loc:Tr Hoshi_ClickToViewLarger}">
                        <Image Name="ImageThumb" Stretch="UniformToFill"/>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout><Border Padding="4"><Image Name="ImageThumbLarge" MaxWidth="600" MaxHeight="600"/></Border></Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0" Spacing="2">
                        <TextBlock Name="ImageLabel" Text="{loc:Tr Hoshi_NoImageAttached}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Name="ImageHint" Text="{loc:Tr Hoshi_DropAnImageHerePasteWith}" FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <Button Classes="hoshiIcon" Name="ViewArtworkBtn" Content="{loc:Tr Hoshi_ViewArtwork}"
                                Click="OnViewArtworkClicked" IsVisible="False"
                                ToolTip.Tip="{loc:Tr Hoshi_OpenThisArtworkInTheGallery}"/>
                        <Button Classes="hoshiIcon" Name="OpenImageBtn" Content="{loc:Tr Hoshi_Open}"
                                Click="OnOpenImageClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_AttachAnImageFromYourComputer}"/>
                        <Button Classes="hoshiIcon" Content="{loc:Tr Hoshi_Paste}" Click="OnPasteImageClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_PasteImageFromClipboardCtrlV}"/>
                        <Button Classes="hoshiIcon" Content="{loc:Tr Hoshi_URL}" Click="OnUrlImageClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_PasteAnImageUrl}"/>
                        <Button Classes="hoshiIcon" Content="{loc:Tr Hoshi_ClearChat}" Click="OnClearClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_ClearsTheConversationOnlyTheAttached}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Messages -->
            <ScrollViewer Grid.Row="2" Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- empty-chat suggestions -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,40,0,0" Spacing="8"
                                IsVisible="{Binding Messages.Count, Converter={x:Static svc:CountToBoolConverter.IsZero}}">
                        <TextBlock Text="{loc:Tr Hoshi_ClickNewToStartThenDrop}" FontSize="12" TextAlignment="Center"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_DescribeThis}" Click="OnSuggestionClicked" Tag="{loc:Tr Hoshi_Describe}"/>
                            <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_WhenWasItPosted}" Click="OnSuggestionClicked" Tag="{loc:Tr Hoshi_WhenWasItPosted}"/>
                            <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_FindSimilarArt}" Click="OnSuggestionClicked" Tag="{loc:Tr Hoshi_FindSimilarArt}"/>
                        </StackPanel>
                    </StackPanel>
                    <ItemsControl Name="MessagesList" Margin="12,8,12,12" ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiChatMessage" x:CompileBindings="True">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,4"
                                      HorizontalAlignment="{Binding BubbleAlignment}"
                                      IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Border Grid.Column="0" Padding="6,2" CornerRadius="4" Margin="0,2,8,0"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding !IsUser}"
                                            Background="{DynamicResource Container2BackgroundBrush}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,8" CornerRadius="8"
                                            Background="{Binding IsUser, Converter={x:Static conv:BoolToBubbleBrushConverter.Background}}"
                                            BorderBrush="{Binding IsUser, Converter={x:Static conv:BoolToBubbleBrushConverter.Border}}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{loc:Tr Hoshi_You}" FontSize="10" FontWeight="SemiBold"
                                                       IsVisible="{Binding IsUser}"
                                                       Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                            <!-- Image thumbnail (if present) -->
                                            <Border Name="MessageImage" Width="200" Height="150" CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource Container3BackgroundBrush}"
                                                    IsVisible="{Binding HasImage}">
                                                <Image Stretch="UniformToFill" Source="{Binding ImageSource}"/>
                                            </Border>
                                            <!-- Message text -->
                                            <ctrl:LinkTextBlock LinkText="{Binding Content}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                            <!-- Quick actions for artwork/artist results -->
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding HasAnyAction}">
                                                <Button Content="{loc:Tr Hoshi_ViewArtwork}"  FontSize="10" 
                                                        IsVisible="{Binding HasArtworkAction}"
                                                        Click="OnOpenArtworkFromChat"
                                                        Tag="{Binding ArtworkId}"
                                                        ToolTip.Tip="{loc:Tr Rankings_OpenThisArtworkInANew}"/>
                                                <Button Content="{loc:Tr Hoshi_Gallery}"  FontSize="10" 
                                                        IsVisible="{Binding HasArtistAction}"
                                                        Click="OnOpenArtistFromChat"
                                                        Tag="{Binding ArtistId}"
                                                        ToolTip.Tip="{loc:Tr Hoshi_OpenThisArtistSGallery}"/>
                                                <Button Content="{loc:Tr Hoshi_OpenURL}"  FontSize="10" 
                                                        IsVisible="{Binding HasUrlAction}"
                                                        Click="OnOpenUrlFromChat"
                                                        Tag="{Binding PixivUrl}"
                                                        ToolTip.Tip="{loc:Tr Hoshi_OpenThisPixivPageInYour}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel HorizontalAlignment="Center" Margin="0,8" IsVisible="{Binding IsThinking}">
                        <Border Background="{DynamicResource Container2BackgroundBrush}" CornerRadius="12" Padding="12,6"
                                BorderBrush="{DynamicResource Container2BorderBrush}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#10022;" FontSize="10" VerticalAlignment="Center" Foreground="#FFD6BAFF">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                                                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                    <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <TextBlock Text="{loc:Tr Hoshi_HoshiIsThinking}" FontSize="11"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           FontStyle="Italic" VerticalAlignment="Center"/>
                                <Button Content="{loc:Tr Hoshi_Stop}" FontSize="10" Padding="6,1"
                                        CornerRadius="4" IsVisible="{Binding IsGenerating}"
                                        Command="{Binding StopCommand}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Quick chips + input -->
            <Border Grid.Row="3" Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}" BorderThickness="0,1,0,0" Padding="10,8">
                <StackPanel Spacing="8">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="4">
                        <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_Describe}" Name="DescribeBtn" Click="OnDescribeClicked"
                                IsVisible="{Binding !IsCurrentSubmissionMultiPage}" IsEnabled="{Binding !IsThinking}"
                                ToolTip.Tip="{loc:Tr Hoshi_DescribeTheImageItsStyleAnd}"/>
                        <SplitButton Classes="hoshiChip" Content="{loc:Tr Hoshi_Describe}" Name="DescribeSplitBtn" Click="OnDescribeClicked"
                                IsVisible="{Binding IsCurrentSubmissionMultiPage}" IsEnabled="{Binding !IsThinking}"
                                ToolTip.Tip="{loc:Tr Hoshi_DescribeTheImageItsStyleAnd_2}">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="{loc:Tr Hoshi_DescribeCurrentPage}" Click="OnDescribeClicked"/>
                                    <MenuItem Header="{loc:Tr Hoshi_DescribeAllPages}" Click="OnAllPagesClicked"
                                              ToolTip.Tip="{loc:Tr Hoshi_DescribesEveryPageOfAMulti}"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_Tags}" Name="TagsBtn" Click="OnTagsClicked"
                                IsEnabled="{Binding !IsThinking}"/>
                        <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_SimilarArt}" Name="SimilarArtBtn" Click="OnSimilarArtworksClicked"
                                IsEnabled="{Binding !IsThinking}"
                                ToolTip.Tip="{loc:Tr Hoshi_RecommendArtworksSimilarToThisImage}"/>
                        <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_SimilarArtists}" Name="SimilarArtistsBtn" Click="OnSimilarArtistsClicked"
                                IsEnabled="{Binding !IsThinking}"
                                ToolTip.Tip="{loc:Tr Hoshi_RecommendArtistsWithASimilarStyle}"/>
                        <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_Fav}" Name="FavBtn" Click="OnFavClicked"/>
                        <Button Classes="hoshiChip" Content="{loc:Tr Hoshi_DL}" Name="DlBtn" Click="OnDlClicked"/>
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Name="InputBox"
                                 PlaceholderText="{loc:Tr Hoshi_AskHoshiAnythingDropAnImage}"
                                 FontSize="12" CornerRadius="12" Padding="10,6"
                                 KeyDown="OnInputKeyDown"/>
                        <Button Grid.Column="1" Name="HoshiStopBtn" Content="&#9632;" CornerRadius="12" Padding="12,6"
                                Margin="6,0,0,0" Command="{Binding StopCommand}" ToolTip.Tip="{loc:Tr Hoshi_Stop}"
                                IsVisible="{Binding IsGenerating}"/>
                        <Button Grid.Column="1" Name="SendBtn" CornerRadius="12" Padding="12,6" Margin="6,0,0,0"
                                Click="OnSendClicked" IsEnabled="{Binding !IsThinking}"
                                IsVisible="{Binding !IsGenerating}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="&#10022;" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding IsThinking}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                        <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3"/></KeyFrame>
                                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1"/></KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                    <TextBlock Text="{loc:Tr Hoshi_Sending}" VerticalAlignment="Center" IsVisible="{Binding IsThinking}"/>
                                    <TextBlock Text="{loc:Tr Hoshi_Send}" VerticalAlignment="Center" IsVisible="{Binding !IsThinking}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
