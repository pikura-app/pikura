<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:svc="using:Pikura.Avalonia.Services"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             xmlns:ctrl="using:Pikura.Avalonia.Views.Controls"
             x:DataType="vm:AiViewModel"
             x:Class="Pikura.Avalonia.Views.Hoshi.HoshiView"
             DragDrop.AllowDrop="True">

    <Grid ColumnDefinitions="260,*" Margin="0,32,0,0">

        <!-- ── Left sidebar: sessions list ───────────────────────────────── -->
        <Border Grid.Column="0"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*">
                <!-- Sidebar header -->
                <Border Grid.Row="0" Padding="12,10"
                        BorderBrush="{DynamicResource Container1BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Grid.Column="0" Text="{loc:Tr Hoshi_Sessions}" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{loc:Tr Hoshi_ClearAll}" Name="ClearAllBtn"
                                  FontSize="11" Margin="6,0"
                                Click="OnClearAllSessionsClicked"/>
                        <Button Grid.Column="2" Content="{loc:Tr Hoshi_New}" Name="NewSessionBtn"
                                  FontSize="11"
                                Click="OnNewSessionClicked"/>
                    </Grid>
                </Border>

                <!-- Empty state -->
                <StackPanel Grid.Row="1" Margin="14,18" Spacing="6"
                            IsVisible="{Binding Sessions.Count, Converter={x:Static svc:CountToBoolConverter.IsZero}}">
                    <TextBlock Text="{loc:Tr Hoshi_NoSessionsYet}"
                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                               FontSize="12" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Tr Hoshi_ClickNewToStartThenDrop}"
                               Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                               FontSize="10" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- Sessions list (grouped by date) -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Margin="6,6">
                        <TextBox PlaceholderText="{loc:Tr Hoshi_SearchChats}" Text="{Binding SessionSearchText}"
                                 FontSize="11" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding MigrationStatusText}" FontSize="11" IsVisible="{Binding !!MigrationStatusText}"
                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                        <!-- Delete selected button -->
                        <Button Name="DeleteSelectedBtn" Content="{loc:Tr Hoshi_DeleteSelected}" 
                                  FontSize="11"
                                Click="OnDeleteSelectedSessionsClicked"
                                IsVisible="False"/>
                        <!-- Search results (flat list with snippets) -->
                        <ItemsControl ItemsSource="{Binding SearchResultSessions}" IsVisible="{Binding !!SessionSearchText}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="svc:HoshiSession">
                                    <Border Margin="0,2" Padding="10,8" CornerRadius="6"
                                            Background="{DynamicResource Container3BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                            BorderThickness="1" Cursor="Hand" Tag="{Binding}"
                                            PointerPressed="OnSessionClicked">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                            <TextBlock Text="{Binding SearchSnippet}" FontSize="10" TextWrapping="Wrap" MaxLines="2"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ListBox Name="SessionsList" ItemsSource="{Binding FlattenedSessions}"
                                 IsVisible="{Binding !SessionSearchText}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="vm:SessionGroupViewModel">
                                    <TextBlock Text="{Binding DisplayDate}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               Margin="0,10,0,4"/>
                                </DataTemplate>
                                <DataTemplate DataType="svc:HoshiSession">
                                    <Border Margin="0,2" Padding="10,8" CornerRadius="6"
                                            Background="{DynamicResource Container3BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                            BorderThickness="1" Cursor="Hand" Tag="{Binding}"
                                            PointerPressed="OnSessionClicked">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <CheckBox Grid.Column="0" Name="SessionCheckbox"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                                      Click="OnSessionCheckboxClicked" Tag="{Binding}"/>
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="📌" FontSize="10" IsVisible="{Binding Pinned}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                                                               Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <ContextMenu.Styles>
                                                    <Style Selector="ContextMenu">
                                                        <Setter Property="Background" Value="{DynamicResource Container1BackgroundBrush}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrush}"/>
                                                    </Style>
                                                    <Style Selector="MenuItem">
                                                        <Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrush}"/>
                                                        <Setter Property="Background" Value="Transparent"/>
                                                    </Style>
                                                    <Style Selector="MenuItem:pointerover">
                                                        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSoftAccent}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrush}"/>
                                                    </Style>
                                                    <Style Selector="Separator">
                                                        <Setter Property="Background" Value="{DynamicResource Container1BorderBrush}"/>
                                                    </Style>
                                                </ContextMenu.Styles>
                                                <MenuItem Header="{loc:Tr Hoshi_Pin}" Click="OnPinSession" Tag="{Binding}" IsVisible="{Binding !Pinned}"/>
                                                <MenuItem Header="{loc:Tr Hoshi_Unpin}" Click="OnPinSession" Tag="{Binding}" IsVisible="{Binding Pinned}"/>
                                                <MenuItem Header="{loc:Tr Common_Rename}" Click="OnRenameSession" Tag="{Binding}"/>
                                                <MenuItem Header="{loc:Tr Hoshi_Duplicate}" Click="OnDuplicateSession" Tag="{Binding}"/>
                                                <Separator/>
                                                <MenuItem Header="{loc:Tr Hoshi_DeleteSession}" Click="OnDeleteSession" Tag="{Binding}"/>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                    </Border>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ── Right side: chat area ─────────────────────────────────────── -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*,Auto">

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="16,12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="✦" FontSize="20"/>
                        <StackPanel Spacing="1">
                            <TextBlock Name="SessionTitleLabel" Text="Hoshi 星" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Name="StatusLabel" Text="{Binding StatusText}" FontSize="11"
                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Name="ToggleBtn" Content="{loc:Tr Hoshi_Enable}"  
                                FontSize="11" Click="OnToggleClicked"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Image preview strip (visible when an image is attached) -->
            <Border Grid.Row="1" Name="ImageStrip" Padding="12,10"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Background="{DynamicResource Container2BackgroundBrush}">
                <DockPanel>
                    <!-- Thumbnail — click to pop up a much larger preview since 100x100 is
                         still too small to make out details in a full-screen chat window. -->
                    <Border DockPanel.Dock="Left" Name="ImageThumbBorder" Width="100" Height="100" CornerRadius="6"
                            ClipToBounds="True" Cursor="Hand"
                            Background="{DynamicResource Container3BackgroundBrush}"
                            PointerPressed="OnImageThumbClicked"
                            ToolTip.Tip="{loc:Tr Hoshi_ClickToViewLarger}">
                        <Image Name="ImageThumb" Stretch="UniformToFill"/>
                        <FlyoutBase.AttachedFlyout>
                            <Flyout Placement="RightEdgeAlignedTop" ShowMode="Transient">
                                <Border Padding="6" MaxWidth="640" MaxHeight="640">
                                    <Image Name="ImageThumbLarge" Stretch="Uniform" MaxWidth="620" MaxHeight="620"/>
                                </Border>
                            </Flyout>
                        </FlyoutBase.AttachedFlyout>
                    </Border>
                    <!-- Info -->
                    <StackPanel DockPanel.Dock="Left" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Name="ImageLabel" Text="{loc:Tr Hoshi_NoImageAttached}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Name="ImageHint"
                                   Text="{loc:Tr Hoshi_DropAnImageHerePasteWith}"
                                   FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                    </StackPanel>
                    <!-- Buttons (last child fills remaining width and wraps) -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <WrapPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,4,0"/>
                            </Style>
                        </WrapPanel.Styles>
                        <Button Name="ViewArtworkBtn" Content="{loc:Tr Hoshi_ViewArtwork}"   FontSize="11"
                                Click="OnViewArtworkClicked" IsVisible="False"
                                ToolTip.Tip="{loc:Tr Hoshi_OpenThisArtworkInTheGallery}"/>
                        <Button Name="OpenImageBtn" Content="{loc:Tr Hoshi_Open}"   FontSize="11"
                                Click="OnOpenImageClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_AttachAnImageFromYourComputer}"/>
                        <Button Content="{loc:Tr Hoshi_Paste}"   FontSize="11"
                                Click="OnPasteImageClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_PasteImageFromClipboardCtrlV}"/>
                        <Button Content="{loc:Tr Hoshi_URL}"   FontSize="11"
                                Click="OnUrlImageClicked"/>
                        <Button Content="{loc:Tr Hoshi_ClearChat}"   FontSize="11"
                                Click="OnClearClicked"
                                ToolTip.Tip="{loc:Tr Hoshi_ClearsTheConversationOnlyTheAttached}"/>
                    </WrapPanel>
                </DockPanel>
            </Border>

            <!-- Chat messages -->
            <ScrollViewer Grid.Row="2" Name="ChatScroll"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <ItemsControl Name="MessagesList" Margin="12,8,12,12" ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AiChatMessage">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,4"
                                      HorizontalAlignment="{Binding BubbleAlignment}"
                                      IsVisible="{Binding Content, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                    <Border Grid.Column="0" Padding="6,2" CornerRadius="4" Margin="0,2,8,0"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding !IsUser}"
                                            Background="{DynamicResource Container2BackgroundBrush}">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="10" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </Border>
                                    <Border Grid.Column="1" Padding="10,8" CornerRadius="8"
                                            Background="{Binding IsUser, Converter={x:Static conv:BoolToBubbleBrushConverter.Background}}"
                                            BorderBrush="{Binding IsUser, Converter={x:Static conv:BoolToBubbleBrushConverter.Border}}"
                                            BorderThickness="1">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{loc:Tr Hoshi_You}" FontSize="10" FontWeight="SemiBold"
                                                       IsVisible="{Binding IsUser}"
                                                       Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                            <!-- Image thumbnail (if present) -->
                                            <Border Name="MessageImage" Width="200" Height="150" CornerRadius="6"
                                                    ClipToBounds="True"
                                                    Background="{DynamicResource Container3BackgroundBrush}"
                                                    IsVisible="{Binding HasImage}">
                                                <Image Stretch="UniformToFill" Source="{Binding ImageSource}"/>
                                            </Border>
                                            <!-- Message text -->
                                            <ctrl:LinkTextBlock LinkText="{Binding Content}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{DynamicResource DefaultForegroundBrush}"/>
                                            <!-- Quick actions for artwork/artist results -->
                                            <StackPanel Orientation="Horizontal" Spacing="6"
                                                        IsVisible="{Binding HasAnyAction}">
                                                <Button Content="{loc:Tr Hoshi_ViewArtwork}"  FontSize="10" 
                                                        IsVisible="{Binding HasArtworkAction}"
                                                        Click="OnOpenArtworkFromChat"
                                                        Tag="{Binding ArtworkId}"
                                                        ToolTip.Tip="{loc:Tr Rankings_OpenThisArtworkInANew}"/>
                                                <Button Content="{loc:Tr Hoshi_Gallery}"  FontSize="10" 
                                                        IsVisible="{Binding HasArtistAction}"
                                                        Click="OnOpenArtistFromChat"
                                                        Tag="{Binding ArtistId}"
                                                        ToolTip.Tip="{loc:Tr Hoshi_OpenThisArtistSGallery}"/>
                                                <Button Content="{loc:Tr Hoshi_OpenURL}"  FontSize="10" 
                                                        IsVisible="{Binding HasUrlAction}"
                                                        Click="OnOpenUrlFromChat"
                                                        Tag="{Binding PixivUrl}"
                                                        ToolTip.Tip="{loc:Tr Hoshi_OpenThisPixivPageInYour}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel HorizontalAlignment="Center" Margin="0,8"
                                IsVisible="{Binding IsThinking}">
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                CornerRadius="12" Padding="12,6"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="&#10022;" FontSize="10" VerticalAlignment="Center"
                                           Foreground="#FFD6BAFF">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Style.Animations>
                                                <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                                                    <KeyFrame Cue="0%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="50%">
                                                        <Setter Property="Opacity" Value="0.3"/>
                                                    </KeyFrame>
                                                    <KeyFrame Cue="100%">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </KeyFrame>
                                                </Animation>
                                            </Style.Animations>
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                                <TextBlock Text="{loc:Tr Hoshi_HoshiIsThinking}" FontSize="11"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           FontStyle="Italic" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Quick actions + input -->
            <Border Grid.Row="3"
                    Background="{DynamicResource Container1BackgroundBrush}"
                    BorderBrush="{DynamicResource Container1BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="10,8">
                <StackPanel Spacing="8">
                    <WrapPanel Orientation="Horizontal">
                        <!-- Single-page submissions get a plain button; the "all pages" dropdown
                             only appears once a multi-page submission is actually detected. -->
                        <Button Content="{loc:Tr Hoshi_Describe}"   FontSize="10"
                                Margin="0,0,4,4" Name="DescribeBtn" Click="OnDescribeClicked"
                                IsVisible="{Binding !IsCurrentSubmissionMultiPage}"
                                IsEnabled="{Binding !IsThinking}"
                                ToolTip.Tip="{loc:Tr Hoshi_DescribeTheImageItsStyleAnd}"/>
                        <SplitButton Content="{loc:Tr Hoshi_Describe}" CornerRadius="4" Padding="8,4" FontSize="10"
                                Margin="0,0,4,4" Name="DescribeSplitBtn" Click="OnDescribeClicked"
                                IsVisible="{Binding IsCurrentSubmissionMultiPage}"
                                IsEnabled="{Binding !IsThinking}"
                                ToolTip.Tip="{loc:Tr Hoshi_DescribeTheImageItsStyleAnd_2}">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="{loc:Tr Hoshi_DescribeCurrentPage}" Click="OnDescribeClicked"/>
                                    <MenuItem Header="{loc:Tr Hoshi_DescribeAllPages}" Click="OnAllPagesClicked"
                                              ToolTip.Tip="{loc:Tr Hoshi_DescribesEveryPageOfAMulti}"/>
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Content="{loc:Tr Hoshi_Tags}"   FontSize="10"
                                Margin="0,0,4,4" Name="TagsBtn" Click="OnTagsClicked"
                                IsEnabled="{Binding !IsThinking}"/>
                        <Button Content="{loc:Tr Hoshi_SimilarArt}"   FontSize="10"
                                Margin="0,0,4,4" Name="SimilarArtBtn" Click="OnSimilarArtworksClicked"
                                IsEnabled="{Binding !IsThinking}"
                                ToolTip.Tip="{loc:Tr Hoshi_RecommendArtworksSimilarToThisImage}"/>
                        <Button Content="{loc:Tr Hoshi_SimilarArtists}"   FontSize="10"
                                Margin="0,0,4,4" Name="SimilarArtistsBtn" Click="OnSimilarArtistsClicked"
                                IsEnabled="{Binding !IsThinking}"
                                ToolTip.Tip="{loc:Tr Hoshi_RecommendArtistsWithASimilarStyle}"/>
                        <Button Content="{loc:Tr Hoshi_Fav}"   FontSize="10"
                                Margin="0,0,4,4" Name="FavBtn" Click="OnFavClicked"/>
                        <Button Content="{loc:Tr Hoshi_DL}"   FontSize="10"
                                Margin="0,0,0,4" Name="DlBtn" Click="OnDlClicked"/>
                    </WrapPanel>
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0" Name="InputBox"
                                 PlaceholderText="{loc:Tr Hoshi_AskHoshiAnythingDropAnImage}"
                                 FontSize="12" CornerRadius="6,0,0,6"
                                 KeyDown="OnInputKeyDown"/>
                        <Button Grid.Column="1" Name="SendBtn"
                                CornerRadius="0,6,6,0" Padding="14,0" FontSize="12"
                                Click="OnSendClicked" IsEnabled="{Binding !IsThinking}">
                            <Button.Content>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#10022;" FontSize="11" VerticalAlignment="Center"
                                               IsVisible="{Binding IsThinking}">
                                        <TextBlock.Styles>
                                            <Style Selector="TextBlock">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:1.2" IterationCount="INFINITE">
                                                        <KeyFrame Cue="0%">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </KeyFrame>
                                                        <KeyFrame Cue="50%">
                                                            <Setter Property="Opacity" Value="0.3"/>
                                                        </KeyFrame>
                                                        <KeyFrame Cue="100%">
                                                            <Setter Property="Opacity" Value="1"/>
                                                        </KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </TextBlock.Styles>
                                    </TextBlock>
                                    <TextBlock Text="{loc:Tr Hoshi_Sending}" VerticalAlignment="Center" IsVisible="{Binding IsThinking}"/>
                                    <TextBlock Text="{loc:Tr Hoshi_Send}" VerticalAlignment="Center" IsVisible="{Binding !IsThinking}"/>
                                </StackPanel>
                            </Button.Content>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
