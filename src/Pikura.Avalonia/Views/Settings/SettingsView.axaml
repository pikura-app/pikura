<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             xmlns:svc="using:Pikura.Avalonia.Services"
             xmlns:loc="using:Pikura.Avalonia.Localization"
             xmlns:sys="using:System"
             xmlns:settings="using:Pikura.Core.Settings"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Pikura.Avalonia.Views.Settings.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <UserControl.Resources>
        <!-- Vector crown icon for the Pixiv Premium account badge. -->
        <StreamGeometry x:Key="PremiumCrownGeometry">M2,18 L4,7 L8,11 L12,5 L16,11 L20,7 L22,18 Z</StreamGeometry>
        <conv:BlocklistScopeToDisplayConverter x:Key="BlocklistScopeToDisplayConverter"/>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Page title -->
        <TextBlock Grid.Row="0" Text="{loc:Tr Settings_Title}" FontSize="22" FontWeight="Bold"
                   Margin="24,36,24,8"/>

        <!-- Restart banner -->
        <Border Grid.Row="1" Background="#1AFFA500" BorderBrush="Orange"
                BorderThickness="0,0,0,2" Padding="16,7"
                IsVisible="{Binding RestartRequired}">
            <StackPanel Orientation="Horizontal" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource WarningIcon}" Width="14" Height="14" VerticalAlignment="Center"
                              Foreground="Orange"/>
                    <TextBlock Text="{loc:Tr Settings_RestartRequired}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="{loc:Tr Settings_RestartNow}"   FontSize="11"
                        Classes="accent" Command="{Binding RestartApplicationCommand}"/>
                <Button Content="{loc:Tr Common_Dismiss}"   FontSize="11"
                        Command="{Binding DismissRestartNotificationCommand}"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="2" TabStripPlacement="Top" Margin="16,0,16,16"
                    VerticalAlignment="Stretch" VerticalContentAlignment="Stretch">

            <!-- ====================== APPEARANCE ====================== -->
            <TabItem Header="{loc:Tr Settings_Appearance}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="24" Margin="24" VerticalAlignment="Top">
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="20">
                                <TextBlock Text="{loc:Tr Settings_Theme}" FontWeight="SemiBold" FontSize="14"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button FontSize="13"
                                            Command="{Binding SetThemeCommand}" CommandParameter="Light"
                                            Classes.accent="{Binding IsThemeLight}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource SunIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                            <TextBlock Text="{loc:Tr Settings_ThemeLight}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button FontSize="13"
                                            Command="{Binding SetThemeCommand}" CommandParameter="Dark"
                                            Classes.accent="{Binding IsThemeDark}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource MoonIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                            <TextBlock Text="{loc:Tr Settings_ThemeDark}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button FontSize="13"
                                            Command="{Binding SetThemeCommand}" CommandParameter="System"
                                            Classes.accent="{Binding IsThemeSystem}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource MonitorIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                            <TextBlock Text="{loc:Tr Settings_ThemeSystem}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button FontSize="13"
                                            Command="{Binding SetThemeCommand}" CommandParameter="Scheduled"
                                            Classes.accent="{Binding IsThemeScheduled}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource ClockIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                            <TextBlock Text="{loc:Tr Settings_ThemeScheduled}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding IsThemeScheduled}">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr Settings_DarkFrom}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <TimePicker SelectedTime="{Binding ThemeScheduleDarkStart, Mode=TwoWay}" ClockIdentifier="12HourClock"/>
                                    </StackPanel>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr Settings_DarkUntil}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <TimePicker SelectedTime="{Binding ThemeScheduleDarkEnd, Mode=TwoWay}" ClockIdentifier="12HourClock"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="20">
                                <TextBlock Text="{loc:Tr Settings_Accessibility}" FontWeight="SemiBold" FontSize="14"/>
                                <WrapPanel>
                                    <CheckBox Content="{loc:Tr Settings_HighContrast}" IsChecked="{Binding UseHighContrast, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_LargeFonts}" IsChecked="{Binding UseLargeFonts, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_IncreaseSpacing}" IsChecked="{Binding IncreaseSpacing, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_ReduceMotion}" IsChecked="{Binding ReduceMotion, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                </WrapPanel>
                                <StackPanel Spacing="8" Margin="0,8,0,0">
                                    <TextBlock Text="{loc:Tr Settings_FontSizeScale}" FontSize="13"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0" Value="{Binding FontSizeScale, Mode=TwoWay}"
                                               Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                               Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding FontSizeScale, StringFormat='{}{0:F1}x'}"
                                                   FontSize="13" MinWidth="40" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Background Artwork Overlay -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="20">
                                <TextBlock Text="{loc:Tr Settings_BgOverlay}" FontWeight="SemiBold" FontSize="14"/>
                                <CheckBox Content="{loc:Tr Settings_EnableBgOverlay}"
                                          IsChecked="{Binding OverlayService.IsEnabled, Mode=TwoWay}"
                                          FontSize="13"/>

                                <StackPanel Spacing="16" IsVisible="{Binding OverlayService.IsEnabled}">
                                    <TextBlock Text="{Binding OverlayService.MaxImageItemsValue, StringFormat='Selected images (up to {0})'}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    <ItemsControl ItemsSource="{Binding OverlayService.ImageItems}"
                                                  Padding="0,8,10,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="svc:OverlayImageItem">
                                                <Grid Margin="0,3">
                                                    <!-- Thumbnail card -->
                                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6"
                                                            Padding="6" Height="72">
                                                        <Grid ColumnDefinitions="80,*,Auto">
                                                            <!-- Thumbnail -->
                                                            <Border Grid.Column="0" CornerRadius="4"
                                                                    ClipToBounds="True" Width="68" Height="58">
                                                                <Image Source="{Binding Thumbnail}"
                                                                       Stretch="UniformToFill"
                                                                       RenderOptions.BitmapInterpolationMode="HighQuality" UseLayoutRounding="True"/>
                                                            </Border>
                                                            <!-- Artwork info (clickable — navigates to artist gallery) -->
                                                            <Button Grid.Column="1"
                                                                    Background="Transparent" BorderThickness="0"
                                                                    Padding="0" Margin="10,0,0,0"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalContentAlignment="Left"
                                                                    Cursor="Hand"
                                                                    Tag="{Binding}"
                                                                    Click="OnOverlayImageTitleClick">
                                                                <TextBlock Text="{Binding DisplayTitle}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" MaxLines="2"
                                                                           TextWrapping="Wrap"
                                                                           TextDecorations="Underline"
                                                                           Foreground="{DynamicResource ControlForegroundBrushOutlineAccent}"/>
                                                            </Button>
                                                            <!-- Edit button -->
                                                            <Button Grid.Column="2" Content="{loc:Tr Common_Edit}" FontSize="11"
                                                                    Padding="10,4" 
                                                                    VerticalAlignment="Center" Margin="6,0"
                                                                    Tag="{Binding Path}"
                                                                    Click="OnEditOverlayImageClick"/>
                                                        </Grid>
                                                    </Border>
                                                    <!-- X remove button outside top-right of card -->
                                                    <Button FontSize="10"
                                                            Width="22" Height="22" Padding="0"
                                                            
                                                            Background="{DynamicResource Container2BackgroundBrush}"
                                                            Foreground="{DynamicResource DefaultForegroundBrush}"
                                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                                            BorderThickness="1"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            Margin="0,-8,-8,0"
                                                            Tag="{Binding Path}"
                                                            Click="OnRemoveOverlayImageClick">
                                                        <Path Data="{StaticResource CloseIcon}" Width="10" Height="10" Margin="1"
                                                              Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                                              VerticalAlignment="Center" HorizontalAlignment="Center" UseLayoutRounding="False"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{loc:Tr Settings_ClearAll}" FontSize="12" HorizontalAlignment="Left"
                                            Padding="10,4" 
                                            Click="OnClearAllOverlayImagesClick"/>

                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                                        <!-- Multi-line so a pasted list of IDs/links works as-is. -->
                                        <TextBox Grid.Column="0" x:Name="OverlayUrlTextBox"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 MinHeight="58" MaxHeight="140"
                                                 VerticalContentAlignment="Top"
                                                 PlaceholderText="{loc:Tr Settings_OverlayPlaceholder}"
                                                 CornerRadius="6" FontSize="12" Margin="0,0,8,0"
                                                 ToolTip.Tip="{loc:Tr Settings_OverlayTip}"/>
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Top" Margin="0,0,8,0">
                                            <Button Content="{loc:Tr Common_Add}" FontSize="12"
                                                    Padding="10,4" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Center"
                                                    Click="OnAddOverlayUrlClick"/>
                                            <TextBlock x:Name="OverlayAddStatus" FontSize="10"
                                                       TextWrapping="Wrap" MaxWidth="110"
                                                       IsVisible="False"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{loc:Tr Settings_BrowseImages}" FontSize="12"
                                                Padding="10,4" VerticalAlignment="Top"
                                                ToolTip.Tip="{loc:Tr Settings_BrowseImagesTip}"
                                                Click="OnAddOverlayFilesClick"/>
                                    </Grid>

                                    <TextBlock Text="{loc:Tr Settings_ImageAdjustments}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    <TextBlock Text="{loc:Tr Settings_ImageAdjustmentsHint}"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    <CheckBox Content="{loc:Tr Settings_GlobalOverrides}"
                                              IsChecked="{Binding OverlayService.UseGlobalOverrides, Mode=TwoWay}"
                                              FontSize="12" Margin="0,4,0,0"/>
                                    <StackPanel Spacing="10"
                                                IsVisible="{Binding OverlayService.UseGlobalOverrides}">
                                        <Grid ColumnDefinitions="120,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Opacity}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Value="{Binding OverlayService.ImageOpacity, Mode=TwoWay}"
                                                    Minimum="0" Maximum="0.85" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                    Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding OverlayService.ImageOpacity, StringFormat='{}{0:F2}'}"
                                                       FontSize="12" MinWidth="40" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="120,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Lighten}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Value="{Binding OverlayService.Brightness, Mode=TwoWay}"
                                                    Minimum="0" Maximum="0.85" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                    Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding OverlayService.Brightness, StringFormat='{}{0:F2}'}"
                                                       FontSize="12" MinWidth="40" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                        <Grid ColumnDefinitions="120,*,Auto">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Darken}" FontSize="12"
                                                       VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Value="{Binding OverlayService.Darkness, Mode=TwoWay}"
                                                    Minimum="0" Maximum="0.85" TickFrequency="0.01" IsSnapToTickEnabled="True"
                                                    Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding OverlayService.Darkness, StringFormat='{}{0:F2}'}"
                                                       FontSize="12" MinWidth="40" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="{loc:Tr Settings_Cycling}"
                                               FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <ComboBox Grid.Column="0" ItemsSource="{Binding OverlayService.CycleModeOptions}"
                                                  SelectedIndex="{Binding OverlayService.SelectedCycleModeIndex, Mode=TwoWay}"
                                                  FontSize="12" CornerRadius="6" HorizontalAlignment="Left" MinWidth="180"/>
                                        <NumericUpDown Grid.Column="1" Value="{Binding OverlayService.CycleInterval, Mode=TwoWay}"
                                                       Minimum="1" Maximum="999" FontSize="12" CornerRadius="6" Width="100"
                                                       HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== STORAGE & NAMING ====================== -->
            <TabItem Header="{loc:Tr Settings_StorageNaming}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="16" Margin="24,24,24,48" VerticalAlignment="Top">

                        <!-- Download Folder -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="20">
                                <TextBlock Text="{loc:Tr Settings_DownloadFolder}" FontWeight="SemiBold" FontSize="14"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding DownloadRoot}" IsReadOnly="True"
                                             CornerRadius="6" FontSize="13" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" Content="{loc:Tr Common_Browse}"
                                            Command="{Binding ChangeDownloadFolderCommand}"
                                             FontSize="13" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Naming Templates -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="24">
                                <TextBlock Text="{loc:Tr Settings_NamingTemplates}" FontWeight="SemiBold" FontSize="14"/>

                                <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">

                                    <!-- Folder template -->
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_FolderTemplate}"
                                               FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,0,5"/>
                                    <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding FolderTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CornerRadius="6" FontSize="13" Margin="0,0,8,0" PlaceholderText="%artist% (%member_id%)"/>
                                        <ComboBox Grid.Column="1" Width="120" CornerRadius="6" FontSize="12"
                                                  PlaceholderText="{loc:Tr Settings_Token}" SelectionChanged="OnFolderTokenSelected">
                                            <ComboBoxItem>%artist%</ComboBoxItem>
                                            <ComboBoxItem>%member_id%</ComboBoxItem>
                                            <ComboBoxItem>%member_token%</ComboBoxItem>
                                            <ComboBoxItem>%R-18%</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                                                VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource FolderIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding FolderPreview}"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>

                                    <!-- Filename template -->
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr Settings_FilenameTemplate}"
                                               FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,0,5"/>
                                    <Grid Grid.Row="1" Grid.Column="2" ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding FilenameTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CornerRadius="6" FontSize="13" Margin="0,0,8,0" PlaceholderText="%image_id% - %title%"/>
                                        <ComboBox Grid.Column="1" Width="120" CornerRadius="6" FontSize="12"
                                                  PlaceholderText="{loc:Tr Settings_Token}" SelectionChanged="OnFilenameTokenSelected">
                                            <ComboBoxItem>%image_id%</ComboBoxItem>
                                            <ComboBoxItem>%title%</ComboBoxItem>
                                            <ComboBoxItem>%artist%</ComboBoxItem>
                                            <ComboBoxItem>%page_index%</ComboBoxItem>
                                            <ComboBoxItem>%page_number%</ComboBoxItem>
                                            <ComboBoxItem>%date%</ComboBoxItem>
                                            <ComboBoxItem>%works_date%</ComboBoxItem>
                                            <ComboBoxItem>%member_id%</ComboBoxItem>
                                            <ComboBoxItem>%member_token%</ComboBoxItem>
                                            <ComboBoxItem>%R-18%</ComboBoxItem>
                                            <ComboBoxItem>%AI%</ComboBoxItem>
                                            <ComboBoxItem>%image_ext%</ComboBoxItem>
                                            <ComboBoxItem>%urlFilename%</ComboBoxItem>
                                            <ComboBoxItem>%bookmark_count%</ComboBoxItem>
                                            <ComboBoxItem>%manga_series_title%</ComboBoxItem>
                                            <ComboBoxItem>%tags%</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                                                VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource DocumentIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding FilenamePreview}"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>

                                    <Separator Grid.Row="3" Grid.ColumnSpan="3" Margin="0,10"
                                               Background="{DynamicResource Container1BorderBrush}"/>

                                    <!-- Manga / Info templates -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Tr Settings_MangaFilename}"
                                               FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,0,5"/>
                                    <Grid Grid.Row="5" Grid.Column="0" ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding FilenameMangaFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CornerRadius="6" FontSize="13" Margin="0,0,8,0" PlaceholderText="%artist%\%image_id%\p%page_number%"/>
                                        <ComboBox Grid.Column="1" Width="120" CornerRadius="6" FontSize="12"
                                                  PlaceholderText="{loc:Tr Settings_Token}" SelectionChanged="OnMangaFilenameTokenSelected">
                                            <ComboBoxItem>%image_id%</ComboBoxItem>
                                            <ComboBoxItem>%title%</ComboBoxItem>
                                            <ComboBoxItem>%artist%</ComboBoxItem>
                                            <ComboBoxItem>%member_id%</ComboBoxItem>
                                            <ComboBoxItem>%member_token%</ComboBoxItem>
                                            <ComboBoxItem>%page_index%</ComboBoxItem>
                                            <ComboBoxItem>%page_number%</ComboBoxItem>
                                            <ComboBoxItem>%date%</ComboBoxItem>
                                            <ComboBoxItem>%works_date%</ComboBoxItem>
                                            <ComboBoxItem>%R-18%</ComboBoxItem>
                                            <ComboBoxItem>%image_ext%</ComboBoxItem>
                                            <ComboBoxItem>%urlFilename%</ComboBoxItem>
                                            <ComboBoxItem>%tags%</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Grid.Row="6" Grid.Column="0" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                                                VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource DocumentIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding MangaFilenamePreview}"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>

                                    <TextBlock Grid.Row="4" Grid.Column="2" Text="{loc:Tr Settings_InfoFilename}"
                                               FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,0,5"/>
                                    <Grid Grid.Row="5" Grid.Column="2" ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding FilenameInfoFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CornerRadius="6" FontSize="13" Margin="0,0,8,0" PlaceholderText="%artist%\%image_id%.txt"/>
                                        <ComboBox Grid.Column="1" Width="120" CornerRadius="6" FontSize="12"
                                                  PlaceholderText="{loc:Tr Settings_Token}" SelectionChanged="OnInfoFilenameTokenSelected">
                                            <ComboBoxItem>%image_id%</ComboBoxItem>
                                            <ComboBoxItem>%title%</ComboBoxItem>
                                            <ComboBoxItem>%artist%</ComboBoxItem>
                                            <ComboBoxItem>%member_id%</ComboBoxItem>
                                            <ComboBoxItem>%member_token%</ComboBoxItem>
                                            <ComboBoxItem>%date%</ComboBoxItem>
                                            <ComboBoxItem>%works_date%</ComboBoxItem>
                                            <ComboBoxItem>%R-18%</ComboBoxItem>
                                            <ComboBoxItem>%urlFilename%</ComboBoxItem>
                                            <ComboBoxItem>%tags%</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <StackPanel Grid.Row="6" Grid.Column="2" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0"
                                                VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource DocumentIcon}" Width="12" Height="12" VerticalAlignment="Center"/>
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding InfoFilenamePreview}"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>

                                    <Separator Grid.Row="7" Grid.ColumnSpan="3" Margin="0,10"
                                               Background="{DynamicResource Container1BorderBrush}"/>

                                    <!-- Tags separator + Date format -->
                                    <StackPanel Grid.Row="8" Grid.Column="0" Orientation="Horizontal" Spacing="20">
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{loc:Tr Settings_TagsSeparator}" FontSize="13"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBox Text="{Binding TagsSeparator, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     CornerRadius="6" FontSize="13" Width="80"/>
                                        </StackPanel>
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{loc:Tr Settings_DateFormat}" FontSize="13"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBox Text="{Binding DateFormat, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     CornerRadius="6" FontSize="13" Width="160" PlaceholderText="yyyy-MM-dd"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Subfolder checkboxes -->
                                    <StackPanel Grid.Row="8" Grid.Column="2" Spacing="10" VerticalAlignment="Bottom">
                                        <CheckBox Content="{loc:Tr Settings_SubfolderPerWork}"
                                                  IsChecked="{Binding CreateSubfolderPerSubmission, Mode=TwoWay}" FontSize="13"/>
                                        <CheckBox Content="{loc:Tr Settings_R18SeparateFolder}"
                                                  IsChecked="{Binding SeparateR18Folder, Mode=TwoWay}" FontSize="13"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- FFmpeg & Ugoira (Animated) Settings -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28" Margin="0,0,0,8">
                            <StackPanel Spacing="20">
                                <TextBlock Text="{loc:Tr Settings_FfmpegUgoira}" FontWeight="SemiBold" FontSize="14"/>

                                <!-- FFmpeg status row -->
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" RowSpacing="10">
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                        <TextBlock FontSize="12">
                                            <Run Text="{loc:Tr Settings_Status}" FontWeight="SemiBold"/>
                                            <Run Text="{Binding FfmpegStatusText}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   Text="{Binding FfmpegVersionText}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="{loc:Tr Settings_InstallFfmpeg}" Command="{Binding InstallFfmpegCommand}"
                                                IsVisible="{Binding !IsFfmpegInstalled}"
                                                 FontSize="12" />
                                        <Button Content="{loc:Tr Settings_CheckAgain}" Command="{Binding CheckFfmpegCommand}"
                                                 FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{DynamicResource Container1BorderBrush}"/>

                                <!-- Ugoira format toggles -->
                                <TextBlock Text="{loc:Tr Settings_UgoiraAlsoCreate}"
                                           FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                <WrapPanel>
                                    <CheckBox Content="{loc:Tr Settings_Mp4Recommended}" IsChecked="{Binding CreateUgoiraMp4, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_WebmVp9}" IsChecked="{Binding CreateUgoiraWebm, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="GIF" IsChecked="{Binding CreateUgoiraGif, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="WebP" IsChecked="{Binding CreateUgoiraWebp, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="APNG" IsChecked="{Binding CreateUgoiraApng, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                </WrapPanel>
                                <CheckBox Content="{loc:Tr Settings_KeepFrameZip}"
                                          IsChecked="{Binding KeepUgoiraZip, Mode=TwoWay}"
                                          FontSize="13" Margin="0,4,0,0"/>
                                <Separator Background="{DynamicResource Container1BorderBrush}" Margin="0,8"/>
                                <CheckBox Content="{loc:Tr Settings_SaveFramesPng}"
                                          IsChecked="{Binding SaveUgoiraFrames, Mode=TwoWay}"
                                          FontSize="13" Margin="0,4,0,0"/>
                                <CheckBox Content="{loc:Tr Settings_FramesOnly}"
                                          IsChecked="{Binding UgoiraFramesOnly, Mode=TwoWay}"
                                          FontSize="13" Margin="0,4,0,0"
                                          IsEnabled="{Binding SaveUgoiraFrames}"/>
                            </StackPanel>
                        </Border>

                        <!-- Per-Account Download Settings (only when multiple accounts) -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24"
                                Margin="0,0,0,8"
                                IsVisible="{Binding HasMultipleAccounts}">
                            <StackPanel Spacing="18">

                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{loc:Tr Settings_PerAccount}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                            <Run Text="{loc:Tr Settings_OverridesFor}"/>
                                            <Run Text="{Binding ActiveProfileLabel}" FontWeight="SemiBold"/>
                                            <Run Text="{loc:Tr Settings_OverridesBlank}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding UseAccountSettings}"
                                                 OnContent="Enabled" OffContent="Disabled"
                                                 VerticalAlignment="Center"/>
                                </Grid>

                                <Separator Background="{DynamicResource Container1BorderBrush}"/>

                                <StackPanel Spacing="14" IsEnabled="{Binding UseAccountSettings}">

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{loc:Tr Settings_DownloadRoot}" FontSize="12" FontWeight="SemiBold"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding AcctDownloadRoot}"
                                                     PlaceholderText="{loc:Tr Settings_BlankGlobalRoot}"
                                                     FontSize="12" CornerRadius="6"/>
                                            <Button Grid.Column="1" Content="{loc:Tr Common_Browse}"
                                                    Command="{Binding BrowseAcctDownloadRootCommand}"
                                                     FontSize="12" Padding="10,6"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{loc:Tr Settings_FolderTemplate2}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding AcctFolderTemplate}"
                                                 PlaceholderText="e.g. %artist% (%member_id%)"
                                                 FontSize="12" CornerRadius="6"/>
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{loc:Tr Settings_FilenameTemplate2}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding AcctFilenameTemplate}"
                                                 PlaceholderText="e.g. %image_id%_p%page_index%"
                                                 FontSize="12" CornerRadius="6"/>
                                    </StackPanel>

                                    <StackPanel Spacing="5">
                                        <TextBlock Text="{loc:Tr Settings_MaxConcurrent}" FontSize="12" FontWeight="SemiBold"/>
                                        <NumericUpDown Value="{Binding AcctMaxConcurrentDownloads}"
                                                       Minimum="1" Maximum="20"
                                                       FontSize="12" CornerRadius="6" Width="120"
                                                       HorizontalAlignment="Left"/>
                                    </StackPanel>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:Tr Settings_ContentFilters}" FontSize="12" FontWeight="SemiBold"/>
                                        <CheckBox IsChecked="{Binding AcctFilterAiGenerated}"
                                                  Content="{loc:Tr Settings_FilterAi}" FontSize="12"/>
                                        <CheckBox IsChecked="{Binding AcctSkipR18}"
                                                  Content="{loc:Tr Settings_SkipR18}" FontSize="12"/>
                                        <CheckBox IsChecked="{Binding AcctSkipR18G}"
                                                  Content="{loc:Tr Settings_SkipR18G}" FontSize="12"/>
                                        <CheckBox IsChecked="{Binding AcctSeparateR18Folder}"
                                                  Content="{loc:Tr Settings_R18Subfolder}" FontSize="12"/>
                                        <CheckBox IsChecked="{Binding AcctAllowRedownload}"
                                                  Content="{loc:Tr Settings_AllowRedownload}" FontSize="12"/>
                                    </StackPanel>

                                </StackPanel>

                                <Button Content="{loc:Tr Settings_SaveAccount}"
                                        Command="{Binding SaveAccountSettingsCommand}"
                                        Classes="accent"  
                                        HorizontalAlignment="Right"/>

                            </StackPanel>
                        </Border>

                        <!-- Metadata Export -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="20">
                                <TextBlock Text="{loc:Tr Settings_MetadataExport}" FontWeight="SemiBold" FontSize="14"/>
                                <WrapPanel>
                                    <CheckBox Content="{loc:Tr Settings_JsonMetadata}" IsChecked="{Binding WriteImageJSON, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_InfoTextFile}" IsChecked="{Binding WriteImageInfo, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_RawJson}" IsChecked="{Binding WriteRawJSON, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_SeriesMetadata}" IsChecked="{Binding IncludeSeriesJSON, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_EmbedXmp}" IsChecked="{Binding WriteImageXMP, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_XmpPerPage}" IsChecked="{Binding WriteImageXMPPerImage, Mode=TwoWay}"
                                              IsEnabled="{Binding WriteImageXMP}" FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_VerifyImages}" IsChecked="{Binding VerifyImage, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_PreserveTimestamps}" IsChecked="{Binding SetLastModified, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                    <CheckBox Content="{loc:Tr Settings_LocalTimezone}" IsChecked="{Binding UseLocalTimezone, Mode=TwoWay}"
                                              FontSize="13" Margin="0,0,24,8"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== IMAGE PROCESSING ====================== -->
            <TabItem Header="{loc:Tr Settings_ImageProcessing}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="16" Margin="24,24,24,48" VerticalAlignment="Top">

                        <!-- Enable Image Processing -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="16">
                                <CheckBox Content="{loc:Tr Settings_EnableProcessing}"
                                          IsChecked="{Binding EnableImageProcessing, Mode=TwoWay}"
                                          FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Text="{loc:Tr Settings_ProcessingHint}"/>

                                <Separator/>

                                <CheckBox Content="{loc:Tr Settings_ExportMetadata}"
                                          IsChecked="{Binding ExportMetadataWithDownloads, Mode=TwoWay}"
                                          FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Text="{loc:Tr Settings_ExportMetadataHint}"/>
                                <Grid ColumnDefinitions="120,*" IsVisible="{Binding ExportMetadataWithDownloads}">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Settings_FileFormat}" FontSize="12"
                                               VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="1" HorizontalAlignment="Left" MinWidth="220"
                                              ItemsSource="{Binding MetadataExportFormatOptions}"
                                              SelectedIndex="{Binding MetadataExportFormatIndex, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Active Resize Preset -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="20">
                                <TextBlock Text="{loc:Tr Settings_ResizePreset}" FontWeight="SemiBold" FontSize="14"/>

                                <ComboBox SelectedIndex="{Binding ActiveResizePresetIndex, Mode=TwoWay}"
                                          FontSize="13" CornerRadius="6" HorizontalAlignment="Left" MinWidth="250">
                                    <ComboBoxItem Content="{loc:Tr Settings_PresetNone}"/>
                                    <ComboBoxItem Content="4K Desktop Wallpaper (3840x2160)"/>
                                    <ComboBoxItem Content="QHD Desktop Wallpaper (2560x1440)"/>
                                    <ComboBoxItem Content="Full HD Desktop Wallpaper (1920x1080)"/>
                                    <ComboBoxItem Content="HD Desktop Wallpaper (1280x720)"/>
                                    <ComboBoxItem Content="iPhone 16 Pro Max (1320x2868)"/>
                                    <ComboBoxItem Content="iPhone 16 / Pro (1179x2556)"/>
                                    <ComboBoxItem Content="iPhone 14/15 Pro Max (1290x2796)"/>
                                    <ComboBoxItem Content="iPhone SE (750x1334)"/>
                                    <ComboBoxItem Content="iPad Pro 12.9&quot; (2048x2732)"/>
                                    <ComboBoxItem Content="Samsung Galaxy S24 Ultra (1440x3120)"/>
                                    <ComboBoxItem Content="Samsung Galaxy S24 / S24+ (1080x2340)"/>
                                    <ComboBoxItem Content="{loc:Tr Settings_PresetCustom}"/>
                                </ComboBox>

                                <StackPanel Spacing="12" IsVisible="{Binding IsCustomResizePreset}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Width}" VerticalAlignment="Center" FontSize="13"/>
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding ResizeCustomWidth, Mode=TwoWay}"
                                                       Minimum="100" Maximum="7680"
                                                       FontSize="13" CornerRadius="6"/>
                                        <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr Settings_Height}" VerticalAlignment="Center" FontSize="13"/>
                                        <NumericUpDown Grid.Column="1"
                                                       Value="{Binding ResizeCustomHeight, Mode=TwoWay}"
                                                       Minimum="100" Maximum="4320"
                                                       FontSize="13" CornerRadius="6"/>
                                        <TextBlock Grid.Column="2" Text="px" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </Grid>
                                    <CheckBox Content="{loc:Tr Settings_MaintainAspect}"
                                              IsChecked="{Binding ResizeMaintainAspect, Mode=TwoWay}"
                                              FontSize="12"/>
                                </StackPanel>

                                <Separator Margin="0,8"
                                           Background="{DynamicResource Container1BorderBrush}"/>

                                <!-- Resize Mode -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{loc:Tr Settings_ResizeMode}" FontSize="13" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <RadioButton Content="{loc:Tr Settings_Fit}"
                                                     IsChecked="{Binding ResizeMode, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Fit}"/>
                                        <RadioButton Content="{loc:Tr Settings_Fill}"
                                                     IsChecked="{Binding ResizeMode, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Fill}"/>
                                        <RadioButton Content="{loc:Tr Settings_Stretch}"
                                                     IsChecked="{Binding ResizeMode, Mode=TwoWay, Converter={x:Static conv:EnumToBoolConverter.Instance}, ConverterParameter=Stretch}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Output Format -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="20">
                                <TextBlock Text="{loc:Tr Settings_OutputFormat}" FontWeight="SemiBold" FontSize="14"/>

                                <ComboBox SelectedIndex="{Binding ResizeOutputFormatIndex, Mode=TwoWay}"
                                          FontSize="13" CornerRadius="6" HorizontalAlignment="Left" MinWidth="250">
                                    <ComboBoxItem Content="{loc:Tr Settings_KeepFormat}"/>
                                    <ComboBoxItem Content="{loc:Tr Settings_JpegHigh}"/>
                                    <ComboBoxItem Content="{loc:Tr Settings_JpegMedium}"/>
                                    <ComboBoxItem Content="{loc:Tr Settings_PngLossless}"/>
                                    <ComboBoxItem Content="{loc:Tr Settings_WebpModern}"/>
                                </ComboBox>

                                <StackPanel Spacing="8" IsVisible="{Binding IsJpegOutputFormat}">
                                    <TextBlock Text="{loc:Tr Settings_JpegQuality}" FontSize="12" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Slider Grid.Column="0"
                                                Value="{Binding ResizeJpegQuality, Mode=TwoWay}"
                                                Minimum="1" Maximum="100" TickFrequency="1"
                                                IsSnapToTickEnabled="True"
                                                Margin="0,0,16,0"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ResizeJpegQuality, StringFormat='{}{0}'}"
                                                   FontSize="13" MinWidth="35" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Custom Output Folder -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{loc:Tr Settings_CustomOutput}" FontWeight="SemiBold" FontSize="14"/>
                                <CheckBox Content="{loc:Tr Settings_SaveToCustom}"
                                          IsChecked="{Binding UseCustomProcessingFolder, Mode=TwoWay}"
                                          FontSize="13"/>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                      IsVisible="{Binding UseCustomProcessingFolder}">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding ImageProcessingOutputFolder}"
                                             IsReadOnly="True"
                                             PlaceholderText="{loc:Tr Settings_SelectFolder}"
                                             CornerRadius="6" FontSize="13"/>
                                    <Button Grid.Column="1"
                                            Content="{loc:Tr Common_Browse}"
                                            Command="{Binding BrowseProcessingFolderCommand}"
                                             FontSize="13" />
                                </Grid>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Text="{loc:Tr Settings_CustomOutputHint}"
                                           IsVisible="{Binding !UseCustomProcessingFolder}"/>
                            </StackPanel>
                        </Border>

                        <!-- Saved Custom Presets -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="16">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{loc:Tr Settings_CustomPresets}" FontWeight="SemiBold" FontSize="14"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding OpenImageEditorCommand}"
                                             FontSize="12" >
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource EditIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                            <TextBlock Text="{loc:Tr Settings_OpenImageEditor}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock FontSize="11"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Text="{loc:Tr Settings_CustomPresetsHint}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== CONTENT FILTERING ====================== -->
            <TabItem Header="{loc:Tr Settings_ContentFiltering}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="24" Margin="24" VerticalAlignment="Top">

                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{loc:Tr Settings_Blocklist}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                           Text="{loc:Tr Settings_BlocklistHint}"/>

                                <!-- Add new rule -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                    <ComboBox Grid.Column="0" ItemsSource="{Binding BlocklistTypes}" SelectedItem="{Binding NewBlocklistType, Mode=TwoWay}"
                                              FontSize="12" CornerRadius="5" Padding="8,4" VerticalAlignment="Center"/>
                                    <TextBox Grid.Column="1" Text="{Binding NewBlocklistValue, Mode=TwoWay}"
                                             PlaceholderText="{loc:Tr Settings_BlocklistPlaceholder}" CornerRadius="5" FontSize="12" VerticalAlignment="Center"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding BlocklistScopeOptions}"
                                              SelectedItem="{Binding SelectedBlocklistScope, Mode=TwoWay}"
                                              FontSize="12" CornerRadius="5" Padding="8,4" VerticalAlignment="Center">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:BlocklistScopeOption">
                                                <TextBlock Text="{Binding Display}" FontSize="12" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <CheckBox Grid.Column="3" Content="{loc:Tr Settings_Regex}" FontSize="11"
                                              IsChecked="{Binding NewBlocklistUseRegex, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <CheckBox Grid.Column="4" Content="{loc:Tr Settings_BlockDownloads}" FontSize="11"
                                              IsChecked="{Binding NewBlocklistBlockDownload, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="5" Content="{loc:Tr Common_Add}"  FontSize="12" 
                                            Command="{Binding AddBlocklistEntryCommand}" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Existing rules -->
                                <ItemsControl ItemsSource="{Binding BlocklistEntries}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="6"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="settings:BlocklistEntry">
                                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                    BorderBrush="{DynamicResource Container2BorderBrush}"
                                                    BorderThickness="1" CornerRadius="5" Padding="8,6">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{Binding Type}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Scope, Converter={StaticResource BlocklistScopeToDisplayConverter}}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="3" Background="{DynamicResource Container3BackgroundBrush}" CornerRadius="3" Padding="4,2"
                                                            IsVisible="{Binding UseRegex}">
                                                        <TextBlock Text="{loc:Tr Settings_Regex}" FontSize="10" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Border Grid.Column="4" Background="{DynamicResource Container3BackgroundBrush}" CornerRadius="3" Padding="4,2"
                                                            IsVisible="{Binding BlockDownload}">
                                                        <TextBlock Text="{loc:Tr Settings_BlockDownloads}" FontSize="10" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Button Grid.Column="5" FontSize="10"  
                                                            Command="{Binding $parent[ItemsControl].DataContext.RemoveBlocklistEntryCommand}"
                                                            CommandParameter="{Binding}" VerticalAlignment="Center">
                                                        <PathIcon Data="{StaticResource CloseIcon}" Width="10" Height="10" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- R-18 Content -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <Grid ColumnDefinitions="*,20,*">
                                <StackPanel Grid.Column="0" Spacing="20">
                                    <TextBlock Text="{loc:Tr Settings_R18Content}" FontWeight="SemiBold" FontSize="14"/>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:Tr Settings_ContentMode}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{loc:Tr Settings_ModeOff}"   FontSize="12"
                                                    Classes.accent="{Binding R18Mode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=Off}"
                                                    Click="OnR18ModeButtonClick" Tag="Off"/>
                                            <Button Content="{loc:Tr Settings_ModeShow}"   FontSize="12"
                                                    Classes.accent="{Binding R18Mode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=Show}"
                                                    Click="OnR18ModeButtonClick" Tag="Show"/>
                                            <Button Content="{loc:Tr Settings_ModeOnly}"   FontSize="12"
                                                    Classes.accent="{Binding R18Mode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=Only}"
                                                    Click="OnR18ModeButtonClick" Tag="Only"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:Tr Settings_TypeFilter}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{loc:Tr Settings_Both}"   FontSize="12"
                                                    Classes.accent="{Binding R18Type, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=Both}"
                                                    Click="OnR18TypeButtonClick" Tag="Both"/>
                                            <Button Content="R-18"   FontSize="12"
                                                    Classes.accent="{Binding R18Type, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=R18}"
                                                    Click="OnR18TypeButtonClick" Tag="R18"/>
                                            <Button Content="R-18G"   FontSize="12"
                                                    Classes.accent="{Binding R18Type, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=R18G}"
                                                    Click="OnR18TypeButtonClick" Tag="R18G"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="24">
                                    <TextBlock Text="{loc:Tr Settings_GalleryDisplay}" FontWeight="SemiBold" FontSize="14"/>
                                    <CheckBox Content="{loc:Tr Settings_BlurR18}"
                                              IsChecked="{Binding BlurR18Content, Mode=TwoWay}" FontSize="13"/>
                                    <StackPanel Spacing="6" IsEnabled="{Binding BlurR18Content}">
                                        <TextBlock Text="{Binding BlurIntensity, StringFormat='Blur intensity: {0}px'}"
                                                   FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <Slider Value="{Binding BlurIntensity, Mode=TwoWay}"
                                                Minimum="5" Maximum="50" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                    <CheckBox Content="{loc:Tr Settings_FilterAiContent}"
                                              IsChecked="{Binding FilterAiGenerated, Mode=TwoWay}"
                                              FontSize="13"
                                              ToolTip.Tip="{loc:Tr Settings_SkipAiTip}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== ADVANCED ====================== -->
            <TabItem Header="{loc:Tr Settings_Advanced}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="24" Margin="24,24,24,48">
                        <Grid ColumnDefinitions="*,12,*" VerticalAlignment="Top">
                            <StackPanel Grid.Column="0" Spacing="20">
                                <Border Background="{DynamicResource Container1BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container1BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="24">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="{loc:Tr Settings_Network}" FontWeight="SemiBold" FontSize="13"/>
                                        <CheckBox Content="{loc:Tr Settings_UseProxy}" IsChecked="{Binding UseProxy, Mode=TwoWay}" FontSize="12"/>
                                        <TextBox Text="{Binding ProxyAddress, Mode=TwoWay}" CornerRadius="5" FontSize="12"
                                                 PlaceholderText="http://127.0.0.1:8080" IsEnabled="{Binding UseProxy}"/>
                                        <CheckBox Content="{loc:Tr Settings_VerifySsl}" IsChecked="{Binding EnableSSLVerification, Mode=TwoWay}" FontSize="12"/>
                                        <CheckBox Content="{loc:Tr Settings_RespectRobots}" IsChecked="{Binding UseRobots, Mode=TwoWay}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Container1BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container1BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="24">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="FANBOX" FontWeight="SemiBold" FontSize="13"/>
                                        <CheckBox Content="{loc:Tr Settings_FanboxCover}"
                                                  IsChecked="{Binding DownloadFanboxCoverWhenRestricted, Mode=TwoWay}" FontSize="12"/>
                                        <CheckBox Content="{loc:Tr Settings_FanboxHtml}"
                                                  IsChecked="{Binding WriteFanboxHtml, Mode=TwoWay}" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource Container1BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container1BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="24">
                                    <StackPanel Spacing="16">
                                        <TextBlock Text="{loc:Tr Settings_ViewedHistory}" FontWeight="SemiBold" FontSize="13"/>
                                        <CheckBox Content="{loc:Tr Settings_IncognitoMode}"
                                                  IsChecked="{Binding IncognitoModeEnabled, Mode=TwoWay}"
                                                  FontSize="12"
                                                  ToolTip.Tip="{loc:Tr Settings_IncognitoTip}"/>
                                        <Separator Margin="0,4"/>
                                        <CheckBox Content="{loc:Tr Settings_AutoClearStart}"
                                                  IsChecked="{Binding AutoClearViewedHistoryEnabled, Mode=TwoWay}"
                                                  FontSize="12"
                                                  ToolTip.Tip="{loc:Tr Settings_AutoClearStartTip}"/>
                                        <CheckBox Content="{loc:Tr Settings_AutoClearRunning}"
                                                  IsChecked="{Binding AutoClearViewedHistoryWhileRunning, Mode=TwoWay}"
                                                  FontSize="12"
                                                  ToolTip.Tip="{loc:Tr Settings_AutoClearRunningTip}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding AutoClearHistoryAnyEnabled}">
                                            <TextBlock Text="{loc:Tr Settings_KeepHistoryFor}" FontSize="12" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <NumericUpDown Value="{Binding AutoClearViewedHistoryValue, Mode=TwoWay}"
                                                           Minimum="1" Maximum="999" Increment="1" FormatString="0"
                                                           Width="100" FontSize="12" CornerRadius="6"/>
                                            <ComboBox ItemsSource="{Binding AutoClearHistoryUnits}"
                                                      SelectedItem="{Binding AutoClearViewedHistoryUnit, Mode=TwoWay}"
                                                      FontSize="12" CornerRadius="6" MinWidth="110"/>
                                        </StackPanel>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                   Text="{loc:Tr Settings_KeepHistoryHint}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="2" Background="{DynamicResource Container1BackgroundBrush}"
                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="24">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="{loc:Tr Settings_UgoiraSection}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                               Text="{loc:Tr Settings_UgoiraFfmpeg}" TextWrapping="Wrap"/>
                                    <WrapPanel>
                                        <CheckBox Content="WebM" IsChecked="{Binding CreateUgoiraWebm, Mode=TwoWay}" FontSize="12" Margin="0,0,12,4"/>
                                        <CheckBox Content="GIF"  IsChecked="{Binding CreateUgoiraGif,  Mode=TwoWay}" FontSize="12" Margin="0,0,12,4"/>
                                        <CheckBox Content="WebP" IsChecked="{Binding CreateUgoiraWebp, Mode=TwoWay}" FontSize="12" Margin="0,0,12,4"/>
                                        <CheckBox Content="APNG" IsChecked="{Binding CreateUgoiraApng, Mode=TwoWay}" FontSize="12" Margin="0,0,12,4"/>
                                    </WrapPanel>
                                    <CheckBox Content="{loc:Tr Settings_KeepZip}"
                                              IsChecked="{Binding KeepUgoiraZip, Mode=TwoWay}" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4,0,0">
                                        <TextBlock Text="{loc:Tr Settings_Codec}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,8,0"/>
                                        <ComboBox Grid.Column="1" CornerRadius="5" FontSize="12"
                                                  SelectedItem="{Binding FfMpegCodec, Mode=TwoWay}">
                                            <ComboBoxItem>libvpx-vp9</ComboBoxItem>
                                            <ComboBoxItem>libx264</ComboBoxItem>
                                            <ComboBoxItem>libvpx</ComboBoxItem>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{Binding FfMpegCRF, StringFormat='Quality (CRF): {0} - lower = better'}"
                                               FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    <Slider Minimum="0" Maximum="35" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Value="{Binding FfMpegCRF, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                    <!-- Download Behavior -->
                    <Border Background="{DynamicResource Container1BackgroundBrush}"
                            BorderBrush="{DynamicResource Container1BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Margin="4,10,4,4">
                        <StackPanel Spacing="24">
                            <TextBlock Text="{loc:Tr Settings_DownloadBehavior}" FontWeight="SemiBold" FontSize="14"/>

                            <!-- Safe Mode (anti-suspension) -->
                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                    BorderBrush="{DynamicResource Container2BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14,12">
                                <StackPanel Spacing="6">
                                    <CheckBox IsChecked="{Binding SafeMode, Mode=TwoWay}"
                                              FontSize="13" FontWeight="SemiBold"
                                              Content="{loc:Tr Settings_SafeMode}"/>
                                    <TextBlock FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               Text="{loc:Tr Settings_SafeModeHint}"/>
                                </StackPanel>
                            </Border>

                            <!-- Artist profile images -->
                            <CheckBox IsChecked="{Binding DownloadAvatarAndBanner, Mode=TwoWay}"
                                      FontSize="13"
                                      Content="{loc:Tr Settings_ArtistAvatar}"/>

                            <Grid ColumnDefinitions="*,20,*,20,*">

                                <!-- Concurrency + Overwrite -->
                                <StackPanel Grid.Column="0" Spacing="24">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_MaxConcurrentDl}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Minimum="1" Maximum="99" Increment="1" FormatString="0"
                                                       IsEnabled="{Binding !SafeMode}"
                                                       Value="{Binding MaxConcurrentDownloads, Mode=TwoWay}"
                                                       Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                   Text="{loc:Tr Settings_MaxConcurrentDlHint}"
                                                   IsVisible="{Binding !SafeMode}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                   Text="{loc:Tr Settings_SafeModeOverride}"
                                                   IsVisible="{Binding SafeMode}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_MaxConcurrentJobs}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Minimum="1" Maximum="99" Increment="1" FormatString="0"
                                                       IsEnabled="{Binding !SafeMode}"
                                                       Value="{Binding MaxConcurrentJobs, Mode=TwoWay}"
                                                       Width="100" HorizontalAlignment="Left"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                   Text="{loc:Tr Settings_MaxJobsHint}"
                                                   IsVisible="{Binding !SafeMode}"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                   Text="{loc:Tr Settings_SafeModeOverride}"
                                                   IsVisible="{Binding SafeMode}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_OverwriteBehavior}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="{loc:Tr Settings_Skip}"   FontSize="12"
                                                    Classes.accent="{Binding OverwriteMode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=0}"
                                                    Click="OnOverwriteModeButtonClick" Tag="0"/>
                                            <Button Content="{loc:Tr Settings_Overwrite}"   FontSize="12"
                                                    Classes.accent="{Binding OverwriteMode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=1}"
                                                    Click="OnOverwriteModeButtonClick" Tag="1"/>
                                            <Button Content="{loc:Tr Settings_Backup}"   FontSize="12"
                                                    Classes.accent="{Binding OverwriteMode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=2}"
                                                    Click="OnOverwriteModeButtonClick" Tag="2"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- File size limits -->
                                <StackPanel Grid.Column="2" Spacing="24">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_MinFileSize}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Value="{Binding MinFileSizeKB, Mode=TwoWay}"
                                                       Minimum="0" Maximum="102400" Increment="100"
                                                       CornerRadius="6" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_MaxFileSize}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Value="{Binding MaxFileSizeKB, Mode=TwoWay}"
                                                       Minimum="0" Maximum="102400" Increment="1000"
                                                       CornerRadius="6" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="{loc:Tr Settings_NoLimit}" FontSize="12"
                                               Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                </StackPanel>

                                <!-- Timing -->
                                <StackPanel Grid.Column="4" Spacing="24">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_Timeout}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Value="{Binding DownloadTimeout, Mode=TwoWay}"
                                                       Minimum="10" Maximum="300" Increment="5"
                                                       CornerRadius="6" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_RetryCount}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Value="{Binding RetryCount, Mode=TwoWay}"
                                                       Minimum="0" Maximum="10" Increment="1"
                                                       CornerRadius="6" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_RetryDelay}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Value="{Binding RetryDelaySeconds, Mode=TwoWay}"
                                                       Minimum="0" Maximum="60" Increment="1"
                                                       CornerRadius="6" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_DownloadDelay}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Value="{Binding DownloadDelaySeconds, Mode=TwoWay}"
                                                       Minimum="0" Maximum="30" Increment="1"
                                                       CornerRadius="6" FontSize="13"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Diagnostics & Logging -->
                    <Border Background="{DynamicResource Container1BackgroundBrush}"
                            BorderBrush="{DynamicResource Container1BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20" Margin="4,10,4,24">
                        <StackPanel Spacing="16">
                            <TextBlock Text="{loc:Tr Settings_Diagnostics}" FontWeight="SemiBold" FontSize="14"/>

                            <CheckBox Content="{loc:Tr Settings_VerboseLogging}"
                                      IsChecked="{Binding VerboseLogging, Mode=TwoWay}"/>
                            <StackPanel Orientation="Horizontal" Spacing="6"
                                        IsVisible="{Binding VerboseLogging}">
                                <PathIcon Data="{StaticResource WarningIcon}" Width="14" Height="14" VerticalAlignment="Center"
                                          Foreground="Orange"/>
                                <TextBlock Text="{loc:Tr Settings_VerboseHint}"
                                           FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                            </StackPanel>

                            <Separator Background="{DynamicResource Container1BorderBrush}" Margin="0,4"/>

                            <!-- App log -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Tr Settings_AppLog}" FontSize="13"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Grid.Column="0" IsReadOnly="True" FontSize="13" CornerRadius="5"
                                             Text="{Binding AppLogPath, Mode=OneWay}"
                                             FontFamily="Consolas,Menlo,monospace"/>
                                    <Button Grid.Column="1" Content="{loc:Tr Common_Copy}" FontSize="12" Margin="6,0,0,0"
                                             Padding="10,5" Click="OnCopyAppLogPath"/>
                                    <Button Grid.Column="2" Content="{loc:Tr Settings_OpenFolder}" FontSize="12" Margin="6,0,0,0"
                                             Padding="10,5" Click="OnOpenLogFolder"/>
                                </Grid>
                            </StackPanel>

                            <!-- Crash log -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="{loc:Tr Settings_CrashLog}" FontSize="13"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" IsReadOnly="True" FontSize="13" CornerRadius="5"
                                             Text="{Binding CrashLogPath, Mode=OneWay}"
                                             FontFamily="Consolas,Menlo,monospace"/>
                                    <Button Grid.Column="1" Content="{loc:Tr Common_Copy}" FontSize="12" Margin="6,0,0,0"
                                             Padding="10,5" Click="OnCopyCrashLogPath"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== HOSHI AI ====================== -->
            <TabItem Header="{loc:Tr Settings_HoshiAI}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="16" Margin="24,24,24,24" VerticalAlignment="Top">

                        <!-- Active models -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="24">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Tr Settings_ActiveModels}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               TextWrapping="Wrap"
                                               Text="{loc:Tr Settings_ActiveModelsHint}"/>
                                </StackPanel>

                                <!-- Ollama models -->
                                <StackPanel Spacing="14">
                                    <TextBlock Text="Ollama" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               TextWrapping="Wrap"
                                               Text="{loc:Tr Settings_OllamaModelsHint}"/>
                                    <!-- Shown while the installed-models list is still loading (e.g. right after
                                         app startup while Ollama itself is spinning up) so an empty ComboBox
                                         doesn't read as "my selection got cleared" — it's just still loading. -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                IsVisible="{Binding IsLoadingModels}">
                                        <PathIcon Data="{StaticResource ClockIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="{loc:Tr Settings_LoadingOllama}" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>
                                    <Grid ColumnDefinitions="*,20,*" RowDefinitions="Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_TextModel}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,0,5"/>
                                        <ComboBox Grid.Row="1" Grid.Column="0"
                                                  ItemsSource="{Binding InstalledOllamaModelNames}"
                                                  SelectedItem="{Binding HoshiTextModel, Mode=TwoWay}"
                                                  PlaceholderText="{Binding HoshiTextModel}"
                                                  CornerRadius="6" FontSize="13" HorizontalAlignment="Stretch"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Tr Settings_VisionModel}" FontSize="13"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,0,5"/>
                                        <ComboBox Grid.Row="1" Grid.Column="2"
                                                  ItemsSource="{Binding InstalledVisionModelNames}"
                                                  SelectedItem="{Binding HoshiVisionModel, Mode=TwoWay}"
                                                  PlaceholderText="{Binding HoshiVisionModel}"
                                                  CornerRadius="6" FontSize="13" HorizontalAlignment="Stretch"/>
                                    </Grid>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Container1BorderBrush}" Margin="0,0"/>

                                <!-- Anime tagger -->
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{loc:Tr Settings_AnimeTagger}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               TextWrapping="Wrap"
                                               Text="{loc:Tr Settings_AnimeTaggerHint}"/>

                                    <CheckBox Content="{loc:Tr Settings_EnableTagger}"
                                              IsChecked="{Binding HoshiUseAnimeTagger}"/>

                                    <StackPanel Spacing="14" IsEnabled="{Binding HoshiUseAnimeTagger}">
                                        <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_Model}" FontSize="13"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center" Margin="0,0,0,5"/>
                                            <ComboBox Grid.Row="0" Grid.Column="2"
                                                      ItemsSource="{Binding InstalledTaggerModelNames}"
                                                      SelectedItem="{Binding HoshiAnimeTaggerModel, Mode=TwoWay}"
                                                      CornerRadius="6" FontSize="13" HorizontalAlignment="Stretch"/>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="8"
                                                        Margin="0,10,0,0">
                                                <TextBlock Text="{loc:Tr Settings_AvailableTaggers}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                <ItemsControl ItemsSource="{Binding RecommendedTaggerModels}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RecommendedModelRow">
                                                            <Border Margin="0,0,6,6" Padding="10,5" CornerRadius="10"
                                                                    Background="{DynamicResource Container2BackgroundBrush}"
                                                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                                                    BorderThickness="1"
                                                                    ToolTip.Tip="{Binding ToolTipText}">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"/>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                                                                                IsVisible="{Binding IsInstalled}">
                                                                        <PathIcon Data="{StaticResource CheckIcon}" Width="10" Height="10" VerticalAlignment="Center"
                                                                                  Foreground="#4ADE80"/>
                                                                        <TextBlock Text="{loc:Tr Settings_Installed}" FontSize="11" Foreground="#4ADE80" VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <Button Content="{loc:Tr Common_Install}" FontSize="11"  
                                                                            Classes="accent"
                                                                            IsVisible="{Binding !IsInstalled}"
                                                                            IsEnabled="{Binding !IsInstalling}"
                                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).InstallRecommendedModelCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <StackPanel Spacing="6" IsVisible="{Binding IsInstallingTaggerModel}">
                                                    <ProgressBar Minimum="0" Maximum="100"
                                                                 Value="{Binding TaggerInstallPercent}" Height="6"/>
                                                    <TextBlock Text="{Binding TaggerInstallStatus}" FontSize="11"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <TextBlock Text="{Binding TaggerInstallError}" FontSize="11"
                                                           Foreground="#F87171" TextWrapping="Wrap"
                                                           IsVisible="{Binding TaggerInstallError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                                                <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="#F87171"
                                                           IsVisible="{Binding !IsSelectedTaggerModelInstalled}"
                                                           Text="{loc:Tr Settings_ModelNotInstalled}"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Spacing="14" IsVisible="{Binding IsSelectedTaggerModelInstalled}">
                                            <Grid ColumnDefinitions="Auto,12,*" RowDefinitions="Auto,Auto">
                                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_ConfidenceThreshold}" FontSize="13"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center" Margin="0,0,0,0"/>
                                                <Slider Grid.Row="0" Grid.Column="2"
                                                        Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                        Value="{Binding HoshiAnimeTaggerThreshold, Mode=TwoWay}"/>

                                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Settings_MaxTags}" FontSize="13"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center" Margin="0,8,0,0"/>
                                                <NumericUpDown Grid.Row="1" Grid.Column="2"
                                                               Minimum="1" Maximum="1000"
                                                               Value="{Binding HoshiAnimeTaggerMaxTags, Mode=TwoWay}"
                                                               Margin="0,8,0,0" FontSize="13"/>
                                            </Grid>

                                            <CheckBox Content="{loc:Tr Settings_AutoTag}"
                                                      IsChecked="{Binding HoshiAnimeTaggerAutoTagDownloads}"
                                                      ToolTip.Tip="{loc:Tr Settings_AutoTagTip}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Chat storage -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{loc:Tr Hoshi_StorageTitle}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Text="{Binding HoshiStorageStats}" FontSize="12"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,*">
                                    <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                        <TextBlock Text="{loc:Tr Hoshi_Retention}" FontSize="12"/>
                                        <ComboBox SelectedIndex="{Binding HoshiRetentionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{loc:Tr Hoshi_RetentionOff}"/>
                                            <ComboBoxItem Content="30"/>
                                            <ComboBoxItem Content="90"/>
                                            <ComboBoxItem Content="180"/>
                                            <ComboBoxItem Content="365"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="6">
                                        <TextBlock Text="{loc:Tr Hoshi_StorageLimit}" FontSize="12"/>
                                        <ComboBox SelectedIndex="{Binding HoshiStorageLimitIndex, Mode=TwoWay}" HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="{loc:Tr Hoshi_RetentionOff}"/>
                                            <ComboBoxItem Content="250 MB"/>
                                            <ComboBoxItem Content="500 MB"/>
                                            <ComboBoxItem Content="1 GB"/>
                                            <ComboBoxItem Content="2 GB"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel>
                                    <Button Content="{loc:Tr Hoshi_CleanUpNow}" Command="{Binding HoshiCleanUpNowCommand}" Margin="0,0,8,0"/>
                                    <Button Content="{loc:Tr Hoshi_PruneImages}" Command="{Binding HoshiPruneImagesCommand}" Margin="0,0,8,0"/>
                                    <Button Content="{loc:Tr Hoshi_DeleteLegacy}" Command="{Binding HoshiDeleteLegacyCommand}"
                                            IsVisible="{Binding HoshiLegacyMigratedExists}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Model management -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="24">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="{loc:Tr Settings_ModelManagement}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               TextWrapping="Wrap"
                                               Text="{loc:Tr Settings_ModelManagementHint}"/>
                                </StackPanel>

                                <!-- Install a model -->
                                <StackPanel Spacing="14">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{loc:Tr Settings_InstallModel}" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   TextWrapping="Wrap"
                                                   Text="{loc:Tr Settings_InstallModelHint}"/>
                                    </StackPanel>

                                    <Grid ColumnDefinitions="*,Auto,Auto">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding ModelToInstall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 CornerRadius="6" FontSize="13" Margin="0,0,8,0"
                                                 PlaceholderText="{loc:Tr Settings_OllamaModelName}"/>
                                        <Button Grid.Column="1" Content="{loc:Tr Common_Install}"
                                                Classes="accent"   FontSize="13"
                                                Command="{Binding PullModelCommand}"
                                                IsEnabled="{Binding !IsPullingModel}"/>
                                        <Button Grid.Column="2" Content="{loc:Tr Common_Cancel}" Margin="6,0,0,0"
                                                  FontSize="13"
                                                Command="{Binding CancelModelPullCommand}"
                                                IsVisible="{Binding IsPullingModel}"/>
                                    </Grid>

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{loc:Tr Settings_Recommended}" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{loc:Tr Settings_TextChat}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <ItemsControl ItemsSource="{Binding RecommendedTextModels}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RecommendedModelRow">
                                                        <Button Content="{Binding Name}" Margin="0,0,6,6" 
                                                                FontSize="11" 
                                                                ToolTip.Tip="{Binding ToolTipText}"
                                                                IsEnabled="{Binding !IsInstalling}"
                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).InstallRecommendedModelCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Spacing="6">
                                            <TextBlock Text="{loc:Tr Settings_Vision}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <ItemsControl ItemsSource="{Binding RecommendedVisionModels}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RecommendedModelRow">
                                                        <Button Content="{Binding Name}" Margin="0,0,6,6" 
                                                                FontSize="11" 
                                                                ToolTip.Tip="{Binding ToolTipText}"
                                                                IsEnabled="{Binding !IsInstalling}"
                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).InstallRecommendedModelCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Spacing="6" IsVisible="{Binding IsPullingModel}">
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{Binding ModelPullPercent}" Height="6"/>
                                        <TextBlock Text="{Binding ModelPullStatus}" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding ModelManagementError}" FontSize="11"
                                               Foreground="#F87171" TextWrapping="Wrap"
                                               IsVisible="{Binding ModelManagementError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Container1BorderBrush}" Margin="0,0"/>

                                <!-- Installed Ollama models -->
                                <StackPanel Spacing="14">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="{loc:Tr Settings_InstalledOllama}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                 Padding="10,5" FontSize="12"
                                                Command="{Binding RefreshInstalledModelsCommand}"
                                                IsEnabled="{Binding !IsLoadingModels}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <PathIcon Data="{StaticResource RefreshIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                <TextBlock Text="{loc:Tr Common_Refresh}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{loc:Tr Common_Loading}" FontSize="12"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               IsVisible="{Binding IsLoadingModels}"/>

                                    <TextBlock Text="{loc:Tr Settings_NoOllamaModels}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="!IsLoadingModels"/>
                                                <Binding Path="InstalledOllamaModels.Count" Converter="{x:Static svc:CountToBoolConverter.IsZero}"/>
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding InstalledOllamaModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InstalledModelRow">
                                                <Border Margin="0,3" Padding="12,8" CornerRadius="6"
                                                        Background="{DynamicResource Container2BackgroundBrush}"
                                                        BorderBrush="{DynamicResource Container1BorderBrush}"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                                <Run Text="{Binding DisplaySize}"/>
                                                                <Run Text="  ·  "/>
                                                                <Run Text="{Binding DisplayModified}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                            <Button Content="{loc:Tr Settings_UseForChat}"
                                                                      FontSize="11"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UseModelForTextCommand}"
                                                                    CommandParameter="{Binding Name}"/>
                                                            <Button Content="{loc:Tr Settings_UseForVision}"
                                                                      FontSize="11"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UseModelForVisionCommand}"
                                                                    CommandParameter="{Binding Name}"/>
                                                            <Button Content="{loc:Tr Common_Uninstall}"
                                                                      FontSize="11"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteModelCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Border Height="1" Background="{DynamicResource Container1BorderBrush}" Margin="0,0"/>

                                <!-- Installed anime taggers -->
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{loc:Tr Settings_InstalledTaggers}" FontWeight="SemiBold" FontSize="13"/>

                                    <TextBlock Text="{loc:Tr Settings_NoTaggers}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                        <TextBlock.IsVisible>
                                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                <Binding Path="!IsLoadingModels"/>
                                                <Binding Path="InstalledTaggerModels.Count" Converter="{x:Static svc:CountToBoolConverter.IsZero}"/>
                                            </MultiBinding>
                                        </TextBlock.IsVisible>
                                    </TextBlock>

                                    <ItemsControl ItemsSource="{Binding InstalledTaggerModels}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:InstalledModelRow">
                                                <Border Margin="0,3" Padding="12,8" CornerRadius="6"
                                                        Background="{DynamicResource Container2BackgroundBrush}"
                                                        BorderBrush="{DynamicResource Container1BorderBrush}"
                                                        BorderThickness="1">
                                                    <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                            <TextBlock FontSize="11"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                                <Run Text="{Binding DisplaySize}"/>
                                                                <Run Text="  ·  "/>
                                                                <Run Text="{Binding DisplayModified}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                            <Button Content="{loc:Tr Settings_UseForTagger}"
                                                                      FontSize="11"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).UseModelForTaggerCommand}"
                                                                    CommandParameter="{Binding Name}"/>
                                                            <Button Content="{loc:Tr Common_Uninstall}"
                                                                      FontSize="11"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).DeleteModelCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Text="{loc:Tr Settings_OllamaLibraryTip}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== CONFIG ====================== -->
            <TabItem Header="{loc:Tr Settings_Config}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="24" Margin="24" VerticalAlignment="Top">

                        <Grid ColumnDefinitions="*,12,*">
                            <!-- Languages -->
                            <Border Grid.Column="0" Background="{DynamicResource Container1BackgroundBrush}"
                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="24">
                                <StackPanel Spacing="20">
                                    <TextBlock Text="{loc:Tr Settings_Language}" FontWeight="SemiBold" FontSize="13"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_AppLanguage}" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  ItemsSource="{Binding AvailableAppLanguages}"
                                                  SelectedItem="{Binding AppLanguage, Mode=TwoWay}"
                                                  SelectionChanged="OnAppLanguageChanged"
                                                  CornerRadius="5" FontSize="12"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Settings_ApiLanguage}" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   VerticalAlignment="Center" Margin="0,8,10,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                                  ItemsSource="{Binding AvailableLocales}"
                                                  SelectedItem="{Binding PixivLocale, Mode=TwoWay}"
                                                  SelectionChanged="OnPixivLocaleChanged"
                                                  CornerRadius="5" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Startup -->
                            <Border Grid.Column="2" Background="{DynamicResource Container1BackgroundBrush}"
                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="24">
                                <StackPanel Spacing="20">
                                    <TextBlock Text="{loc:Tr Settings_Startup}" FontWeight="SemiBold" FontSize="13"/>
                                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_WindowState}" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"/>
                                        <ComboBox Grid.Row="0" Grid.Column="1"
                                                  SelectedItem="{Binding StartupWindowState, Mode=TwoWay}"
                                                  ItemsSource="{Binding StartupWindowStates}"
                                                  CornerRadius="5" FontSize="12"/>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Settings_SystemTray}" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   VerticalAlignment="Center" Margin="0,8,10,0"/>
                                        <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0"
                                                  CornerRadius="5" FontSize="12"
                                                  SelectedIndex="{Binding TrayBehavior, Mode=TwoWay}">
                                            <ComboBoxItem>Disabled</ComboBoxItem>
                                            <ComboBoxItem>Minimize to tray</ComboBoxItem>
                                            <ComboBoxItem>Close to tray</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Settings_StartupTab}" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                   VerticalAlignment="Center" Margin="0,8,10,0"/>
                                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0"
                                                  ItemsSource="{Binding AvailableStartupTabs}"
                                                  SelectedItem="{Binding SelectedStartupTab, Mode=TwoWay}"
                                                  CornerRadius="5" FontSize="12">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StartupTabOption">
                                                    <TextBlock Text="{Binding Display}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox Content="{loc:Tr Settings_Splash}"
                                              IsChecked="{Binding ShowSplashScreen, Mode=TwoWay}"
                                              FontSize="12"
                                              ToolTip.Tip="{loc:Tr Settings_SplashTip}"/>
                                    <CheckBox Content="{loc:Tr Settings_WhatsNew}"
                                              IsChecked="{Binding ShowFeatureHighlights, Mode=TwoWay}"
                                              FontSize="12"
                                              ToolTip.Tip="{loc:Tr Settings_WhatsNewTip}"/>
                                    <CheckBox Content="{loc:Tr Settings_StartWithWindows}"
                                              IsChecked="{Binding StartWithWindows, Mode=TwoWay}" FontSize="12"/>
                                    <CheckBox Content="{loc:Tr Settings_RestoreViewerTabs}"
                                              IsChecked="{Binding RestoreViewerTabs, Mode=TwoWay}" FontSize="12"/>
                                    <TextBlock Text="{loc:Tr Settings_RestoreViewerTabsHint}" FontSize="11"
                                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Gallery Viewer Keyboard Navigation -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="16">
                                <TextBlock Text="{loc:Tr Settings_GalleryViewer}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Text="{loc:Tr Settings_GalleryViewerHint}"/>
                                <CheckBox Content="{loc:Tr Settings_KeyNavGallery}"
                                          IsChecked="{Binding GalleryKeyboardNavEnabled, Mode=TwoWay}"
                                          FontSize="13"
                                          ToolTip.Tip="{loc:Tr Settings_KeyNavGalleryTip}"/>
                                <CheckBox Content="{loc:Tr Settings_KeyNavFullscreen}"
                                          IsChecked="{Binding FullscreenKeyboardNavEnabled, Mode=TwoWay}"
                                          FontSize="13"
                                          ToolTip.Tip="{loc:Tr Settings_KeyNavFullscreenTip}"/>
                            </StackPanel>
                        </Border>

                        <!-- Download Notifications -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <StackPanel Spacing="14">
                                <TextBlock Text="{loc:Tr Settings_DownloadNotifications}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                           Text="{loc:Tr Settings_NotificationsHint}"/>

                                <CheckBox IsChecked="{Binding NotifyOnDownloadStarted, Mode=TwoWay}" FontSize="12">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{loc:Tr Settings_NotifyStarted}" FontSize="12"/>
                                        <TextBlock Text="{loc:Tr Settings_NotifyStartedHint}" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding NotifyOnDownloadComplete, Mode=TwoWay}" FontSize="12">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{loc:Tr Settings_NotifyCompleted}" FontSize="12"/>
                                        <TextBlock Text="{loc:Tr Settings_NotifyCompletedHint}" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding NotifyOnDownloadFailed, Mode=TwoWay}" FontSize="12">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{loc:Tr Settings_NotifyFailed}" FontSize="12"/>
                                        <TextBlock Text="{loc:Tr Settings_NotifyFailedHint}" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                    </StackPanel>
                                </CheckBox>

                                <CheckBox IsChecked="{Binding NotifyOnDownloadPaused, Mode=TwoWay}" FontSize="12">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{loc:Tr Settings_NotifyPaused}" FontSize="12"/>
                                        <TextBlock Text="{loc:Tr Settings_NotifyPausedHint}" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                    </StackPanel>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- Settings.json -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{Binding SettingsPathHint}" FontSize="11"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                                    <Button Content="{loc:Tr Settings_ResetDefaults}" Command="{Binding ResetSettingsCommand}"
                                             FontSize="12"/>
                                    <TextBlock Text="Pikura &#xB7; Avalonia UI 12" FontSize="11"
                                               Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== ACCOUNTS ====================== -->
            <TabItem Header="{loc:Tr Settings_Accounts}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="24" Margin="24" VerticalAlignment="Top">

                        <!-- Accounts list (always visible) -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel Spacing="20">

                                <!-- Accounts header row -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Settings_Accounts}" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="{loc:Tr Settings_AccountsHint}" FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:Tr Settings_SignOutAll}"
                                            Command="{Binding SignOutAllCommand}"
                                             Margin="0,0,8,0"
                                            IsVisible="{Binding IsSignedIn}"/>
                                    <Button Grid.Column="2" Content="{loc:Tr Settings_AddAccount}"
                                            Command="{Binding AddAccountCommand}"
                                             Classes="accent"/>
                                </Grid>

                                <!-- Accounts list -->
                                <Border Background="{DynamicResource Container2BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container2BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="8">
                                    <ItemsControl ItemsSource="{Binding Profiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border CornerRadius="6" Padding="12,10" Margin="0,2">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="#1A5599FF" Opacity="0"/>
                                                    </Border.Background>
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                                                Background="{DynamicResource ControlBackgroundBrushSolidAccent}"
                                                                Margin="0,0,12,0" VerticalAlignment="Center">
                                                            <TextBlock FontSize="14" FontWeight="Bold" Foreground="White"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                       Text="{Binding DisplayLabel[0]}"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{Binding DisplayLabel}" FontWeight="SemiBold" FontSize="13"/>
                                                                <Border IsVisible="{Binding IsPremium}"
                                                                        Background="#F5A623" CornerRadius="4"
                                                                        Padding="4,2" VerticalAlignment="Center"
                                                                        ToolTip.Tip="{loc:Tr Settings_PixivPremium}">
                                                                    <Path Data="{StaticResource PremiumCrownGeometry}"
                                                                          Width="10" Height="10" Stretch="Uniform" Fill="White"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock FontSize="10"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                                <Run Text="{loc:Tr Settings_Id}"/><Run Text="{Binding UserId}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                        <Panel Grid.Column="2" Margin="0,0,6,0">
                                                            <Border CornerRadius="5" Padding="10,4"
                                                                    Background="#6366F1"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{loc:Tr Settings_Active}" FontSize="11" FontWeight="SemiBold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"/>
                                                                <Border.IsVisible>
                                                                    <MultiBinding Converter="{x:Static conv:StringsEqualMultiConverter.Instance}">
                                                                        <Binding Path="Id"/>
                                                                        <Binding Path="$parent[ItemsControl].((vm:SettingsViewModel)DataContext).ActiveProfileId"/>
                                                                    </MultiBinding>
                                                                </Border.IsVisible>
                                                            </Border>
                                                            <Button Content="{loc:Tr Settings_Switch}"
                                                                    
                                                                    Classes="accent"
                                                                    Padding="10,4"
                                                                    FontSize="11"
                                                                    Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SwitchToAccountCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Button.IsVisible>
                                                                    <MultiBinding Converter="{x:Static conv:StringsEqualMultiConverter.Instance}"
                                                                                  ConverterParameter="negate">
                                                                        <Binding Path="Id"/>
                                                                        <Binding Path="$parent[ItemsControl].((vm:SettingsViewModel)DataContext).ActiveProfileId"/>
                                                                    </MultiBinding>
                                                                </Button.IsVisible>
                                                            </Button>
                                                        </Panel>
                                                        <Button Grid.Column="3"
                                                                Content="{loc:Tr Settings_SignOut}"
                                                                
                                                                Padding="10,4"
                                                                FontSize="11"
                                                                Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SignOutAccountCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.Styles>
                                            <Style Selector="ItemsControl:empty">
                                                <Setter Property="Template">
                                                    <ControlTemplate>
                                                        <TextBlock Text="{loc:Tr Settings_NoAccounts}"
                                                                   FontSize="12" Padding="12"
                                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                   HorizontalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </Setter>
                                            </Style>
                                        </ItemsControl.Styles>
                                    </ItemsControl>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== UPDATES ====================== -->
            <TabItem Header="{loc:Tr Settings_Updates}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="24" Margin="24" HorizontalAlignment="Center" MaxWidth="620" VerticalAlignment="Top">

                        <!-- Current version + check now -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="14">

                                <!-- Version row -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="Pikura" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                            <Run Text="{loc:Tr Settings_CurrentVersion}"/>
                                            <Run Text="{Binding AppVersion}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{loc:Tr Settings_CheckNow}"
                                            Command="{Binding CheckForUpdatesNowCommand}"
                                            Classes="accent"  
                                            IsEnabled="{Binding !CheckingForUpdates}"/>
                                </Grid>

                                <!-- Progress / status -->
                                <ProgressBar Grid.Row="1"
                                             IsVisible="{Binding CheckingForUpdates}"
                                             IsIndeterminate="True" Height="4" CornerRadius="2"/>

                                <TextBlock Grid.Row="2"
                                           Text="{Binding UpdateStatusMessage}"
                                           FontSize="12" IsVisible="{Binding UpdateStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                            </Grid>
                        </Border>

                        <!-- Update preferences -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="24">
                            <StackPanel Spacing="18">

                                <TextBlock Text="{loc:Tr Settings_UpdatePrefs}" FontWeight="SemiBold" FontSize="14"/>
                                <Separator Background="{DynamicResource Container1BorderBrush}"/>

                                <!-- Check frequency -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{loc:Tr Settings_CheckUpdates}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr Settings_CheckUpdatesHint}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding UpdateFrequencyOptions}"
                                              SelectedItem="{Binding UpdateCheckFrequency}"
                                              Width="130" FontSize="12" CornerRadius="6"/>
                                </Grid>

                                <!-- Release channel -->
                                <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{loc:Tr Settings_ReleaseChannel}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr Settings_ReleaseChannelHint}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding UpdateChannelOptions}"
                                              SelectedItem="{Binding UpdateChannel}"
                                              Width="130" FontSize="12" CornerRadius="6"/>
                                </Grid>

                                <!-- Notify toggle -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{loc:Tr Settings_NotifyUpdate}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr Settings_NotifyUpdateHint}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding NotifyOnUpdate}"
                                                 OnContent="On" OffContent="Off" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Auto-download toggle -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{loc:Tr Settings_AutoDownload}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="{loc:Tr Settings_AutoDownloadHint}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoDownloadUpdates}"
                                                 OnContent="On" OffContent="Off" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Save -->
                                <Button Content="{loc:Tr Settings_SaveUpdates}"
                                        Command="{Binding SaveUpdateSettingsCommand}"
                                        Classes="accent"  
                                        HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Border>

                        <!-- Note: download progress and install banners appear at the top of the main window -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <TextBlock FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                       Text="{loc:Tr Settings_UpdateBannerHint}"/>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ====================== ABOUT ====================== -->
            <TabItem Header="{loc:Tr Settings_About}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalAlignment="Stretch">
                    <StackPanel Spacing="24" Margin="24" HorizontalAlignment="Center" MaxWidth="560" VerticalAlignment="Top">

                        <!-- Logo / App Identity -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="36,32">
                            <StackPanel Spacing="10" HorizontalAlignment="Center">
                                <Image Source="/Assets/pikura-logo.png" Width="80" Height="80"
                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Pikura" FontSize="32" FontWeight="Bold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="ピクラ" FontSize="13"
                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                           HorizontalAlignment="Center" Margin="0,-4,0,0"/>
                                <TextBlock Text="{loc:Tr Settings_Tagline}" FontSize="14"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           HorizontalAlignment="Center"/>
                                <Separator Background="{DynamicResource Container1BorderBrush}" Margin="0,8"/>
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" HorizontalAlignment="Center">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Tr Settings_Version}" FontSize="13"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,20,6"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding AppVersion}" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Tr Settings_Developer}" FontSize="13"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,20,6"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="mrplusultra" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Tr Settings_Year}" FontSize="13"
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}" Margin="0,0,20,0"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="© 2026" FontSize="13" FontWeight="SemiBold"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,8,0,0">
                                    <Button Content="{loc:Tr Settings_GitHubPage}"
                                            Click="OnGitHubPageClick"
                                            Cursor="Hand"
                                            FontSize="13"
                                            
                                            />
                                    <Button Content="{loc:Tr Settings_ViewChangelog}"
                                            Click="OnViewChangelogClick"
                                            Cursor="Hand"
                                            FontSize="13"
                                            
                                            />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- License -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Tr Settings_License}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           Text="{loc:Tr Settings_LicenseText}"/>
                            </StackPanel>
                        </Border>

                        <!-- Tech Stack -->
                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="28">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Tr Settings_BuiltWith}" FontWeight="SemiBold" FontSize="14"/>
                                <WrapPanel>
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text=".NET 10" FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="Avalonia UI" FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="ActiPro" FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="SQLite" FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="CommunityToolkit.Mvvm" FontSize="11"/>
                                    </Border>
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            CornerRadius="4" Padding="8,3" Margin="0,0,6,6">
                                        <TextBlock Text="Ollama" FontSize="11"/>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <StackPanel Spacing="12" Margin="0,24,0,0">
                                    <TextBlock Text="{loc:Tr Settings_LibrarySection}" FontSize="16" FontWeight="Bold"/>
                                    <CheckBox Content="{loc:Tr Settings_LibraryAutoIndex}" IsChecked="{Binding LibraryAutoIndexDownloads}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{loc:Tr Settings_LibraryDupThreshold}" VerticalAlignment="Center"/>
                                        <Slider Value="{Binding LibraryDuplicateThreshold}" Minimum="0" Maximum="7" Width="160" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LibraryDuplicateThreshold, StringFormat='{}{0}'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Spacing="12" Margin="0,24,0,0">
                            <Button Content="{loc:Tr Settings_SwitchUpdater}" Command="{Binding SwitchToNewUpdaterCommand}"
                                    IsVisible="{Binding CanMigrateToVelopack}" IsEnabled="{Binding !IsMigrating}"/>
                            <TextBlock Text="{loc:Tr Settings_SwitchUpdaterDesc}" FontSize="12"
                                       IsVisible="{Binding CanMigrateToVelopack}"
                                       Foreground="{DynamicResource DefaultForegroundBrushSecondary}" TextWrapping="Wrap"/>
                            <Button Content="{loc:Tr Settings_RemoveAllData}" Command="{Binding RemoveAllDataCommand}"/>
                        </StackPanel>
                    </StackPanel>
                            </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
