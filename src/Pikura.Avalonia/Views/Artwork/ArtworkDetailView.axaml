<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="Pikura.Avalonia.Views.Artwork.ArtworkDetailView"
             x:DataType="vm:ArtworkDetailViewModel">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Container1BackgroundBrush}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Content="← Back" Command="{Binding GoBackCommand}"/>
                
                <SelectableTextBlock Grid.Column="1" 
                                     Text="{Binding Artwork.Title}" 
                                     FontWeight="SemiBold" 
                                     FontSize="18" 
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="Download Current" Command="{Binding DownloadCurrentPageCommand}"/>
                    <Button Content="Download All" Command="{Binding DownloadAllPagesCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Image Display -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource ImageCanvasBackgroundBrush}" 
                    Margin="16"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource Container1BorderBrush}" 
                    BorderThickness="1">
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Artwork Image" 
                              FontSize="24" 
                              Opacity="0.5"/>
                    <StackPanel VerticalAlignment="Bottom" 
                              HorizontalAlignment="Center" 
                              Margin="0,0,0,16">
                        <TextBlock Text="{Binding CurrentPageIndex, StringFormat='Page {0}'}" 
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalPages, StringFormat='of {0}'}" 
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Side Panel -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource Container1BackgroundBrush}" 
                    BorderBrush="{DynamicResource Container1BorderBrush}" 
                    BorderThickness="1,0,0,0"
                    Width="300"
                    Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Artwork Info" FontWeight="SemiBold" FontSize="16"/>
                    
                    <StackPanel Spacing="8">
                        <TextBlock Text="Artist:" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Artwork.UserName}"/>

                        <TextBlock Text="ID:" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Artwork.Id}"/>

                        <TextBlock Text="Type:" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Artwork.TypeLabel}"/>

                        <TextBlock Text="Pages:" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding Artwork.PageCount}"/>

                        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Bookmarks">
                                <PathIcon Data="{StaticResource BookmarkIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="#3B82F6"/>
                                <TextBlock Text="{Binding BookmarkCount, StringFormat='{}{0:N0}', TargetNullValue='—'}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Likes">
                                <PathIcon Data="{StaticResource HeartIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="#EF4444"/>
                                <TextBlock Text="{Binding LikeCount, StringFormat='{}{0:N0}', TargetNullValue='—'}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="Views">
                                <PathIcon Data="{StaticResource EyeIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="#10B981"/>
                                <TextBlock Text="{Binding ViewCount, StringFormat='{}{0:N0}', TargetNullValue='—'}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>


                        <WrapPanel Orientation="Horizontal">
                            <Button Command="{Binding LikeCommand}" IsEnabled="{Binding !IsLiked}" Margin="0,0,8,8" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource HeartIcon}" Fill="#EF4444" IsVisible="{Binding !IsLiked}"/>
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource HeartFilledIcon}" Fill="#EF4444" IsVisible="{Binding IsLiked}"/>
                                    <TextBlock Text="Like" FontSize="12" IsVisible="{Binding !IsLiked}"/>
                                    <TextBlock Text="Liked" FontSize="12" IsVisible="{Binding IsLiked}"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ToggleBookmarkCommand}" IsEnabled="{Binding !IsActionLoading}" Margin="0,0,8,8" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource BookmarkIcon}" Fill="#3B82F6" IsVisible="{Binding !IsBookmarked}"/>
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource BookmarkFilledIcon}" Fill="#3B82F6" IsVisible="{Binding IsBookmarked}"/>
                                    <TextBlock Text="Bookmark" FontSize="12" IsVisible="{Binding !IsBookmarked}"/>
                                    <TextBlock Text="Bookmarked" FontSize="12" IsVisible="{Binding IsBookmarked}"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ToggleFollowCommand}" IsEnabled="{Binding !IsActionLoading}" Margin="0,0,8,8" BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Width="14" Height="14" Stretch="Uniform" Data="{StaticResource PersonIcon}" Fill="#10B981"/>
                                    <TextBlock Text="Follow" FontSize="12" IsVisible="{Binding !IsFollowing}"/>
                                    <TextBlock Text="Following" FontSize="12" IsVisible="{Binding IsFollowing}"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <TextBlock Text="Tags:" FontWeight="SemiBold" Margin="0,8,0,0"/>
                        <ItemsControl ItemsSource="{Binding Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{Binding}" Margin="0,2,6,2" FontSize="12" BorderThickness="0" Command="{Binding $parent[UserControl].((vm:ArtworkDetailViewModel)DataContext).SearchByTagCommand}" CommandParameter="{Binding}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                                                <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSoftAccent}"/>
                                            </Style>
                                        </Button.Styles>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Navigation Footer -->
        <Border Grid.Row="2" 
                Background="{DynamicResource Container1BackgroundBrush}" 
                Padding="16,8" 
                BorderBrush="{DynamicResource Container1BorderBrush}" 
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="← Previous" Command="{Binding GoToPreviousPageCommand}" IsEnabled="{Binding CanGoToPreviousPage}"/>
                
                <TextBlock Grid.Column="2" 
                          Text="{Binding StatusMessage}" 
                          VerticalAlignment="Center"
                          Margin="16,0"/>
                
                <Button Content="Next →" Command="{Binding GoToNextPageCommand}" IsEnabled="{Binding CanGoToNextPage}"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.Row="1" 
              Background="#80000000" 
              IsVisible="{Binding IsLoading}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Margin="0,0,0,8"/>
                <TextBlock Text="Loading..." Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
