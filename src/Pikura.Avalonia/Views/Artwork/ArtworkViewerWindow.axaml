<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        xmlns:vm="using:Pikura.Avalonia.ViewModels"
        xmlns:anim="using:Pikura.Avalonia.Controls"
        x:Class="Pikura.Avalonia.Views.Artwork.ArtworkViewerWindow"
        x:DataType="vm:ArtworkViewerViewModel"
        Title="{Binding Title, StringFormat='Pikura — {0}'}"
        Width="1000" Height="750"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ImageCanvasBackgroundBrush}">

    <Grid RowDefinitions="Auto,*,Auto" Name="MainGrid">

        <!-- Zoom toolbar -->
        <Border Grid.Row="0" Name="TopToolbar"
                Background="{DynamicResource Container2BackgroundBrush}"
                BorderBrush="{DynamicResource Container2BorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Name="PopupZoomOutBtn" FontSize="14">
                    <PathIcon Data="{StaticResource MinusIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button Name="PopupZoomFitBtn" Content="Fit" FontSize="12"/>
                <Button Name="PopupZoomInBtn" FontSize="14">
                    <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <TextBlock Name="PopupZoomLabel" Text="100%" VerticalAlignment="Center"
                           Margin="8,0" FontSize="11"
                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                <TextBlock Text="|" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource Container1BorderBrush}"/>
                <TextBlock Name="PopupResLabel" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                <TextBlock Text="|" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource Container1BorderBrush}"/>
                <Button Name="PopupFullscreenBtn" FontSize="14" Click="OnFullscreenClicked">
                    <PathIcon Data="{StaticResource FullscreenEnterIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Image area -->
        <Grid Grid.Row="1" Name="ImageArea" Background="{DynamicResource ImageCanvasBackgroundBrush}">
            <!-- Just the image, nothing else. Canvas for positioning. -->
            <Canvas Name="PopupCanvas" ClipToBounds="True" Background="{DynamicResource ImageCanvasBackgroundBrush}">
                <Image Name="PopupImage"
                       Source="{Binding CurrentPageBitmap}"
                       Stretch="Uniform"
                       RenderTransformOrigin="0,0"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       IsVisible="{Binding !IsUgoira}"/>                
                <!-- Ugoira animated playback -->
                <anim:AnimatedImage Name="UgoiraImage"
                                    SourcePath="{Binding UgoiraPreviewPath}"
                                    IsPlaying="{Binding IsPlayingUgoira}"
                                    Stretch="Uniform"
                                    RenderTransformOrigin="0,0"
                                    IsVisible="{Binding IsUgoira}"/>
            </Canvas>

            <!-- Loading spinner (hidden in fullscreen) -->
            <StackPanel Name="LoadingSpinner" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        IsVisible="{Binding IsLoadingPage}">
                <ProgressBar IsIndeterminate="True" Width="160"/>
                <TextBlock Text="Loading…" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Bottom panel: info + actions -->
        <Border Grid.Row="2" Name="BottomPanel"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Info -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <SelectableTextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                         TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SelectableTextBlock Text="{Binding ArtistName}" FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        <TextBlock Text="{Binding TypeLabel}" FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        <TextBlock Text="{Binding PageCount, StringFormat='{}{0} pages'}"
                                   FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   IsVisible="{Binding HasMultiplePages}"/>
                        <Border Background="#CC374151" CornerRadius="4" Padding="5,1"
                                IsVisible="{Binding IsR18}">
                            <TextBlock Text="R-18" FontSize="10" Foreground="#FC8181" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding TagsText}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>

                <!-- Download actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button FontSize="12" Command="{Binding DownloadCurrentPageCommand}" IsEnabled="{Binding !IsDownloading}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="This page" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button FontSize="12" Command="{Binding DownloadAllPagesCommand}" Classes="accent" IsEnabled="{Binding !IsDownloading}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="All pages" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button FontSize="12" Command="{Binding DownloadRangeCommand}" IsEnabled="{Binding !IsDownloading}" IsVisible="{Binding HasMultiplePages}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="Range…" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button FontSize="12" Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Path Data="{StaticResource CloseIcon}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" UseLayoutRounding="False"/>
                            <TextBlock Text="Close" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                                 IsVisible="{Binding IsDownloading}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
