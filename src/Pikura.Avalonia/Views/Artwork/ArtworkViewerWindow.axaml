<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        xmlns:vm="using:Pikura.Avalonia.ViewModels"
        xmlns:anim="using:Pikura.Avalonia.Controls"
        xmlns:conv="using:Pikura.Avalonia.Converters"
        x:Class="Pikura.Avalonia.Views.Artwork.ArtworkViewerWindow"
        x:DataType="vm:ArtworkViewerViewModel"
        Title="{Binding Title, StringFormat='Pikura — {0}'}"
        Width="1000" Height="750"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ImageCanvasBackgroundBrush}">

    <Window.Styles>
        <!-- Background must come from styles (not a local value) or the .current highlight can't win. -->
        <Style Selector="Button.page">
            <Setter Property="Background" Value="{DynamicResource Container2BackgroundBrush}"/>
        </Style>
        <Style Selector="Button.page.current">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrushSolidAccent}"/>
        </Style>
        <Style Selector="Border.pagetile.current">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
            <Setter Property="BorderThickness" Value="3"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Name="MainGrid">

        <!-- Zoom toolbar -->
        <Border Grid.Row="0" Name="TopToolbar"
                Background="{DynamicResource Container2BackgroundBrush}"
                BorderBrush="{DynamicResource Container2BorderBrush}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Name="PopupZoomOutBtn" FontSize="14">
                    <PathIcon Data="{StaticResource MinusIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <Button Name="PopupZoomFitBtn" Content="{loc:Tr Viewer_Fit}" FontSize="12"/>
                <Button Name="PopupZoomInBtn" FontSize="14">
                    <PathIcon Data="{StaticResource PlusIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
                <TextBlock Name="PopupZoomLabel" Text="100%" VerticalAlignment="Center"
                           Margin="8,0" FontSize="11"
                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                <TextBlock Text="|" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource Container1BorderBrush}"/>
                <TextBlock Name="PopupResLabel" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                <TextBlock Text="|" VerticalAlignment="Center" Margin="4,0"
                           Foreground="{DynamicResource Container1BorderBrush}"/>
                <Button Name="PopupFullscreenBtn" FontSize="14" Click="OnFullscreenClicked">
                    <PathIcon Data="{StaticResource FullscreenEnterIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                </Button>
            </StackPanel>
        </Border>

        <!-- Image area -->
        <Grid Grid.Row="1" Name="ImageArea" Background="{DynamicResource ImageCanvasBackgroundBrush}">
            <!-- Just the image, nothing else. Canvas for positioning. -->
            <Canvas Name="PopupCanvas" ClipToBounds="True" Background="{DynamicResource ImageCanvasBackgroundBrush}">
                <Image Name="PopupImage"
                       Source="{Binding CurrentPageBitmap}"
                       Stretch="Uniform"
                       RenderTransformOrigin="0,0"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       IsVisible="{Binding !IsUgoira}"/>                
                <!-- Ugoira animated playback -->
                <anim:AnimatedImage Name="UgoiraImage"
                                    SourcePath="{Binding UgoiraPreviewPath}"
                                    IsPlaying="{Binding IsPlayingUgoira}"
                                    Stretch="Uniform"
                                    RenderTransformOrigin="0,0"
                                    IsVisible="{Binding IsUgoira}"/>
            </Canvas>

            <!-- Loading spinner (hidden in fullscreen) -->
            <StackPanel Name="LoadingSpinner" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10"
                        IsVisible="{Binding IsLoadingPage}">
                <ProgressBar IsIndeterminate="True" Width="160"/>
                <TextBlock Text="{loc:Tr Common_Loading_2}" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- All-pages grid overlay -->
            <Border x:Name="PageGridOverlay"
                    IsVisible="{Binding IsPageGridVisible}"
                    Background="#E6000000"
                    Padding="24">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <TextBlock Text="{loc:Tr Viewer_AllPages}"
                                   FontSize="16"
                                   Foreground="White"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕"
                                FontSize="14"
                                Padding="8,4"
                                CornerRadius="4"
                                Click="OnClosePageGrid"
                                Background="{DynamicResource Container2BackgroundBrush}"
                                Foreground="White"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PageList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PageThumbnailItem">
                                    <Button Margin="8" Padding="0"
                                            Background="Transparent"
                                            Click="OnPageGridItemClick">
                                        <Border Width="120" CornerRadius="8"
                                                Classes="pagetile" Classes.current="{Binding IsCurrent}"
                                                ClipToBounds="True"
                                                Background="{DynamicResource Container1BackgroundBrush}">
                                            <Grid RowDefinitions="Auto,Auto">
                                                <Image Grid.Row="0"
                                                       Source="{Binding Thumbnail}"
                                                       Stretch="Uniform"
                                                       Width="120"
                                                       Height="{Binding AspectRatio, Converter={x:Static conv:AspectRatioToHeightConverter.Instance}, ConverterParameter=120}"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       UseLayoutRounding="True"/>
                                                <Border Grid.Row="1"
                                                        Background="#CC000000"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding Number}"
                                                               HorizontalAlignment="Center"
                                                               Foreground="White"
                                                               FontSize="11"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Page bar: prev/next, indicator, numbered pages, all-pages toggle -->
        <Border Grid.Row="2" Name="PageBar"
                IsVisible="{Binding HasMultiplePages}"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="8,4">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
                <Button Grid.Column="0" Command="{Binding PrevPageCommand}" Padding="6,4" CornerRadius="4">
                    <PathIcon Data="{StaticResource ChevronLeftIcon}" Width="12" Height="12"
                              VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
                <TextBlock Grid.Column="1" Text="{Binding PageIndicator}"
                           FontSize="11" VerticalAlignment="Center" Margin="8,0"
                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                <ScrollViewer Grid.Column="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PageList}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="4"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PageThumbnailItem">
                                <Button Content="{Binding Number}"
                                        CornerRadius="4"
                                        Padding="8,4"
                                        FontSize="11"
                                        Classes="page" Classes.current="{Binding IsCurrent}"
                                        Click="OnPageStripClick"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <Button Grid.Column="3" Command="{Binding NextPageCommand}" Padding="6,4" CornerRadius="4"
                        Margin="8,0,0,0">
                    <PathIcon Data="{StaticResource ChevronRightIcon}" Width="12" Height="12"
                              VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}"/>
                </Button>
                <Button Grid.Column="4"
                        Content="{loc:Tr Search_All}"
                        CornerRadius="4"
                        Padding="10,4"
                        FontSize="11"
                        Margin="8,0,0,0"
                        Command="{Binding TogglePageGridCommand}"
                        Background="{DynamicResource Container2BackgroundBrush}"
                        ToolTip.Tip="{loc:Tr Viewer_ShowAllPages}"/>
            </Grid>
        </Border>

        <!-- Bottom panel: info + actions -->
        <Border Grid.Row="3" Name="BottomPanel"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto">

                <!-- Info -->
                <StackPanel Grid.Column="0" Spacing="4">
                    <SelectableTextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"
                                         TextTrimming="CharacterEllipsis"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <SelectableTextBlock Text="{Binding ArtistName}" FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        <TextBlock Text="{Binding TypeLabel}" FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        <TextBlock Text="{Binding PageCount, StringFormat='{}{0} pages'}"
                                   FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   IsVisible="{Binding HasMultiplePages}"/>
                        <Border Background="#CC374151" CornerRadius="4" Padding="5,1"
                                IsVisible="{Binding IsR18}">
                            <TextBlock Text="R-18" FontSize="10" Foreground="#FC8181" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding TagsText}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                </StackPanel>

                <!-- Download actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button FontSize="12" Command="{Binding DownloadCurrentPageCommand}" IsEnabled="{Binding !IsDownloading}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_ThisPage}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button FontSize="12" Command="{Binding DownloadAllPagesCommand}" Classes="accent" IsEnabled="{Binding !IsDownloading}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_AllPages}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button FontSize="12" Command="{Binding DownloadRangeCommand}" IsEnabled="{Binding !IsDownloading}" IsVisible="{Binding HasMultiplePages}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <PathIcon Data="{StaticResource DownloadIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="{loc:Tr Viewer_Range}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button FontSize="12" Command="{Binding CloseCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <Path Data="{StaticResource CloseIcon}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round"
                                  VerticalAlignment="Center" UseLayoutRounding="False"/>
                            <TextBlock Text="{loc:Tr Common_Close}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <ProgressBar IsIndeterminate="True" Width="60" Height="4"
                                 IsVisible="{Binding IsDownloading}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
