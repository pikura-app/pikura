<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        x:Class="Pikura.Avalonia.Views.Dialogs.ArtistSettingsDialog"
        Title="{loc:Tr Artist_ArtistDownloadSettings}"
        Width="620"
        Height="620"
        MinWidth="520"
        MinHeight="480"
        MaxHeight="740"
        WindowStartupLocation="CenterOwner"
        CanResize="True">

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Container2BackgroundBrush}"
                BorderBrush="{DynamicResource Container2BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock x:Name="TitleTextBlock" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Tr Artist_LeaveFieldsBlankToInheritGlobal}"
                               FontSize="11"
                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                </StackPanel>
                <CheckBox x:Name="UseGlobalSettingsCheckBox"
                          Grid.Column="1"
                          Content="{loc:Tr Artist_UseGlobalDefaults}"
                          FontSize="11"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"/>
            </Grid>
        </Border>

        <!-- Action bar -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource Container2BackgroundBrush}"
                BorderBrush="{DynamicResource Container2BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Content="{loc:Tr Artist_ResetToDefaults}" Click="ResetButton_Click" FontSize="12"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button x:Name="CancelBtn" Content="{loc:Tr Common_Cancel}" Click="CancelButton_Click"/>
                    <Button Content="{loc:Tr Common_Save}" Click="SaveButton_Click" Classes="accent"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: no ScrollViewer needed — content fits in window -->
        <StackPanel x:Name="SettingsPanel" Spacing="8" Margin="16,10,16,10">

            <!-- Row 1: Location + Naming side by side -->
            <Grid ColumnDefinitions="*,8,*">

                <!-- Location -->
                <Border Grid.Column="0"
                        Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container2BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Artist_Location}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{loc:Tr Artist_DownloadFolder}"
                                   FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBox Grid.Column="0"
                                     x:Name="DownloadRootTextBox"
                                     PlaceholderText="{loc:Tr Artist_GlobalFolder}"
                                     FontSize="11"
                                     CornerRadius="5"/>
                            <Button Content="…" Click="BrowseFolderButton_Click" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Naming -->
                <Border Grid.Column="2"
                        Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container2BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{loc:Tr Artist_Naming}" FontWeight="SemiBold" FontSize="12"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Settings_FolderTemplate}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                            <TextBox x:Name="FolderTemplateTextBox"
                                     PlaceholderText="%artist% (%member_id%)"
                                     FontSize="11" CornerRadius="5"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Settings_FilenameTemplate}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                            <TextBox x:Name="FilenameTemplateTextBox"
                                     PlaceholderText="%image_id% - %title%"
                                     FontSize="11" CornerRadius="5"/>
                        </StackPanel>
                        <TextBlock Text="%artist% %member_id% %image_id% %title% %page_index% %tags% %date%"
                                   FontSize="9"
                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Row 2: Filtering -->
            <Border Background="{DynamicResource Container2BackgroundBrush}"
                    BorderBrush="{DynamicResource Container2BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid ColumnDefinitions="*,12,*,12,Auto">

                    <!-- Include tags -->
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="{loc:Tr Artist_IncludeTags}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBox x:Name="IncludeTagsTextBox"
                                 PlaceholderText="{loc:Tr Artist_TagsExample}"
                                 FontSize="11" CornerRadius="5"/>
                        <TextBlock Text="{loc:Tr Artist_OnlyDownloadArtworksWithTheseTags}"
                                   FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Exclude tags -->
                    <StackPanel Grid.Column="2" Spacing="4">
                        <TextBlock Text="{loc:Tr Artist_ExcludeTags}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBox x:Name="ExcludeTagsTextBox"
                                 PlaceholderText="{loc:Tr Artist_ExcludeExample}"
                                 FontSize="11" CornerRadius="5"/>
                        <TextBlock Text="{loc:Tr Artist_SkipArtworksThatHaveTheseTags}"
                                   FontSize="10"
                                   Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Date range + options -->
                    <StackPanel Grid.Column="4" Spacing="8" Width="140">
                        <TextBlock Text="{loc:Tr Artist_DateRange}" FontWeight="SemiBold" FontSize="12"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Artist_FromYYYYMMDD}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                            <TextBox x:Name="DateFromTextBox"
                                     PlaceholderText="e.g. 2023-01-01"
                                     FontSize="11" CornerRadius="5"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Artist_ToYYYYMMDD}"
                                       FontSize="10"
                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                            <TextBox x:Name="DateToTextBox"
                                     PlaceholderText="e.g. 2024-12-31"
                                     FontSize="11" CornerRadius="5"/>
                        </StackPanel>
                        <Button Content="{loc:Tr Artist_ClearDates}" Click="ClearDatesButton_Click" HorizontalAlignment="Stretch" FontSize="11"/>
                    </StackPanel>

                </Grid>
            </Border>

            <!-- Row 3: Behavior + AI (combined) -->
            <Border Background="{DynamicResource Container2BackgroundBrush}"
                    BorderBrush="{DynamicResource Container2BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12,10">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="{loc:Tr Artist_DownloadBehavior}"
                               FontWeight="SemiBold" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <CheckBox x:Name="CreateSubfolderCheckBox"
                              Grid.Column="1"
                              Content="{loc:Tr Artist_SubfolderPerSubmission}"
                              FontSize="11"
                              VerticalAlignment="Center"/>
                    <CheckBox x:Name="SeparateR18CheckBox"
                              Grid.Column="2"
                              Content="{loc:Tr DlArtist_SeparateR18Folder}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="12,0"/>
                    <Border Grid.Column="3" Width="1"
                            Background="{DynamicResource Container2BorderBrush}"
                            Margin="8,2" VerticalAlignment="Stretch"/>
                    <CheckBox x:Name="FilterAiCheckBox"
                              Grid.Column="4"
                              Content="{loc:Tr Artist_SkipAIGeneratedArtworks}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="8,0,0,0"/>
                    <CheckBox x:Name="AllowRedownloadCheckBox"
                              Grid.Column="5"
                              Content="{loc:Tr Artist_AllowReDownload}"
                              FontSize="11"
                              VerticalAlignment="Center"
                              Margin="12,0,0,0"/>
                </Grid>
            </Border>

        </StackPanel>

    </DockPanel>
</Window>
