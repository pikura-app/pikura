<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
        xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
        xmlns:anim="using:Pikura.Avalonia.Controls"
        xmlns:vm="clr-namespace:Pikura.Avalonia.ViewModels"
        xmlns:models="clr-namespace:Pikura.Core.Models"
        xmlns:dialogs="clr-namespace:Pikura.Avalonia.Views.Dialogs"
        x:Class="Pikura.Avalonia.Views.Dialogs.DownloadPresetWindow"
        Title="{loc:Tr Preset_PikuraDownloadWithPreset}"
        Width="1300"
        Height="850"
        WindowStartupLocation="CenterOwner"
        MinWidth="1000"
        MinHeight="650"
        CanResize="True">

    <Grid ColumnDefinitions="350,*,300">
        <!-- LEFT: Preset Selection -->
        <Border Grid.Column="0"
                Background="{DynamicResource Container2BackgroundBrush}"
                BorderBrush="{DynamicResource Container2BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="16">
            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="12">
                <TextBlock Grid.Row="0" Text="{loc:Tr Preset_Presets}" FontSize="18" FontWeight="Bold"/>

                <!-- Search -->
                <TextBox Grid.Row="1"
                         x:Name="PresetSearchBox"
                         PlaceholderText="{loc:Tr Preset_SearchPresets}"
                         TextChanged="OnPresetSearchChanged"/>

                <!-- Preset List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PresetList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dialogs:DownloadPresetWindow+PresetViewModel">
                                <Border x:Name="PresetItem"
                                        Background="{DynamicResource Container2BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container2BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,8"
                                        PointerPressed="OnPresetPointerPressed"
                                        Tag="{Binding}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="4">
                                            <TextBlock Text="{Binding Preset.Name}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Preset.DevicePreset}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBlock Text="{Binding Preset.Adjustments.HasAdjustments, StringFormat='Adjustments: {0}'}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </StackPanel>
                                        <RadioButton Grid.Column="1"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     GroupName="PresetGroup"
                                                     VerticalAlignment="Center"
                                                     Click="OnPresetRadioClick"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Orientation Toggle -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{loc:Tr Preset_Orientation}" VerticalAlignment="Center"/>
                    <ToggleButton x:Name="PortraitToggle" Content="{loc:Tr Search_Portrait}" IsCheckedChanged="OnOrientationChanged"/>
                    <ToggleButton x:Name="LandscapeToggle" Content="{loc:Tr Search_Landscape}" IsChecked="True" IsCheckedChanged="OnOrientationChanged"/>
                </StackPanel>

                <!-- Custom Button -->
                <Button x:Name="CustomPresetButton" Content="{loc:Tr Preset_CustomEdit}" HorizontalAlignment="Stretch" Classes="accent" Click="OnCustomEditClick"/>
            </Grid>
        </Border>

        <!-- CENTER: Image Preview -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*,Auto">
            <!-- Selected Images Header -->
            <Border Grid.Row="0"
                    Background="{DynamicResource Container2BackgroundBrush}"
                    BorderBrush="{DynamicResource Container2BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock x:Name="SelectedCountText" Text="{loc:Tr Preset_1ImageSelected}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubmissionInfoText"
                                   Text="{loc:Tr Preset_Submission1Of1}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   IsVisible="False"/>
                        <TextBlock x:Name="MultiPageInfoText"
                                   Text="{loc:Tr Preset_5TotalPagesAcross2Submissions}"
                                   FontSize="12"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   IsVisible="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PrevImageButton" Content="◀" Click="OnPrevImageClick" IsEnabled="False"/>
                        <!-- Submission indicator (shows X/Y for multi-selection) -->
                        <Border x:Name="SubmissionNumberBorder"
                                Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4">
                            <TextBlock x:Name="SubmissionIndicator" Text="1 / 1" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </Border>
                        <!-- Page indicator (only visible for multi-page, blue badge) -->
                        <Border x:Name="PageNumberBorder"
                                Background="#3B82F6"
                                CornerRadius="4"
                                Padding="8,4"
                                IsVisible="False">
                            <TextBlock x:Name="PageNumberText" Text="{loc:Tr Preset_Pg13}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                        <Button x:Name="NextImageButton" Content="▶" Click="OnNextImageClick" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Image Canvas -->
            <Border Grid.Row="1"
                    Background="{DynamicResource Container3BackgroundBrush}"
                    Margin="16">
                <Grid>
                    <!-- Loading Spinner -->
                    <ProgressBar x:Name="LoadingSpinner"
                                 IsIndeterminate="True"
                                 IsVisible="False"
                                 Width="100"
                                 Height="4"/>

                    <!-- Image with navigation overlays -->
                    <Grid>
                        <Image x:Name="PreviewImage"
                               Stretch="Uniform"
                               Margin="20"/>

                        <!-- Ugoira animation player (hidden by default) -->
                        <anim:AnimatedImage x:Name="UgoiraPlayer"
                                          Stretch="Uniform"
                                          Margin="20"
                                          IsVisible="False"/>

                        <!-- Left page navigation overlay -->
                        <Border x:Name="LeftNavOverlay"
                                Background="Transparent"
                                HorizontalAlignment="Left"
                                Width="60"
                                Cursor="Hand"
                                PointerPressed="OnLeftNavClick"
                                IsVisible="False">
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#80000000"
                                    CornerRadius="20"
                                    Padding="12,8"
                                    Opacity="0.6">
                                <TextBlock Text="◀" FontSize="20" Foreground="White"/>
                            </Border>
                        </Border>

                        <!-- Right page navigation overlay -->
                        <Border x:Name="RightNavOverlay"
                                Background="Transparent"
                                HorizontalAlignment="Right"
                                Width="60"
                                Cursor="Hand"
                                PointerPressed="OnRightNavClick"
                                IsVisible="False">
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#80000000"
                                    CornerRadius="20"
                                    Padding="12,8"
                                    Opacity="0.6">
                                <TextBlock Text="▶" FontSize="20" Foreground="White"/>
                            </Border>
                        </Border>

                        <!-- Play Animation button for ugoira -->
                        <Border x:Name="PlayAnimationButton"
                                Background="Transparent"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Cursor="Hand"
                                PointerPressed="OnPlayAnimationClick"
                                IsVisible="False">
                            <Border HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="#80000000"
                                    CornerRadius="30"
                                    Padding="20,12"
                                    Opacity="0.8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="▶" FontSize="24" Foreground="White"/>
                                    <TextBlock Text="{loc:Tr Preset_Play}" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- Canvas for crop overlay -->
                    <Canvas x:Name="CropOverlayCanvas"
                          Background="Transparent"
                          IsVisible="False"/>

                    <!-- Empty state -->
                    <TextBlock x:Name="NoPreviewText"
                               Text="{loc:Tr Preset_SelectAnImageToPreview}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                </Grid>
            </Border>

            <!-- Preview Controls -->
            <Border Grid.Row="2"
                    Background="{DynamicResource Container2BackgroundBrush}"
                    BorderBrush="{DynamicResource Container2BorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Text="{loc:Tr Preset_PreviewQuality}" VerticalAlignment="Center"/>
                    <Slider x:Name="PreviewQualitySlider"
                            Minimum="400"
                            Maximum="1200"
                            Value="800"
                            Width="150"
                            ValueChanged="OnPreviewQualityChanged"/>
                    <TextBlock x:Name="PreviewQualityValue" Text="{loc:Tr Preset_800px}" VerticalAlignment="Center"/>
                    <CheckBox x:Name="ShowCropOverlayCheck"
                              Content="{loc:Tr Preset_ShowCrop}"
                              IsChecked="False"
                              IsCheckedChanged="OnShowCropChanged"/>
                    <Button x:Name="ResetPreviewButton" Content="{loc:Tr Preset_Reset}" Click="OnResetPreviewClick"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- RIGHT: Output Options & Actions -->
        <Border Grid.Column="2"
                Background="{DynamicResource Container2BackgroundBrush}"
                BorderBrush="{DynamicResource Container2BorderBrush}"
                BorderThickness="1,0,0,0"
                Padding="16">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto" RowSpacing="16">
                <TextBlock Grid.Row="0" Text="{loc:Tr Preset_OutputOptions}" FontSize="16" FontWeight="Bold"/>

                <!-- Output Options -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">
                        <!-- Save Mode -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Preset_SaveMode}" FontWeight="SemiBold"/>
                            <RadioButton x:Name="SaveAsNewRadio"
                                         Content="{loc:Tr Preset_SaveAsNewFileProcessed}"
                                         IsChecked="True"
                                         GroupName="SaveModeGroup"/>
                            <RadioButton x:Name="OverwriteRadio"
                                         Content="{loc:Tr Preset_OverwriteOriginal}"
                                         GroupName="SaveModeGroup"/>
                        </StackPanel>

                        <!-- Also download unprocessed -->
                        <StackPanel Spacing="4">
                            <CheckBox x:Name="AlsoDownloadUnprocessedCheck"
                                      Content="{loc:Tr Preset_AlsoDownloadUnprocessedCopy}"
                                      ToolTip.Tip="{loc:Tr Preset_DownloadsTheOriginalUnprocessedImageAlon}"/>
                        </StackPanel>

                        <!-- Format -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Settings_OutputFormat}" FontWeight="SemiBold"/>
                            <ComboBox x:Name="FormatComboBox" SelectedIndex="0">
                                <ComboBoxItem Content="{loc:Tr Preset_KeepOriginal}"/>
                                <ComboBoxItem Content="{loc:Tr Settings_JpegHigh}"/>
                                <ComboBoxItem Content="{loc:Tr Settings_JpegMedium}"/>
                                <ComboBoxItem Content="{loc:Tr Settings_PngLossless}"/>
                                <ComboBoxItem Content="WebP"/>
                            </ComboBox>
                            <Slider x:Name="JpegQualitySlider"
                                    Minimum="1"
                                    Maximum="100"
                                    Value="90"
                                    IsVisible="False"/>
                        </StackPanel>

                        <!-- Ugoira (Animated) Format Options -->
                        <StackPanel x:Name="UgoiraFormatPanel" Spacing="4" IsVisible="False">
                            <TextBlock Text="{loc:Tr Preset_AnimationOutputFormats}" FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Tr Preset_SelectWhichFormatsToCreateFor}"
                                       FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                            <WrapPanel>
                                <CheckBox x:Name="UgoiraMp4Check" Content="{loc:Tr Preset_MP4Recommended}" IsChecked="True"
                                          FontSize="13" Margin="0,4,16,4"/>
                                <CheckBox x:Name="UgoiraGifCheck" Content="GIF" IsChecked="False"
                                          FontSize="13" Margin="0,4,16,4"/>
                                <CheckBox x:Name="UgoiraWebmCheck" Content="WebM" IsChecked="False"
                                          FontSize="13" Margin="0,4,16,4"/>
                                <CheckBox x:Name="UgoiraWebpCheck" Content="WebP" IsChecked="False"
                                          FontSize="13" Margin="0,4,16,4"/>
                            </WrapPanel>
                            <StackPanel Spacing="4">
                                <CheckBox x:Name="UgoiraSaveFramesCheck"
                                          Content="{loc:Tr Preset_SaveProcessedFramesToSubfolder}"
                                          IsChecked="False"
                                          FontSize="12"
                                          ToolTip.Tip="{loc:Tr Preset_CreatesASubfolderWithEachProcessed}"/>
                                <CheckBox x:Name="UgoiraFramesOnlyCheck"
                                          Content="{loc:Tr Preset_FramesOnlySkipAnimation}"
                                          IsChecked="False"
                                          FontSize="12"
                                          IsEnabled="{Binding #UgoiraSaveFramesCheck.IsChecked}"
                                          ToolTip.Tip="{loc:Tr Preset_DownloadOnlyTheIndividualFramesWithout}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Batch Mode (for multi-selection) -->
                        <StackPanel x:Name="BatchModePanel" Spacing="4" IsVisible="False">
                            <Separator/>
                            <CheckBox x:Name="EnableBatchModeCheck"
                                      Content="{loc:Tr Preset_ConfigureEachSubmission}"
                                      ToolTip.Tip="{loc:Tr Preset_EnableToSetDifferentPageSelections}"
                                      IsChecked="False"
                                      IsCheckedChanged="OnBatchModeChanged"/>
                            <Border x:Name="BatchSubmissionsBorder"
                                    Background="{DynamicResource Container3BackgroundBrush}"
                                    BorderBrush="{DynamicResource Container3BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="8"
                                    IsVisible="False">
                                <ScrollViewer x:Name="BatchSubmissionsList"
                                              MaxHeight="180">
                                    <StackPanel x:Name="BatchSubmissionsStack" Spacing="6"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Custom Folder -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Preset_OutputFolder}" FontWeight="SemiBold"/>
                            <CheckBox x:Name="UseCustomFolderCheck"
                                      Content="{loc:Tr Preset_SaveToCustomFolder}"
                                      IsChecked="False"
                                      IsCheckedChanged="OnCustomFolderChanged"/>
                            <TextBox x:Name="CustomFolderTextBox"
                                     PlaceholderText="{loc:Tr Batch_SelectFolder}"
                                     IsReadOnly="True"
                                     IsVisible="False"/>
                            <Button x:Name="BrowseFolderButton" Content="{loc:Tr Common_Browse}" Click="OnBrowseFolderClick" IsVisible="False"/>
                        </StackPanel>

                        <!-- Divider -->
                        <Separator/>

                        <!-- Preset Actions -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{loc:Tr Preset_PresetActions}" FontWeight="SemiBold"/>
                            <Button x:Name="SavePresetButton" Content="{loc:Tr Preset_SaveCurrentAsPreset}" HorizontalAlignment="Stretch" Click="OnSavePresetClick"/>
                            <Button x:Name="DeletePresetButton" Content="{loc:Tr Preset_DeleteCustomPreset}" HorizontalAlignment="Stretch" IsEnabled="False" Click="OnDeletePresetClick"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Preset Info -->
                <Border Grid.Row="2"
                        Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container2BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="CurrentPresetName" Text="{loc:Tr Preset_OriginalNoProcessing}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CurrentPresetInfo"
                                   Text="{loc:Tr Preset_NoResizeOrAdjustments}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                    </StackPanel>
                </Border>

                <!-- Apply Buttons -->
                <StackPanel Grid.Row="3" Spacing="6">
                    <Grid ColumnDefinitions="*,4,*" RowDefinitions="Auto,4,Auto">
                        <Button x:Name="ApplyToPageButton" Content="{loc:Tr Viewer_Page}" HorizontalAlignment="Stretch" Height="34" FontSize="12" Click="OnApplyToPageClick"/>
                        <Button x:Name="ApplyToSelectedPagesButton" Content="{loc:Tr Preset_SelectedPages}" HorizontalAlignment="Stretch" Height="34" FontSize="12" Click="OnApplyToSelectedPagesClick">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight"
                                        ShowMode="TransientWithDismissOnPointerMoveAway">
                                    <Border Background="{DynamicResource Container3BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container3BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="12"
                                            Width="280">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="{loc:Tr Preset_SelectPagesToApplyPreset}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                            <TextBox x:Name="PagePickerTextBox"
                                                     PlaceholderText="{loc:Tr Preset_PagesExample1}"
                                                     FontSize="12"
                                                     TextChanged="OnPagePickerTextChanged"/>
                                            <WrapPanel x:Name="PagePickerPanel"
                                                       Orientation="Horizontal"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Top"/>
                                            <Grid ColumnDefinitions="*,4,*,4,*">
                                                <Button Content="{loc:Tr Search_All}" HorizontalAlignment="Stretch" FontSize="11" Click="OnPagePickerAllClick"/>
                                                <Button Content="{loc:Tr Preset_None}" HorizontalAlignment="Stretch" FontSize="11" Click="OnPagePickerNoneClick"/>
                                                <Button Content="{loc:Tr Preset_Invert}" HorizontalAlignment="Stretch" FontSize="11" Click="OnPagePickerInvertClick"/>
                                            </Grid>
                                            <Button x:Name="PagePickerApplyButton" Content="{loc:Tr Preset_ApplyPreset}" HorizontalAlignment="Stretch" Classes="accent" Height="34" Click="OnPagePickerApplyClick"/>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button x:Name="ApplyToArtworkButton" Content="{loc:Tr Preset_Artwork}" HorizontalAlignment="Stretch" Height="34" FontSize="12" Click="OnApplyToArtworkClick"/>
                        <Button x:Name="ApplyToAllButton" Content="{loc:Tr Search_All}" HorizontalAlignment="Stretch" Height="34" FontSize="12" Click="OnApplyToAllClick"/>
                    </Grid>
                    <Button x:Name="ApplyToSelectedArtworksButton" Content="{loc:Tr Preset_ApplyToSelectedArtworks}" HorizontalAlignment="Stretch" Height="34" FontSize="12" Click="OnApplyToSelectedArtworksClick"/>
                    <Border x:Name="ApplyToArtworksPanel"
                            Background="{DynamicResource Container3BackgroundBrush}"
                            BorderBrush="{DynamicResource Container3BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8"
                            IsVisible="True"
                            MaxHeight="140">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ApplyToArtworksStack" Spacing="4"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="AppliedPresetStatus"
                               Text=""
                               FontSize="11"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                               IsVisible="False"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Row="4" Spacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Tr Preset_DownloadArtworks}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DownloadArtworksComboBox"
                                  SelectionChanged="OnDownloadArtworksChanged">
                            <ComboBoxItem Content="{loc:Tr Preset_CurrentArtworkOnly}"/>
                        </ComboBox>
                        <TextBox x:Name="DownloadArtworksTextBox"
                                 PlaceholderText="{loc:Tr Preset_PagesExample2}"
                                 FontSize="12"
                                 IsVisible="False"/>
                        <Border x:Name="DownloadArtworksPanel"
                                Background="{DynamicResource Container3BackgroundBrush}"
                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                IsVisible="False"
                                MaxHeight="140">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="DownloadArtworksStack" Spacing="4"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{loc:Tr Preset_DownloadScope}" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DownloadScopeComboBox"
                                  SelectedIndex="0"
                                  SelectionChanged="OnDownloadScopeChanged">
                            <ComboBoxItem Content="{loc:Tr Viewer_AllPages}"/>
                            <ComboBoxItem Content="{loc:Tr Preset_PagesWithPresetsOnly}"/>
                            <ComboBoxItem Content="{loc:Tr Preset_CurrentPageOnly}"/>
                            <ComboBoxItem Content="{loc:Tr Preset_SelectedPages_2}"/>
                        </ComboBox>
                        <TextBox x:Name="SelectedPagesTextBox"
                                 PlaceholderText="{loc:Tr Preset_PagesExample3}"
                                 IsVisible="False"/>
                    </StackPanel>
                    <Button x:Name="DownloadButton" Content="{loc:Tr Preset_Download}" HorizontalAlignment="Stretch" Classes="accent" Height="44" FontSize="14" Click="OnDownloadClick"/>
                    <Button x:Name="CancelButton" Content="{loc:Tr Common_Cancel}" HorizontalAlignment="Stretch" Height="36" Click="OnCancelClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
