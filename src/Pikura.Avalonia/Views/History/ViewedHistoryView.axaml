<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             xmlns:gallery="using:Pikura.Avalonia.Views.Gallery"
             xmlns:services="using:Pikura.Avalonia.Services"
             xmlns:dialogs="using:Pikura.Avalonia.Views.Dialogs"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Pikura.Avalonia.Views.History.ViewedHistoryView"
             x:DataType="vm:ViewedHistoryViewModel">

    <UserControl.Resources>
        <conv:BoolToBlurRadiusConverter x:Key="BoolToBlurRadiusConverter"/>

        <ContextMenu x:Key="ViewedCardContextMenu" x:DataType="vm:ArtworkCardViewModel">
            <MenuItem Header="☑ Select" Click="OnContextToggleSelection" IsVisible="{Binding !IsSelected}"/>
            <MenuItem Header="☒ Deselect" Click="OnContextToggleSelection" IsVisible="{Binding IsSelected}"/>
            <Separator/>
            <MenuItem Header="↓ Download all" Click="OnContextDownloadAll"/>
            <MenuItem Header="↓ First page only" Click="OnContextDownloadThisPage" IsVisible="{Binding IsMultiPage}"/>
            <Separator/>
            <MenuItem Header="👁 Open in side panel" Click="OnContextPreview"/>
            <MenuItem Header="⛶ Open full screen" Click="OnContextOpenFullScreen"/>
            <MenuItem Header="⊞ Open in new tab" Click="OnContextOpenInNewTab"/>
            <MenuItem Header="⧉ Open in popup" Click="OnContextOpenPopup"/>
            <MenuItem Header="🌐 Open on pixiv.net" Click="OnContextOpenPixiv"/>
            <MenuItem Header="👤 Open artist gallery" Click="OnContextOpenArtistGallery"/>
            <Separator/>
            <MenuItem Header="★ Add to local favorites" Click="OnContextToggleFavorite" IsVisible="{Binding !IsLocalFavorite}"/>
            <MenuItem Header="★ Remove from favorites" Click="OnContextToggleFavorite" IsVisible="{Binding IsLocalFavorite}"/>
            <Separator/>
            <MenuItem Header="Copy artwork ID" Click="OnContextCopyId"/>
            <MenuItem Header="Copy artist ID" Click="OnContextCopyArtistId"/>
            <MenuItem Header="📋 Copy image" Click="OnContextCopyImage"/>
            <MenuItem Header="🖼 Use as app background" Click="OnContextUseAsBackground" IsVisible="{Binding IsEnabled, Source={x:Static services:AppServices.OverlayService}}"/>
            <Separator/>
            <MenuItem Header="✕ Remove from history" Click="OnContextRemove"/>
        </ContextMenu>
    </UserControl.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ══ Row 0: Title + actions ══ -->
        <Border Grid.Row="0"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,10"
                Margin="0,32,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="History" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
                    <Button Content="⟳"   FontSize="11"
                            VerticalAlignment="Center"
                            Command="{Binding ReloadCommand}" ToolTip.Tip="Refresh"/>
                    <ToggleButton IsChecked="{Binding IncognitoModeEnabled, Mode=TwoWay}"   FontSize="11"
                                  BorderThickness="1" VerticalAlignment="Center"
                                  ToolTip.Tip="Incognito mode: artworks you open won't be added to this history while enabled.">
                        <ToggleButton.Styles>
                            <Style Selector="ToggleButton">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Container1BorderBrush}"/>
                            </Style>
                            <Style Selector="ToggleButton:checked">
                                <Setter Property="Background" Value="#7C3AED"/>
                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                            </Style>
                            <Style Selector="ToggleButton:checked TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                            </Style>
                        </ToggleButton.Styles>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="🕶" FontSize="12"/>
                            <TextBlock Text="Incognito: Off" FontSize="11" IsVisible="{Binding !IncognitoModeEnabled}"/>
                            <TextBlock Text="Incognito: On" FontSize="11" FontWeight="Bold" IsVisible="{Binding IncognitoModeEnabled}"/>
                        </StackPanel>
                    </ToggleButton>
                    <ProgressBar IsIndeterminate="True" Width="70" Height="3"
                                 IsVisible="{Binding IsLoading}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                            BorderBrush="{DynamicResource Container1BorderBrush}"
                            BorderThickness="1" CornerRadius="7" Padding="3">
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <Button Name="CalendarFlyoutButton" Content="📅" FontSize="12"
                                      Background="Transparent" BorderThickness="0"
                                    ToolTip.Tip="Browse by exact date">
                                <Button.Flyout>
                                    <Flyout Placement="Bottom" ShowMode="Standard" Opened="OnCalendarOpened">
                                        <Calendar Name="DatePopupCalendar"
                                                  SelectionMode="SingleDate"
                                                  SelectedDatesChanged="OnCalendarSelectedDateChanged"/>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Name="QuickRangeButton" Content="⏱" FontSize="12"
                                      Background="Transparent" BorderThickness="0"
                                    ToolTip.Tip="Quick range">
                                <Button.Flyout>
                                    <MenuFlyout Placement="Bottom">
                                        <MenuItem Header="Today"      Command="{Binding SetQuickRangeCommand}" CommandParameter="today"/>
                                        <MenuItem Header="Past day"   Command="{Binding SetQuickRangeCommand}" CommandParameter="day"/>
                                        <MenuItem Header="Past week"  Command="{Binding SetQuickRangeCommand}" CommandParameter="week"/>
                                        <MenuItem Header="Past month" Command="{Binding SetQuickRangeCommand}" CommandParameter="month"/>
                                        <MenuItem Header="Past year"  Command="{Binding SetQuickRangeCommand}" CommandParameter="year"/>
                                        <Separator/>
                                        <MenuItem Header="Custom range…" Click="OnCustomRangeMenuClick"/>
                                        <Separator/>
                                        <MenuItem Header="All time" Command="{Binding GoToAllTimeCommand}"/>
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock Text="{Binding DateLabel}" FontSize="11" VerticalAlignment="Center" Margin="8,0"/>
                            <Button Content="⊙" FontSize="12"  
                                    Background="Transparent" BorderThickness="0"
                                    IsVisible="{Binding IsFilteredByDate}"
                                    Command="{Binding GoToAllTimeCommand}"
                                    ToolTip.Tip="Back to all time"/>
                        </StackPanel>
                    </Border>
                    <!-- Custom range picker — an anchored Popup (like an airline booking site's
                         inline date-range dropdown) rather than a separate modal window. -->
                    <Popup Name="CustomRangePopup" PlacementTarget="{Binding #QuickRangeButton}"
                           Placement="BottomEdgeAlignedLeft" IsLightDismissEnabled="False">
                        <dialogs:DateRangePickerPanel Name="CustomRangePanel"
                                                       Applied="OnCustomRangeApplied"
                                                       Cancelled="OnCustomRangeCancelled"/>
                    </Popup>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <ToggleButton IsChecked="{Binding IsDefaultMode}"   FontSize="11"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="default"
                                  ToolTip.Tip="Default — flat, chronological feed">🕒 Default</ToggleButton>
                    <ToggleButton IsChecked="{Binding IsGroupedMode}"   FontSize="11"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="grouped"
                                  ToolTip.Tip="Grouped — collage thumbnail per day">▦ Grouped</ToggleButton>
                    <ToggleButton IsChecked="{Binding IsListMode}"   FontSize="11"
                                  Command="{Binding SetViewModeCommand}" CommandParameter="list"
                                  ToolTip.Tip="List — day-by-day list">📋 List</ToggleButton>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="3,0"/>
                    <ToggleButton IsChecked="{Binding IsGridView}"   FontSize="11"
                                  Command="{Binding SetGridViewCommand}" IsVisible="{Binding IsDefaultMode}">⊞ Grid</ToggleButton>
                    <ToggleButton IsChecked="{Binding IsListView}"   FontSize="11"
                                  Command="{Binding SetListViewCommand}" IsVisible="{Binding IsDefaultMode}">☰ List</ToggleButton>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="3,0"
                               IsVisible="{Binding IsDefaultMode}"/>
                    <ToggleButton IsChecked="{Binding IsFixedHeight}"   FontSize="11"
                                  Command="{Binding SetFixedHeightCommand}" IsVisible="{Binding ShowResultsGrid}">
                        Fixed
                    </ToggleButton>
                    <ToggleButton IsChecked="{Binding IsNaturalHeight}"   FontSize="11"
                                  Command="{Binding SetNaturalHeightCommand}" IsVisible="{Binding ShowResultsGrid}">
                        Natural
                    </ToggleButton>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="3,0"/>
                    <Slider Value="{Binding CardSize}" Minimum="100" Maximum="320" Width="80" IsVisible="{Binding ShowResultsGrid}"/>
                    <ToggleButton IsChecked="{Binding ShowInfo}"   FontSize="11">Info</ToggleButton>
                    <ToggleButton IsChecked="{Binding ShowTags}"   FontSize="11">Tags</ToggleButton>
                    <Rectangle Width="1" Height="16" Fill="{DynamicResource Container1BorderBrush}" Margin="3,0"/>
                    <ToggleButton IsChecked="{Binding ShowPreview}"  Padding="10,5" FontSize="11">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="▣" FontSize="12"/>
                            <TextBlock Text="Show Panel" FontSize="11" IsVisible="{Binding !ShowPreview}"/>
                            <TextBlock Text="Hide Panel" FontSize="11" IsVisible="{Binding ShowPreview}"/>
                        </StackPanel>
                    </ToggleButton>
                    <Button Content="🗑"   FontSize="11" ToolTip.Tip="Clear history…">
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="Past hour"  Command="{Binding ClearHistoryRangeCommand}" CommandParameter="hour"/>
                                <MenuItem Header="Past day"   Command="{Binding ClearHistoryRangeCommand}" CommandParameter="day"/>
                                <MenuItem Header="Past week"  Command="{Binding ClearHistoryRangeCommand}" CommandParameter="week"/>
                                <MenuItem Header="Past month" Command="{Binding ClearHistoryRangeCommand}" CommandParameter="month"/>
                                <MenuItem Header="Past year"  Command="{Binding ClearHistoryRangeCommand}" CommandParameter="year"/>
                                <Separator/>
                                <MenuItem Header="All time"   Command="{Binding ClearHistoryRangeCommand}" CommandParameter="all"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ Row 1: Action buttons ══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <Button   FontSize="11"
                        Classes.accent="{Binding HasSelection}"
                        IsEnabled="{Binding HasSelection}"
                        Command="{Binding DownloadSelectedCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="↓" FontSize="12"/>
                        <TextBlock Text="{Binding SelectedCount, StringFormat='Download Selected ({0})'}"/>
                    </StackPanel>
                </Button>
                <Button   FontSize="11"
                        Command="{Binding DownloadAllVisibleCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="⊞" FontSize="12"/>
                        <TextBlock Text="Download Visible"/>
                    </StackPanel>
                </Button>
                <Button Content="☑ Select All"   FontSize="11" Command="{Binding SelectAllCommand}"/>
                <Button Content="{Binding SelectedCount, StringFormat='☒ Deselect All ({0})'}"
                          FontSize="11"
                        Command="{Binding ClearSelectionCommand}" IsVisible="{Binding HasSelection}"/>
                <Button Content="🎨 Download Preset"   FontSize="11"
                        Classes="accent"
                        Click="OnDownloadPresetClicked"
                        ToolTip.Tip="Download with image processing preset"/>
            </StackPanel>
        </Border>

        <!-- ══ Row 2: Results area ══ -->
        <Border Grid.Row="2" Background="{DynamicResource Container3BackgroundBrush}">
            <Grid Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="0" MinWidth="0"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Width="4"
                              Background="{DynamicResource Container1BorderBrush}"
                              IsVisible="{Binding ShowPreview}"
                              ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                              DragCompleted="OnSplitterDragCompleted"/>

                <Border Grid.Column="2"
                        Background="{DynamicResource Container1BackgroundBrush}"
                        BorderBrush="{DynamicResource Container1BorderBrush}"
                        BorderThickness="1,0,0,0"
                        IsVisible="{Binding ShowPreview}">
                    <gallery:InlineArtworkViewer Name="HistoryInlineViewer"
                                                 DataContext="{Binding GalleryVm}"
                                                 IsExpanded="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).IsViewerExpanded}"
                                                 IsPanelOpen="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).ShowPreview}"/>
                </Border>

                <Panel Grid.Column="0">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"
                                IsVisible="{Binding !HasResults}">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="400"/>
                    </StackPanel>

                    <!-- Grouped overview: one collage tile per day with 4 of that day's newest thumbnails -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="False" IsVisible="{Binding ShowDateGroups}">
                        <ScrollViewer.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="ShowDateGroups"/>
                                <Binding Path="IsGroupedMode"/>
                            </MultiBinding>
                        </ScrollViewer.IsVisible>
                        <ItemsControl ItemsSource="{Binding DateGroups}" Margin="10">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryDateGroupViewModel">
                                    <!--
                                        A Button (rather than a Border+PointerPressed) is used here specifically
                                        because Button guarantees its Click fires for any point within its bounds —
                                        unlike a bare Border/Panel, whose hit-testing can silently miss clicks on
                                        blank/label sub-regions depending on descendant backgrounds. Chrome is
                                        stripped via the styles below so it still looks like a plain card.
                                    -->
                                    <Button Width="200" Margin="0,0,10,10" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).OpenDateGroupCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </Button.Styles>
                                        <Border Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                BoxShadow="{DynamicResource CardShadow}">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BoxShadow" Value="0 6 20 0 #55000000"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                                </Style>
                                            </Border.Styles>
                                            <StackPanel>
                                                <Grid Width="200" Height="200" ColumnDefinitions="*,*" RowDefinitions="*,*" ClipToBounds="True">
                                                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource Container2BackgroundBrush}">
                                                        <Image Source="{Binding Thumb1}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource Container2BackgroundBrush}">
                                                        <Image Source="{Binding Thumb2}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource Container2BackgroundBrush}">
                                                        <Image Source="{Binding Thumb3}" Stretch="UniformToFill"/>
                                                    </Border>
                                                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource Container2BackgroundBrush}">
                                                        <Image Source="{Binding Thumb4}" Stretch="UniformToFill"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Margin="10,8,10,10" Spacing="1">
                                                    <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} viewed'}" FontSize="10"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- List overview: one row per day, with a single thumbnail, the date, and its view count -->
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  AllowAutoHide="False">
                        <ScrollViewer.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="ShowDateGroups"/>
                                <Binding Path="IsListMode"/>
                            </MultiBinding>
                        </ScrollViewer.IsVisible>
                        <ItemsControl ItemsSource="{Binding DateGroups}" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:HistoryDateGroupViewModel">
                                    <Button Margin="0,0,0,6" Padding="0" HorizontalContentAlignment="Stretch"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Command="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).OpenDateGroupCommand}"
                                            CommandParameter="{Binding}">
                                        <Button.Styles>
                                            <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                            <Style Selector="Button:pressed /template/ ContentPresenter">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </Style>
                                        </Button.Styles>
                                        <Border Padding="10,8"
                                                Background="{DynamicResource Container1BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container1BorderBrush}"
                                                BorderThickness="1" CornerRadius="8">
                                            <Border.Styles>
                                                <Style Selector="Border:pointerover">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                                </Style>
                                            </Border.Styles>
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Width="56" Height="56" CornerRadius="6" ClipToBounds="True"
                                                        Background="{DynamicResource Container2BackgroundBrush}">
                                                    <Image Source="{Binding Thumb1}" Stretch="UniformToFill"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding FullLabel}" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} viewed'}" FontSize="11"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="›" FontSize="18" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid RowDefinitions="Auto,*" IsVisible="{Binding !ShowDateGroups}">
                        <Button Grid.Row="0" Content="← Back to days"  Padding="10,5" FontSize="11"
                                Margin="10,10,0,0" HorizontalAlignment="Left"
                                Command="{Binding BackToGroupsCommand}"
                                IsVisible="{Binding DrillDownDate, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                        <ScrollViewer Grid.Row="1" Name="GridScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      AllowAutoHide="False"
                                      ScrollChanged="OnScrollChanged">
                        <Panel>
                        <ItemsControl ItemsSource="{Binding DisplayedResults}" Margin="10,10,4,10"
                                      IsVisible="{Binding ShowResultsGrid}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <gallery:MasonryPanel ColumnWidth="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).CardSize}" ItemSpacing="6"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtworkCardViewModel">
                                    <Border Margin="0,0,6,6"
                                            Width="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).CardSize}"
                                            Background="{DynamicResource Container1BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                            BorderThickness="1" CornerRadius="8"
                                            BoxShadow="{DynamicResource CardShadow}" Cursor="Hand"
                                            PointerPressed="OnCardClicked"
                                            ContextMenu="{StaticResource ViewedCardContextMenu}">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="BoxShadow" Value="0 6 20 0 #55000000"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Grid RowDefinitions="*,Auto">
                                            <Border Grid.Row="0"
                                                    Height="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).FixedCardTotalHeight}"
                                                    CornerRadius="7,7,0,0" ClipToBounds="True">
                                                <Panel>
                                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                            IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}"/>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                                        <Image.Effect>
                                                            <BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/>
                                                        </Image.Effect>
                                                    </Image>
                                                </Panel>
                                            </Border>
                                            <Border Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Right"
                                                    Margin="0,6,6,0" Padding="5,2" CornerRadius="4"
                                                    Background="#CCDC2626" IsVisible="{Binding IsR18}" IsHitTestVisible="False">
                                                <TextBlock Text="R-18" FontSize="8" Foreground="White" FontWeight="Bold"/>
                                            </Border>
                                            <CheckBox Grid.Row="0" ZIndex="6"
                                                      IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Top" HorizontalAlignment="Left"
                                                      Margin="6,6,0,0" MinWidth="0" MinHeight="0"
                                                      Click="OnCardCheckboxClicked"/>
                                            <StackPanel Grid.Row="1" Margin="8,5,8,7" Spacing="2"
                                                        IsVisible="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).ShowInfo}">
                                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{Binding UserName}" FontSize="10"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{Binding ViewedAtLabel}" FontSize="9"
                                                           Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                           IsVisible="{Binding HasViewedAt}"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                                              IsVisible="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).ShowTags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                                    CornerRadius="3" Padding="4,1" Margin="0,2,3,0">
                                                                <TextBlock Text="{Binding}" FontSize="8"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- List view -->
                        <ItemsControl ItemsSource="{Binding DisplayedResults}" Margin="10"
                                      IsVisible="{Binding ShowResultsList}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ArtworkCardViewModel">
                                    <Border Margin="0,0,0,6" Padding="8"
                                            Background="{DynamicResource Container1BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container1BorderBrush}"
                                            BorderThickness="1" CornerRadius="8" Cursor="Hand"
                                            PointerPressed="OnCardClicked"
                                            ContextMenu="{StaticResource ViewedCardContextMenu}">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
                                            </Style>
                                        </Border.Styles>
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                                      VerticalAlignment="Center" Margin="0,0,8,0"
                                                      Click="OnCardCheckboxClicked"/>
                                            <Border Grid.Column="1" Width="70" Height="70" CornerRadius="6" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                                    <Image.Effect>
                                                        <BlurEffect Radius="{Binding IsBlurred, Converter={StaticResource BoolToBlurRadiusConverter}}"/>
                                                    </Image.Effect>
                                                </Image>
                                            </Border>
                                            <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2"
                                                        IsVisible="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).ShowInfo}">
                                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{Binding UserName}" FontSize="11"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                <TextBlock Text="{Binding ViewedAtLabel}" FontSize="10"
                                                           Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                           IsVisible="{Binding HasViewedAt}"/>
                                                <ItemsControl ItemsSource="{Binding TopTags}" Margin="0,2,0,0"
                                                              IsVisible="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).ShowTags}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="x:String">
                                                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                                    CornerRadius="3" Padding="5,1" Margin="0,2,4,0">
                                                                <TextBlock Text="{Binding}" FontSize="9"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </Panel>
                        </ScrollViewer>
                    </Grid>
                </Panel>
            </Grid>
        </Border>

        <!-- ══ Row 3: Status bar ══ -->
        <Border Grid.Row="3"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,8">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" FontSize="11"
                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                           Text="{Binding StatusMessage}" VerticalAlignment="Center"/>

                <!-- Single switch: checked = paged (Prev/Next), unchecked = autoload while
                     scrolling — mirrors Rankings'/Pixivision's identical "Pages" toggle. Default
                     (flat) mode only; Grouped/List already show one date at a time. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsVisible="{Binding IsDefaultMode}">
                    <ToggleButton IsChecked="{Binding UsePagination, Mode=TwoWay}"
                                    FontSize="11"
                                  ToolTip.Tip="Toggle pagination (off = autoload while scrolling)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📄" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Pages" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ToggleButton>

                    <ComboBox IsVisible="{Binding UsePagination}"
                              SelectedItem="{Binding ItemsPerPage, Mode=TwoWay}"
                              ItemsSource="{Binding ItemsPerPageOptions}"
                              CornerRadius="6" MinWidth="75" FontSize="11"
                              ToolTip.Tip="Items per page"/>

                    <StackPanel IsVisible="{Binding UsePagination}" Orientation="Horizontal" Spacing="6">
                        <Button Content="‹ Prev"  Padding="10,5" FontSize="11"
                                Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanGoPrevious}"/>
                        <TextBlock Text="{Binding CurrentPage, StringFormat='Page {0} of'}" FontSize="11"
                                   VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="{Binding TotalPages}" FontSize="11" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding PageInput}" PlaceholderText="#"
                                 Width="44" BorderThickness="1" CornerRadius="6"
                                 Padding="6,4" FontSize="11" Margin="6,0,0,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnHistoryPageInputKeyDown"
                                 ToolTip.Tip="Type a page number and press Enter"/>
                        <Button Content="Next ›"  Padding="10,5" FontSize="11"
                                Command="{Binding NextPageCommand}" IsEnabled="{Binding CanGoNext}"/>
                    </StackPanel>

                    <Button Content="Load More"   FontSize="11"
                            Command="{Binding LoadMoreCommand}">
                        <Button.IsVisible>
                            <MultiBinding Converter="{x:Static BoolConverters.And}">
                                <Binding Path="!UsePagination"/>
                                <Binding Path="CanLoadMore"/>
                            </MultiBinding>
                        </Button.IsVisible>
                    </Button>
                </StackPanel>
                <Button Grid.Column="1" Content="Load More"   FontSize="11"
                        Command="{Binding LoadMoreCommand}">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="!IsDefaultMode"/>
                            <Binding Path="CanLoadMore"/>
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>
            </Grid>
        </Border>

        <gallery:InlineArtworkViewer Name="HistoryOverlayViewer"
                                     Grid.Row="0" Grid.RowSpan="4"
                                     Margin="0,32,0,0"
                                     ZIndex="10"
                                     DataContext="{Binding GalleryVm}"
                                     IsExpanded="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).IsViewerExpanded}"
                                     IsPanelOpen="{Binding $parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).ShowPreview}">
            <gallery:InlineArtworkViewer.IsVisible>
                <Binding Path="$parent[UserControl].((vm:ViewedHistoryViewModel)DataContext).IsViewerExpanded"/>
            </gallery:InlineArtworkViewer.IsVisible>
        </gallery:InlineArtworkViewer>
    </Grid>
</UserControl>
