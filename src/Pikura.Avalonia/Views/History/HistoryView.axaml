<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="Pikura.Avalonia.Views.History.HistoryView"
             x:DataType="vm:HistoryViewModel">

    <Design.DataContext>
        <vm:HistoryViewModel/>
    </Design.DataContext>


    <UserControl.Styles>
        <!-- Neutralize ListBox selection/hover chrome so grouped history rows
             render like plain cards (no selection highlight). -->
        <Style Selector="ListBox.history">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox.history ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.history ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox.history ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <!-- Job card hover lift + drag feedback -->
        <Style Selector="Border.jobCard">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Border.jobCard:pointerover">
            <Setter Property="RenderTransform" Value="translateY(-1px)"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBackgroundBrushSolidAccent}"/>
        </Style>
        <!-- Drag grip fades in on hover -->
        <Style Selector="Border.jobCard:pointerover TextBlock#DragGrip">
            <Setter Property="Opacity" Value="0.5"/>
        </Style>

        <!-- Compact mode: hide detailed info -->
        <Style Selector="Border.jobCard.compact TextBlock#CurrentArtistLabel">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.jobCard.compact TextBlock#CurrentFileLabel">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.jobCard.compact TextBlock#SpeedText">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.jobCard.compact TextBlock#EtaText">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="Border.jobCard.compact ProgressBar#FileProgress">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <!-- While dragging: code-behind drives RenderTransform/ZIndex for 1:1 cursor
             follow; here we only add a subtle translucency + shadow for the lift. -->
        <Style Selector="Border.jobCard.dragging">
            <Setter Property="Opacity" Value="0.9"/>
            <Setter Property="BoxShadow" Value="0 8 24 0 #55000000"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10"
                Margin="0,32,0,0">
            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource QueueIcon}" Width="24" Height="24" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Jobs" FontWeight="SemiBold" FontSize="18"/>
                        <TextBlock Text="Active and completed downloads"
                                   FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding RefreshCommand}"
                             Padding="10,6" FontSize="12">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding RetryAllFailedCommand}"
                            IsVisible="{Binding FailedJobs.Count}"
                             Padding="10,6" FontSize="12" Classes="accent">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                            <TextBlock Text="Retry All Failed" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tabs: Active / Completed / Failed / Cancelled -->
        <TabControl Grid.Row="1" Padding="0" TabStripPlacement="Top">

            <!-- ── Active ── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource ClockIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text="Active" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Container3BackgroundBrush}"
                                CornerRadius="8" Padding="5,1"
                                IsVisible="{Binding ActiveJobs.Count}">
                            <TextBlock Text="{Binding ActiveJobs.Count}" FontSize="11" Foreground="DodgerBlue"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="16,8" BorderBrush="{DynamicResource Container2BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveSummary}"
                                           FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="2"
                                            IsVisible="{Binding ActiveJobs.Count}">
                                    <Button CornerRadius="6,0,0,6" Padding="10,6" FontSize="12" ToolTip.Tip="Card view"
                                            Classes.accent="{Binding !ActiveListView}"
                                            Command="{Binding SetActiveListViewCommand}" CommandParameter="false">
                                        <PathIcon Data="{StaticResource GridViewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button CornerRadius="0,6,6,0" Padding="10,6" FontSize="12" ToolTip.Tip="List view"
                                            Classes.accent="{Binding ActiveListView}"
                                            Command="{Binding SetActiveListViewCommand}" CommandParameter="true">
                                        <PathIcon Data="{StaticResource ListViewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="6"
                                            IsVisible="{Binding ActiveJobs.Count}">
                                    <Button Command="{Binding PauseAllCommand}"
                                             Padding="10,6" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource PauseIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                            <TextBlock Text="Pause All" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button Command="{Binding ResumeAllCommand}"
                                             Padding="10,6" FontSize="12" Classes="accent">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <PathIcon Data="{StaticResource PlayIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                            <TextBlock Text="Resume All" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,12">
                            <ListBox x:Name="ActiveJobsList" Classes="history" ItemsSource="{Binding ActiveJobs}"
                                     IsVisible="{Binding !ActiveListView}">
                                <!-- Non-virtualizing panel: the active queue is small, and a stable
                                     1:1 mapping between realized containers and items is required for
                                     the drag-to-reorder logic in the code-behind to work reliably. -->
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.DataTemplates>
                                    <DataTemplate DataType="vm:DownloadJobViewModel">
                                        <Border Classes="jobCard"
                                                Background="{DynamicResource Container3BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                                BorderThickness="1" CornerRadius="8" Margin="0,0,0,10"
                                                Padding="6,10,12,10"
                                                ClipToBounds="True"
                                                RenderTransform="none">
                                            <Border.Transitions>
                                                <Transitions>
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut"/>
                                                    <DoubleTransition Property="Opacity" Duration="0:0:0.18"/>
                                                </Transitions>
                                            </Border.Transitions>
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Command="{Binding PauseCommand}" IsVisible="{Binding IsPausable}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <PathIcon Data="{StaticResource PauseIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Pause" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding ResumeCommand}" IsVisible="{Binding IsResumable}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <PathIcon Data="{StaticResource PlayIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                                                <TextBlock Text="Resume" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <MenuItem Command="{Binding CancelCommand}" IsVisible="{Binding IsCancellable}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Path Data="{StaticResource CloseIcon}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{DynamicResource DefaultForegroundBrush}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                    <Separator/>
                                                    <MenuItem Header="Move to Top"    Command="{Binding MoveToTopCommand}"/>
                                                    <MenuItem Header="Move Up"         Command="{Binding MoveUpCommand}"/>
                                                    <MenuItem Header="Move Down"       Command="{Binding MoveDownCommand}"/>
                                                    <MenuItem Header="Move to Bottom"  Command="{Binding MoveToBottomCommand}"/>
                                                    <Separator/>
                                                    <MenuItem Command="{Binding $parent[ListBox].DataContext.RemoveActiveJobCommand}" CommandParameter="{Binding}">
                                                        <MenuItem.Header>
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <Path Data="{StaticResource TrashIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{DynamicResource DefaultForegroundBrush}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                                <TextBlock Text="Remove from Queue" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </MenuItem.Header>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                <!-- Queue position + drag handle -->
                                                <Border Grid.Column="0" Width="32" Background="Transparent"
                                                        VerticalAlignment="Stretch" HorizontalAlignment="Center">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="{Binding QueuePosition}" FontSize="12" FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                        <PathIcon x:Name="DragGrip" Data="{StaticResource GripIcon}" Width="12" Height="12"
                                                                  Opacity="0" VerticalAlignment="Center"
                                                                  HorizontalAlignment="Center"
                                                                  Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Artist / artwork thumbnail -->
                                                <Border Grid.Column="1" Width="96" Height="96" CornerRadius="10" ClipToBounds="True"
                                                        Margin="2,0,14,0" VerticalAlignment="Center"
                                                        BorderThickness="1"
                                                        BorderBrush="{DynamicResource Container1BorderBrush}"
                                                        Background="{DynamicResource Container2BackgroundBrush}">
                                                    <Panel>
                                                        <PathIcon Data="{StaticResource ImageIcon}" Width="42" Height="42" Opacity="0.35"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                  IsVisible="{Binding !HasAnyThumbnail}"/>
                                                        <Image Source="{Binding CurrentFileThumbnail}" Stretch="UniformToFill"
                                                               IsVisible="{Binding CurrentFileThumbnail, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill">
                                                            <Image.IsVisible>
                                                                <MultiBinding Converter="{x:Static BoolConverters.And}">
                                                                    <Binding Path="HasThumbnail"/>
                                                                    <Binding Path="CurrentFileThumbnail" Converter="{x:Static ObjectConverters.IsNull}"/>
                                                                </MultiBinding>
                                                            </Image.IsVisible>
                                                        </Image>
                                                    </Panel>
                                                </Border>
                                                <!-- Info column -->
                                                <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center" Margin="0,8,0,8">
                                                    <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <StackPanel x:Name="CurrentArtistLabel" Orientation="Horizontal" Spacing="4"
                                                                IsVisible="{Binding CurrentArtist, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                        <PathIcon Data="{StaticResource PlayIcon}" Width="10" Height="10" Foreground="DodgerBlue" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding CurrentArtist}" FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                                                   TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="CurrentFileLabel" Text="{Binding CurrentFileLabel}" FontSize="12"
                                                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                                               IsVisible="{Binding HasCurrentFile}"
                                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <!-- "Preparing…" hint only while actively enumerating (Running + no total yet) -->
                                                    <TextBlock Text="Preparing… (fetching artwork list)" FontSize="12"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                               IsVisible="{Binding IsPreparing}"/>
                                                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" CornerRadius="3" Margin="0,3,0,0"
                                                                 IsIndeterminate="{Binding IsPreparing}"/>
                                                    <ProgressBar x:Name="FileProgress" Value="{Binding CurrentFilePct}" Maximum="100" Height="3" CornerRadius="2"
                                                                 IsVisible="{Binding HasCurrentFile}" Opacity="0.6"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="3" Spacing="4" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <!-- Status badge (auto-width so "▶ Running"/"⏸ Paused" aren't clipped) -->
                                                    <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Right"
                                                            Background="{Binding StatusAccentColor}">
                                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource DefaultForegroundBrush}"
                                                               IsVisible="{Binding ProgressPercent}"
                                                               Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}"/>
                                                    <TextBlock FontSize="11" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                               Text="{Binding TargetSummaryText}"/>
                                                    <TextBlock FontSize="11" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                               Text="{Binding DownloadedSizeText}"
                                                               IsVisible="{Binding DownloadedSizeText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                    <TextBlock x:Name="SpeedText" Text="{Binding SpeedText}" FontSize="11" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                               IsVisible="{Binding SpeedText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                    <TextBlock x:Name="EtaText" Text="{Binding EtaText}" FontSize="11" HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                               IsVisible="{Binding EtaText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                        <!-- Play/Pause toggle button -->
                                                        <Button   FontSize="12"
                                                                IsVisible="{Binding IsPausable}"
                                                                Command="{Binding PauseCommand}"
                                                                ToolTip.Tip="Pause">
                                                            <PathIcon Data="{StaticResource PauseIcon}" Width="16" Height="16" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                        </Button>
                                                        <Button   FontSize="12"
                                                                IsVisible="{Binding IsResumable}"
                                                                Command="{Binding ResumeCommand}"
                                                                ToolTip.Tip="Resume" Classes="accent">
                                                            <PathIcon Data="{StaticResource PlayIcon}" Width="16" Height="16" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                        </Button>
                                                        <Button   FontSize="14"
                                                                ToolTip.Tip="Actions">
                                                            <PathIcon Data="{StaticResource HamburgerIcon}" Width="16" Height="16" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                            <Button.Flyout>
                                                                <MenuFlyout>
                                                                    <MenuItem Command="{Binding PauseCommand}" IsVisible="{Binding IsPausable}">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <PathIcon Data="{StaticResource PauseIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Pause" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <MenuItem Command="{Binding ResumeCommand}" IsVisible="{Binding IsResumable}">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <PathIcon Data="{StaticResource PlayIcon}" Width="14" Height="14" VerticalAlignment="Center"/>
                                                                                <TextBlock Text="Resume" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <MenuItem Command="{Binding CancelCommand}" IsVisible="{Binding IsCancellable}">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <Path Data="{StaticResource CloseIcon}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{DynamicResource DefaultForegroundBrush}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                                                <TextBlock Text="Cancel" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                    <Separator/>
                                                                    <MenuItem Header="Move to Top"    Command="{Binding MoveToTopCommand}"/>
                                                                    <MenuItem Header="Move Up"         Command="{Binding MoveUpCommand}"/>
                                                                    <MenuItem Header="Move Down"       Command="{Binding MoveDownCommand}"/>
                                                                    <MenuItem Header="Move to Bottom"  Command="{Binding MoveToBottomCommand}"/>
                                                                    <Separator/>
                                                                    <MenuItem Command="{Binding $parent[ListBox].DataContext.RemoveActiveJobCommand}" CommandParameter="{Binding}">
                                                                        <MenuItem.Header>
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <Path Data="{StaticResource TrashIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{DynamicResource DefaultForegroundBrush}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                                                <TextBlock Text="Remove from Queue" VerticalAlignment="Center"/>
                                                                            </StackPanel>
                                                                        </MenuItem.Header>
                                                                    </MenuItem>
                                                                </MenuFlyout>
                                                            </Button.Flyout>
                                                        </Button>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>
                            <!-- List view for Active tab -->
                            <ListBox Classes="history" ItemsSource="{Binding ActiveJobs}"
                                     IsVisible="{Binding ActiveListView}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.DataTemplates>
                                    <DataTemplate DataType="vm:DownloadJobViewModel">
                                        <Border Background="{DynamicResource Container3BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Margin="0,0,0,4" Padding="10,8,12,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                    <TextBlock Text="{Binding TargetSummaryText}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="4" Padding="6,2" Margin="10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Background="{Binding StatusAccentColor}">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                                </Border>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                    <Button   FontSize="12"
                                                            IsVisible="{Binding IsPausable}" Command="{Binding PauseCommand}" ToolTip.Tip="Pause">
                                                        <PathIcon Data="{StaticResource PauseIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                    </Button>
                                                    <Button   FontSize="12" Classes="accent"
                                                            IsVisible="{Binding IsResumable}" Command="{Binding ResumeCommand}" ToolTip.Tip="Resume">
                                                        <PathIcon Data="{StaticResource PlayIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.DataTemplates>
                            </ListBox>
                            <StackPanel IsVisible="{Binding !ActiveJobs.Count}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Spacing="8" Margin="0,-40,0,0">
                                <PathIcon Data="{StaticResource QueueIcon}" Width="48" Height="48" Opacity="0.3" HorizontalAlignment="Center"/>
                                <TextBlock Text="No active downloads" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Queue a job from Gallery or Discover to get started"
                                           FontSize="12"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ── Completed ── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource CheckIcon}" Width="14" Height="14" VerticalAlignment="Center"/><TextBlock Text="Completed" FontSize="12" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource Container3BackgroundBrush}"
                                CornerRadius="8" Padding="5,1"
                                IsVisible="{Binding CompletedJobs.Count}">
                            <TextBlock Text="{Binding CompletedJobs.Count}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="16,8" BorderBrush="{DynamicResource Container2BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CompletedJobs.Count, StringFormat='{}{0} jobs'}"
                                       FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button CornerRadius="6,0,0,6" Padding="10,6" FontSize="12" ToolTip.Tip="Card view"
                                            Classes.accent="{Binding !CompletedListView}"
                                            Command="{Binding SetCompletedListViewCommand}" CommandParameter="false">
                                        <PathIcon Data="{StaticResource GridViewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button CornerRadius="0,6,6,0" Padding="10,6" FontSize="12" ToolTip.Tip="List view"
                                            Classes.accent="{Binding CompletedListView}"
                                            Command="{Binding SetCompletedListViewCommand}" CommandParameter="true">
                                        <PathIcon Data="{StaticResource ListViewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                </StackPanel>
                                <Button Command="{Binding ClearCompletedCommand}"
                                        IsVisible="{Binding CompletedJobs.Count}"
                                         Padding="10,6" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource TrashIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                        <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Panel Grid.Row="1">
                        <!-- List view for Completed tab -->
                        <ListBox Classes="history" ItemsSource="{Binding CompletedJobs}"
                                 IsVisible="{Binding CompletedListView}"
                                 Padding="16,12" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="vm:DownloadJobViewModel">
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,4" Padding="12,8,12,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} • {1:MMM d, yyyy HH:mm}">
                                                            <Binding Path="TypeLabel"/>
                                                            <Binding Path="Job.CompletedAt"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ResultSummary}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                       Margin="12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button   FontSize="12"
                                                        IsVisible="{Binding HasOutputFolder}" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open Folder">
                                                    <PathIcon Data="{StaticResource FolderIcon}" Width="12" Height="12" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                </Button>
                                                <Button   FontSize="12"
                                                        Command="{Binding $parent[ListBox].DataContext.RemoveJobCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Remove">
                                                    <Path Data="{StaticResource CloseIcon}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                        <ListBox Classes="history" ItemsSource="{Binding CompletedView}"
                                 IsVisible="{Binding !CompletedListView}"
                                 Padding="16,12" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="vm:HistoryGroupViewModel">
                                    <Button Command="{Binding ToggleCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Padding="4,10,4,4" Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="16,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Chevron}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DownloadJobViewModel">
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,8"
                                            Padding="10,10,12,10" ClipToBounds="True">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="10" ClipToBounds="True"
                                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                                    Background="{DynamicResource Container3BackgroundBrush}">
                                                <Panel>
                                                    <TextBlock Text="&#128444;" FontSize="34" Opacity="0.35"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasThumbnail}"/>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} • {1:MMM d, yyyy HH:mm}">
                                                            <Binding Path="TypeLabel"/>
                                                            <Binding Path="Job.CompletedAt"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ArtistInfo}" FontSize="12"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           IsVisible="{Binding HasArtistInfo}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{Binding ResultSummary}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           Text="{Binding DownloadedSizeText}"
                                                           IsVisible="{Binding DownloadedSizeText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" Margin="0,0,4,0" VerticalAlignment="Center" MinWidth="130">
                                                <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,2"/>
                                                <Button Command="{Binding OpenFolderCommand}"
                                                        IsVisible="{Binding HasOutputFolder}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                          FontSize="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <PathIcon Data="{StaticResource FolderIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                        <TextBlock Text="Open Folder" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding $parent[ListBox].DataContext.RemoveJobCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                          FontSize="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <Path Data="{StaticResource CloseIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                        <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                        <TextBlock Text="No completed downloads" FontSize="13"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   IsVisible="{Binding !CompletedJobs.Count}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"/>
                    </Panel>
                </Grid>
            </TabItem>

            <!-- ── Failed ── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource WarningIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="OrangeRed"/><TextBlock Text="Failed" FontSize="12" VerticalAlignment="Center" Foreground="OrangeRed"/>
                        <Border Background="{DynamicResource Container3BackgroundBrush}"
                                CornerRadius="8" Padding="5,1"
                                IsVisible="{Binding FailedJobs.Count}">
                            <TextBlock Text="{Binding FailedJobs.Count}" FontSize="11" Foreground="OrangeRed"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="16,8" BorderBrush="{DynamicResource Container2BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding FailedJobs.Count, StringFormat='{}{0} jobs'}"
                                       FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button CornerRadius="6,0,0,6" Padding="10,6" FontSize="12" ToolTip.Tip="Card view"
                                            Classes.accent="{Binding !FailedListView}"
                                            Command="{Binding SetFailedListViewCommand}" CommandParameter="false">
                                        <PathIcon Data="{StaticResource GridViewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button CornerRadius="0,6,6,0" Padding="10,6" FontSize="12" ToolTip.Tip="List view"
                                            Classes.accent="{Binding FailedListView}"
                                            Command="{Binding SetFailedListViewCommand}" CommandParameter="true">
                                        <PathIcon Data="{StaticResource ListViewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                </StackPanel>
                                <Button Command="{Binding RetryAllFailedCommand}"
                                        IsVisible="{Binding FailedJobs.Count}"
                                         Padding="10,6" FontSize="12" Classes="accent">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                        <TextBlock Text="Retry All" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding ClearFailedCommand}"
                                        IsVisible="{Binding FailedJobs.Count}"
                                         Padding="10,6" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource TrashIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                        <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Panel Grid.Row="1">
                        <!-- List view for Failed tab -->
                        <ListBox Classes="history" ItemsSource="{Binding FailedJobs}"
                                 IsVisible="{Binding FailedListView}"
                                 Padding="16,12" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="vm:DownloadJobViewModel">
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,4" Padding="12,8,12,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} • {1:MMM d, yyyy HH:mm}">
                                                            <Binding Path="TypeLabel"/>
                                                            <Binding Path="Job.CompletedAt"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ResultSummary}" FontSize="11" FontWeight="SemiBold" Foreground="OrangeRed"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="OrangeRed" Margin="12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button   FontSize="12" Classes="accent"
                                                        Command="{Binding $parent[ListBox].DataContext.RetryJobCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Retry">
                                                    <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                </Button>
                                                <Button   FontSize="12"
                                                        Command="{Binding $parent[ListBox].DataContext.RemoveJobCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Remove">
                                                    <Path Data="{StaticResource CloseIcon}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                        <ListBox Classes="history" ItemsSource="{Binding FailedView}"
                                 IsVisible="{Binding !FailedListView}"
                                 Padding="16,12" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="vm:HistoryGroupViewModel">
                                    <Button Command="{Binding ToggleCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Padding="4,10,4,4" Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="16,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Chevron}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DownloadJobViewModel">
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,8"
                                            Padding="10,10,12,10" ClipToBounds="True">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="10" ClipToBounds="True"
                                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                                    Background="{DynamicResource Container3BackgroundBrush}">
                                                <Panel>
                                                    <TextBlock Text="&#128444;" FontSize="34" Opacity="0.35"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasThumbnail}"/>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} • {1:MMM d, yyyy HH:mm}">
                                                            <Binding Path="TypeLabel"/>
                                                            <Binding Path="Job.CompletedAt"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ArtistInfo}" FontSize="12"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           IsVisible="{Binding HasArtistInfo}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{Binding ResultSummary}" FontSize="12" FontWeight="SemiBold" Foreground="OrangeRed"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           Text="{Binding DownloadedSizeText}"
                                                           IsVisible="{Binding DownloadedSizeText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" Margin="0,0,4,0" VerticalAlignment="Center" MinWidth="130">
                                                <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,2" Foreground="OrangeRed"/>
                                                <Button Command="{Binding $parent[ListBox].DataContext.RetryJobCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                          FontSize="12" Classes="accent">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                        <TextBlock Text="Retry" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding $parent[ListBox].DataContext.RemoveJobCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                          FontSize="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <Path Data="{StaticResource CloseIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                        <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                        <TextBlock Text="No failed downloads" FontSize="13"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   IsVisible="{Binding !FailedJobs.Count}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"/>
                    </Panel>
                </Grid>
            </TabItem>

            <!-- ── Cancelled ── -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource CloseFilledIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="OrangeRed"/>
                        <TextBlock Text="Cancelled" FontSize="12" VerticalAlignment="Center" Foreground="OrangeRed"/>
                        <Border Background="{DynamicResource Container3BackgroundBrush}"
                                CornerRadius="8" Padding="5,1"
                                IsVisible="{Binding CancelledJobs.Count}">
                            <TextBlock Text="{Binding CancelledJobs.Count}" FontSize="11"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="16,8" BorderBrush="{DynamicResource Container2BorderBrush}" BorderThickness="0,0,0,1">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Text="{Binding CancelledJobs.Count, StringFormat='{}{0} jobs'}"
                                       FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button CornerRadius="6,0,0,6" Padding="10,6" FontSize="12" ToolTip.Tip="Card view"
                                            Classes.accent="{Binding !CancelledListView}"
                                            Command="{Binding SetCancelledListViewCommand}" CommandParameter="false">
                                        <PathIcon Data="{StaticResource GridViewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                    <Button CornerRadius="0,6,6,0" Padding="10,6" FontSize="12" ToolTip.Tip="List view"
                                            Classes.accent="{Binding CancelledListView}"
                                            Command="{Binding SetCancelledListViewCommand}" CommandParameter="true">
                                        <PathIcon Data="{StaticResource ListViewIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                    </Button>
                                </StackPanel>
                                <Button Command="{Binding ClearCancelledCommand}"
                                        IsVisible="{Binding CancelledJobs.Count}"
                                         Padding="10,6" FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Data="{StaticResource TrashIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                        <TextBlock Text="Clear All" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Panel Grid.Row="1">
                        <!-- List view for Cancelled tab -->
                        <ListBox Classes="history" ItemsSource="{Binding CancelledJobs}"
                                 IsVisible="{Binding CancelledListView}"
                                 Padding="16,12" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="vm:DownloadJobViewModel">
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,4" Padding="12,8,12,8">
                                        <Grid ColumnDefinitions="*,Auto,Auto">
                                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} &#x2022; {1:MMM d, yyyy HH:mm}">
                                                            <Binding Path="TypeLabel"/>
                                                            <Binding Path="Job.CompletedAt"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ResultSummary}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                       Margin="12,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button   FontSize="12" Classes="accent"
                                                        Command="{Binding $parent[ListBox].DataContext.RetryJobCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Retry">
                                                    <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                </Button>
                                                <Button   FontSize="12"
                                                        Command="{Binding $parent[ListBox].DataContext.RemoveJobCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Remove">
                                                    <Path Data="{StaticResource CloseIcon}" Width="12" Height="12"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                        <ListBox Classes="history" ItemsSource="{Binding CancelledView}"
                                 IsVisible="{Binding !CancelledListView}"
                                 Padding="16,12" Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.DataTemplates>
                                <DataTemplate DataType="vm:HistoryGroupViewModel">
                                    <Button Command="{Binding ToggleCommand}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Padding="4,10,4,4" Margin="0,0,0,2"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Grid ColumnDefinitions="16,Auto,*">
                                            <TextBlock Grid.Column="0" Text="{Binding Chevron}" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" FontSize="11"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate DataType="vm:DownloadJobViewModel">
                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Margin="0,0,0,8"
                                            Padding="10,10,12,10" ClipToBounds="True">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="96" Height="96" CornerRadius="10" ClipToBounds="True"
                                                    VerticalAlignment="Center" Margin="0,0,14,0"
                                                    BorderThickness="1"
                                                    BorderBrush="{DynamicResource Container1BorderBrush}"
                                                    Background="{DynamicResource Container3BackgroundBrush}">
                                                <Panel>
                                                    <TextBlock Text="&#128444;" FontSize="34" Opacity="0.35"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasThumbnail}"/>
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" IsVisible="{Binding HasThumbnail}"/>
                                                </Panel>
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Job.Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0} • {1:MMM d, yyyy HH:mm}">
                                                            <Binding Path="TypeLabel"/>
                                                            <Binding Path="Job.CompletedAt"/>
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock Text="{Binding ArtistInfo}" FontSize="12"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           IsVisible="{Binding HasArtistInfo}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                                <TextBlock Text="{Binding ResultSummary}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                <TextBlock FontSize="11"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           Text="{Binding DownloadedSizeText}"
                                                           IsVisible="{Binding DownloadedSizeText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="8" Margin="0,0,4,0" VerticalAlignment="Center" MinWidth="130">
                                                <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,0,0,2"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                <Button Command="{Binding $parent[ListBox].DataContext.RetryJobCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                          FontSize="12" Classes="accent">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14" VerticalAlignment="Center" Foreground="{Binding $parent[Button].Foreground}" />
                                                        <TextBlock Text="Retry" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Command="{Binding $parent[ListBox].DataContext.RemoveJobCommand}"
                                                        CommandParameter="{Binding}"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                          FontSize="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                                        <Path Data="{StaticResource CloseIcon}" Width="14" Height="14"
                                  Stretch="Uniform" Stroke="{Binding $parent[Button].Foreground}" StrokeThickness="2"
                                  StrokeLineCap="Round" VerticalAlignment="Center" UseLayoutRounding="False"/>
                                                        <TextBlock Text="Remove" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.DataTemplates>
                        </ListBox>
                        <TextBlock Text="No cancelled downloads" FontSize="13"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                   IsVisible="{Binding !CancelledJobs.Count}"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0"/>
                    </Panel>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
