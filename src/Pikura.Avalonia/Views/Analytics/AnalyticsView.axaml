<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:Pikura.Avalonia.Localization"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:ctl="using:Pikura.Avalonia.Controls"
             xmlns:conv="using:Pikura.Avalonia.Converters"
             x:Class="Pikura.Avalonia.Views.Analytics.AnalyticsView"
             x:DataType="vm:AnalyticsViewModel">
    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource Container2BackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Container2BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style Selector="TextBlock.cardTitle"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style Selector="TextBlock.big"><Setter Property="FontSize" Value="32"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style Selector="TextBlock.sub"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrushSecondary}"/></Style>
        <Style Selector="TextBlock.note"><Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource DefaultForegroundBrushTertiary}"/></Style>
        <Style Selector="ProgressBar.stat"><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/><Setter Property="CornerRadius" Value="5"/><Setter Property="Foreground" Value="#2B8BE6"/><Setter Property="Maximum" Value="100"/></Style>
        <Style Selector="ProgressBar.stat.top"><Setter Property="Foreground" Value="#8CC4F0"/></Style>
        <Style Selector="TextBlock.top"><Setter Property="FontWeight" Value="Bold"/></Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="vm:StatRow">
            <Grid ColumnDefinitions="150,*,110" Margin="0,4">
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Classes.top="{Binding IsTop}"/>
                <ProgressBar Grid.Column="1" Classes="stat" Classes.top="{Binding IsTop}" Value="{Binding Percent}" VerticalAlignment="Center" Margin="8,0"/>
                <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer Margin="0,32,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="14" Margin="24,16,24,24">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Analytics_Stats}" FontSize="26" FontWeight="SemiBold" Foreground="#4EA1F3"/>
                    <TextBlock Text="{Binding Subtitle}" Classes="sub" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="2" Command="{Binding LoadAnalyticsCommand}" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14" Foreground="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="{loc:Tr Common_Refresh}" FontSize="13"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Classes="card">
                <Grid ColumnDefinitions="170,*">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Tr Analytics_Total}" Classes="cardTitle"/>
                        <TextBlock Text="{Binding TotalText}" Classes="big"/>
                        <TextBlock Text="{Binding TotalSub}" Classes="sub"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                        <ctl:StackedBar Values="{Binding TotalSegments}"/>
                        <WrapPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,24,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#2B8BE6"/>
                                <TextBlock Text="{Binding ViewsLegend}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,24,0">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#E2602C"/>
                                <TextBlock Text="{Binding R18Legend}" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="12" Height="12" CornerRadius="2" Background="#1E9E6A"/>
                                <TextBlock Text="{Binding DownloadsLegend}" FontSize="13"/>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,14,*,14,*,14,*">
                <Border Classes="card"><StackPanel Spacing="2">
                    <TextBlock Text="{loc:Tr Analytics_Today}" Classes="cardTitle"/>
                    <TextBlock Text="{Binding TodayText}" Classes="big"/>
                    <TextBlock Text="{Binding TodaySub}" Classes="sub" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Classes="card"><StackPanel Spacing="2">
                    <TextBlock Text="{loc:Tr Analytics_Past7}" Classes="cardTitle"/>
                    <TextBlock Text="{Binding Past7Text}" Classes="big"/>
                    <TextBlock Text="{Binding Past7Sub}" Classes="sub" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <Border Grid.Column="4" Classes="card"><StackPanel Spacing="2">
                    <TextBlock Text="{loc:Tr Analytics_Streak}" Classes="cardTitle"/>
                    <TextBlock Text="{Binding StreakText}" Classes="big"/>
                    <TextBlock Text="{Binding StreakSub}" Classes="sub" TextWrapping="Wrap"/>
                </StackPanel></Border>
                <Border Grid.Column="6" Classes="card"><StackPanel Spacing="2">
                    <TextBlock Text="{loc:Tr Analytics_BusiestDay}" Classes="cardTitle"/>
                    <TextBlock Text="{Binding BusiestText}" Classes="big"/>
                    <TextBlock Text="{Binding BusiestSub}" Classes="sub" TextWrapping="Wrap"/>
                </StackPanel></Border>
            </Grid>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{loc:Tr Analytics_EveryDay}" Classes="cardTitle"/>
                            <TextBlock Text="{Binding ActiveDaysText}" Classes="note"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Analytics_Less}" Classes="note" Margin="0,0,4,0"/>
                            <Border Width="12" Height="12" CornerRadius="2" Background="#29808080"/>
                            <Border Width="12" Height="12" CornerRadius="2" Background="#732B8BE6"/>
                            <Border Width="12" Height="12" CornerRadius="2" Background="#B32B8BE6"/>
                            <Border Width="12" Height="12" CornerRadius="2" Background="#2B8BE6"/>
                            <Border Width="12" Height="12" CornerRadius="2" Background="#8CC4F0"/>
                            <TextBlock Text="{loc:Tr Analytics_More}" Classes="note" Margin="4,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <ctl:ActivityHeatmap Data="{Binding Daily}" FirstDay="{Binding FirstDay}"/>
                </StackPanel>
            </Border>

            <Border Classes="card">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{loc:Tr Analytics_TimeOfDay}" Classes="cardTitle"/>
                            <TextBlock Text="{Binding BusiestHourText}" Classes="note"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Button Content="{loc:Tr Analytics_All}" Padding="12,4" Command="{Binding SetHourModeCommand}" CommandParameter="all"
                                    Classes.accent="{Binding HourMode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=all}"/>
                            <Button Content="{loc:Tr Analytics_Views}" Padding="12,4" Command="{Binding SetHourModeCommand}" CommandParameter="views"
                                    Classes.accent="{Binding HourMode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=views}"/>
                            <Button Content="{loc:Tr Analytics_Downloads}" Padding="12,4" Command="{Binding SetHourModeCommand}" CommandParameter="downloads"
                                    Classes.accent="{Binding HourMode, Converter={x:Static conv:StringEqualityConverter.Instance}, ConverterParameter=downloads}"/>
                        </StackPanel>
                    </Grid>
                    <ctl:HourBarChart Values="{Binding Hours}"/>
                </StackPanel>
            </Border>

            <Grid ColumnDefinitions="*,14,*">
                <Border Classes="card"><StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{loc:Tr Analytics_DayOfWeek}" Classes="cardTitle"/>
                        <TextBlock Text="{Binding BusiestWeekdayText}" Classes="note"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Weekdays}"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Classes="card"><StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Analytics_MostViewedArtists}" Classes="cardTitle"/>
                    <ItemsControl ItemsSource="{Binding MostViewedArtists}"/>
                    <TextBlock Text="{loc:Tr Analytics_NoDataYet}" Classes="note" IsVisible="{Binding !MostViewedArtists.Count}"/>
                </StackPanel></Border>
            </Grid>

            <Grid ColumnDefinitions="*,14,*">
                <Border Classes="card"><StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Analytics_TopTags}" Classes="cardTitle"/>
                    <ItemsControl ItemsSource="{Binding TopTags}"/>
                    <TextBlock Text="{loc:Tr Analytics_NoDataYet}" Classes="note" IsVisible="{Binding !TopTags.Count}"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Classes="card"><StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Analytics_ContentTypes}" Classes="cardTitle"/>
                    <ItemsControl ItemsSource="{Binding ContentTypes}"/>
                </StackPanel></Border>
            </Grid>

            <Grid ColumnDefinitions="*,14,*">
                <Border Classes="card"><StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Analytics_MostDownloadedArtists}" Classes="cardTitle"/>
                    <ItemsControl ItemsSource="{Binding MostDownloadedArtists}"/>
                    <TextBlock Text="{loc:Tr Analytics_NoDataYet}" Classes="note" IsVisible="{Binding !MostDownloadedArtists.Count}"/>
                </StackPanel></Border>
                <Border Grid.Column="2" Classes="card"><StackPanel Spacing="8">
                    <TextBlock Text="{loc:Tr Analytics_DownloadJobs}" Classes="cardTitle"/>
                    <ItemsControl ItemsSource="{Binding DownloadJobs}"/>
                    <TextBlock Text="{loc:Tr Analytics_NoDataYet}" Classes="note" IsVisible="{Binding !DownloadJobs.Count}"/>
                </StackPanel></Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
