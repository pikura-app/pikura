<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
        xmlns:vm="using:Pikura.Avalonia.ViewModels"
        x:CompileBindings="false"
        x:Class="Pikura.Avalonia.Views.Library.LibraryView">
    <DockPanel>
        <!-- Header / tabs -->
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="16,12,16,8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:Tr Library_Browse}" Click="BrowseTab_Click"/>
                <Button Content="{loc:Tr Library_Duplicates}" Click="DuplicatesTab_Click"/>
                <TextBlock Text="{Binding StatusLine}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
            </StackPanel>
        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Margin="16,8" Padding="8"
                Background="{DynamicResource Container2BackgroundBrush}"
                CornerRadius="6" IsVisible="{Binding TabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProgressLine}" IsVisible="{Binding ProgressLine, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                    <Button Content="{loc:Tr Common_Cancel}" IsVisible="{Binding ProgressLine, Converter={x:Static ObjectConverters.IsNotNull}}"
                            Command="{Binding CancelWorkCommand}" Padding="6,2" Margin="8,0,0,0" FontSize="11"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Tr Library_Rescan}" Command="{Binding RescanCommand}" Margin="4,0" Padding="10,4"/>
                <Button Grid.Column="2" Content="{loc:Tr Library_FetchMissing}" Command="{Binding FetchMissingInfoCommand}" Margin="4,0" Padding="10,4"/>
                <Button Grid.Column="3" Content="{loc:Tr Library_TagUntagged}" Command="{Binding TagUntaggedCommand}" Margin="4,0" Padding="10,4"/>
            </Grid>
        </Border>

        <!-- Browse tab -->
        <Grid IsVisible="{Binding TabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Top" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Text="{Binding SearchText}" PlaceholderText="{loc:Tr Library_SearchWatermark}" Width="260"/>
                        <TextBox Text="{Binding ArtistFilter}" PlaceholderText="{loc:Tr Library_ArtistFilter}" Width="160"/>
                        <ComboBox SelectedIndex="{Binding MediaTypeIndex}" Width="110">
                            <ComboBoxItem Content="{loc:Tr Library_MediaAll}"/>
                            <ComboBoxItem Content="{loc:Tr Library_MediaImage}"/>
                            <ComboBoxItem Content="{loc:Tr Library_MediaVideo}"/>
                            <ComboBoxItem Content="{loc:Tr Library_MediaAnimation}"/>
                        </ComboBox>
                        <ComboBox SelectedIndex="{Binding SortIndex}" Width="130">
                            <ComboBoxItem Content="{loc:Tr Library_SortAdded}"/>
                            <ComboBoxItem Content="{loc:Tr Library_SortCreated}"/>
                            <ComboBoxItem Content="{loc:Tr Library_SortTitle}"/>
                            <ComboBoxItem Content="{loc:Tr Library_SortArtist}"/>
                        </ComboBox>
                        <CheckBox Content="{loc:Tr Library_IncludeR18}" IsChecked="{Binding IncludeR18}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Tr Library_AiTags}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <ItemsControl ItemsSource="{Binding AiTagChips}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding}" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).ToggleAiTagCommand}"
                                        CommandParameter="{Binding}" Padding="8,2" Margin="0,0,4,4" FontSize="11"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{loc:Tr Library_PixivTags}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <ItemsControl ItemsSource="{Binding PixivTagChips}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding}" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).TogglePixivTagCommand}"
                                        CommandParameter="{Binding}" Padding="8,2" Margin="0,0,4,4" FontSize="11"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding ActiveFilters.Count}">
                        <TextBlock Text="{loc:Tr Library_ActiveFilters}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0"/>
                        <ItemsControl ItemsSource="{Binding ActiveFilters}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Content="{Binding StringFormat='{}{0} ✕'}" Classes="accent"
                                        Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).RemoveFilterCommand}"
                                        CommandParameter="{Binding}" Padding="8,2" Margin="0,0,4,4" FontSize="11"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer x:Name="LibraryScroll" ScrollChanged="OnLibraryScrollChanged">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Width="180" Margin="6" CornerRadius="8" Padding="6"
                                    Background="{DynamicResource Container2BackgroundBrush}"
                                    ToolTip.Tip="{Binding PathTooltip}">
                                <Border.ContextMenu><ContextMenu>
                                    <MenuItem Header="{loc:Tr Library_OpenFile}" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenFileCommand}" CommandParameter="{Binding}"/>
                                    <MenuItem Header="{loc:Tr Library_ShowInFolder}" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).ShowInFolderCommand}" CommandParameter="{Binding}"/>
                                    <MenuItem Header="{loc:Tr Library_OpenOnPixiv}" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).OpenOnPixivCommand}" CommandParameter="{Binding}"/>
                                    <MenuItem Header="{loc:Tr Library_CopyPath}" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).CopyPathCommand}" CommandParameter="{Binding}"/>
                                    <MenuItem Header="{loc:Tr Library_TagWithAi}" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).TagWithAiCommand}" CommandParameter="{Binding}"/>
                                    <MenuItem Header="{loc:Tr Library_Delete}" Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).DeleteFileCommand}" CommandParameter="{Binding}"/>
                                </ContextMenu></Border.ContextMenu>
                                <StackPanel Spacing="4">
                                    <Image Source="{Binding Thumbnail}" Width="168" Height="168" Stretch="Uniform"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock Text="{Binding SubText}" FontSize="11"
                                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}"
                                               TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- Duplicates tab -->
        <Grid IsVisible="{Binding TabIndex, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=1}">
            <DockPanel Margin="16,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                    <Button Content="{loc:Tr Library_FindDuplicates}" Classes="accent" Command="{Binding FindDuplicatesCommand}" Padding="12,5"/>
                    <TextBlock Text="{loc:Tr Library_Threshold}" VerticalAlignment="Center"/>
                    <Slider Value="{Binding DupThreshold}" Minimum="0" Maximum="7" Width="140" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DupThreshold, StringFormat='{}{0:0}'}" VerticalAlignment="Center"/>
                    <Button Content="{loc:Tr Library_DeleteMarked}" Command="{Binding DeleteMarkedCommand}" Margin="16,0,0,0"/>
                    <TextBlock Text="{Binding PendingRehashText}" VerticalAlignment="Center" Margin="16,0,0,0"
                               Foreground="{DynamicResource DefaultForegroundBrushSecondary}" FontSize="12"
                               IsVisible="{Binding PendingRehashText, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                </StackPanel>
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding DupGroups}">
                        <ItemsControl.ItemTemplate><DataTemplate>
                            <Border Margin="0,6" Padding="8" CornerRadius="8"
                                    Background="{DynamicResource Container2BackgroundBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Badge}" FontWeight="Bold" Foreground="Orange"/>
                                        <Button Content="{loc:Tr Library_KeepBest}" FontSize="11" Padding="8,2"
                                                Command="{Binding $parent[ItemsControl].((vm:LibraryViewModel)DataContext).KeepBestCommand}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Margin="0,0,10,6">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <CheckBox IsChecked="{Binding IsMarked}" VerticalAlignment="Center"/>
                                                    <Image Source="{Binding Thumbnail}" Width="80" Height="80" Stretch="Uniform"/>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Info}" FontSize="11"/>
                                                        <TextBlock Text="{Binding File.Path}" FontSize="10" MaxWidth="340"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding File.Path}"/>
                                                        <TextBlock Text="{Binding DateText}" FontSize="10"
                                                                   Foreground="{DynamicResource DefaultForegroundBrushSecondary}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
