<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="700"
             x:Class="Pikura.Avalonia.Views.DownloadByImageIdView"
             x:DataType="vm:DownloadByImageIdViewModel"
             x:Name="ThisView">

    <Design.DataContext>
        <vm:DownloadByImageIdViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto,Auto">

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="20,16">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{loc:Tr DlId_DownloadByImageID}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Tr DlId_DownloadSpecificArtworksByTheirID}"
                               FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:Tr DlId_Help}"  />
            </Grid>
        </Border>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="20">

                <!-- Image IDs Input -->
                <Border Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container2BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Tr DlId_ImageIDsOrURLs}"
                                       FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ParsedIds.Count, StringFormat='{}{0} IDs detected'}"
                                       FontSize="13"
                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        </Grid>

                        <TextBox Text="{Binding InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 PlaceholderText="{loc:Tr DlId_EnterImageIdsMulti}"
                                 Height="200"
                                 CornerRadius="6"
                                 FontFamily="Consolas, monospace"
                                 FontSize="13"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{loc:Tr DlId_PasteFromClipboard}"
                                    Click="OnPasteClicked"
                                     />
                            <Button Content="{loc:Tr DlId_ImportFromFile}"
                                    Command="{Binding ImportFromFileCommand}"
                                     />
                            <Button Content="{loc:Tr Common_Clear}"
                                    Command="{Binding ClearInputCommand}"
                                     />
                        </StackPanel>

                        <!-- Validation Summary -->
                        <Border IsVisible="{Binding HasInvalidInput}"
                                Background="{DynamicResource Container3BackgroundBrush}"
                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{loc:Tr DlId_SomeEntriesCouldNotBeParsed}"
                                           FontSize="12" Foreground="Orange"/>
                                <TextBlock Text="{Binding InvalidEntriesSummary}"
                                           FontSize="11"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Download Options -->
                <Border Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container2BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Tr DlId_DownloadOptions}" FontSize="15" FontWeight="SemiBold"/>

                        <StackPanel Spacing="6">
                            <TextBlock Text="{loc:Tr DlId_PageRangeForMultiPageWorks}"
                                       FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                            <ComboBox ItemsSource="{Binding PageRangeOptions}"
                                      SelectedItem="{Binding SelectedPageRange, Mode=TwoWay}"
                                      Width="200" HorizontalAlignment="Left"
                                      CornerRadius="6"/>
                            <TextBlock Text="{loc:Tr DlId_SinglePageArtworksWillDownloadThe}"
                                       FontSize="11"
                                       Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                        </StackPanel>

                        <CheckBox Content="{loc:Tr DlId_SkipAlreadyDownloadedImages}"
                                  IsChecked="{Binding SkipExisting, Mode=TwoWay}"/>
                    </StackPanel>
                </Border>

                <!-- Settings Override -->
                <Border Background="{DynamicResource Container2BackgroundBrush}"
                        BorderBrush="{DynamicResource Container2BorderBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Text="{loc:Tr DlId_DownloadSettings}" FontSize="15" FontWeight="SemiBold"/>

                        <StackPanel Spacing="8">
                            <RadioButton Content="{loc:Tr DlId_UseGlobalSettings}"
                                          IsChecked="{Binding UseGlobalSettings, Mode=TwoWay}"/>
                            <RadioButton Content="{loc:Tr DlId_UseCustomSettingsForThisDownload}"
                                          IsChecked="{Binding !UseGlobalSettings, Mode=TwoWay}"/>
                        </StackPanel>

                        <!-- Custom Settings Panel -->
                        <StackPanel IsVisible="{Binding !UseGlobalSettings}" Spacing="10">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                <StackPanel Grid.Column="0" Spacing="6">
                                    <TextBlock Text="{loc:Tr Settings_FolderTemplate}" FontSize="12"/>
                                    <TextBox Text="{Binding CustomSettings.FolderTemplate, Mode=TwoWay}"
                                             CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock Text="{loc:Tr Settings_FilenameTemplate}" FontSize="12"/>
                                    <TextBox Text="{Binding CustomSettings.FilenameTemplate, Mode=TwoWay}"
                                             CornerRadius="4"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Progress Panel -->
        <Border Grid.Row="2" Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16"
                IsVisible="{Binding HasActiveJob}">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="13"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}"
                               FontSize="13" FontWeight="SemiBold"/>
                </Grid>
                <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4"/>
                <TextBlock Text="{Binding CurrentItemName}"
                           FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                           IsVisible="{Binding CurrentItemName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
        </Border>

        <!-- Action Bar -->
        <Border Grid.Row="3" Background="{DynamicResource Container2BackgroundBrush}"
                BorderBrush="{DynamicResource Container2BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <Button Grid.Column="0" Content="{loc:Tr DlId_SavePreset}"
                        Command="{Binding SavePresetCommand}"
                         />

                <Button Grid.Column="1" Content="{loc:Tr Common_Cancel}"
                        Command="{Binding CancelDownloadCommand}"
                        IsVisible="{Binding HasActiveJob}"
                         Padding="16,10" Margin="0,0,8,0"/>

                <Button Grid.Column="2" Content="{loc:Tr DlId_StartDownload}"
                        Command="{Binding StartDownloadCommand}"
                        IsEnabled="{Binding ParsedIds.Count}"
                        IsVisible="{Binding !HasActiveJob}"
                        Classes="accent"
                         Padding="20,12" />
            </Grid>
        </Border>

    </Grid>
</UserControl>
