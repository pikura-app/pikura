<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             x:Class="Pikura.Avalonia.Views.Download.DownloadQueueView"
             MinWidth="600" MinHeight="400">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Download Queue" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                    <TextBlock x:Name="JobCountLabel" FontSize="12"
                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <Button Grid.Column="1"  Padding="10,6" FontSize="12"
                        Click="OnRefresh">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14"
                                  VerticalAlignment="Center"
                                  Foreground="{Binding $parent[Button].Foreground}"/>
                        <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Job list -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="JobsPanel" Spacing="8" Margin="12"/>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button x:Name="ClearCompletedBtn" Content="Clear Completed"  Padding="10,6" FontSize="12"
                        Click="OnClearCompleted"/>
                <Button Content="Close"   FontSize="12"
                        Click="OnClose"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
