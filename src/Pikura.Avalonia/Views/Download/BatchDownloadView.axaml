<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:Pikura.Avalonia.Localization"
             xmlns:vm="using:Pikura.Avalonia.ViewModels"
             xmlns:actipro="http://schemas.actiprosoftware.com/avaloniaui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="800"
             x:Class="Pikura.Avalonia.Views.BatchDownloadView"
             x:DataType="vm:BatchDownloadViewModel">

    <Design.DataContext>
        <vm:BatchDownloadViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource Container1BackgroundBrush}"
                BorderBrush="{DynamicResource Container1BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10"
                Margin="0,32,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- LEFT: Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Tr Nav_BatchDownload}" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- CENTER: Spacer -->
                <Border Grid.Column="1"/>

                <!-- RIGHT: Queue button -->
                <Button Grid.Column="2"
                        Command="{Binding OpenQueueCommand}"
                          FontSize="12"
                        ToolTip.Tip="{loc:Tr Queue_DownloadQueue}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="📋" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Batch_Queue}" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Tabbed Content -->
        <TabControl Grid.Row="1" Padding="0" TabStripPlacement="Top" Margin="0">
            <TabItem Header="{loc:Tr Batch_ByArtist}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="20">
                        <!-- Artist Selection -->
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <DockPanel LastChildFill="False">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr DlArtist_SelectedArtists}" FontSize="15" FontWeight="SemiBold"
                                                   AutomationProperties.Name="Selected Artists Header"
                                                   AutomationProperties.HelpText="List of artists selected for download"/>
                                        <TextBlock Text="{Binding ArtistViewModel.SelectedArtists.Count, StringFormat='{}{0} artists'}"
                                                   FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"
                                                   AutomationProperties.Name="{Binding ArtistViewModel.SelectedArtists.Count, StringFormat='{}{0} artists selected'}"/>
                                        <TextBlock Text="•"
                                                   FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"
                                                   IsVisible="{Binding ArtistViewModel.SelectedArtists.Count}"/>
                                        <TextBlock Text="{Binding ArtistViewModel.EstimatedItemCount, StringFormat='~{}{0} items'}"
                                                   FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"
                                                   IsVisible="{Binding ArtistViewModel.SelectedArtists.Count}"
                                                   AutomationProperties.Name="{Binding ArtistViewModel.EstimatedItemCount, StringFormat='Approximately {0} items to download'}"/>
                                    </StackPanel>
                                    <Button DockPanel.Dock="Right"
                                            Content="{loc:Tr Batch_ClearAll}"
                                            Command="{Binding ArtistViewModel.ClearArtistsCommand}"
                                            IsVisible="{Binding ArtistViewModel.SelectedArtists.Count}"
                                            ToolTip.Tip="{loc:Tr Batch_RemoveAllSelectedArtists}"
                                             Padding="10,4" FontSize="12"/>
                                </DockPanel>

                                <Border Background="{DynamicResource Container3BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container3BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Height="150">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding ArtistViewModel.SelectedArtists}" Margin="8">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:SelectedArtist">
                                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6"
                                                            Padding="8,4" Margin="0,0,6,6">
                                                        <DockPanel LastChildFill="False">
                                                            <Button DockPanel.Dock="Right" Content="✕"
                                                                    FontSize="10"  Padding="4,0" Margin="6,0,0,0"
                                                                    ToolTip.Tip="{loc:Tr Batch_RemoveArtist}"
                                                                    Command="{Binding $parent[ItemsControl].DataContext.ArtistViewModel.RemoveArtistCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Button DockPanel.Dock="Right" Content="⚙"
                                                                    FontSize="10"  Padding="4,0" Margin="6,0,0,0"
                                                                    ToolTip.Tip="{loc:Tr DlArtist_ConfigureCustomDownloadSettingsForThis}"
                                                                    Command="{Binding $parent[ItemsControl].DataContext.ArtistViewModel.ConfigureArtistSettingsCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                            <Border DockPanel.Dock="Right" IsVisible="{Binding HasCustomSettings}"
                                                                    Background="{DynamicResource ControlBackgroundBrushSolidAccent}"
                                                                    CornerRadius="3" Padding="3,0" Margin="6,0,0,0"
                                                                    ToolTip.Tip="{loc:Tr DlArtist_HasCustomDownloadSettings}">
                                                                <TextBlock Text="●" FontSize="10" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Text="{Binding UserName}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr DlArtist_AddFollowedArtists}"
                                            Command="{Binding ArtistViewModel.AddFollowedArtistsCommand}"
                                            ToolTip.Tip="{loc:Tr Batch_AddAllArtistsYouFollowOn}"
                                             />
                                    <Button Content="{loc:Tr DlId_ImportFromFile}"
                                            Command="{Binding ArtistViewModel.ImportArtistsFromFileAsync}"
                                            ToolTip.Tip="{loc:Tr Batch_ImportAListOfArtistIDs}"
                                             />
                                </StackPanel>

                                <StackPanel Spacing="8">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock DockPanel.Dock="Left" Text="{loc:Tr DlArtist_ArtistIDsOrURLs}" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ArtistViewModel.ParsedArtistIds.Count, StringFormat='{}{0} IDs detected'}"
                                                   FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                                    </DockPanel>

                                    <TextBox Text="{Binding ArtistViewModel.NewArtistId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             PlaceholderText="{loc:Tr Batch_EnterArtistIdsMulti}"
                                             CornerRadius="6" MinHeight="80"
                                             AutomationProperties.Name="Artist ID or URL Input"
                                             AutomationProperties.HelpText="Enter Pixiv artist IDs or profile URLs. Multiple IDs can be entered separated by commas or new lines."
                                             KeyboardNavigation.TabIndex="1"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="{loc:Tr Hoshi_Paste}"
                                                Command="{Binding ArtistViewModel.PasteFromClipboardCommand}"
                                                ToolTip.Tip="{loc:Tr DlArtist_PasteLastCopiedID}"
                                                 Padding="10,6"
                                                IsVisible="{Binding ArtistViewModel.HasClipboardContent}"/>
                                        <Button Content="{loc:Tr Batch_Clear}"
                                                Command="{Binding ArtistViewModel.ClearInputCommand}"
                                                ToolTip.Tip="{loc:Tr Batch_ClearTheInputBox}"
                                                 Padding="10,6"
                                                IsVisible="{Binding ArtistViewModel.ParsedArtistIds.Count}"/>
                                        <Button Content="{loc:Tr DlArtist_AddArtists}"
                                                Command="{Binding ArtistViewModel.AddArtistByIdCommand}"
                                                IsEnabled="{Binding ArtistViewModel.ParsedArtistIds.Count}"
                                                ToolTip.Tip="{loc:Tr Batch_AddArtistsByIDOrPixiv}"
                                                 
                                                AutomationProperties.Name="Add Artists Button"
                                                AutomationProperties.HelpText="Click to add all valid artist IDs entered above"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Artist Preview Card -->
                                <Border IsVisible="{Binding ArtistViewModel.ShowArtistPreview}"
                                        Background="{DynamicResource Container3BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container3BorderBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="12">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Avatar -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20"
                                                Background="{DynamicResource Container2BackgroundBrush}">
                                            <TextBlock Text="👤" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock Text="{Binding ArtistViewModel.PreviewArtistName}" FontWeight="SemiBold" FontSize="13"/>
                                            <TextBlock Text="{Binding ArtistViewModel.PreviewArtistId, StringFormat='ID: {0}'}"
                                                       FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </StackPanel>

                                        <!-- Add Button -->
                                        <Button Grid.Column="2" Content="{loc:Tr Batch_Add}"
                                                Command="{Binding ArtistViewModel.AddArtistByIdCommand}"
                                                 />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Page Range Settings -->
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="{loc:Tr Batch_DefaultPageRangeAllArtists}" FontSize="15" FontWeight="SemiBold"
                                           ToolTip.Tip="{loc:Tr Batch_SpecifyWhichPagesToDownload0}"/>

                                <StackPanel Spacing="4">
                                    <TextBox Text="{Binding ArtistViewModel.DefaultPageRange, Mode=TwoWay}"
                                             CornerRadius="6" Width="200" HorizontalAlignment="Left"
                                             PlaceholderText="e.g., 0, 1-5, 2,4,6-10"
                                             ToolTip.Tip="{loc:Tr Batch_EnterPageNumbers0OrAll}"/>
                                    <TextBlock Margin="0,2,0,0"
                                               FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                               TextWrapping="Wrap"
                                               Text="{loc:Tr Batch_Format0OrAllAllPages}"/>
                                </StackPanel>

                                <TextBlock IsVisible="{Binding ArtistViewModel.DefaultPageRangeInvalid}"
                                           Text="{loc:Tr Batch_InvalidFormatUse021}"
                                           FontSize="12" Foreground="Orange"/>

                                <CheckBox Content="{loc:Tr DlArtist_SetCustomPageRangesAndSettings}"
                                          IsChecked="{Binding ArtistViewModel.UsePerArtistPageRanges, Mode=TwoWay}"
                                          ToolTip.Tip="{loc:Tr Batch_EnableToSetDifferentPageRanges}"/>

                                <!-- Per-Artist Page Ranges + Settings (visible when enabled) -->
                                <Border IsVisible="{Binding ArtistViewModel.UsePerArtistPageRanges}"
                                        Background="{DynamicResource Container3BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container3BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8">
                                    <StackPanel>
                                        <!-- Header row -->
                                        <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="8" Margin="4,4,4,4">
                                            <TextBlock Grid.Column="0" Text="{loc:Tr Viewer_Artist}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBlock Grid.Column="1" Text="{loc:Tr DlArtist_PageRange}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBlock Grid.Column="2" Text="{loc:Tr Batch_CustomSettings}" FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding ArtistViewModel.SelectedArtists}"
                                                      Margin="4,0,4,4">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:SelectedArtist">
                                                    <Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="8" Margin="0,4">
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding UserName}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <Border IsVisible="{Binding HasCustomSettings}"
                                                                    Background="{DynamicResource ControlBackgroundBrushSolidAccent}"
                                                                    CornerRadius="3" Padding="4,1"
                                                                    ToolTip.Tip="{loc:Tr DlArtist_HasCustomDownloadSettings}">
                                                                <TextBlock Text="{loc:Tr DlArtist_Custom}" FontSize="10"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1"
                                                                 Text="{Binding PageRange, Mode=TwoWay}"
                                                                 PlaceholderText="{loc:Tr Gallery_Default}"
                                                                 CornerRadius="4"
                                                                 FontSize="12"/>
                                                        <Button Grid.Column="2"
                                                                Content="{loc:Tr DlArtist_Settings}"
                                                                FontSize="11" 
                                                                
                                                                ToolTip.Tip="{loc:Tr DlArtist_ConfigureCustomDownloadSettingsForThis}"
                                                                Command="{Binding $parent[ItemsControl].DataContext.ArtistViewModel.ConfigureArtistSettingsCommand}"
                                                                CommandParameter="{Binding}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Settings Section -->
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr DlId_DownloadSettings}" FontSize="15" FontWeight="SemiBold"/>

                                <StackPanel Spacing="8">
                                    <RadioButton Content="{loc:Tr DlId_UseGlobalSettings}"
                                                 IsChecked="{Binding ArtistViewModel.UseGlobalSettings, Mode=TwoWay}"/>
                                    <RadioButton Content="{loc:Tr DlId_UseCustomSettingsForThisDownload}"
                                                 IsChecked="{Binding !ArtistViewModel.UseGlobalSettings, Mode=TwoWay}"/>
                                </StackPanel>

                                <!-- Custom Settings Panel -->
                                <StackPanel IsVisible="{Binding !ArtistViewModel.UseGlobalSettings}" Spacing="10">
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                        <StackPanel Grid.Column="0" Spacing="6">
                                            <TextBlock Text="{loc:Tr Settings_FolderTemplate}" FontSize="12"/>
                                            <TextBox Text="{Binding ArtistViewModel.CustomSettings.FolderTemplate, Mode=TwoWay}"
                                                     CornerRadius="4" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="{loc:Tr Settings_FilenameTemplate}" FontSize="12"/>
                                            <TextBox Text="{Binding ArtistViewModel.CustomSettings.FilenameTemplate, Mode=TwoWay}"
                                                     CornerRadius="4" FontSize="12"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="20">
                                        <CheckBox Content="{loc:Tr DlArtist_CreateSubfolderPerSubmission}"
                                                  IsChecked="{Binding ArtistViewModel.CustomSettings.CreateSubfolderPerSubmission, Mode=TwoWay}"
                                                  ToolTip.Tip="{loc:Tr Batch_CreateASeparateFolderForEach}"
                                                  FontSize="12"/>
                                        <CheckBox Content="{loc:Tr DlArtist_SeparateR18Folder}"
                                                  IsChecked="{Binding ArtistViewModel.CustomSettings.SeparateR18Folder, Mode=TwoWay}"
                                                  ToolTip.Tip="{loc:Tr Batch_SaveR18MatureContentTo}"
                                                  FontSize="12"/>
                                    </StackPanel>

                                    <!-- Content Filters -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:Tr Settings_ContentFilters}" FontSize="12" FontWeight="SemiBold"/>
                                        <Border Background="{DynamicResource Container3BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="10">

                                                <TextBlock Text="{loc:Tr Batch_SkipContentTypes}" FontSize="11"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                <WrapPanel>
                                                    <CheckBox Content="{loc:Tr Batch_AIGenerated}" Margin="0,0,16,4"
                                                              IsChecked="{Binding ArtistViewModel.CustomSettings.FilterAiGenerated, Mode=TwoWay}"
                                                              FontSize="12"/>
                                                    <CheckBox Content="{loc:Tr Search_Manga}" Margin="0,0,16,4"
                                                              IsChecked="{Binding ArtistViewModel.CustomSettings.SkipManga, Mode=TwoWay}"
                                                              FontSize="12"/>
                                                    <CheckBox Content="{loc:Tr Rankings_Ugoira}" Margin="0,0,16,4"
                                                              IsChecked="{Binding ArtistViewModel.CustomSettings.SkipUgoira, Mode=TwoWay}"
                                                              FontSize="12"/>
                                                    <CheckBox Content="R-18" Margin="0,0,16,4"
                                                              IsChecked="{Binding ArtistViewModel.CustomSettings.SkipR18, Mode=TwoWay}"
                                                              FontSize="12"/>
                                                    <CheckBox Content="{loc:Tr Batch_R18GOnly}" Margin="0,0,0,4"
                                                              IsChecked="{Binding ArtistViewModel.CustomSettings.SkipR18G, Mode=TwoWay}"
                                                              FontSize="12"
                                                              ToolTip.Tip="{loc:Tr Batch_SkipGrotesqueViolentR18GBut}"/>
                                                </WrapPanel>

                                                <!-- Tag filters -->
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{loc:Tr Batch_MustIncludeTagS}" FontSize="11"/>
                                                        <TextBox Text="{Binding ArtistViewModel.CustomSettings.IncludeTags, Mode=TwoWay}"
                                                                 PlaceholderText="{loc:Tr Batch_TagsExample}"
                                                                 CornerRadius="4" FontSize="12"
                                                                 ToolTip.Tip="{loc:Tr Batch_CommaSeparatedArtworkMustMatchAt}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{loc:Tr Batch_ExcludeTagS}" FontSize="11"/>
                                                        <TextBox Text="{Binding ArtistViewModel.CustomSettings.ExcludeTagsFilter, Mode=TwoWay}"
                                                                 PlaceholderText="{loc:Tr Batch_ExcludeExample}"
                                                                 CornerRadius="4" FontSize="12"
                                                                 ToolTip.Tip="{loc:Tr Batch_CommaSeparatedArtworkIsSkippedIf}"/>
                                                    </StackPanel>
                                                </Grid>

                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Auto-Retry Settings -->
                                    <StackPanel Spacing="8">
                                        <CheckBox Content="{loc:Tr Batch_AutoRetryFailedDownloads}"
                                                  IsChecked="{Binding ArtistViewModel.CustomSettings.AutoRetryFailedDownloads, Mode=TwoWay}"
                                                  ToolTip.Tip="{loc:Tr Batch_AutomaticallyRetryFailedDownloadsWithThe}"
                                                  FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" Spacing="16" IsVisible="{Binding ArtistViewModel.CustomSettings.AutoRetryFailedDownloads}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{loc:Tr Batch_MaxRetries}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                <NumericUpDown Value="{Binding ArtistViewModel.CustomSettings.MaxRetryAttempts, Mode=TwoWay}"
                                                               Minimum="1" Maximum="10"
                                                               Width="80" FontSize="12"/>
                                            </StackPanel>
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{loc:Tr Batch_RetryDelaySec}" FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                <NumericUpDown Value="{Binding ArtistViewModel.CustomSettings.RetryDelaySeconds, Mode=TwoWay}"
                                                               Minimum="1" Maximum="60"
                                                               Width="100" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Progress Section (visible when downloading) -->
                        <Border IsVisible="{Binding ArtistViewModel.HasActiveJob}"
                                Background="{DynamicResource Container3BackgroundBrush}"
                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <ProgressBar Value="{Binding ArtistViewModel.ProgressPercent}"
                                                Maximum="100"
                                                Width="300"
                                                Height="8"
                                                CornerRadius="4"
                                                ShowProgressText="False"
                                                IsIndeterminate="{Binding ArtistViewModel.IsLoading}"
                                                AutomationProperties.Name="Download Progress"
                                                AutomationProperties.HelpText="Shows the current download progress"/>
                                    <TextBlock Text="{Binding ArtistViewModel.ProgressPercent, StringFormat='{}{0:F0}%'}"
                                               FontSize="13" VerticalAlignment="Center"
                                               AutomationProperties.Name="{Binding ArtistViewModel.ProgressPercent, StringFormat='Download is {0:F0} percent complete'}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding ArtistViewModel.ProgressStatusMessage}"
                                           FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           TextTrimming="CharacterEllipsis"
                                           AutomationProperties.Name="{Binding ArtistViewModel.ProgressStatusMessage}"/>
                                <TextBlock Text="{Binding ArtistViewModel.CompletedItemCount, StringFormat='Completed {0} of {1} items', TargetNullValue='Starting...'}"
                                           FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                           IsVisible="{Binding ArtistViewModel.EstimatedItemCount}"/>
                            </StackPanel>
                        </Border>

                        <!-- Download Preview (visible when not downloading) -->
                        <Border IsVisible="{Binding !ArtistViewModel.HasActiveJob}"
                                Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="📊" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ArtistViewModel.DownloadPreviewText}"
                                           FontSize="13"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           VerticalAlignment="Center"
                                           AutomationProperties.Name="Download Preview"
                                           AutomationProperties.HelpText="Shows what will be downloaded"/>
                            </StackPanel>
                        </Border>

                        <!-- Action Bar -->
                        <DockPanel LastChildFill="False">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr Batch_Save}"
                                        Command="{Binding ArtistViewModel.SavePresetCommand}"
                                        ToolTip.Tip="{loc:Tr Batch_SaveCurrentArtistListAndSettings}"
                                         
                                        AutomationProperties.Name="Save Preset Button"
                                        AutomationProperties.HelpText="Save current configuration for later use"
                                        KeyboardNavigation.TabIndex="10"/>
                                <Button Content="{loc:Tr Batch_Load}"
                                        Command="{Binding ArtistViewModel.LoadPresetCommand}"
                                        ToolTip.Tip="{loc:Tr Batch_LoadAPreviouslySavedPresetWith}"
                                         
                                        AutomationProperties.Name="Load Preset Button"
                                        AutomationProperties.HelpText="Load a previously saved configuration"
                                        KeyboardNavigation.TabIndex="11"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                <Button Content="{loc:Tr Batch_AddToQueue}"
                                        Command="{Binding ArtistViewModel.AddToQueueCommand}"
                                        IsEnabled="{Binding ArtistViewModel.SelectedArtists.Count}"
                                          
                                        ToolTip.Tip="{loc:Tr Batch_AddToQueueWithoutStartingImmediately}"
                                        KeyboardNavigation.TabIndex="19"/>
                                <Button Content="{loc:Tr DlId_StartDownload}"
                                        Command="{Binding ArtistViewModel.StartDownloadCommand}"
                                        IsEnabled="{Binding ArtistViewModel.SelectedArtists.Count}"
                                        Classes="accent"
                                         Padding="20,12" 
                                        ToolTip.Tip="{loc:Tr Batch_BeginDownloadingArtworksFromAllSelected}"
                                        AutomationProperties.Name="Start Download Button"
                                        AutomationProperties.HelpText="Click to begin downloading from all selected artists"
                                        KeyboardNavigation.TabIndex="20"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr Batch_ByImageID}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="20">
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{loc:Tr DlId_ImageIDsOrURLs}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ImageIdViewModel.ParsedIds.Count, StringFormat='{}{0} IDs detected'}"
                                               FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBox Text="{Binding ImageIdViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         PlaceholderText="{loc:Tr Batch_EnterImageIdsMulti}"
                                         Height="200"
                                         CornerRadius="6"
                                         FontFamily="Consolas, monospace"
                                         FontSize="13"/>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr DlId_ImportFromFile}"
                                            Command="{Binding ImageIdViewModel.ImportFromFileAsync}"
                                             />
                                    <Button Content="{loc:Tr Common_Clear}"
                                            Command="{Binding ImageIdViewModel.ClearInputCommand}"
                                             />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="{loc:Tr Batch_StartImageIDDownload}"
                                Command="{Binding ImageIdViewModel.StartDownloadCommand}"
                                IsEnabled="{Binding ImageIdViewModel.ParsedIds.Count}"
                                Classes="accent"
                                HorizontalAlignment="Right"
                                 Padding="20,12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr Batch_ByCollection}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="20">
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <DockPanel LastChildFill="False">
                                    <TextBlock DockPanel.Dock="Left" Text="{loc:Tr Batch_CollectionURLsOrIDs}" FontSize="15" FontWeight="SemiBold"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CollectionViewModel.ParsedIds.Count, StringFormat='{}{0} collection(s) detected'}"
                                               FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}" VerticalAlignment="Center"/>
                                </DockPanel>

                                <TextBox Text="{Binding CollectionViewModel.InputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         PlaceholderText="{loc:Tr Batch_EnterCollectionIdsMulti}"
                                         Height="160"
                                         CornerRadius="6"
                                         FontFamily="Consolas, monospace"
                                         FontSize="13"/>

                                <TextBlock Text="{Binding CollectionViewModel.InvalidEntriesSummary}" FontSize="11"
                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           IsVisible="{Binding CollectionViewModel.HasInvalidInput}"/>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="{loc:Tr Common_Clear}"
                                            Command="{Binding CollectionViewModel.ClearInputCommand}"
                                             />
                                    <CheckBox Content="{loc:Tr Batch_KeepEachCollectionInItsOwn}" FontSize="12"
                                              IsChecked="{Binding CollectionViewModel.UseCollectionFolder, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              ToolTip.Tip="{loc:Tr Batch_OnEachCollectionSWorksGo}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding CollectionViewModel.StatusMessage}" FontSize="12"
                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>

                        <Button Content="{loc:Tr Batch_StartCollectionDownload}"
                                Command="{Binding CollectionViewModel.StartDownloadCommand}"
                                IsEnabled="{Binding CollectionViewModel.ParsedIds.Count}"
                                Classes="accent"
                                HorizontalAlignment="Right"
                                 Padding="20,12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr Batch_Bookmarks}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="20">
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr DlBookmarks_Source}" FontSize="15" FontWeight="SemiBold"/>
                                <RadioButton Content="{loc:Tr DlBookmarks_BookmarkedImagesIllustrationsManga}"
                                             IsChecked="{Binding BookmarksViewModel.IsBookmarkedImages, Mode=TwoWay}"/>
                                <RadioButton Content="{loc:Tr DlBookmarks_BookmarkedArtists}"
                                             IsChecked="{Binding !BookmarksViewModel.IsBookmarkedImages, Mode=TwoWay}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr DlBookmarks_Visibility}" FontSize="15" FontWeight="SemiBold"/>
                                <StackPanel Spacing="8">
                                    <RadioButton Content="{loc:Tr DlBookmarks_PublicBookmarksOnly}"
                                                 IsChecked="{Binding BookmarksViewModel.IsPublicOnly, Mode=TwoWay}"/>
                                    <RadioButton Content="{loc:Tr DlBookmarks_PrivateBookmarksOnly}"
                                                 IsChecked="{Binding BookmarksViewModel.IsPrivateOnly, Mode=TwoWay}"/>
                                    <RadioButton Content="{loc:Tr DlBookmarks_BothPublicAndPrivate}"
                                                 IsChecked="{Binding BookmarksViewModel.IsBothVisibility, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr DlBookmarks_FilterOptions}" FontSize="15" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="16">
                                    <CheckBox Content="{loc:Tr DlBookmarks_IncludeR18}" IsChecked="{Binding BookmarksViewModel.IncludeR18, Mode=TwoWay}"/>
                                    <CheckBox Content="{loc:Tr DlBookmarks_IncludeAIGenerated}" IsChecked="{Binding BookmarksViewModel.IncludeAiGenerated, Mode=TwoWay}"/>
                                    <CheckBox Content="{loc:Tr DlBookmarks_IncludeManga}" IsChecked="{Binding BookmarksViewModel.IncludeManga, Mode=TwoWay}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="{loc:Tr Batch_StartRemoteBookmarkDownload}"
                                Command="{Binding BookmarksViewModel.StartDownloadCommand}"
                                Classes="accent"
                                HorizontalAlignment="Right"
                                 Padding="20,12" 
                                ToolTip.Tip="{loc:Tr Batch_DownloadFromPixivBookmarksPublicPrivate}"/>

                        <!-- Local Favorites Download Options -->
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr Batch_LocalFavorites}" FontSize="15" FontWeight="SemiBold"/>
                                <StackPanel Spacing="8">
                                    <Button Content="{loc:Tr Batch_DownloadAllFavorites}"
                                            Command="{Binding BookmarksViewModel.DownloadAllFavoritesCommand}"
                                              FontSize="12"
                                            HorizontalAlignment="Stretch"/>
                                    
                                    <StackPanel Spacing="4" IsVisible="{Binding BookmarksViewModel.HasFolders}">
                                        <TextBlock Text="{loc:Tr Batch_DownloadFromFolder}" FontSize="12"
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <Grid ColumnDefinitions="*,Auto">
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding BookmarksViewModel.AvailableFolders}"
                                                      SelectedItem="{Binding BookmarksViewModel.SelectedFolder, Mode=TwoWay}"
                                                      PlaceholderText="{loc:Tr Batch_SelectFolder}"
                                                      CornerRadius="6" Padding="8,4" FontSize="12"/>
                                            <Button Grid.Column="1" Content="{loc:Tr Common_Download}"
                                                    Command="{Binding BookmarksViewModel.DownloadFromFolderCommand}"
                                                      FontSize="12"
                                                    Margin="8,0,0,0"/>
                                        </Grid>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <CheckBox Content="{loc:Tr Batch_UseCustomDownloadPath}"
                                                  IsChecked="{Binding BookmarksViewModel.UseCustomDownloadPath, Mode=TwoWay}"/>
                                        <TextBox Text="{Binding BookmarksViewModel.CustomDownloadPath, Mode=TwoWay}"
                                                 PlaceholderText="{loc:Tr Batch_CustomDownloadPath}"
                                                 CornerRadius="6" Padding="8,4" FontSize="12"
                                                 IsEnabled="{Binding BookmarksViewModel.UseCustomDownloadPath}"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr Batch_FromList}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="20">
                        <TextBlock Text="{loc:Tr Batch_DownloadFromList}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Tr Batch_DownloadFromListFiles}"
                                   TextAlignment="Center" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                        
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                                    <TextBox Grid.Column="0" 
                                             Text="{Binding FromListViewModel.SelectedFilePath, Mode=OneWay}"
                                             PlaceholderText="{loc:Tr Batch_NoFileSelected}"
                                             IsReadOnly="True"
                                             CornerRadius="6" Padding="8,4" FontSize="12"/>
                                    <Button Grid.Column="1" Content="{loc:Tr Batch_Browse}"
                                            Command="{Binding FromListViewModel.SelectListFileCommand}"
                                              FontSize="12"
                                            Margin="8,0,0,0"/>
                                </Grid>
                                
                                <Border Background="{DynamicResource Container3BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container3BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12"
                                        MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding FromListViewModel.ListContent}" 
                                                   FontSize="11" 
                                                   FontFamily="Consolas,monospace"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.9"/>
                                    </ScrollViewer>
                                </Border>
                                
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{loc:Tr Batch_Items}" FontSize="12" 
                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                    <TextBlock Text="{Binding FromListViewModel.ItemCount}" 
                                               FontWeight="SemiBold" FontSize="12"/>
                                </StackPanel>
                                
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Content="{loc:Tr Common_Clear}" 
                                            Command="{Binding FromListViewModel.ClearListCommand}"
                                              FontSize="12"/>
                                    <Button Content="{loc:Tr DlId_StartDownload}" 
                                            Command="{Binding FromListViewModel.StartDownloadCommand}"
                                            Classes="accent"
                                            IsEnabled="{Binding FromListViewModel.HasItems}"
                                              FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr Batch_Search}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="20">
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr Batch_SearchKeyword}" FontSize="14" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding SearchViewModel.SearchKeyword, Mode=TwoWay}"
                                         PlaceholderText="{loc:Tr Batch_EnterSearchKeyword}"
                                         CornerRadius="6" Padding="8,4" FontSize="12"/>
                                
                                <Grid ColumnDefinitions="*,*,*" HorizontalAlignment="Stretch">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="{loc:Tr Batch_Mode}" FontSize="12" 
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <ComboBox SelectedValue="{Binding SearchViewModel.SearchMode, Mode=TwoWay}"
                                                  SelectedValueBinding="{ReflectionBinding Tag}"
                                                  CornerRadius="6" FontSize="12">
                                            <ComboBoxItem Content="{loc:Tr Search_Safe}" Tag="safe"/>
                                            <ComboBoxItem Content="R-18" Tag="r18"/>
                                            <ComboBoxItem Content="{loc:Tr Search_All}" Tag="all"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="4" Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{loc:Tr Batch_SortOrder}" FontSize="12"
                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                            <TextBlock Text="👑" FontSize="10" VerticalAlignment="Center"
                                                       IsVisible="{Binding !SearchViewModel.IsPremiumAccount}"
                                                       ToolTip.Tip="{loc:Tr Batch_PopularitySortRequiresPixivPremium}"/>
                                        </StackPanel>
                                        <ComboBox SelectedValue="{Binding SearchViewModel.SortOrder, Mode=TwoWay}"
                                                  SelectedValueBinding="{ReflectionBinding Tag}"
                                                  CornerRadius="6" FontSize="12">
                                            <ComboBoxItem Content="{loc:Tr Search_NewestFirst}" Tag="date_d"/>
                                            <ComboBoxItem Content="{loc:Tr Search_PopularFirst}" Tag="popular_d"
                                                          IsVisible="{Binding SearchViewModel.IsPremiumAccount}"
                                                          IsEnabled="{Binding SearchViewModel.IsPremiumAccount}"
                                                          ToolTip.Tip="{loc:Tr Batch_SortByPopularityPixivPremium}"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" Margin="8,0,0,0">
                                        <TextBlock Text="{loc:Tr Batch_MaxResults}" FontSize="12" 
                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                        <NumericUpDown Value="{Binding SearchViewModel.MaxResults, Mode=TwoWay}"
                                                     Minimum="1" Maximum="500"
                                                     CornerRadius="6" FontSize="12"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Button Content="{loc:Tr Batch_Search}"
                                        Command="{Binding SearchViewModel.SearchCommand}"
                                        IsEnabled="{Binding !SearchViewModel.IsSearching}"
                                          FontSize="12"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16"
                                IsVisible="{Binding SearchViewModel.HasResults}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Batch_Results}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding SearchViewModel.ResultCount, StringFormat='{}{0} items'}"
                                               FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                </Grid>
                                
                                <Border Background="{DynamicResource Container3BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container3BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12"
                                        MaxHeight="400">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding SearchViewModel.SearchResults}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,8,8"
                                                            Width="150">
                                                        <StackPanel Spacing="6">
                                                            <!-- Thumbnail -->
                                                            <Border BorderBrush="{DynamicResource Container3BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="4"
                                                                    Height="150" Background="{DynamicResource Container3BackgroundBrush}">
                                                                <Image Source="{Binding Thumbnail}"
                                                                       Stretch="UniformToFill"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       RenderOptions.BitmapInterpolationMode="HighQuality" UseLayoutRounding="True"/>
                                                            </Border>
                                                            <!-- Info -->
                                                            <TextBlock Text="{Binding Title}" FontSize="11" 
                                                                       TextTrimming="CharacterEllipsis" MaxLines="2"/>
                                                            <TextBlock Text="{Binding ArtistName}" FontSize="10"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding PageCount, StringFormat='{}{0}p'}" FontSize="9"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                                <TextBlock Text="•" FontSize="9"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                           IsVisible="{Binding IsR18}"/>
                                                                <TextBlock Text="R-18" FontSize="9" Foreground="Red"
                                                                           IsVisible="{Binding IsR18}"/>
                                                                <TextBlock Text="•" FontSize="9"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                           IsVisible="{Binding IsAiGenerated}"/>
                                                                <TextBlock Text="{loc:Tr Rankings_AI}" FontSize="9" Foreground="Orange"
                                                                           IsVisible="{Binding IsAiGenerated}"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Content="{loc:Tr Batch_ClearResults}" 
                                            Command="{Binding SearchViewModel.ClearResultsCommand}"
                                              FontSize="12"/>
                                    <Button Content="{loc:Tr DlId_StartDownload}" 
                                            Command="{Binding SearchViewModel.StartDownloadCommand}"
                                            Classes="accent"
                                              FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{loc:Tr Batch_FANBOX}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Margin="20">
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="{loc:Tr Batch_SearchByPostID}" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding FanboxViewModel.PostId, Mode=TwoWay}"
                                             PlaceholderText="{loc:Tr Batch_EnterFANBOXPostID}"
                                             CornerRadius="6" Padding="8,4" FontSize="12"/>
                                    <Button Grid.Column="1" Content="{loc:Tr Batch_Search}"
                                            Command="{Binding FanboxViewModel.SearchByPostIdCommand}"
                                            IsEnabled="{Binding !FanboxViewModel.IsSearching}"
                                              FontSize="12" Margin="8,0,0,0"/>
                                </Grid>
                                <Separator/>
                                <TextBlock Text="{loc:Tr Batch_SearchByCreatorID}" FontSize="14" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding FanboxViewModel.CreatorId, Mode=TwoWay}"
                                             PlaceholderText="{loc:Tr Batch_EnterCreatorID}"
                                             CornerRadius="6" Padding="8,4" FontSize="12"/>
                                    <Button Grid.Column="1" Content="{loc:Tr Batch_Search}"
                                            Command="{Binding FanboxViewModel.SearchByCreatorIdCommand}"
                                            IsEnabled="{Binding !FanboxViewModel.IsSearching}"
                                              FontSize="12" Margin="8,0,0,0"/>
                                </Grid>
                                <TextBlock Text="{Binding FanboxViewModel.SearchResult}"
                                           FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Background="{DynamicResource Container2BackgroundBrush}"
                                BorderBrush="{DynamicResource Container2BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="16"
                                IsVisible="{Binding FanboxViewModel.Posts.Count}">
                            <StackPanel Spacing="12">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Batch_Results}" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding FanboxViewModel.Posts.Count, StringFormat='{}{0} posts'}"
                                               FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                </Grid>
                                
                                <Border Background="{DynamicResource Container2BackgroundBrush}"
                                        BorderBrush="{DynamicResource Container2BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12"
                                        MaxHeight="300">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding FanboxViewModel.Posts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                            BorderBrush="{DynamicResource Container2BorderBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,4">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="{Binding Post.Title}" FontSize="12" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Post.User.Name, StringFormat='{}By {0}'}" FontSize="11"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            <TextBlock Text="{Binding Post.PublishedDatetime, StringFormat='{}{0:yyyy-MM-dd}'}" FontSize="10"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            <TextBlock Text="{Binding Post.Images.Count, StringFormat='{}{0} images'}" FontSize="10"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            <Separator Margin="0,4,0,4"/>
                                                            <TextBlock Text="{loc:Tr Batch_CoverFilename}" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            <TextBlock Text="{Binding CoverFilename}" FontSize="9"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{loc:Tr Batch_InfoFilename}" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            <TextBlock Text="{Binding InfoFilename}" FontSize="9"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{loc:Tr Batch_ImageFilenames}" FontSize="9" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            <ItemsControl ItemsSource="{Binding ImageFilenames}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" FontSize="9"
                                                                                   Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                                   TextWrapping="Wrap"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                                
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <Button Content="{loc:Tr Batch_ClearResults}" 
                                            Command="{Binding FanboxViewModel.ClearResultsCommand}"
                                              FontSize="12"/>
                                    <Button Content="{loc:Tr Batch_Download}" 
                                            Command="{Binding FanboxViewModel.DownloadSelectedCommand}"
                                            Classes="accent"
                                              FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- ====================== SCHEDULES ====================== -->
            <TabItem Header="{loc:Tr Batch_Schedules}">
                <Grid RowDefinitions="*">
                    <!-- Single unified view: List or Editor based on IsEditing -->
                    <Grid RowDefinitions="Auto,*">
                        <!-- Toolbar -->
                        <Border Grid.Row="0" Padding="16,10"
                                BorderBrush="{DynamicResource Container2BorderBrush}" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="False">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SchedulesViewModel.Schedules.Count, StringFormat='{}{0} schedules'}"
                                               FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding !SchedulesViewModel.IsEditing}"/>
                                    <TextBlock Text="{Binding SchedulesViewModel.StatusMessage}"
                                               FontSize="12" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding SchedulesViewModel.StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                                    <!-- Show when NOT editing -->
                                    <Button Content="{loc:Tr Batch_NewSchedule}"
                                            Command="{Binding SchedulesViewModel.AddNewCommand}"
                                            IsVisible="{Binding !SchedulesViewModel.IsEditing}"
                                            Classes="accent"
                                              FontSize="12"/>
                                    <Button Command="{Binding SchedulesViewModel.RefreshCommand}"
                                            IsVisible="{Binding !SchedulesViewModel.IsEditing}"
                                             Padding="10,4" FontSize="12">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <PathIcon Data="{StaticResource RefreshIcon}" Width="14" Height="14"
                                                      VerticalAlignment="Center"
                                                      Foreground="{Binding $parent[Button].Foreground}"/>
                                            <TextBlock Text="{loc:Tr Common_Refresh}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <!-- Show when editing -->
                                    <Button Content="{loc:Tr Batch_BackToSchedules}"
                                            Command="{Binding SchedulesViewModel.CancelEditCommand}"
                                            IsVisible="{Binding SchedulesViewModel.IsEditing}"
                                             Padding="10,6" FontSize="12"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <!-- Content area -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="0">
                                <!-- Schedule LIST (visible when not editing) -->
                                <StackPanel Spacing="0" Margin="16,12"
                                            IsVisible="{Binding !SchedulesViewModel.IsEditing}">
                                <ItemsControl ItemsSource="{Binding SchedulesViewModel.Schedules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ScheduleRowViewModel">
                                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                    BorderBrush="{DynamicResource Container2BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Padding="12,10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                                                    <!-- Enable toggle -->
                                                    <CheckBox Grid.Column="0"
                                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                                              Command="{Binding $parent[ItemsControl].DataContext.SchedulesViewModel.ToggleEnabledCommand}"
                                                              CommandParameter="{Binding}"/>
                                                    <!-- Info -->
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/>
                                                            <Border Background="{DynamicResource Container3BackgroundBrush}"
                                                                    CornerRadius="3" Padding="5,1">
                                                                <TextBlock Text="{Binding TypeLabel}" FontSize="10"
                                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            </Border>
                                                            <Border Background="#1A7F37" CornerRadius="3" Padding="5,1"
                                                                    IsVisible="{Binding IsRunning}">
                                                                <TextBlock Text="{loc:Tr Batch_Running}" FontSize="10" Foreground="#3FB950"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <TextBlock Text="{Binding TriggerLabel}" FontSize="11"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                            <TextBlock Text="{Binding ArtistsSummary}" FontSize="11"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                                       IsVisible="{Binding HasArtists}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                                            <TextBlock Text="{Binding LastRun, StringFormat='Last: {0}'}" FontSize="10"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                                            <TextBlock Text="{Binding NextRun, StringFormat='Next: {0}'}" FontSize="10"
                                                                       Foreground="{DynamicResource DefaultForegroundBrushDisabled}"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding LastError, StringFormat='⚠ {0}'}" FontSize="10"
                                                                   Foreground="OrangeRed" IsVisible="{Binding HasError}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                    <!-- Edit -->
                                                    <Button Grid.Column="2" Content="{loc:Tr Batch_Edit}"
                                                            FontSize="11"   Margin="6,0,0,0"
                                                            ToolTip.Tip="{loc:Tr Batch_EditThisSchedule}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.SchedulesViewModel.BeginEditCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <!-- Run Now -->
                                                    <Button Grid.Column="3" Content="{loc:Tr Batch_Run}"
                                                            FontSize="11"   Margin="4,0,0,0"
                                                            ToolTip.Tip="{loc:Tr Batch_RunThisScheduleImmediately}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.SchedulesViewModel.RunNowCommand}"
                                                            CommandParameter="{Binding}"/>
                                                    <!-- Delete -->
                                                    <Button Grid.Column="4" Content="🗑"
                                                            FontSize="11"   Margin="4,0,0,0"
                                                            ToolTip.Tip="{loc:Tr Batch_DeleteThisSchedule}"
                                                            Command="{Binding $parent[ItemsControl].DataContext.SchedulesViewModel.DeleteScheduleCommand}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{loc:Tr Batch_NoSchedulesYetClickNewSchedule}"
                                           FontSize="13" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                           IsVisible="{Binding !SchedulesViewModel.Schedules.Count}"
                                           Margin="0,8"/>
                            </StackPanel>

                            <!-- Schedule EDITOR (visible when editing) -->
                            <StackPanel Spacing="16" Margin="20"
                                        IsVisible="{Binding SchedulesViewModel.IsEditing}">

                                    <!-- Schedule name -->
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{loc:Tr Batch_ScheduleName}" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding SchedulesViewModel.NewScheduleName, Mode=TwoWay}"
                                                 PlaceholderText="{loc:Tr Batch_ScheduleNameExample}"
                                                 CornerRadius="6" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Artists in this schedule -->
                                    <StackPanel Spacing="8">
                                        <DockPanel LastChildFill="False">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Text="{loc:Tr Nav_Artists}" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SchedulesViewModel.StagedArtists.Count, StringFormat='{}{0} added'}"
                                                           FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushTertiary}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button DockPanel.Dock="Right" Content="{loc:Tr Batch_ClearAll_2}"
                                                    Command="{Binding SchedulesViewModel.ClearStagedArtistsCommand}"
                                                    IsVisible="{Binding SchedulesViewModel.HasStagedArtists}"
                                                      FontSize="11"/>
                                        </DockPanel>
                                        <Border Background="{DynamicResource Container3BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" MinHeight="40" Padding="6">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="120">
                                                <ItemsControl ItemsSource="{Binding SchedulesViewModel.StagedArtists}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="vm:StagedArtist">
                                                            <Border Background="{DynamicResource Container2BackgroundBrush}"
                                                                    BorderBrush="{DynamicResource Container2BorderBrush}"
                                                                    BorderThickness="1" CornerRadius="5"
                                                                    Padding="8,3" Margin="0,0,5,5">
                                                                <DockPanel LastChildFill="False">
                                                                    <Button DockPanel.Dock="Right" Content="✕"
                                                                            FontSize="9"  Padding="3,0" Margin="5,0,0,0"
                                                                            Command="{Binding $parent[ItemsControl].DataContext.SchedulesViewModel.RemoveArtistFromStagingCommand}"
                                                                            CommandParameter="{Binding}"/>
                                                                    <TextBlock Text="{Binding DisplayLabel}" FontSize="11" VerticalAlignment="Center"/>
                                                                </DockPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>
                                        </Border>
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding SchedulesViewModel.NewArtistId, Mode=TwoWay}"
                                                     PlaceholderText="{loc:Tr Batch_ArtistIDOrPixivNetEn}"
                                                     CornerRadius="6" FontSize="12"/>
                                            <TextBox Grid.Column="1" Width="80"
                                                     Text="{Binding SchedulesViewModel.PageRange, Mode=TwoWay}"
                                                     PlaceholderText="{loc:Tr Search_Pages}"
                                                     ToolTip.Tip="{loc:Tr Batch_PageRangeForThisArtistE}"
                                                     CornerRadius="6" FontSize="12"/>
                                            <Button Grid.Column="2" Content="{loc:Tr Batch_Add}"
                                                    Command="{Binding SchedulesViewModel.AddArtistToStagingCommand}"
                                                    IsEnabled="{Binding !SchedulesViewModel.IsResolvingArtist}"
                                                     Padding="10,6" FontSize="12"
                                                    ToolTip.Tip="{loc:Tr Batch_ResolveArtistNameAndAddTo}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding SchedulesViewModel.ResolveError}"
                                                   FontSize="11" Foreground="OrangeRed"
                                                   IsVisible="{Binding SchedulesViewModel.ResolveError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>

                                    <!-- When to Run -->
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{loc:Tr Batch_WhenToRun}" FontSize="12" FontWeight="SemiBold"/>
                                        <StackPanel Spacing="6">
                                            <RadioButton Content="{loc:Tr Batch_DailyRecurring}" GroupName="TriggerType"
                                                         IsChecked="{Binding SchedulesViewModel.IsTriggerDaily, Mode=TwoWay}" FontSize="12"/>
                                            <RadioButton Content="{loc:Tr Batch_RunOnAppStartup}" GroupName="TriggerType"
                                                         IsChecked="{Binding SchedulesViewModel.IsTriggerStartup, Mode=TwoWay}" FontSize="12"/>
                                            <RadioButton Content="{loc:Tr Batch_RunOnceAtASpecificDate}" GroupName="TriggerType"
                                                         IsChecked="{Binding SchedulesViewModel.IsTriggerOnce, Mode=TwoWay}" FontSize="12"/>
                                        </StackPanel>
                                        <Border IsVisible="{Binding SchedulesViewModel.IsTriggerDaily}"
                                                Background="{DynamicResource Container3BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="8">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{loc:Tr Batch_Time}" FontSize="12" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding SchedulesViewModel.Hour12Options}"
                                                              SelectedItem="{Binding SchedulesViewModel.TriggerHour12, Mode=TwoWay}"
                                                              FontSize="12" Width="65" ToolTip.Tip="{loc:Tr Batch_Hour112}"/>
                                                    <TextBlock Text=":" FontSize="14" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding SchedulesViewModel.MinuteOptions}"
                                                              SelectedItem="{Binding SchedulesViewModel.TriggerMinute, Mode=TwoWay}"
                                                              FontSize="12" Width="65" ToolTip.Tip="{loc:Tr Batch_Minute}"/>
                                                    <ComboBox ItemsSource="{Binding SchedulesViewModel.AmPmOptions}"
                                                              SelectedItem="{Binding SchedulesViewModel.TriggerAmPm, Mode=TwoWay}"
                                                              FontSize="12" Width="65"/>
                                                    <TextBlock Text="{loc:Tr Batch_ChecksDay}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                                    <ComboBox Width="55" SelectedItem="{Binding SchedulesViewModel.ChecksPerDay, Mode=TwoWay}"
                                                              FontSize="12" ToolTip.Tip="{loc:Tr Batch_1OnceDaily2TwiceEvery}">
                                                        <ComboBoxItem Content="1"/>
                                                        <ComboBoxItem Content="2"/>
                                                        <ComboBoxItem Content="3"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                           Text="{loc:Tr Batch_2Every12H3Every}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border IsVisible="{Binding SchedulesViewModel.IsTriggerOnce}"
                                                Background="{DynamicResource Container3BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="8">
                                                <TextBlock Text="{loc:Tr Batch_RunOnceOn}" FontSize="12"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <CalendarDatePicker SelectedDate="{Binding SchedulesViewModel.OnceDateTime, Mode=TwoWay}"
                                                                        FontSize="12" Width="160" ToolTip.Tip="{loc:Tr Batch_PickTheDate}"/>
                                                    <ComboBox ItemsSource="{Binding SchedulesViewModel.Hour12Options}"
                                                              SelectedItem="{Binding SchedulesViewModel.TriggerHour12, Mode=TwoWay}"
                                                              FontSize="12" Width="65" ToolTip.Tip="{loc:Tr Batch_Hour}"/>
                                                    <TextBlock Text=":" FontSize="14" VerticalAlignment="Center"/>
                                                    <ComboBox ItemsSource="{Binding SchedulesViewModel.MinuteOptions}"
                                                              SelectedItem="{Binding SchedulesViewModel.TriggerMinute, Mode=TwoWay}"
                                                              FontSize="12" Width="65" ToolTip.Tip="{loc:Tr Batch_Minute}"/>
                                                    <ComboBox ItemsSource="{Binding SchedulesViewModel.AmPmOptions}"
                                                              SelectedItem="{Binding SchedulesViewModel.TriggerAmPm, Mode=TwoWay}"
                                                              FontSize="12" Width="65"/>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource DefaultForegroundBrushDisabled}"
                                                           Text="{loc:Tr Batch_TheScheduleWillRunExactlyOnce}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Content Filters -->
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{loc:Tr Settings_ContentFilters}" FontSize="12" FontWeight="SemiBold"/>
                                        <Border Background="{DynamicResource Container3BackgroundBrush}"
                                                BorderBrush="{DynamicResource Container3BorderBrush}"
                                                BorderThickness="1" CornerRadius="6" Padding="12,10">
                                            <StackPanel Spacing="10">
                                                <TextBlock Text="{loc:Tr Batch_SkipContentTypes}" FontSize="11"
                                                           Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                <WrapPanel>
                                                    <CheckBox Content="{loc:Tr Batch_AIGenerated}" Margin="0,0,16,4"
                                                              IsChecked="{Binding SchedulesViewModel.FilterSkipAi, Mode=TwoWay}" FontSize="12"/>
                                                    <CheckBox Content="{loc:Tr Search_Manga}" Margin="0,0,16,4"
                                                              IsChecked="{Binding SchedulesViewModel.FilterSkipManga, Mode=TwoWay}" FontSize="12"/>
                                                    <CheckBox Content="{loc:Tr Rankings_Ugoira}" Margin="0,0,16,4"
                                                              IsChecked="{Binding SchedulesViewModel.FilterSkipUgoira, Mode=TwoWay}" FontSize="12"/>
                                                    <CheckBox Content="R-18" Margin="0,0,16,4"
                                                              IsChecked="{Binding SchedulesViewModel.FilterSkipR18, Mode=TwoWay}" FontSize="12"/>
                                                    <CheckBox Content="{loc:Tr Batch_R18GOnly}" Margin="0,0,0,4"
                                                              IsChecked="{Binding SchedulesViewModel.FilterSkipR18G, Mode=TwoWay}" FontSize="12"
                                                              ToolTip.Tip="{loc:Tr Batch_SkipGrotesqueViolentR18GBut}"/>
                                                </WrapPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{loc:Tr Batch_OnlyDownloadArtworksPosted}" FontSize="11"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                    <ComboBox SelectedIndex="{Binding SchedulesViewModel.FilterDateLimitMode, Mode=TwoWay}"
                                                              CornerRadius="4" FontSize="12" HorizontalAlignment="Left" MinWidth="180">
                                                        <ComboBoxItem Content="{loc:Tr Pixivision_AllTime}"/>
                                                        <ComboBoxItem Content="{loc:Tr Batch_SinceLastRun}"/>
                                                        <ComboBoxItem Content="{loc:Tr Batch_WithinTheLast24Hours}"/>
                                                        <ComboBoxItem Content="{loc:Tr Batch_WithinTheLast7Days}"/>
                                                        <ComboBoxItem Content="{loc:Tr Batch_WithinTheLast30Days}"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{loc:Tr Batch_MaxArtworksPerArtist}" FontSize="11"
                                                               Foreground="{DynamicResource DefaultForegroundBrushTertiary}"/>
                                                    <TextBox Text="{Binding SchedulesViewModel.FilterMaxArtworks, Mode=TwoWay}"
                                                             PlaceholderText="{loc:Tr Batch_LimitExample}"
                                                             CornerRadius="4" FontSize="12" HorizontalAlignment="Left" MinWidth="180"
                                                             ToolTip.Tip="{loc:Tr Batch_OnlyFetchTheNMostRecent}"/>
                                                </StackPanel>
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{loc:Tr Batch_MustIncludeTagS}" FontSize="11"/>
                                                        <TextBox Text="{Binding SchedulesViewModel.FilterIncludeTags, Mode=TwoWay}"
                                                                 PlaceholderText="{loc:Tr Batch_TagsExample}" CornerRadius="4" FontSize="12"
                                                                 ToolTip.Tip="{loc:Tr Batch_CommaSeparatedArtworkMustMatchAt}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{loc:Tr Batch_ExcludeTagS}" FontSize="11"/>
                                                        <TextBox Text="{Binding SchedulesViewModel.FilterExcludeTags, Mode=TwoWay}"
                                                                 PlaceholderText="{loc:Tr Batch_ExcludeExample}" CornerRadius="4" FontSize="12"
                                                                 ToolTip.Tip="{loc:Tr Batch_CommaSeparatedArtworkIsSkippedIf}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- Naming Overrides -->
                                    <Expander Header="{loc:Tr Batch_NamingOverridesOptional}" FontSize="12">
                                        <StackPanel Spacing="10" Margin="0,8,0,0">
                                            <CheckBox Content="{loc:Tr Batch_OverrideGlobalFolderFilenameTemplatesFor}"
                                                      IsChecked="{Binding SchedulesViewModel.UseCustomNaming, Mode=TwoWay}" FontSize="12"/>
                                            <StackPanel IsVisible="{Binding SchedulesViewModel.UseCustomNaming}" Spacing="8">
                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{loc:Tr Settings_FolderTemplate}" FontSize="12"/>
                                                        <TextBox Text="{Binding SchedulesViewModel.CustomFolderTemplate, Mode=TwoWay}"
                                                                 PlaceholderText="{loc:Tr Batch_LeaveBlankForGlobal}" CornerRadius="4" FontSize="12"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="4">
                                                        <TextBlock Text="{loc:Tr Settings_FilenameTemplate}" FontSize="12"/>
                                                        <TextBox Text="{Binding SchedulesViewModel.CustomFilenameTemplate, Mode=TwoWay}"
                                                                 PlaceholderText="{loc:Tr Batch_LeaveBlankForGlobal}" CornerRadius="4" FontSize="12"/>
                                                    </StackPanel>
                                                </Grid>
                                                <CheckBox Content="{loc:Tr Batch_SeparateR18IntoSubfolder}"
                                                          IsChecked="{Binding SchedulesViewModel.CustomSeparateR18, Mode=TwoWay}" FontSize="12"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Expander>

                                    <!-- Save / Cancel -->
                                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                        <Button Content="{loc:Tr Batch_BackToSchedules}"
                                                Command="{Binding SchedulesViewModel.CancelEditCommand}"
                                                  FontSize="13"/>
                                        <Button Content="{Binding SchedulesViewModel.AddButtonLabel}"
                                                Command="{Binding SchedulesViewModel.AddScheduleCommand}"
                                                Classes="accent"
                                                  FontSize="13" />
                                    </StackPanel>

                                </StackPanel>
                            </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</UserControl>
